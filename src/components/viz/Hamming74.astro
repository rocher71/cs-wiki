---
// 해밍(7,4): 데이터 1011 → 0110011, 5번 비트 오류(0110111) → 신드롬 5 → 정정. 자리 번호는 본문처럼 왼쪽부터 1번.
// python으로 검산(패리티 = 짝수 패리티, 그룹 = 자리 번호의 해당 비트가 1인 자리).
// 같은 자리에 번갈아 나오는 값 줄·그룹 테두리·아래 설명은 class="hide".
import Stepper from '../Stepper.astro';

const NAMES = ['p1', 'p2', 'd1', 'p4', 'd2', 'd3', 'd4'];
const X = NAMES.map((_, i) => 6 + i * 44); // 칸 폭 40
const CH = 44;
// 단계별 값 (빈칸은 ''), err = 오류 칸, fix = 정정된 칸, hi = 이번에 채운 칸
const variants: Record<string, { v: string; hi?: number[]; err?: number; fix?: number }> = {
  a2: { v: '__1_011', hi: [3, 5, 6, 7] },
  a3: { v: '0_1_011', hi: [1] },
  a4: { v: '011_011', hi: [2] },
  a5: { v: '0110011', hi: [4] },
  a6: { v: '0110111', err: 5 },
  a8: { v: '0110011', fix: 5 },
};
const groups: Record<string, number[]> = { g1: [1, 3, 5, 7], g2: [2, 3, 6, 7], g4: [4, 5, 6, 7] };

const steps = [
  { caption: '7칸에 왼쪽부터 1~7번을 매겨요. 2의 거듭제곱인 1·2·4번은 패리티(p) 자리, 나머지 3·5·6·7번은 데이터(d) 자리예요.', show: ['cells', 't1'] },
  { caption: '데이터 1011을 데이터 자리 3·5·6·7번에 차례로 넣어요.', show: ['cells', 'a2', 't2'] },
  { caption: 'p1은 1·3·5·7번 그룹을 맡아요. 3·5·7번이 1, 0, 1이라 1이 이미 2개(짝수)예요. 그래서 p1 = 0.', show: ['cells', 'a3', 'g1', 't3'] },
  { caption: 'p2는 2·3·6·7번 그룹. 3·6·7번이 1, 1, 1로 1이 3개(홀수)라, 짝수로 맞추려고 p2 = 1.', show: ['cells', 'a4', 'g2', 't4'] },
  { caption: 'p4는 4·5·6·7번 그룹. 5·6·7번이 0, 1, 1로 1이 2개라 p4 = 0. 완성된 부호는 0110011이에요.', show: ['cells', 'a5', 'g4', 't5'] },
  { caption: '보내는 도중 5번 비트가 0에서 1로 뒤집혀, 받는 쪽에는 0110111이 도착했어요.', show: ['cells', 'a6', 't6'] },
  { caption: '받은 값으로 세 그룹을 다시 세요. 1의 개수가 홀수면 틀림(1), 짝수면 맞음(0). p1 그룹 틀림, p2 그룹 맞음, p4 그룹 틀림.', show: ['cells', 'a6', 't7'] },
  { caption: '틀린 그룹 번호를 더하면 4 + 1 = 5(p4 p2 p1 = 101 = 5). 5번 비트를 뒤집으면 0110011로 돌아와요. 신드롬이 0이면 오류 없음이에요.', show: ['cells', 'a8', 'h5', 't8'] },
];
---
<Stepper title="해밍(7,4): 1011 보내고 5번 오류 고치기" steps={steps}>
  <svg class="viz" viewBox="0 0 320 340" role="img" aria-label="데이터 1011을 3·5·6·7번에 넣고 p1=0, p2=1, p4=0을 계산해 0110011을 만든다. 5번 비트가 뒤집혀 0110111을 받으면 p1·p4 그룹이 틀려 신드롬 4+1=5, 5번 비트를 뒤집어 정정한다.">
    <!-- 칸 틀 + 자리 번호 + 이름 (패리티 = 강조색 + p 라벨) -->
    <g data-id="cells">
      <text class="sub" x="160" y="20">자리 번호 (왼쪽부터 1번)</text>
      {NAMES.map((n, i) => <>
        <text class="sub" x={X[i] + 20} y="44">{i + 1}</text>
        <rect class={n[0] === 'p' ? 'chip' : 'box'} x={X[i]} y="56" width="40" height={CH} rx="4" />
        <text class={n[0] === 'p' ? 'hi' : 'sub'} x={X[i] + 20} y="116">{n}</text>
      </>)}
    </g>

    <!-- 단계별 값 -->
    {Object.entries(variants).map(([id, a]) => (
      <g data-id={id} class="hide">
        {[...a.v].map((b, i) => {
          const pos = i + 1;
          if (pos === a.err) return <><rect class="err" x={X[i]} y="56" width="40" height={CH} rx="4" /><text class="err-t" x={X[i] + 20} y="78">{b}</text></>;
          return b === '_' ? null : <text class={a.hi?.includes(pos) || pos === a.fix ? 'hi' : ''} x={X[i] + 20} y="78" style="font-weight:700">{b}</text>;
        })}
      </g>
    ))}

    <!-- 그룹 테두리 -->
    {Object.entries(groups).map(([id, ps]) => (
      <g data-id={id} class="hide">{ps.map((p) => <rect class="hl" x={X[p - 1] - 2} y="54" width="44" height={CH + 4} rx="6" />)}</g>
    ))}
    <rect data-id="h5" class="hl hide" x={X[4] - 2} y="54" width="44" height={CH + 4} rx="6" />

    <!-- 아래 설명 패널 (같은 자리, 번갈아) -->
    <g data-id="t1" class="hide">
      <rect class="box" x="6" y="140" width="308" height="190" rx="8" />
      <text x="160" y="172" style="font-weight:700">패리티 자리 = 1, 2, 4</text>
      <text class="sub" x="160" y="198">(2의 거듭제곱)</text>
      <text x="160" y="240">데이터 자리 = 3, 5, 6, 7</text>
      <text class="sub" x="160" y="290">패리티 3개 + 데이터 4개 = 7칸</text>
    </g>
    <g data-id="t2" class="hide">
      <rect class="box" x="6" y="140" width="308" height="190" rx="8" />
      <text x="160" y="172" style="font-weight:700">데이터 1011</text>
      <text x="160" y="212">3번 = 1, 5번 = 0</text>
      <text x="160" y="240">6번 = 1, 7번 = 1</text>
      <text class="sub" x="160" y="290">p 자리는 아직 비어 있음</text>
    </g>
    <g data-id="t3" class="hide">
      <rect class="box" x="6" y="140" width="308" height="190" rx="8" />
      <text x="160" y="172" style="font-weight:700">p1 그룹: 1, 3, 5, 7</text>
      <text x="160" y="212">3·5·7번 = 1, 0, 1</text>
      <text x="160" y="240">1이 2개 (짝수)</text>
      <text class="hi" x="160" y="290">p1 = 0</text>
    </g>
    <g data-id="t4" class="hide">
      <rect class="box" x="6" y="140" width="308" height="190" rx="8" />
      <text x="160" y="172" style="font-weight:700">p2 그룹: 2, 3, 6, 7</text>
      <text x="160" y="212">3·6·7번 = 1, 1, 1</text>
      <text x="160" y="240">1이 3개 (홀수)</text>
      <text class="hi" x="160" y="290">p2 = 1 (짝수로 맞춤)</text>
    </g>
    <g data-id="t5" class="hide">
      <rect class="box" x="6" y="140" width="308" height="190" rx="8" />
      <text x="160" y="172" style="font-weight:700">p4 그룹: 4, 5, 6, 7</text>
      <text x="160" y="212">5·6·7번 = 0, 1, 1</text>
      <text x="160" y="240">1이 2개 (짝수) → <tspan class="hi">p4 = 0</tspan></text>
      <text x="160" y="290">완성: <tspan class="hi">0110011</tspan></text>
    </g>
    <g data-id="t6" class="hide">
      <rect class="err" x="6" y="140" width="308" height="190" rx="8" />
      <text x="160" y="172" style="font-weight:700">전송 중 5번 비트 오류</text>
      <text x="160" y="220">보냄: 0110011</text>
      <text x="160" y="252">받음: 0110<tspan class="err-t">1</tspan>11</text>
      <text class="sub" x="160" y="298">어디가 틀렸는지 받는 쪽은 모름</text>
    </g>
    <g data-id="t7" class="hide">
      <rect class="box" x="6" y="140" width="308" height="190" rx="8" />
      <text x="160" y="166" style="font-weight:700">받은 값으로 다시 세기</text>
      <text class="l" x="20" y="204">p1 (1,3,5,7)</text>
      <text class="l" x="20" y="226">0,1,1,1 → 3개</text>
      <text class="err-t" x="270" y="215">틀림 1</text>
      <text class="l" x="20" y="252">p2 (2,3,6,7)</text>
      <text class="l" x="20" y="274">1,1,1,1 → 4개</text>
      <text x="270" y="263">맞음 0</text>
      <text class="l" x="20" y="300">p4 (4,5,6,7)</text>
      <text class="l" x="20" y="322">0,1,1,1 → 3개</text>
      <text class="err-t" x="270" y="311">틀림 1</text>
    </g>
    <g data-id="t8" class="hide">
      <rect class="chip" x="6" y="140" width="308" height="190" rx="8" />
      <text x="160" y="172" style="font-weight:700">신드롬 = 4 + 1 = <tspan class="hi">5</tspan></text>
      <text class="sub" x="160" y="200">p4 p2 p1 = 1 0 1 (2진수) = 5</text>
      <text x="160" y="244">5번 비트를 뒤집기</text>
      <text x="160" y="276">0110<tspan class="err-t">1</tspan>11 → 0110<tspan class="hi">0</tspan>11</text>
      <text class="sub" x="160" y="310">신드롬 0 = 오류 없음</text>
    </g>
  </svg>
</Stepper>
