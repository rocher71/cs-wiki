---
// HTTP/1.1 HOL → 다중 연결 우회 → HTTP/2 멀티플렉싱. 가로축은 시간(왼→오), 줄 하나가 TCP 연결 하나.
import Stepper from '../Stepper.astro';
const titles = ['HTTP/1.1 · 연결 1개', 'HTTP/1.1 · 연결 여러 개', 'HTTP/2 · 연결 1개', 'HTTP/2 · 연결 1개'];
const captions = [
  'HTTP/1.1 연결 1개에 A·B·C를 요청해요. 응답은 요청한 순서대로만 와서, B가 느리면 다 된 C도 B 뒤에 갇혀요(파이프라이닝을 켜도 같아요).',
  '1.1의 우회책: 연결을 여러 개(몇 개까지 열지는 브라우저가 정해요) 열어 나눠 보내요. C는 빨리 끝나지만, 연결마다 TCP+TLS 핸드셰이크 비용을 따로 내요.',
  'HTTP/2는 연결 1개 안에서 A·B·C를 스트림 1·3·5로 나누고, 작은 프레임으로 잘라 섞어 보내요.',
  'B가 느려도 A·C의 프레임은 사이사이 먼저 도착해서 먼저 완료돼요. 응용 계층의 HOL이 사라졌어요.',
];
// HTTP/2 프레임 순서 (A=스트림1, B=스트림3, C=스트림5)
const frames = ['A', 'B', 'C', 'A', 'C', 'B', 'B', 'B', 'B', 'B'];
const FX = (i: number) => 14 + i * 29;
const steps = captions.map((caption, i) => ({
  caption,
  show: [`t${i}`, ['h1', 'multi', 'h2', 'h2'][i], ...(i === 3 ? ['done'] : [])],
}));
---
<Stepper title="HTTP/1.1의 HOL과 HTTP/2 멀티플렉싱" steps={steps}>
  <svg class="viz" viewBox="0 0 320 262" role="img" aria-label="HTTP/1.1 연결 하나에서 느린 B 뒤에 C가 갇히고, 연결을 여러 개 열어 우회하지만 핸드셰이크 비용이 들며, HTTP/2는 연결 하나에서 A·B·C 프레임을 섞어 보내 A와 C가 먼저 끝나는 과정">
    {titles.map((t, i) => (
      <g data-id={`t${i}`} class="hide">
        <rect class="chip" x="10" y="6" width="300" height="30" rx="15" />
        <text x="160" y="21" style="font-weight:700">{t}</text>
      </g>
    ))}

    <g data-id="h1" class="hide">
      <text class="sub l" x="12" y="60">연결 1 (TCP)</text>
      <rect class="frame" x="10" y="72" width="300" height="40" rx="6" />
      <rect class="box" x="14" y="76" width="40" height="32" rx="4" /><text x="34" y="92">A</text>
      <rect class="bad" x="58" y="76" width="150" height="32" rx="4" /><text x="133" y="92">B (느림)</text>
      <rect class="err" x="212" y="76" width="40" height="32" rx="4" /><text x="232" y="92">C</text>
      <text class="err-t" x="232" y="134">C 대기</text>
      <text class="sub" x="160" y="168">응답은 요청 순서대로만</text>
      <text class="sub" x="160" y="190">A → B → C</text>
    </g>

    <g data-id="multi" class="hide">
      {[['A', 40, 'box'], ['B (느림)', 150, 'bad'], ['C', 40, 'box']].map(([t, w, cls], i) => (
        <g>
          <text class="sub l" x="12" y={58 + i * 62}>연결 {i + 1}</text>
          <rect class="frame" x="10" y={68 + i * 62} width="300" height="40" rx="6" />
          <rect class="bad" x="14" y={72 + i * 62} width="88" height="32" rx="4" />
          <text class="sub" x="58" y={88 + i * 62}>TCP+TLS</text>
          <rect class={cls} x="106" y={72 + i * 62} width={w} height="32" rx="4" />
          <text x={106 + +w / 2} y={88 + i * 62}>{t}</text>
        </g>
      ))}
      <text class="hi l" x="152" y="212">← C 빨리 끝남</text>
    </g>

    <g data-id="h2" class="hide">
      <text class="sub l" x="12" y="60">연결 1 (TCP) 안의 프레임들</text>
      <rect class="frame" x="10" y="72" width="300" height="40" rx="6" />
      {frames.map((f, i) => (
        <g>
          <rect class={f === 'B' ? 'bad' : 'box'} x={FX(i)} y="76" width="26" height="32" rx="4" />
          <text x={FX(i) + 13} y="92">{f}</text>
        </g>
      ))}
      <text class="sub" x="160" y="200">A=스트림 1 · B=스트림 3 · C=스트림 5</text>
    </g>

    <g data-id="done" class="hide">
      <line class="line" x1={FX(3) + 13} y1="114" x2={FX(3) + 13} y2="140" style="stroke:var(--sl-color-accent);stroke-width:2" />
      <text class="hi" x={FX(3) + 4} y="152">A 완료</text>
      <line class="line" x1={FX(4) + 13} y1="114" x2={FX(4) + 13} y2="164" style="stroke:var(--sl-color-accent);stroke-width:2" />
      <text class="hi" x={FX(4) + 22} y="176">C 완료</text>
      <text class="sub" x={FX(9) - 6} y="134">B 완료</text>
    </g>

    <line class="line" x1="10" y1="240" x2="300" y2="240" />
    <path d="M300 235L310 240L300 245z" fill="var(--sl-color-gray-3)" />
    <text class="sub" x="160" y="254">시간 →</text>
  </svg>
</Stepper>
