---
// @Transactional 호출 흐름: 프록시 → TransactionInterceptor → 트랜잭션 매니저(커넥션 획득·스레드 바인딩) → 진짜 메서드 → 커밋/롤백 분기 → 반납
import Stepper from '../Stepper.astro';
const s1 = ['ctrl', 'a0', 'call', 'proxy'];
const s2 = [...s1, 'int'];
const s3 = [...s2, 'a1', 'mgr', 'a2', 'conn'];
const s4 = [...s3, 'a3', 'real', 'a3b', 'repo1', 'repo2'];
const s5 = [...s4, 'a4', 'ok', 'rb', 'ck'];
const steps = [
  { caption: 'Controller가 orderService.placeOrder()를 불러요. 그런데 이 호출을 먼저 받는 건 진짜 OrderService가 아니라 스프링이 끼워 둔 프록시예요.', show: [...s1, 'hl-proxy'] },
  { caption: '프록시 안의 TransactionInterceptor가 메서드에 붙은 @Transactional 속성(전파, 격리 수준, readOnly, 롤백 규칙)을 읽어요.', show: [...s2, 'hl-int'] },
  { caption: '트랜잭션 매니저가 커넥션을 얻고 autocommit을 꺼요. 그리고 이 커넥션을 현재 스레드에 묶어 둬요.', show: [...s3, 'hl-conn'] },
  { caption: '이제 진짜 placeOrder()가 실행돼요. 안에서 부르는 Repository들은 스레드에 묶인 같은 커넥션 c1을 써서 한 트랜잭션에 참여해요.', show: [...s4, 'hl-real'] },
  { caption: '메서드가 끝나면 결과에 따라 갈려요. 정상 종료면 커밋하고, 런타임 예외나 Error면 롤백해요. checked 예외는 기본 설정이면 커밋돼요.', show: [...s5, 'hl-out'] },
  { caption: '마지막으로 커넥션을 풀에 돌려주고 스레드 바인딩을 풀어요. 그다음 결과(또는 예외)를 Controller에 돌려줘요.', show: [...s5, 'a5', 'ret', 'hl-ret'] },
];
---
<Stepper title="@Transactional 메서드 한 번 호출의 흐름" steps={steps}>
  <svg class="viz" viewBox="0 0 320 474" role="img" aria-label="Controller의 호출을 프록시가 받아, TransactionInterceptor가 속성을 읽고, 트랜잭션 매니저가 커넥션을 얻어 스레드에 묶은 뒤, 진짜 메서드와 Repository가 같은 커넥션으로 실행되고, 결과에 따라 커밋 또는 롤백한 다음 커넥션을 반납하는 그림">
    <defs>
      <marker id="txp-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    <g data-id="ctrl"><rect class="box" x="8" y="4" width="304" height="34" rx="7" /><text x="160" y="21">Controller</text></g>
    <line data-id="a0" class="line" x1="160" y1="38" x2="160" y2="58" marker-end="url(#txp-arr)" />
    <text data-id="call" class="mono l" x="170" y="48">placeOrder()</text>

    <g data-id="proxy">
      <rect class="frame" x="8" y="60" width="304" height="406" rx="10" />
      <text class="sub l" x="16" y="74">프록시 (OrderService 대신 등록됨)</text>
    </g>

    <g data-id="int"><rect class="box" x="18" y="86" width="284" height="34" rx="7" /><text class="mono" x="160" y="103">TransactionInterceptor</text></g>
    <line data-id="a1" class="line" x1="160" y1="120" x2="160" y2="129" marker-end="url(#txp-arr)" />
    <g data-id="mgr"><rect class="box" x="18" y="130" width="284" height="34" rx="7" /><text x="160" y="147">트랜잭션 매니저</text></g>
    <line data-id="a2" class="line" x1="160" y1="164" x2="160" y2="173" marker-end="url(#txp-arr)" />
    <g data-id="conn">
      <rect class="chip" x="18" y="174" width="284" height="46" rx="7" />
      <text x="160" y="189">커넥션 c1 획득 → 스레드에 묶음</text>
      <text class="mono" x="160" y="208">autocommit=false</text>
    </g>
    <line data-id="a3" class="line" x1="160" y1="220" x2="160" y2="229" marker-end="url(#txp-arr)" />
    <g data-id="real"><rect class="box" x="18" y="230" width="284" height="34" rx="7" /><text x="160" y="247">진짜 placeOrder() 실행</text></g>
    <line data-id="a3b" class="line" x1="160" y1="264" x2="160" y2="273" marker-end="url(#txp-arr)" />
    <g data-id="repo1"><rect class="box" x="18" y="274" width="138" height="34" rx="7" /><text class="mono" x="87" y="291">OrderRepo·c1</text></g>
    <g data-id="repo2"><rect class="box" x="164" y="274" width="138" height="34" rx="7" /><text class="mono" x="233" y="291">StockRepo·c1</text></g>
    <line data-id="a4" class="line" x1="160" y1="308" x2="160" y2="317" marker-end="url(#txp-arr)" />

    <g data-id="ok"><rect class="chip" x="18" y="318" width="284" height="30" rx="7" /><text x="160" y="333">정상 종료 → 커밋 ✓</text></g>
    <g data-id="rb"><rect class="err" x="18" y="352" width="284" height="30" rx="7" /><text class="err-t" x="160" y="367">런타임 예외·Error → 롤백 ✗</text></g>
    <g data-id="ck"><rect class="box" x="18" y="386" width="284" height="30" rx="7" /><text x="160" y="401">checked 예외 → 커밋 (기본)</text></g>
    <line data-id="a5" class="line" x1="160" y1="416" x2="160" y2="425" marker-end="url(#txp-arr)" />
    <g data-id="ret"><rect class="box" x="18" y="426" width="284" height="34" rx="7" /><text x="160" y="443">커넥션 반납 · 결과 반환</text></g>

    <rect data-id="hl-proxy" class="hl" x="4" y="0" width="312" height="78" rx="9" />
    <rect data-id="hl-int" class="hl" x="14" y="82" width="292" height="42" rx="9" />
    <rect data-id="hl-conn" class="hl" x="14" y="126" width="292" height="98" rx="9" />
    <rect data-id="hl-real" class="hl" x="14" y="226" width="292" height="86" rx="9" />
    <rect data-id="hl-out" class="hl" x="14" y="314" width="292" height="106" rx="9" />
    <rect data-id="hl-ret" class="hl" x="14" y="422" width="292" height="42" rx="9" />
  </svg>
</Stepper>
