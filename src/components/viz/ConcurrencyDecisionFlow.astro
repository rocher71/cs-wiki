---
// 동시성 문제 풀이 순서: 왼쪽은 질문, 오른쪽은 고를 방법. 단계마다 새 질문·답을 강조.
import Stepper from '../Stepper.astro';

const QX = 6, QW = 140, AX = 180, AW = 134, H = 50;
const rows = [
  { n: 2, y: 72, q: '② 중복 요청?', qs: '같은 요청이 두 번', yes: '예', a: '멱등 키+UNIQUE', as: '락과 별개, 항상' },
  { n: 3, y: 136, q: '③ 한 문장 차감?', qs: '한 행·UPDATE 하나', yes: '예', a: '조건부 UPDATE', as: 'affected rows 확인' },
  { n: 4, y: 206, q: '④ 충돌이 잦나?', qs: '인기 상품·선착순', yes: '잦다', a: '비관적 락', as: 'FOR UPDATE, 짧게' },
  { n: 6, y: 356, q: '⑥ DB 밖 자원?', qs: '외부 API·여러 DB', yes: '예', a: 'Redis 분산 락', as: '정확성은 DB 제약' },
  { n: 7, y: 418, q: '⑦ DB가 못 버팀?', qs: '트래픽 폭주', yes: '예', a: 'Redis 앞단 차감', as: 'DB 확정 + 대기열' },
];
const on = (n: number) => ['q1', ...[2, 3, 4].filter((k) => k <= n).flatMap((k) => ['q' + k, 'v' + k])];
const steps = [
  { caption: '① 먼저 공유 자원을 찾아요. 여러 요청이 동시에 고치는 행이 무엇인지요. 예: 포인트 잔액 한 행, 상품 재고 한 행.', show: ['q1', 'h1'] },
  { caption: '② 같은 요청이 두 번 오는 문제라면 멱등 키와 UNIQUE 제약으로 막아요. 락으로는 못 막으니 락과 별개로 항상 검토해요.', show: [...on(2), 'h2'] },
  { caption: '③ 차감이 한 행, UPDATE 한 문장으로 표현되면 조건부 UPDATE가 가장 간단해요. affected rows가 0이면 잔액 부족이에요.', show: [...on(3), 'h3'] },
  { caption: '④ 아니오(여러 테이블을 읽고 복잡하게 검증)라면 충돌 빈도를 봐요. 잦으면 비관적 락 FOR UPDATE, 트랜잭션은 짧게요.', show: [...on(4), 'h4'] },
  { caption: '⑤ 충돌이 드물면 낙관적 락(@Version)이에요. 충돌 시 트랜잭션 밖에서 재시도하고 횟수를 제한해요.', show: [...on(4), 'q5', 'h5'] },
  { caption: '⑥ DB 밖 자원(외부 API, 여러 DB)을 서버 여러 대가 한 줄로 세워야 하면 Redis 분산 락. 단, 최종 정확성은 DB 제약으로 지켜요.', show: [...on(4), 'q5', 'sep', 'q6', 'h6'] },
  { caption: '⑦ DB가 못 버틸 만큼 트래픽이 몰리면 Redis에서 먼저 차감하고 DB에서 최종 확정해요. 대기열로 유입을 줄이기도 해요.', show: [...on(4), 'q5', 'sep', 'q6', 'q7', 'v7', 'h7'] },
];
---
<Stepper title="동시성 문제, 어떤 방법을 고를까" steps={steps}>
  <svg class="viz" viewBox="0 0 320 476" role="img" aria-label="공유 자원 찾기, 중복 요청이면 멱등 키와 UNIQUE, 한 문장 차감이면 조건부 UPDATE, 아니면 충돌이 잦을 때 비관적 락, 드물 때 낙관적 락. 그 밖에 DB 밖 자원이면 Redis 분산 락, 트래픽이 DB 한계를 넘으면 Redis 앞단 차감과 대기열.">
    <defs>
      <marker id="cdf-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    <g data-id="q1">
      <rect class="box" x="6" y="8" width="308" height={H} rx="7" />
      <text x="160" y="25" style="font-weight:700">① 공유 자원 찾기</text>
      <text class="sub" x="160" y="44">여러 요청이 같이 고치는 행은?</text>
    </g>
    <rect data-id="h1" class="hl hide" x="3" y="5" width="314" height={H + 6} rx="9" />

    <g data-id="v2"><line class="line" x1="30" y1="58" x2="30" y2="70" marker-end="url(#cdf-arr)" /></g>
    <g data-id="v3"><line class="line" x1="30" y1="122" x2="30" y2="134" marker-end="url(#cdf-arr)" /></g>
    <g data-id="v4">
      <line class="line" x1="30" y1="186" x2="30" y2="204" marker-end="url(#cdf-arr)" />
      <text class="l sub" x="38" y="195">아니오</text>
    </g>

    {rows.map((r) => <>
      <g data-id={'q' + r.n}>
        <rect class="box" x={QX} y={r.y} width={QW} height={H} rx="7" />
        <text x={QX + QW / 2} y={r.y + 17} style="font-weight:700">{r.q}</text>
        <text class="sub" x={QX + QW / 2} y={r.y + 36}>{r.qs}</text>
        <line class="line" x1={QX + QW} y1={r.y + 32} x2={AX - 2} y2={r.y + 32} marker-end="url(#cdf-arr)" />
        <text class="sub" x={(QX + QW + AX) / 2} y={r.y + 18}>{r.yes}</text>
        <rect class="chip" x={AX} y={r.y} width={AW} height={H} rx="7" />
        <text x={AX + AW / 2} y={r.y + 17} style="font-weight:700">{r.a}</text>
        <text class="sub" x={AX + AW / 2} y={r.y + 36}>{r.as}</text>
      </g>
      <rect data-id={'h' + r.n} class="hl hide" x="3" y={r.y - 3} width="314" height={H + 6} rx="9" />
    </>)}

    <g data-id="q5">
      <path class="line" d="M110 256 V293 H178" marker-end="url(#cdf-arr)" />
      <text class="sub" x="144" y="282">드물다</text>
      <rect class="chip" x={AX} y="268" width={AW} height={H} rx="7" />
      <text x={AX + AW / 2} y="285" style="font-weight:700">낙관적 락</text>
      <text class="sub" x={AX + AW / 2} y="304">@Version+재시도</text>
    </g>
    <rect data-id="h5" class="hl hide" x={AX - 3} y="265" width={AW + 6} height={H + 6} rx="9" />

    <g data-id="sep">
      <path class="line" d="M6 338 H86 M234 338 H314" style="stroke-dasharray:4 4" />
      <text class="sub" x="160" y="338">그 밖에 확인할 것</text>
    </g>
    <g data-id="v7"><line class="line" x1="30" y1="406" x2="30" y2="416" marker-end="url(#cdf-arr)" /></g>
  </svg>
</Stepper>
