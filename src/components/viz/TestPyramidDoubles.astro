---
// 테스트 피라미드 층별(단위·통합·E2E) 특징 → 아이스크림 콘 안티패턴 → 단위 테스트에서 협력자 자리에 테스트 더블이 서는 모습.
import Stepper from '../Stepper.astro';

// 피라미드: 중심 160, 위로 갈수록 좁아짐
const hw = (y: number) => 40 + ((y - 10) * 110) / 190;
const trap = (y1: number, y2: number) =>
  `${160 - hw(y1)},${y1} ${160 + hw(y1)},${y1} ${160 + hw(y2)},${y2} ${160 - hw(y2)},${y2}`;
const layers = [
  { id: 'L3', y1: 10, y2: 68, name: 'E2E · UI', sub: '가장 적게' },
  { id: 'L2', y1: 72, y2: 133, name: '통합', sub: '중간' },
  { id: 'L1', y1: 137, y2: 200, name: '단위', sub: '가장 많이' },
];
// 아래 정보판: 층마다 같은 자리에 번갈아 나옴
const panels = [
  { id: 'P1', title: '단위 테스트', rows: [['개수', '가장 많이'], ['속도', '아주 빠름 (ms)'], ['실패하면', '어디인지 바로 보임'], ['협력자', '진짜 또는 테스트 더블'], ['보증 범위', '부품 하나']] },
  { id: 'P2', title: '통합 테스트', rows: [['개수', '중간'], ['속도', '중간 (초)'], ['실패하면', '경계 문제를 잡음'], ['협력자', '그 경계(DB 등)는 진짜'], ['보증 범위', '경계와의 연결']] },
  { id: 'P3', title: 'E2E 테스트', rows: [['개수', '핵심 흐름 몇 개만'], ['속도', '느림'], ['실패하면', '원인 찾기 어려움, 플래키'], ['협력자', '전부 진짜'], ['보증 범위', '사용자 흐름 전체 (가장 큼)']] },
];

// 단위 테스트 확대: 진짜 협력자 → 문제 / 대역
const ry = (i: number) => 96 + i * 54;
const deps = [
  { real: 'Logger', prob: '안 쓰지만 인자로 필요', kind: 'Dummy', what: '자리만 채움 (null)' },
  { real: '재고 API', prob: '응답이 그때그때 다름', kind: 'Stub', what: '항상 10개라고 답함' },
  { real: '회원 DB', prob: '띄우고 비우기 느림', kind: 'Fake', what: 'HashMap 저장소' },
  { real: '메일 서버', prob: '진짜 메일이 나감', kind: 'Spy', what: '보낸 횟수를 기록' },
  { real: '결제 API', prob: '진짜 돈이 나감', kind: 'Mock', what: '호출 횟수·인자 검증' },
];
const rows = deps.map((_, i) => 'r' + i);
const probs = (from: number) => deps.slice(from).map((_, i) => 'p' + (i + from));
const dbl = (to: number) => deps.slice(0, to).map((_, i) => 'd' + i);
const pyr = ['pyr', 'L1', 'L2', 'L3'];

const steps = [
  { caption: '맨 아래 단위 테스트: 클래스·함수 하나만 봐요. ms 단위로 빨라서 가장 많이 두고, 실패하면 어디가 고장인지 바로 보여요.', show: [...pyr, 'H1', 'P1'] },
  { caption: '가운데 통합 테스트: DB·외부 API 같은 경계 하나를 실제로 붙여 봐요. 초 단위라 개수는 중간이에요.', show: [...pyr, 'H2', 'P2'] },
  { caption: '꼭대기 E2E: 화면 → 서버 → DB를 사용자처럼 끝까지 돌려요. 보증하는 범위는 가장 크지만 느리고 랜덤 실패(플래키)가 잦아서 핵심 흐름 몇 개만 둬요.', show: [...pyr, 'H3', 'P3'] },
  { caption: '거꾸로 E2E가 대부분인 모양은 아이스크림 콘 안티패턴이에요. 같은 경우는 할 수 있는 한 아래 층에서 확인해요.', show: [...pyr, 'cone'] },
  { caption: '단위 층을 확대해 봐요. 주문 서비스(SUT)가 진짜 협력자를 그대로 쓰면 느리고, 결과가 흔들리고, 진짜 메일·돈이 나가요.', show: ['sut', ...rows, ...probs(0)] },
  { caption: '그 자리에 대역을 세워요. Logger는 Dummy(자리만), 재고는 Stub(정해 둔 답), 회원 DB는 Fake(HashMap으로 진짜처럼 동작)예요. 여기까진 결과 상태를 확인해요.', show: ['sut', ...rows, ...dbl(3), ...probs(3)] },
  { caption: '메일은 Spy(호출을 기록), 결제는 Mock(“정확히 1번, 이 인자로 불렸나” 검증)이에요. 이 둘은 어떻게 불렸는지, 즉 행위를 확인할 때 써요.', show: ['sut', ...rows, ...dbl(5)] },
];
---
<Stepper title="테스트 피라미드와 테스트 더블" steps={steps}>
  <svg class="viz" viewBox="0 0 320 380" role="img" aria-label="테스트 피라미드. 아래부터 단위(가장 많이, 빠름), 통합(중간), E2E(가장 적게, 느림) 층. 거꾸로 된 아이스크림 콘 모양은 안티패턴. 단위 테스트에서는 주문 서비스의 협력자 Logger, 재고 API, 회원 DB, 메일 서버, 결제 API 자리에 각각 Dummy, Stub, Fake, Spy, Mock 대역을 세운다.">
    <defs>
      <marker id="tpd-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    <!-- 피라미드 -->
    <g data-id="pyr" class="hide">
      {layers.map((l) => <polygon class="box" points={trap(l.y1, l.y2)} />)}
    </g>
    {layers.map((l, k) => (
      <polygon data-id={'H' + (3 - k)} class="chip hide" points={trap(l.y1, l.y2)} />
    ))}
    {layers.map((l) => (
      <g data-id={l.id} class="hide">
        <text x="160" y={(l.y1 + l.y2) / 2 - 9} style="font-weight:700">{l.name}</text>
        <text class="sub" x="160" y={(l.y1 + l.y2) / 2 + 11}>{l.sub}</text>
      </g>
    ))}

    <!-- 층별 정보판 -->
    {panels.map((p) => (
      <g data-id={p.id} class="hide">
        <rect class="box" x="10" y="212" width="300" height="164" rx="8" />
        <text class="hi l" x="24" y="234">{p.title}</text>
        {p.rows.map(([k, v], i) => (
          <>
            <text class="sub l" x="24" y={262 + i * 26}>{k}</text>
            <text class="l" x="104" y={262 + i * 26}>{v}</text>
          </>
        ))}
      </g>
    ))}

    <!-- 아이스크림 콘 -->
    <g data-id="cone" class="hide">
      <rect class="box" x="10" y="212" width="300" height="164" rx="8" />
      <circle class="bad" cx="72" cy="236" r="18" />
      <polygon class="err" points="20,250 124,250 112,296 32,296" />
      <text x="72" y="273" style="font-size:14px">E2E</text>
      <polygon class="box" points="32,300 112,300 102,330 42,330" />
      <text class="sub" x="72" y="315">통합</text>
      <polygon class="box" points="42,334 102,334 72,370" />
      <text class="sub" x="72" y="347">단위</text>
      <text class="err-t l" x="140" y="240">아이스크림 콘</text>
      <text class="l" x="140" y="268">E2E가 대부분</text>
      <text class="sub l" x="140" y="296">→ 오래 걸림</text>
      <text class="sub l" x="140" y="320">→ 플래키, 유지보수 힘듦</text>
      <text class="hi l" x="140" y="352">피라미드 모양으로</text>
    </g>

    <!-- 단위 테스트 확대: SUT -->
    <g data-id="sut" class="hide">
      <rect class="chip" x="60" y="10" width="200" height="50" rx="8" />
      <text x="160" y="27" style="font-weight:700">주문 서비스 (SUT)</text>
      <text class="sub" x="160" y="46">지금 테스트하는 대상</text>
      <line class="line" x1="160" y1="60" x2="160" y2="70" />
      <text class="sub l" x="12" y="80">진짜 협력자</text>
      <text class="sub" x="240" y="80">단위 테스트에선</text>
    </g>
    {deps.map((d, i) => (
      <g data-id={'r' + i} class="hide">
        <rect class="box" x="10" y={ry(i)} width="118" height="46" rx="6" />
        <text x="69" y={ry(i) + 23}>{d.real}</text>
        <line class="line" x1="130" y1={ry(i) + 23} x2="164" y2={ry(i) + 23} marker-end="url(#tpd-arr)" />
      </g>
    ))}
    {deps.map((d, i) => (
      <g data-id={'p' + i} class="hide">
        <rect class="bad" x="168" y={ry(i)} width="142" height="46" rx="6" />
        <text class="sub" x="239" y={ry(i) + 23}>{d.prob}</text>
      </g>
    ))}
    {deps.map((d, i) => (
      <g data-id={'d' + i} class="hide">
        <rect class="chip" x="168" y={ry(i)} width="142" height="46" rx="6" />
        <text class="hi" x="239" y={ry(i) + 14}>{d.kind}</text>
        <text x="239" y={ry(i) + 33} style="font-size:14px">{d.what}</text>
      </g>
    ))}
  </svg>
</Stepper>
