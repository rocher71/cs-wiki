---
// TCP 3-way handshake: 클라이언트·서버 두 세로줄(시간은 위→아래), 위쪽 칩에 현재 상태.
import Stepper from '../Stepper.astro';
const C = 70, S = 250;
const states = [
  ['CLOSED', 'LISTEN'],
  ['SYN-SENT', 'LISTEN'],
  ['SYN-SENT', 'SYN-RECEIVED'],
  ['ESTABLISHED', 'ESTABLISHED'],
  ['ESTABLISHED', 'ESTABLISHED'],
];
const msgs = [
  { id: 'syn', x1: C, x2: S, y: 110, t: ['SYN', 'seq=100'] },
  { id: 'synack', x1: S, x2: C, y: 178, t: ['SYN+ACK', 'seq=300, ack=101'] },
  { id: 'ack', x1: C, x2: S, y: 246, t: ['ACK', 'ack=301'] },
  { id: 'data', x1: C, x2: S, y: 314, t: ['데이터', 'seq=101'], hi: true },
];
const captions = [
  '처음엔 서버만 LISTEN(접속 대기) 상태예요. 클라이언트는 아직 연결 정보가 없는 CLOSED예요.',
  '클라이언트가 SYN(연결하자, 내 번호는 100부터)을 보내고 SYN-SENT가 돼요.',
  '서버가 SYN+ACK로 답해요. "101번 기다릴게(ack=101), 내 번호는 300부터." SYN이 번호 1개를 차지해서 ack는 +1이에요.',
  '클라이언트가 ACK(ack=301)를 보내면 양쪽 모두 ESTABLISHED예요. 데이터 없는 ACK는 번호를 차지하지 않아요.',
  '이제 데이터가 흘러요. 클라이언트의 첫 데이터 바이트 번호는 101이에요. ACK가 번호를 쓰지 않았기 때문이에요.',
];
const steps = captions.map((caption, i) => ({
  caption,
  show: [`c${i}`, `s${i}`, ...msgs.slice(0, i).map((m) => m.id)],
}));
const halo = 'paint-order:stroke;stroke:var(--sl-color-gray-7, var(--sl-color-black));stroke-width:5px;stroke-linejoin:round';
---
<Stepper title="TCP 3-way handshake" steps={steps}>
  <svg class="viz" viewBox="0 0 320 360" role="img" aria-label="클라이언트가 SYN, 서버가 SYN+ACK, 클라이언트가 ACK를 보내 양쪽이 ESTABLISHED가 되고 데이터를 보내기 시작하는 과정">
    <defs>
      <marker id="th3-g" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-2)" />
      </marker>
      <marker id="th3-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
    </defs>
    {[[C, '클라이언트'], [S, '서버']].map(([x, t]) => (
      <g>
        <rect class="box" x={+x - 60} y="6" width="120" height="32" rx="8" />
        <text x={x} y="22" style="font-weight:700">{t}</text>
        <line class="line" x1={x} y1="84" x2={x} y2="352" style="stroke-dasharray:4 4" />
      </g>
    ))}
    {states.map(([c, s], i) => (
      <g>
        <g data-id={`c${i}`} class="hide">
          <rect class="chip" x={C - 60} y="44" width="120" height="30" rx="15" />
          <text x={C} y="59" style="font-size:14px">{c}</text>
        </g>
        <g data-id={`s${i}`} class="hide">
          <rect class="chip" x={S - 60} y="44" width="120" height="30" rx="15" />
          <text x={S} y="59" style="font-size:14px">{s}</text>
        </g>
      </g>
    ))}
    {msgs.map((m) => (
      <g data-id={m.id}>
        <line x1={m.x1} y1={m.y} x2={m.x2 + (m.x2 > m.x1 ? -2 : 2)} y2={m.y + 40}
          style={`stroke:var(${m.hi ? '--sl-color-accent' : '--sl-color-gray-2'});stroke-width:2.2`}
          marker-end={`url(#th3-${m.hi ? 'a' : 'g'})`} />
        <text class={m.hi ? 'hi' : ''} x="160" y={m.y + 10} style={`font-weight:700;${halo}`}>{m.t[0]}</text>
        <text class="mono" x="160" y={m.y + 30} style={halo}>{m.t[1]}</text>
      </g>
    ))}
  </svg>
</Stepper>
