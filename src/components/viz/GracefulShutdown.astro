---
// 우아한 종료 4단계. 위: 호출 순서 타임라인(번호 배지 + 메서드 + 한 줄 설명), 아래: 그 순간 풀 상태(새 작업 / 실행 중 / 큐 / 결과).
import Stepper from '../Stepper.astro';
const calls = [
  { m: 'shutdown()', d: '새 작업 거부, 호출은 바로 반환' },
  { m: 'awaitTermination(60s)', d: '다 끝날 때까지 최대 60초 대기' },
  { m: 'shutdownNow()', d: '실행 중엔 interrupt, 대기 작업 반환' },
  { m: 'awaitTermination(60s)', d: '한 번 더 대기, 실패면 로그' },
];
const RY = (i: number) => 8 + i * 46;          // 타임라인 행 top
const P = 200;                                   // 풀 상태 패널 top
const LX = 12, CX = 88;                          // 라벨 x, 내용 시작 x
const yIn = P + 30, yRun = P + 74, yQ = P + 118, yRes = P + 160;
// 스레드 칸 2개: [step id, 글자들]
const run = [
  { id: 'run1', t: ['작업1', '작업2'] },
  { id: 'run2', t: ['작업3', '작업4'] },
  { id: 'run3', t: ['작업3', '작업4'], intr: true },
];
const queue = [
  { id: 'q1', t: ['작업3', '작업4', '작업5'] },
  { id: 'q2', t: ['작업5'] },
];
const steps = [
  { caption: 'shutdown(): 이제 submit()은 거절돼요. 이미 큐에 들어간 작업은 계속 실행해요. 메서드는 기다리지 않고 바로 돌아와요.', show: ['r1', 'hl1', 'in', 'run1', 'q1', 'res1'] },
  { caption: 'awaitTermination(60, SECONDS): 큐까지 다 비고 스레드가 끝날 때까지 최대 60초 기다려요. 끝나면 true, 시간이 다 되면 false예요.', show: ['r1', 'r2', 'hl2', 'in', 'run2', 'q2', 'res2'] },
  { caption: 'false면 shutdownNow(): 실행 중인 스레드에 interrupt를 걸고, 아직 시작 못 한 작업 목록(List<Runnable>)을 돌려받아요. interrupt를 무시하는 작업은 멈추지 않을 수 있어요.', show: ['r1', 'r2', 'r3', 'hl3', 'in', 'run3', 'q3', 'res3'] },
  { caption: '다시 awaitTermination으로 짧게 기다려요. 그래도 안 끝나면 더 할 수 있는 게 없으니 로그를 남겨요. 반환받은 작업은 따로 저장해 두면 유실을 막을 수 있어요.', show: ['r1', 'r2', 'r3', 'r4', 'hl4', 'in', 'q3', 'run4', 'res4'] },
];
---
<Stepper title="스레드 풀을 우아하게 끄는 순서" steps={steps}>
  <svg class="viz" viewBox="0 0 320 384" role="img" aria-label="shutdown, awaitTermination, shutdownNow, awaitTermination 순서로 스레드 풀을 종료하는 과정과 그때의 풀 상태">
    <!-- 타임라인 세로선 -->
    <path class="line" d={`M24 ${RY(0) + 16} L24 ${RY(3) + 16}`} />
    {calls.map((c, i) => (
      <g data-id={`r${i + 1}`}>
        <circle class="badge" cx="24" cy={RY(i) + 16} r="12" />
        <text class="on-badge" x="24" y={RY(i) + 16}>{i + 1}</text>
        <text class="mono l" x="46" y={RY(i) + 10} style="font-weight:700">{c.m}</text>
        <text class="sub l" x="46" y={RY(i) + 30}>{c.d}</text>
      </g>
    ))}
    {calls.map((_, i) => <rect data-id={`hl${i + 1}`} class="hl" x="6" y={RY(i) - 4} width="308" height="44" rx="8" />)}

    <!-- 풀 상태 패널 -->
    <rect class="frame" x="4" y={P - 8} width="312" height="190" rx="10" />
    <text class="sub l" x={LX} y={P + 6}>풀 상태</text>

    <text class="l" x={LX} y={yIn} style="font-weight:700">새 작업</text>
    <g data-id="in">
      <rect class="err" x={CX} y={yIn - 14} width="134" height="28" rx="14" />
      <text class="err-t mono" x={CX + 67} y={yIn}>submit() ✕</text>
    </g>

    <text class="l" x={LX} y={yRun} style="font-weight:700">실행 중</text>
    {[0, 1].map((j) => (
      <g>
        <rect class="frame" x={CX + j * 114} y={yRun - 18} width="108" height="36" rx="6" />
        <text class="mono" x={CX + j * 114 + 16} y={yRun} style="font-weight:700">T{j + 1}</text>
      </g>
    ))}
    {run.map((r) => (
      <g data-id={r.id} class="hide">
        {r.t.map((t, j) => (
          <g>
            <rect class={r.intr ? 'err' : 'chip'} x={CX + j * 114 + 34} y={yRun - 14} width="68" height="28" rx="5" />
            <text class={r.intr ? 'err-t' : ''} x={CX + j * 114 + 68} y={yRun}>{r.intr ? `⚡${t}` : t}</text>
          </g>
        ))}
      </g>
    ))}
    <g data-id="run4" class="hide">
      <rect class="bad" x={CX} y={yRun - 18} width="222" height="36" rx="6" />
      <text class="sub" x={CX + 111} y={yRun}>T1·T2 종료 → TERMINATED</text>
    </g>

    <text class="l" x={LX} y={yQ} style="font-weight:700">큐</text>
    <rect class="frame" x={CX} y={yQ - 18} width="222" height="36" rx="6" />
    {queue.map((q) => (
      <g data-id={q.id} class="hide">
        {q.t.map((t, j) => (
          <g>
            <rect class="box" x={CX + 6 + j * 72} y={yQ - 14} width="66" height="28" rx="5" />
            <text x={CX + 39 + j * 72} y={yQ}>{t}</text>
          </g>
        ))}
      </g>
    ))}
    <text data-id="q3" class="sub hide" x={CX + 111} y={yQ}>비어 있음</text>

    <!-- 결과 한 줄 -->
    <text data-id="res1" class="hi l hide" x={LX} y={yRes} style="font-size:14px">큐의 작업도 끝까지 실행돼요</text>
    <text data-id="res2" class="hi l hide" x={LX} y={yRes} style="font-size:14px">⏱ 60초 안에 끝나면 true → 종료</text>
    <text data-id="res3" class="hi l mono hide" x={LX} y={yRes}>반환: [작업5]  ⚡ = interrupt</text>
    <text data-id="res4" class="hi l hide" x={LX} y={yRes} style="font-size:14px">그래도 false면 로그 남기고 포기</text>
  </svg>
</Stepper>
