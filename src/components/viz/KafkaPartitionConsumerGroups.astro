---
// Kafka 파티션과 컨슈머 그룹 5단계: 토픽=파티션 3칸 → 같은 키는 같은 칸에 순서대로 → email 그룹이 칸을 나눠 맡음 → stats 그룹은 전부 따로 읽음 → C2 사망·리밸런싱.
// 오른쪽 두 열은 "그 칸을 누가 읽나"(email / stats 그룹). 같은 자리에 번갈아 나오는 P2 담당자·아래 정리 상자는 class="hide".
import Stepper from '../Stepper.astro';

const steps = [
  { caption: '토픽 orders는 파티션(칸) P0·P1·P2 세 개로 나뉘어 있어요. 칸마다 메시지가 들어온 순서대로 번호(오프셋)가 붙어요.', show: ['n1'] },
  { caption: 'key=user-A인 메시지 a1·a2·a3은 hash(key) % 3 = 0이라 늘 P0에 들어가요. 칸 안에서는 a1 → a2 → a3 순서(오프셋 0·1·2)가 지켜져요.', show: ['a', 'hlP0', 'n2'] },
  { caption: 'email 그룹의 소비자 C1은 P0·P1, C2는 P2를 맡아요. 한 칸은 그룹 안에서 한 명만 읽어서, 같은 메시지를 둘이 나눠 처리하지 않아요.', show: ['a', 'em', 'e2', 'hlEm', 'n3'] },
  { caption: 'stats 그룹은 소비자 S1 한 명이 세 칸을 전부 읽어요. 그룹마다 책갈피(오프셋)를 따로 가져서, email이 읽었다고 메시지가 지워지지 않아요.', show: ['a', 'em', 'e2', 'st', 'hlSt', 'n4'] },
  { caption: 'email 그룹의 C2가 죽으면 리밸런싱(담당 재배정)이 일어나 P2가 C1에게 넘어가요. C1은 email 그룹이 P2에 마지막으로 커밋한 오프셋부터 이어 읽어요.', show: ['a', 'em', 'e2b', 'st', 'n5'] },
];
// 칸 행: 라벨 x 8~50, 메시지 칸 x 56 + 42i (폭 38), 담당자 열 x 230(email) / 278(stats)
const rows = [
  { p: 'P0', y: 52, msgs: [] as string[] },
  { p: 'P1', y: 96, msgs: ['b1', 'b2'] },
  { p: 'P2', y: 140, msgs: ['c1', 'c2'] },
];
const cx = (i: number) => 56 + i * 42;
---
<Stepper title="Kafka 파티션과 컨슈머 그룹" steps={steps}>
  <svg class="viz" viewBox="0 0 320 266" role="img" aria-label="토픽 orders가 파티션 P0, P1, P2 세 줄로 나뉜 그림. user-A 키 메시지는 모두 P0에 순서대로 쌓인다. 오른쪽 열에 email 그룹과 stats 그룹이 각 파티션을 누가 읽는지 표시된다. email 그룹은 C1이 P0과 P1, C2가 P2를 맡고, stats 그룹은 S1이 전부 읽는다. C2가 죽으면 P2가 C1에게 넘어간다.">
    <!-- 머리글 -->
    <text class="l" x="8" y="14" style="font-weight:700">토픽 orders</text>
    {[0, 1, 2, 3].map((i) => <text class="sub" x={cx(i) + 19} y="40">{i}</text>)}
    <text class="sub" x="30" y="40">오프셋</text>
    <text data-id="em" class="hi" x="248" y="40">email</text>
    <text data-id="st" class="hi" x="296" y="40">stats</text>

    <!-- 파티션 행 -->
    {rows.map((r) => <>
      <rect class="box" x="8" y={r.y} width="42" height="38" rx="6" /><text x="29" y={r.y + 19} style="font-weight:700">{r.p}</text>
      {[0, 1, 2, 3].map((i) => <rect class="frame" x={cx(i)} y={r.y} width="38" height="38" rx="4" />)}
      {r.msgs.map((m, i) => <><rect class="box" x={cx(i)} y={r.y} width="38" height="38" rx="4" /><text x={cx(i) + 19} y={r.y + 19}>{m}</text></>)}
    </>)}
    <g data-id="a">
      {['a1', 'a2', 'a3'].map((m, i) => <><rect class="chip" x={cx(i)} y="52" width="38" height="38" rx="4" /><text x={cx(i) + 19} y="71">{m}</text></>)}
    </g>
    <rect data-id="hlP0" class="hl" x="4" y="48" width="220" height="46" rx="8" />

    <!-- 담당자 열: email -->
    <g data-id="em">
      <rect class="chip" x="230" y="52" width="36" height="38" rx="6" /><text x="248" y="71">C1</text>
      <rect class="chip" x="230" y="96" width="36" height="38" rx="6" /><text x="248" y="115">C1</text>
    </g>
    <g data-id="e2" class="hide"><rect class="chip" x="230" y="140" width="36" height="38" rx="6" /><text x="248" y="159">C2</text></g>
    <g data-id="e2b" class="hide"><rect class="chip" x="230" y="140" width="36" height="38" rx="6" /><text class="hi" x="248" y="159">C1</text></g>
    <rect data-id="hlEm" class="hl" x="226" y="22" width="44" height="160" rx="8" />

    <!-- 담당자 열: stats -->
    <g data-id="st">
      {rows.map((r) => <><rect class="box" x="278" y={r.y} width="36" height="38" rx="6" /><text x="296" y={r.y + 19}>S1</text></>)}
    </g>
    <rect data-id="hlSt" class="hl" x="274" y="22" width="44" height="160" rx="8" />

    <!-- 아래 정리 상자 (같은 자리, 번갈아) -->
    <g data-id="n1" class="hide"><rect class="box" x="6" y="194" width="308" height="66" rx="8" /><text x="160" y="215">토픽 = 파티션 3칸</text><text class="sub" x="160" y="240">칸마다 들어온 순서로 오프셋</text></g>
    <g data-id="n2" class="hide"><rect class="chip" x="6" y="194" width="308" height="66" rx="8" /><text x="160" y="215">hash(user-A) % 3 = <tspan class="hi">0</tspan></text><text class="sub" x="160" y="240">같은 키 → 늘 P0 · 칸 안에서만 순서</text></g>
    <g data-id="n3" class="hide"><rect class="chip" x="6" y="194" width="308" height="66" rx="8" /><text x="160" y="215">email 그룹: C1 = P0·P1, C2 = P2</text><text class="sub" x="160" y="240">한 칸은 그룹 안에서 한 명만</text></g>
    <g data-id="n4" class="hide"><rect class="chip" x="6" y="194" width="308" height="66" rx="8" /><text x="160" y="215">그룹마다 책갈피 따로</text><text class="sub" x="160" y="240">읽어도 메시지는 지워지지 않음</text></g>
    <g data-id="n5" class="hide"><rect class="err" x="6" y="194" width="308" height="66" rx="8" /><text x="160" y="215"><tspan class="err-t">C2 죽음</tspan> → 리밸런싱 → P2는 C1</text><text class="sub" x="160" y="240">마지막 커밋 오프셋부터 이어 읽기</text></g>
  </svg>
</Stepper>
