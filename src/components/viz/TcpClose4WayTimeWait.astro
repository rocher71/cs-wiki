---
// TCP 4-way 종료 + TIME-WAIT: 먼저 닫는 클라이언트·서버 두 세로줄, 위쪽 칩에 현재 상태.
import Stepper from '../Stepper.astro';
const C = 70, S = 250;
const states = [
  ['ESTABLISHED', 'ESTABLISHED'],
  ['FIN-WAIT-1', 'ESTABLISHED'],
  ['FIN-WAIT-2', 'CLOSE-WAIT'],
  ['FIN-WAIT-2', 'LAST-ACK'],
  ['TIME-WAIT', 'CLOSED'],
  ['CLOSED', 'CLOSED'],
];
const msgs = [
  { id: 'fin1', x1: C, x2: S, y: 90, t: 'FIN', st: 1 },
  { id: 'ack1', x1: S, x2: C, y: 140, t: 'ACK', st: 2 },
  { id: 'rest', x1: S, x2: C, y: 190, t: '남은 데이터', st: 2, hi: true },
  { id: 'fin2', x1: S, x2: C, y: 240, t: 'FIN', st: 3 },
  { id: 'ack2', x1: C, x2: S, y: 290, t: 'ACK', st: 4 },
];
const captions = [
  '양쪽 다 ESTABLISHED로 데이터를 주고받는 중이에요. 클라이언트가 먼저 끊기로 해요.',
  '클라이언트가 FIN("나는 더 보낼 게 없어")을 보내고 FIN-WAIT-1이 돼요.',
  '서버는 ACK만 먼저 보내고 CLOSE-WAIT가 돼요. 클라이언트는 FIN-WAIT-2. 한쪽만 닫힌 half-close라서 서버는 남은 데이터를 계속 보낼 수 있어요.',
  '서버 앱이 close를 부르면 그제서야 서버도 FIN을 보내고 LAST-ACK가 돼요. ACK와 FIN이 따로 가서 4-way예요.',
  '클라이언트가 마지막 ACK를 보내고 TIME-WAIT에 들어가요. ACK를 받은 서버는 바로 CLOSED예요.',
  '2MSL을 기다린 뒤에야 클라이언트도 CLOSED가 돼요. TIME-WAIT는 먼저 닫은 쪽에 남는다는 점이 핵심이에요.',
];
const steps = captions.map((caption, i) => ({
  caption,
  show: [
    `c${i}`, `s${i}`,
    ...msgs.filter((m) => m.st <= i).map((m) => m.id),
    ...(i === 2 ? ['nHalf'] : []),
    ...(i >= 4 ? ['tw', 'sClosed', 'nTw'] : []),
    ...(i === 5 ? ['cClosed'] : []),
  ],
}));
const halo = 'paint-order:stroke;stroke:var(--sl-color-gray-7, var(--sl-color-black));stroke-width:5px;stroke-linejoin:round';
const TW0 = 330, TW1 = 392;
---
<Stepper title="TCP 4-way 종료와 TIME-WAIT" steps={steps}>
  <svg class="viz" viewBox="0 0 320 486" role="img" aria-label="클라이언트가 FIN, 서버가 ACK, 남은 데이터, 서버가 FIN, 클라이언트가 ACK를 보내고, 클라이언트가 TIME-WAIT에서 2MSL 기다린 뒤 CLOSED가 되는 과정">
    <defs>
      <marker id="tc4-g" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-2)" />
      </marker>
      <marker id="tc4-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
    </defs>
    {[[C, '클라이언트'], [S, '서버']].map(([x, t]) => (
      <g>
        <rect class="box" x={+x - 60} y="6" width="120" height="32" rx="8" />
        <text x={x} y="22" style="font-weight:700">{t}</text>
        <line class="line" x1={x} y1="80" x2={x} y2="412" style="stroke-dasharray:4 4" />
      </g>
    ))}
    {states.map(([c, s], i) => (
      <g>
        <g data-id={`c${i}`} class="hide">
          <rect class="chip" x={C - 60} y="44" width="120" height="30" rx="15" />
          <text x={C} y="59" style="font-size:14px">{c}</text>
        </g>
        <g data-id={`s${i}`} class="hide">
          <rect class="chip" x={S - 60} y="44" width="120" height="30" rx="15" />
          <text x={S} y="59" style="font-size:14px">{s}</text>
        </g>
      </g>
    ))}
    {msgs.map((m) => (
      <g data-id={m.id}>
        <line x1={m.x1} y1={m.y} x2={m.x2 + (m.x2 > m.x1 ? -2 : 2)} y2={m.y + 36}
          style={`stroke:var(${m.hi ? '--sl-color-accent' : '--sl-color-gray-2'});stroke-width:2.2;${m.hi ? 'stroke-dasharray:6 4' : ''}`}
          marker-end={`url(#tc4-${m.hi ? 'a' : 'g'})`} />
        <text class={m.hi ? 'hi' : ''} x="160" y={m.y + 18} style={`font-weight:700;${halo}`}>{m.t}</text>
      </g>
    ))}
    <!-- TIME-WAIT: 클라이언트 세로줄 위 굵은 막대 + 모래시계 -->
    <g data-id="tw" class="hide">
      <line x1={C} y1={TW0} x2={C} y2={TW1} style="stroke:var(--sl-color-accent);stroke-width:7;stroke-linecap:round" />
      <path d={`M${C + 14} ${TW0 + 14} h16 l-8 10 l8 10 h-16 l8 -10 z`} style="fill:var(--sl-color-accent-low);stroke:var(--sl-color-accent);stroke-width:1.6;stroke-linejoin:round" />
      <text class="hi l" x={C + 38} y={TW0 + 16}>TIME-WAIT</text>
      <text class="sub l" x={C + 38} y={TW0 + 38}>2MSL 동안 대기</text>
    </g>
    <g data-id="sClosed" class="hide">
      <rect class="box" x={S - 40} y={TW0 - 2} width="80" height="26" rx="6" />
      <text x={S} y={TW0 + 11} style="font-size:14px">CLOSED</text>
    </g>
    <g data-id="cClosed" class="hide">
      <rect class="box" x={C - 40} y={TW1 + 4} width="80" height="26" rx="6" />
      <text x={C} y={TW1 + 17} style="font-size:14px">CLOSED</text>
    </g>
    <!-- 아래 메모 -->
    <g data-id="nHalf" class="hide">
      <rect class="chip" x="10" y="430" width="300" height="50" rx="8" />
      <text class="hi" x="160" y="446">half-close</text>
      <text x="160" y="467" style="font-size:14px">서버는 아직 데이터를 보낼 수 있어요</text>
    </g>
    <g data-id="nTw" class="hide">
      <rect class="chip" x="10" y="430" width="300" height="50" rx="8" />
      <text class="hi" x="160" y="446">TIME-WAIT는 먼저 닫은 쪽에 남아요</text>
      <text x="160" y="467" style="font-size:14px">늦은 FIN에 다시 ACK, 옛 패킷 섞임 방지</text>
    </g>
  </svg>
</Stepper>
