---
// 알림 요청이 접수 → 설정·빈도 확인 → 템플릿·중복 검사 → 채널별 큐 → 워커 → 외부 서비스 → 결과 기록으로 흐르는 그림.
// 마지막 단계는 SMS 큐가 막혀도 push·email은 계속 나가는 장면.
import Stepper from '../Stepper.astro';
const cols = [
  { k: 'push', x: 10, q: 'push 큐', w: '푸시 워커', e: 'FCM·APNs' },
  { k: 'sms', x: 120, q: 'sms 큐', w: '문자 워커', e: '문자 중계사' },
  { k: 'email', x: 230, q: 'email 큐', w: '메일 워커', e: '이메일 대행' },
];
const base = ['order', 'a1', 'api'];
const s2 = [...base, 'a2', 'check', 'blk'];
const s3 = [...s2, 'a3', 'tpl', 'dup'];
const s4 = [...s3, 'fan', 'q'];
const s5 = [...s4, 'wk', 'ext'];
const s6 = [...s5, 'res', 'ok-push', 'ok-email', 'log'];
const steps = [
  { caption: '주문 서비스가 "주문 완료" 알림을 요청해요. 알림 API는 접수만 하고 바로 응답해요. 직접 FCM이나 문자 업체를 부르지 않아요.', show: [...base, 'hl-api'] },
  { caption: '사용자 설정(수신 거부, 야간 금지)과 빈도 제한(하루 N건)을 확인해요. 막히면 "보내지 않음"으로 기록하고 여기서 끝나요.', show: [...s2, 'hl-check'] },
  { caption: '템플릿에 값을 채워 문구를 만들고, 알림 ID로 이미 보낸 알림인지 확인해요. 같은 ID면 버려서 두 번 가지 않게 해요.', show: [...s3, 'hl-tpl'] },
  { caption: '채널별 큐(push / sms / email)에 나눠 넣어요. 큐가 따로라서 한 채널이 느려도 다른 채널 줄은 밀리지 않아요.', show: [...s4, 'hl-q'] },
  { caption: '채널마다 전담 워커가 큐에서 꺼내 외부 서비스에 요청해요. 푸시는 FCM·APNs, 문자는 중계사, 이메일은 발송 대행 업체로 가요.', show: [...s5, 'hl-wk'] },
  { caption: '응답을 받으면 결과를 기록해요. 성공은 "발송됨", 일시 오류는 "재시도", 여러 번 실패하면 "실패"로 남겨요. 발송됨은 넘겼다는 뜻이지 도착했다는 뜻은 아니에요.', show: [...s6, 'ok-sms', 'hl-log'] },
  { caption: '문자 중계사가 응답하지 않으면 sms 큐만 쌓이고 "재시도 대기"가 돼요. push 큐와 email 큐는 따로라서 계속 흘러가요. 이게 채널별로 큐를 나누는 이유예요.', show: [...s6, 'jam', 'retry-sms', 'hl-flow'] },
];
---
<Stepper title="알림 요청이 채널별 큐를 지나 나가는 길" steps={steps}>
  <svg class="viz" viewBox="0 0 340 566" role="img" aria-label="주문 서비스가 알림 API에 요청하면, 설정·빈도 확인과 템플릿·중복 검사를 거쳐 push, sms, email 세 큐로 나뉜다. 큐마다 워커가 FCM·APNs, 문자 중계사, 이메일 대행에 요청하고 결과를 기록한다. 문자 중계사가 막히면 sms 큐만 쌓이고 나머지 채널은 계속 발송된다.">
    <defs>
      <marker id="np-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    <g data-id="order">
      <rect class="box" x="16" y="8" width="220" height="38" rx="7" />
      <text x="126" y="27">주문 서비스: 알림 요청</text>
    </g>
    <line data-id="a1" class="line" x1="126" y1="46" x2="126" y2="62" marker-end="url(#np-arr)" />
    <g data-id="api">
      <rect class="box" x="16" y="64" width="220" height="46" rx="7" />
      <text x="126" y="80">알림 API</text>
      <text class="sub" x="126" y="98">접수하고 바로 응답</text>
    </g>
    <line data-id="a2" class="line" x1="126" y1="110" x2="126" y2="124" marker-end="url(#np-arr)" />
    <g data-id="check">
      <rect class="box" x="16" y="126" width="220" height="46" rx="7" />
      <text x="126" y="142">설정·빈도 제한 확인</text>
      <text class="sub" x="126" y="160">수신 거부 · 하루 N건</text>
    </g>
    <g data-id="blk">
      <line class="line" x1="236" y1="149" x2="246" y2="149" />
      <rect class="bad" x="248" y="126" width="84" height="46" rx="6" />
      <text class="sub" x="290" y="142">막히면</text>
      <text class="sub" x="290" y="160">기록 후 끝</text>
    </g>
    <line data-id="a3" class="line" x1="126" y1="172" x2="126" y2="186" marker-end="url(#np-arr)" />
    <g data-id="tpl">
      <rect class="box" x="16" y="188" width="220" height="46" rx="7" />
      <text x="126" y="204">템플릿으로 문구 생성</text>
      <text class="sub" x="126" y="222">알림 ID로 중복 검사</text>
    </g>
    <g data-id="dup">
      <line class="line" x1="236" y1="211" x2="246" y2="211" />
      <rect class="bad" x="248" y="188" width="84" height="46" rx="6" />
      <text class="sub" x="290" y="204">같은 ID면</text>
      <text class="sub" x="290" y="222">버림</text>
    </g>

    <!-- 채널별로 갈라짐 -->
    <g data-id="fan">
      {cols.map((c) => (
        <line class="line" x1="126" y1="234" x2={c.x + 50} y2="268" marker-end="url(#np-arr)" />
      ))}
    </g>
    <g data-id="q">
      {cols.map((c) => (
        <g>
          <rect class="box" x={c.x} y="270" width="100" height="56" rx="7" />
          <text x={c.x + 50} y="286">{c.q}</text>
          {[0, 1, 2].map((j) => (
            <rect class="frame" x={c.x + 14 + j * 25} y="302" width="20" height="16" rx="3" />
          ))}
        </g>
      ))}
    </g>

    <g data-id="wk">
      {cols.map((c) => (
        <g>
          <line class="line" x1={c.x + 50} y1="326" x2={c.x + 50} y2="340" marker-end="url(#np-arr)" />
          <rect class="box" x={c.x} y="342" width="100" height="40" rx="7" />
          <text x={c.x + 50} y="362">{c.w}</text>
        </g>
      ))}
    </g>
    <g data-id="ext">
      {cols.map((c) => (
        <g>
          <line class="line" x1={c.x + 50} y1="382" x2={c.x + 50} y2="398" marker-end="url(#np-arr)" />
          <rect class="frame" x={c.x} y="400" width="100" height="46" rx="7" />
          <text x={c.x + 50} y="416" style="font-size:14px">{c.e}</text>
          <text class="sub" x={c.x + 50} y="434">외부 회사</text>
        </g>
      ))}
    </g>

    <!-- sms 큐가 꽉 참 + 중계사 응답 없음 -->
    <g data-id="jam" class="hide">
      {[0, 1, 2].map((j) => (
        <rect class="err" x={134 + j * 25} y="302" width="20" height="16" rx="3" />
      ))}
      <rect x="120" y="400" width="100" height="46" rx="7" style="fill:var(--sl-color-gray-6)" />
      <rect class="err" x="120" y="400" width="100" height="46" rx="7" />
      <text class="err-t" x="170" y="416">문자 중계사</text>
      <text class="err-t" x="170" y="434" style="font-size:14px">응답 없음 ✕</text>
    </g>

    <!-- 채널별 결과: sms는 같은 자리에 발송됨 / 재시도 대기가 번갈아 나옴 -->
    <g data-id="res">
      {cols.map((c) => (
        <line class="line" x1={c.x + 50} y1="446" x2={c.x + 50} y2="460" marker-end="url(#np-arr)" />
      ))}
    </g>
    {cols.map((c) => (
      <g data-id={'ok-' + c.k} class={c.k === 'sms' ? 'hide' : ''}>
        <rect class="chip" x={c.x} y="462" width="100" height="32" rx="6" />
        <text class="hi" x={c.x + 50} y="478">발송됨</text>
      </g>
    ))}
    <g data-id="retry-sms" class="hide">
      <rect class="bad" x="120" y="462" width="100" height="32" rx="6" />
      <text class="sub" x="170" y="478">재시도 대기</text>
    </g>

    <g data-id="log">
      <rect class="box" x="10" y="508" width="320" height="50" rx="7" />
      <text x="170" y="524">결과 기록</text>
      <text class="sub" x="170" y="543">발송됨 / 재시도 / 실패</text>
    </g>

    <!-- 강조 테두리 -->
    <rect data-id="hl-api" class="hl" x="12" y="60" width="228" height="54" rx="9" />
    <rect data-id="hl-check" class="hl" x="12" y="122" width="324" height="54" rx="9" />
    <rect data-id="hl-tpl" class="hl" x="12" y="184" width="324" height="54" rx="9" />
    <rect data-id="hl-q" class="hl" x="6" y="266" width="328" height="64" rx="9" />
    <rect data-id="hl-wk" class="hl" x="6" y="338" width="328" height="112" rx="9" />
    <rect data-id="hl-log" class="hl" x="6" y="458" width="328" height="104" rx="9" />
    <g data-id="hl-flow" class="hide">
      <rect class="hl" x="6" y="266" width="108" height="232" rx="9" />
      <rect class="hl" x="226" y="266" width="108" height="232" rx="9" />
    </g>
  </svg>
</Stepper>
