---
// 킬 스위치: 외부 추천 API 지연 → 운영자가 recommendation off → 서버가 몇 초 안에 반영 → 추천 숨김, 결제 정상.
import Stepper from '../Stepper.astro';
const runId = (k: string, v: string[], i: number) => { let s = i; while (s > 0 && v[s - 1] === v[i]) s--; return k + s; };
const runs = (k: string, v: string[]) => v.map((x, i) => ({ id: k + i, x, i })).filter(({ i }) => !i || v[i - 1] !== v[i]);
// 값 형식 'class|글자'
const V: Record<string, string[]> = {
  pay: ['sub|정상', 'err-t|대기 늘어남', 'err-t|대기 늘어남', 'err-t|대기 늘어남', 'hi|정상'],
  rec: ['sub|정상', 'err-t|로딩 중…', 'err-t|로딩 중…', 'err-t|로딩 중…', 'sub|숨김(꺼짐)'],
  srv: ['sub|스레드 여유 있음', 'err-t|추천 기다리며 묶임', 'err-t|추천 기다리며 묶임', 'hi|추천 off 받음', 'hi|스레드 풀림'],
  api: ['sub|정상 응답', 'err-t|느림·응답 없음', 'err-t|느림·응답 없음', 'err-t|느림·응답 없음', 'err-t|느림·응답 없음'],
  store: ['sub|추천 = on', 'sub|추천 = on', 'hi|추천 = off', 'hi|추천 = off', 'hi|추천 = off'],
  tg: ['ON', 'ON', 'OFF', 'OFF', 'OFF'],
};
const notes = [
  ['평소: 결제·추천', '둘 다 정상'],
  ['추천 API가 느려져', '스레드가 쌓여요'],
  ['운영자가', '스위치를 내려요'],
  ['서버가 몇 초 안에', '새 값을 받아요'],
  ['재배포 없이', '결제를 살렸어요'],
];
const on: Record<string, number[]> = {
  busy1: [0, 4], busy5: [1, 2, 3], recErr: [1, 2, 3], recOff: [4], apiErr: [1, 2, 3, 4], call: [0, 1, 2, 3], nocall: [4],
  push: [2], pull: [3], hlTg: [2], hlSrv: [3],
};
const captions = [
  '결제 페이지는 결제 영역과 추천 영역으로 돼 있어요. 추천은 서버가 외부 추천 API를 불러 채워요. 지금은 둘 다 정상이에요.',
  '외부 추천 API가 느려졌어요. 서버 스레드가 추천 응답을 기다리며 하나둘 묶여요. 이대로면 결제 요청을 받을 스레드도 모자라요.',
  '운영자가 관리 화면에서 recommendation 스위치를 OFF로 내려요. 값은 플래그 저장소에 저장돼요.',
  '각 서버는 플래그 값을 짧게 캐시하고 저장소에서 주기적으로(또는 변경 알림으로) 새 값을 받아요. 몇 초 안에 모든 서버가 off를 알게 돼요.',
  '서버가 추천 API를 더 부르지 않아요. 추천 영역은 숨겨지고 스레드가 풀려 결제는 정상이에요. 재배포도 재시작도 없었어요.',
];
const steps = captions.map((caption, i) => ({
  caption,
  show: [`n${i}`, ...Object.keys(on).filter((k) => on[k].includes(i)), ...Object.keys(V).map((k) => runId(k, V[k], i))],
}));
const A = 'stroke:var(--sl-color-accent);stroke-width:2.4';
---
<Stepper title="킬 스위치로 추천만 끄기" steps={steps}>
  <svg class="viz" viewBox="0 0 320 332" role="img" aria-label="외부 추천 API가 느려져 서버 스레드가 묶이자, 운영자가 recommendation 플래그를 끄고 서버가 몇 초 안에 반영해 추천은 숨기고 결제는 지킨다">
    <defs>
      <marker id="ks-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" style="fill:var(--sl-color-gray-3)" /></marker>
      <marker id="ks-arr-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0L10 5L0 10z" style="fill:var(--sl-color-accent)" /></marker>
    </defs>

    <!-- 결제 페이지 -->
    <rect class="frame" x="4" y="4" width="312" height="74" rx="8" />
    <text class="sub l" x="12" y="18">결제 페이지 (사용자 화면)</text>
    <rect class="box" x="12" y="30" width="140" height="42" rx="6" />
    <text x="82" y="43" style="font-weight:700">결제</text>
    {runs('pay', V.pay).map(({ id, x }) => { const [c, t] = x.split('|'); return <text data-id={id} class={`hide ${c}`} x="82" y="62" style="font-size:14px">{t}</text>; })}
    <rect class="box" x="168" y="30" width="140" height="42" rx="6" />
    <rect data-id="recErr" class="err hide" x="168" y="30" width="140" height="42" rx="6" />
    <rect data-id="recOff" class="bad hide" x="168" y="30" width="140" height="42" rx="6" />
    <text x="238" y="43" style="font-weight:700">추천 상품</text>
    {runs('rec', V.rec).map(({ id, x }) => { const [c, t] = x.split('|'); return <text data-id={id} class={`hide ${c}`} x="238" y="62" style="font-size:14px">{t}</text>; })}

    <!-- 서버 여러 대 -->
    <rect class="box" x="12" y="100" width="304" height="62" rx="6" />
    <rect class="box" x="8" y="96" width="304" height="62" rx="6" />
    <rect class="box" x="4" y="92" width="304" height="62" rx="6" />
    <rect data-id="hlSrv" class="hl hide" x="1" y="89" width="318" height="76" rx="8" />
    <text class="l" x="14" y="108" style="font-weight:700">서버 (여러 대)</text>
    <text class="sub l" x="14" y="130">스레드</text>
    {[0, 1, 2, 3, 4, 5].map((j) => <rect class="box" x={70 + j * 30} y="122" width="24" height="16" rx="3" />)}
    <g data-id="busy1" class="hide"><rect class="chip" x="70" y="122" width="24" height="16" rx="3" /></g>
    <g data-id="busy5" class="hide">{[0, 1, 2, 3, 4].map((j) => <rect class="err" x={70 + j * 30} y="122" width="24" height="16" rx="3" />)}</g>
    {runs('srv', V.srv).map(({ id, x }) => { const [c, t] = x.split('|'); return <text data-id={id} class={`l hide ${c}`} x="170" y="108" style="font-size:14px">{t}</text>; })}

    <!-- 서버 → 추천 API -->
    <line data-id="call" class="line hide" x1="77" y1="154" x2="77" y2="188" marker-end="url(#ks-arr)" />
    <text data-id="nocall" class="err-t hide l" x="20" y="172" style="font-size:14px">✕ 호출 안 함</text>
    <!-- 저장소 → 서버 -->
    <g data-id="pull" class="hide">
      <line x1="243" y1="188" x2="243" y2="160" style={A} marker-end="url(#ks-arr-a)" />
      <text class="hi l" x="164" y="174" style="font-size:14px">몇 초 안에</text>
    </g>

    <rect class="box" x="4" y="190" width="146" height="50" rx="6" />
    <rect data-id="apiErr" class="err hide" x="4" y="190" width="146" height="50" rx="6" />
    <text x="77" y="205" style="font-weight:700">외부 추천 API</text>
    {runs('api', V.api).map(({ id, x }) => { const [c, t] = x.split('|'); return <text data-id={id} class={`hide ${c}`} x="77" y="226" style="font-size:14px">{t}</text>; })}

    <rect class="box" x="170" y="190" width="146" height="50" rx="6" />
    <text x="243" y="205" style="font-weight:700">플래그 저장소</text>
    {runs('store', V.store).map(({ id, x }) => { const [c, t] = x.split('|'); return <text data-id={id} class={`hide ${c}`} x="243" y="226" style="font-size:14px">{t}</text>; })}

    <!-- 관리 화면 → 저장소 -->
    <line data-id="push" class="hide" x1="243" y1="262" x2="243" y2="244" style={A} marker-end="url(#ks-arr-a)" />
    <rect class="box" x="170" y="264" width="146" height="64" rx="6" />
    <text x="243" y="279" style="font-weight:700">운영자 관리 화면</text>
    <text class="mono" x="243" y="298">recommendation</text>
    {runs('tg', V.tg).map(({ id, x }) => (
      <g data-id={id} class="hide">
        <rect class={x === 'ON' ? 'chip' : 'bad'} x="221" y="306" width="44" height="18" rx="9" />
        <text x="243" y="316" class={x === 'ON' ? '' : 'hi'} style="font-size:14px;font-weight:700">{x}</text>
      </g>
    ))}
    <rect data-id="hlTg" class="hl hide" x="216" y="302" width="54" height="26" rx="12" />

    {notes.map(([a, b], i) => (
      <g data-id={`n${i}`} class="hide">
        <text class="l hi" x="6" y="282" style="font-size:15px">{a}</text>
        <text class="l" x="6" y="306" style="font-size:15px">{b}</text>
      </g>
    ))}
  </svg>
</Stepper>
