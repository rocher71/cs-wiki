---
// 보조 인덱스 k(10·20·30)에 WHERE k=20 FOR UPDATE → 넥스트 키 락(10~20 틈 + 20) + 갭 락(20~30) + PK 레코드 락.
// 세로로 쌓은 인덱스 | A의 락 | B의 INSERT 세 칸. 마지막 단계는 PK로 잠갔을 때 비교.
import Stepper from '../Stepper.astro';
const Y0 = 82, DY = 38, RH = 32;
const IX = 12, IW = 112, LX = 130, LW = 86, BX = 222, BW = 90;
const rows = [
  { t: '틈 (~10)', gap: true },
  { t: 'k=10 · id=1' },
  { t: '틈 (10~20)', gap: true },
  { t: 'k=20 · id=2' },
  { t: '틈 (20~30)', gap: true },
  { t: 'k=30 · id=3' },
  { t: '틈 (30~)', gap: true },
].map((r, i) => ({ ...r, y: Y0 + i * DY }));
const top = (i: number) => rows[i].y - RH / 2;
const ins = [
  { id: 'i5', r: 0, t: 'k=5 성공', ok: true },
  { id: 'i15', r: 2, t: 'k=15 대기', ok: false },
  { id: 'i25', r: 4, t: 'k=25 대기', ok: false },
  { id: 'i35', r: 6, t: 'k=35 성공', ok: true },
  { id: 'i15ok', r: 2, t: 'k=15 성공', ok: true },
];
const PKY = rows[6].y + 62;
const LOCKS = ['qA', 'nk', 'gp', 'pk'];
const steps = [
  { caption: '보조 인덱스 k에 10, 20, 30이 정렬돼 있어요. 값과 값 사이에는 빈 틈(갭)이 있어요. 맨 앞과 맨 뒤도 틈이에요.', show: [] },
  { caption: 'A가 WHERE k=20 FOR UPDATE를 실행해요. 조건에 맞는 행은 k=20(id=2) 하나뿐이에요.', show: ['qA', 'find'] },
  { caption: '그런데 잠기는 건 더 넓어요. 레코드 20과 앞 틈(10~20)에 넥스트 키 락, 뒤 틈(20~30)에 갭 락, PK id=2에 레코드 락이 걸려요.', show: LOCKS },
  { caption: 'B가 INSERT를 시도해요. 잠긴 틈에 들어가는 k=15, k=25는 막혀서 기다리고(타임아웃 시 1205), 잠기지 않은 틈의 k=5, k=35는 바로 성공해요.', show: [...LOCKS, 'i5', 'i15', 'i25', 'i35'] },
  { caption: '비교: PK로 WHERE id=2 FOR UPDATE를 하면 PK 레코드 하나만 잠겨요. 틈이 비어 있으니 k=15 INSERT도 바로 성공해요.', show: ['qPK', 'pk', 'i15ok'] },
];
---
<Stepper title="k=20 하나 잠갔는데 앞뒤 틈까지 잠긴다" steps={steps}>
  <svg class="viz" viewBox={`0 0 320 ${PKY + 26}`} role="img" aria-label="보조 인덱스 k=20을 FOR UPDATE로 잠그면 레코드 20과 앞뒤 틈이 잠겨 k=15, k=25 INSERT가 막히고, PK로 잠그면 레코드 하나만 잠기는 비교">
    <g data-id="qA" class="hide"><text class="mono hi" x="160" y="18">A: WHERE k=20 FOR UPDATE</text></g>
    <g data-id="qPK" class="hide"><text class="mono hi" x="160" y="18">A: WHERE id=2 FOR UPDATE</text></g>

    <text class="sub" x={IX + IW / 2} y="50">인덱스 k</text>
    <text class="sub" x={LX + LW / 2} y="50">A의 락</text>
    <text class="sub" x={BX + BW / 2} y="50">B의 INSERT</text>

    {rows.map((r, i) => (
      <g>
        <rect class={r.gap ? 'frame' : 'box'} x={IX} y={top(i)} width={IW} height={RH} rx="6" />
        <text class={r.gap ? 'sub' : ''} x={IX + IW / 2} y={r.y} style={r.gap ? '' : 'font-weight:700'}>{r.t}</text>
      </g>
    ))}
    <rect data-id="find" class="hl hide" x={IX - 3} y={top(3) - 3} width={IW + 6} height={RH + 6} rx="8" />

    <!-- 넥스트 키 락: 틈(10~20) + 레코드 20 -->
    <g data-id="nk" class="hide">
      <rect class="chip" x={IX} y={top(2)} width={IW} height={RH} rx="6" style="fill-opacity:.55" />
      <rect class="chip" x={IX} y={top(3)} width={IW} height={RH} rx="6" style="fill-opacity:.55" />
      <text class="hi" x={IX + IW / 2} y={rows[2].y}>틈 (10~20)</text>
      <text class="hi" x={IX + IW / 2} y={rows[3].y}>k=20 · id=2</text>
      <rect class="chip" x={LX} y={top(2)} width={LW} height={RH * 2 + DY - RH} rx="6" />
      <text style="font-weight:700" x={LX + LW / 2} y={rows[2].y + 6}>넥스트 키</text>
      <text class="sub" x={LX + LW / 2} y={rows[3].y - 4}>레코드+앞 틈</text>
    </g>
    <!-- 갭 락: 틈(20~30) -->
    <g data-id="gp" class="hide">
      <rect class="chip" x={IX} y={top(4)} width={IW} height={RH} rx="6" style="fill-opacity:.55" />
      <text class="hi" x={IX + IW / 2} y={rows[4].y}>틈 (20~30)</text>
      <rect class="chip" x={LX} y={top(4)} width={LW} height={RH} rx="6" />
      <text style="font-weight:700" x={LX + LW / 2} y={rows[4].y}>갭 락</text>
    </g>

    {ins.map((b) => (
      <g data-id={b.id} class="hide">
        <rect class={b.ok ? 'box' : 'err'} x={BX} y={top(b.r)} width={BW} height={RH} rx="6" />
        <text class={b.ok ? "" : "err-t"} x={BX + BW / 2} y={rows[b.r].y} style="font-size:14px">{b.ok ? '✓ ' : '✗ '}{b.t}</text>
      </g>
    ))}

    <!-- PK 인덱스 -->
    <text class="sub" x={IX + IW / 2} y={PKY - 30}>PK 인덱스</text>
    <rect class="box" x={IX} y={PKY - RH / 2} width={IW} height={RH} rx="6" />
    <text x={IX + IW / 2} y={PKY} style="font-weight:700">id=2</text>
    <g data-id="pk" class="hide">
      <rect class="chip" x={IX} y={PKY - RH / 2} width={IW} height={RH} rx="6" style="fill-opacity:.55" />
      <text class="hi" x={IX + IW / 2} y={PKY}>id=2</text>
      <rect class="chip" x={LX} y={PKY - RH / 2} width={LW} height={RH} rx="6" />
      <text style="font-weight:700" x={LX + LW / 2} y={PKY}>레코드 락</text>
    </g>
  </svg>
</Stepper>
