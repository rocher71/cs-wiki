---
// 컨텍스트 스위칭: CPU 레지스터 ↔ TCB 저장/복원. 아래 시간 막대로 "전환 구간 = 오버헤드"를 보여주고, 마지막에 스레드 vs 프로세스 전환 비교.
import Stepper from '../Stepper.astro';
const base = ['cpu', 'tcb1', 'tcb2', 't2-saved'];
const steps = [
  { caption: 'T1이 실행 중이에요. CPU 레지스터에는 T1의 PC(다음 명령 위치)와 SP(스택 꼭대기)가 들어 있어요.', show: [...base, 'cpu-t1', 'tl-t1', 'hl-cpu'] },
  { caption: '타이머 인터럽트(할당 시간 끝)나 블로킹 호출(I/O 대기 등)이 일어나면 CPU가 커널로 넘어가요.', show: [...base, 'cpu-t1', 'tl-t1', 'tl-sw', 'k', 'k-in', 'a-int', 'hl-k'] },
  { caption: 'T1의 레지스터 값을 TCB1(스레드 제어 블록)에 저장해요. 프로세스 전환이면 PCB1에 저장해요.', show: [...base, 'cpu-t1', 'tl-t1', 'tl-sw', 'k', 'a-save', 't1-saved', 'hl-tcb1'] },
  { caption: '스케줄러가 다음에 돌릴 스레드로 T2를 골라요.', show: [...base, 'cpu-t1', 't1-saved', 'tl-t1', 'tl-sw', 'k', 'k-pick', 'hl-k'] },
  { caption: 'TCB2에 저장돼 있던 T2의 PC·SP를 CPU 레지스터로 복원해요.', show: [...base, 't1-saved', 'tl-t1', 'tl-sw', 'k', 'a-rest', 'cpu-t2', 'hl-cpu'] },
  { caption: 'T2가 멈췄던 곳부터 이어서 실행해요. 저장·복원하는 동안은 T1도 T2도 일을 못 해요. 이 구간이 컨텍스트 스위칭 오버헤드예요.', show: [...base, 't1-saved', 'cpu-t2', 'tl-t1', 'tl-sw', 'tl-t2', 'oh', 'hl-sw'] },
  { caption: '같은 프로세스의 스레드끼리는 주소 공간(코드·힙)이 그대로라 레지스터만 바꾸면 돼요. 다른 프로세스로 바꿀 땐 주소 공간까지 교체해서 더 비싸요.', show: [...base, 't1-saved', 'cpu-t2', 'tl-t1', 'tl-sw', 'tl-t2', 'cmp'] },
];
const arr = 'fill:none;stroke:var(--sl-color-accent);stroke-width:2';
const tcbs = [{ x: 8, n: 'TCB1 (T1)', s: 't1-saved' }, { x: 168, n: 'TCB2 (T2)', s: 't2-saved' }];
---
<Stepper title="컨텍스트 스위칭: T1 → T2" steps={steps}>
  <svg class="viz" viewBox="0 0 320 470" role="img" aria-label="T1의 레지스터를 TCB1에 저장하고 TCB2에서 T2의 레지스터를 복원하는 과정">
    <defs>
      <marker id="csw-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
    </defs>

    <!-- CPU -->
    <g data-id="cpu">
      <rect class="box" x="70" y="8" width="180" height="72" rx="10" />
      <text x="160" y="25" style="font-weight:700">CPU 레지스터</text>
      <rect class="box" x="86" y="40" width="148" height="30" rx="6" />
    </g>
    <g data-id="cpu-t1" class="hide">
      <rect class="chip" x="86" y="40" width="148" height="30" rx="6" />
      <text x="160" y="55">PC · SP = T1</text>
    </g>
    <g data-id="cpu-t2" class="hide">
      <rect class="chip" x="86" y="40" width="148" height="30" rx="6" />
      <text x="160" y="55">PC · SP = T2</text>
    </g>

    <path data-id="a-int" class="hide" d="M160 80 L160 102" style={arr} marker-end="url(#csw-a)" />

    <!-- 커널 -->
    <g data-id="k">
      <rect class="frame" x="8" y="104" width="304" height="72" rx="10" />
      <text class="sub l" x="18" y="120">커널</text>
    </g>
    <g data-id="k-in" class="hide">
      <text x="160" y="140" style="font-weight:700">커널 진입</text>
      <text class="sub" x="160" y="162">타이머 인터럽트 · 블로킹 호출</text>
    </g>
    <g data-id="k-pick" class="hide">
      <text x="160" y="140" style="font-weight:700">스케줄러</text>
      <text class="sub" x="160" y="162">다음 차례: T2</text>
    </g>

    <!-- 저장 / 복원 화살표 -->
    <g data-id="a-save" class="hide">
      <path d="M70 44 C 30 50, 30 180, 52 240" style={arr} marker-end="url(#csw-a)" />
      <rect class="badge" x="10" y="182" width="56" height="22" rx="11" />
      <text class="on-badge" x="38" y="193">저장</text>
    </g>
    <g data-id="a-rest" class="hide">
      <path d="M268 240 C 290 180, 290 50, 252 44" style={arr} marker-end="url(#csw-a)" />
      <rect class="badge" x="254" y="182" width="56" height="22" rx="11" />
      <text class="on-badge" x="282" y="193">복원</text>
    </g>

    <!-- TCB 두 개 (RuntimeDataAreas의 스레드별 박스와 같은 표현) -->
    {tcbs.map((t) => (
      <g data-id={t.x === 8 ? 'tcb1' : 'tcb2'}>
        <rect class="box" x={t.x} y="212" width="144" height="84" rx="8" />
        <text x={t.x + 72} y="230" style="font-weight:700">{t.n}</text>
        <rect class="box" x={t.x + 12} y="246" width="120" height="30" rx="6" />
        <text class="sub" x={t.x + 72} y="261">—</text>
      </g>
    ))}
    {tcbs.map((t) => (
      <g data-id={t.s} class="hide">
        <rect class="chip" x={t.x + 12} y="246" width="120" height="30" rx="6" />
        <text x={t.x + 72} y="261" style="font-size:14px">PC · SP 보관</text>
      </g>
    ))}

    <!-- 시간 막대 -->
    <text class="sub l" x="8" y="322">시간 →</text>
    <g data-id="tl-t1"><rect class="chip" x="8" y="334" width="110" height="30" rx="4" /><text x="63" y="349">T1 실행</text></g>
    <g data-id="tl-sw"><rect class="bad" x="118" y="334" width="84" height="30" rx="4" /><text class="sub" x="160" y="349">전환</text></g>
    <g data-id="tl-t2"><rect class="chip" x="202" y="334" width="110" height="30" rx="4" /><text x="257" y="349">T2 실행</text></g>
    <rect data-id="hl-sw" class="hl" x="115" y="331" width="90" height="36" rx="6" />
    <text data-id="oh" class="hi hide" x="160" y="384" style="font-size:14px">전환 = 사용자 코드 멈춤 (오버헤드)</text>

    <!-- 비교 -->
    <g data-id="cmp" class="hide">
      <rect class="box" x="8" y="402" width="304" height="28" rx="6" />
      <text x="160" y="416" style="font-size:14px">같은 프로세스 스레드: 레지스터만 교체</text>
      <rect class="chip" x="8" y="436" width="304" height="28" rx="6" />
      <text x="160" y="450" style="font-size:14px">다른 프로세스: + 주소 공간 교체 → 더 비쌈</text>
    </g>

    <rect data-id="hl-cpu" class="hl" x="67" y="5" width="186" height="78" rx="12" />
    <rect data-id="hl-k" class="hl" x="5" y="101" width="310" height="78" rx="12" />
    <rect data-id="hl-tcb1" class="hl" x="5" y="209" width="150" height="90" rx="10" />
  </svg>
</Stepper>
