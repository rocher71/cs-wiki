---
// kubectl apply 한 번이 Pod 실행까지 가는 길. 모든 화살표는 API 서버를 거친다.
import Stepper from '../Stepper.astro';
const base = ['kubectl', 'cp', 'api', 'etcd', 'ctrl', 'sched', 'node', 'kubelet', 'rt'];
const steps = [
  { caption: '1. 개발자가 kubectl apply로 "Pod 3개(replicas: 3)"라는 원하는 상태를 API 서버에 보내요.', show: [...base, 'a1', 'hl1'] },
  { caption: '2. API 서버가 요청을 검사한 뒤 etcd(장부)에 저장해요. 아직 아무것도 실행되지 않았어요.', show: [...base, 'a2', 'hl2'] },
  { caption: '3. 컨트롤러가 API 서버를 지켜보다(watch) 새 Deployment를 발견해요. ReplicaSet을 거쳐 "3개 필요한데 0개"를 보고 Pod 3개 생성을 요청해요. 아직 노드는 정해지지 않았어요.', show: [...base, 'a3', 'hl3'] },
  { caption: '4. 스케줄러가 노드 없는 Pod를 발견해요. 조건 안 맞는 노드를 거르고(필터링), 점수를 매겨(스코어링) 고른 노드를 API 서버에 기록해요.', show: [...base, 'a4', 'hl4'] },
  { caption: '5. 그 노드의 kubelet이 "우리 노드에 배정된 Pod"를 보고, 컨테이너 런타임에 이미지 받기와 실행을 맡겨요.', show: [...base, 'a5', 'ar', 'pods', 'hl5'] },
  { caption: '6. kubelet이 "실행 중(Running)"이라고 API 서버에 보고하고, 그 상태가 etcd에 저장돼요. 구성요소끼리 직접 말하지 않고 모두 API 서버를 거쳐요.', show: [...base, 'a6', 'a2', 'pods', 'run', 'hl6'] },
];
---
<Stepper title="kubectl apply 한 번이 Pod가 되기까지" steps={steps}>
  <svg class="viz" viewBox="0 0 320 472" role="img" aria-label="kubectl 요청이 API 서버, etcd, 컨트롤러, 스케줄러, kubelet을 거쳐 Pod 3개가 실행되는 흐름. 모든 연결은 API 서버를 거친다">
    <defs>
      <marker id="kaf-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
    </defs>
    <style>
      .kaf-a { stroke: var(--sl-color-accent); stroke-width: 2.6; fill: none; }
    </style>

    <g data-id="kubectl">
      <rect class="box" x="80" y="8" width="160" height="52" rx="8" />
      <text x="160" y="26">kubectl apply</text>
      <text class="sub" x="160" y="46">replicas: 3</text>
    </g>

    <g data-id="cp">
      <rect class="frame" x="10" y="72" width="300" height="206" rx="10" />
      <text class="sub l" x="22" y="86">컨트롤 플레인</text>
    </g>
    <g data-id="api">
      <rect class="chip" x="24" y="98" width="272" height="58" rx="8" />
      <text x="160" y="117" style="font-weight:700">API 서버</text>
      <text class="sub" x="160" y="140">모든 요청이 거치는 창구</text>
    </g>
    <g data-id="etcd">
      <rect class="box" x="24" y="196" width="76" height="64" rx="8" />
      <text x="62" y="216">etcd</text>
      <text class="sub" x="62" y="240">장부</text>
    </g>
    <g data-id="ctrl">
      <rect class="box" x="112" y="196" width="76" height="64" rx="8" />
      <text x="150" y="216">컨트롤러</text>
      <text class="sub" x="150" y="240">개수 맞춤</text>
    </g>
    <g data-id="sched">
      <rect class="box" x="200" y="196" width="76" height="64" rx="8" />
      <text x="238" y="216">스케줄러</text>
      <text class="sub" x="238" y="240">노드 고름</text>
    </g>

    <g data-id="node">
      <rect class="frame" x="10" y="300" width="300" height="164" rx="10" />
      <text class="sub l" x="22" y="314">노드 (서버 한 대)</text>
    </g>
    <g data-id="rt">
      <rect class="box" x="24" y="328" width="120" height="52" rx="8" />
      <text x="84" y="346">런타임</text>
      <text class="sub" x="84" y="366">이미지 받고 실행</text>
    </g>
    <g data-id="kubelet">
      <rect class="box" x="176" y="328" width="120" height="52" rx="8" />
      <text x="236" y="346">kubelet</text>
      <text class="sub" x="236" y="366">노드 점장</text>
    </g>
    <g data-id="pods" class="hide">
      <rect class="chip" x="24" y="396" width="80" height="34" rx="8" /><text x="64" y="413">Pod</text>
      <rect class="chip" x="120" y="396" width="80" height="34" rx="8" /><text x="160" y="413">Pod</text>
      <rect class="chip" x="216" y="396" width="80" height="34" rx="8" /><text x="256" y="413">Pod</text>
    </g>
    <text data-id="run" class="hide hi" x="160" y="448">3개 모두 Running</text>

    <!-- 단계별 화살표 (현재 단계 것만 보임) -->
    <line data-id="a1" class="kaf-a hide" x1="160" y1="62" x2="160" y2="96" marker-end="url(#kaf-arr)" />
    <line data-id="a2" class="kaf-a hide" x1="62" y1="158" x2="62" y2="194" marker-end="url(#kaf-arr)" />
    <line data-id="a3" class="kaf-a hide" x1="150" y1="160" x2="150" y2="194" marker-start="url(#kaf-arr)" marker-end="url(#kaf-arr)" />
    <line data-id="a4" class="kaf-a hide" x1="238" y1="160" x2="238" y2="194" marker-start="url(#kaf-arr)" marker-end="url(#kaf-arr)" />
    <line data-id="a5" class="kaf-a hide" x1="288" y1="158" x2="288" y2="326" marker-end="url(#kaf-arr)" />
    <line data-id="a6" class="kaf-a hide" x1="288" y1="326" x2="288" y2="158" marker-end="url(#kaf-arr)" />
    <line data-id="ar" class="kaf-a hide" x1="174" y1="354" x2="146" y2="354" marker-end="url(#kaf-arr)" />

    <rect data-id="hl1" class="hl" x="76" y="4" width="168" height="60" rx="10" />
    <rect data-id="hl2" class="hl" x="20" y="192" width="84" height="72" rx="10" />
    <rect data-id="hl3" class="hl" x="108" y="192" width="84" height="72" rx="10" />
    <rect data-id="hl4" class="hl" x="196" y="192" width="84" height="72" rx="10" />
    <rect data-id="hl5" class="hl" x="20" y="324" width="280" height="110" rx="10" />
    <rect data-id="hl6" class="hl" x="20" y="392" width="280" height="68" rx="10" />
  </svg>
</Stepper>
