---
// "캐시 먼저 지우고 DB 갱신" 순서의 경쟁 상태. 위 = 캐시/DB 현재 값, 아래 = 쓰기 A | 읽기 B 세로 타임라인.
import Stepper from '../Stepper.astro';
const AX = 80, BX = 240, CW = 148, CH = 44;
const T0 = 168, GAP = 54;
const rows = [
  { side: 'A', l1: 'DEL key', l2: '캐시 비움' },
  { side: 'B', l1: 'GET key', l2: '→ miss' },
  { side: 'B', l1: 'SELECT', l2: '→ 10 (옛 값)' },
  { side: 'A', l1: 'UPDATE', l2: 'DB = 20' },
  { side: 'B', l1: 'SET key 10', l2: '옛 값을 넣음', cls: 'err', tc: 'err-t' },
];
const S = (n: number, extra: string[] = []) => [...Array.from({ length: n }, (_, i) => `r${i}`), ...extra];
const steps = [
  { caption: '처음엔 캐시와 DB 모두 10이에요. 쓰기 A가 값을 20으로 바꾸려는데, 캐시를 먼저 지우는 순서를 써요.', show: ['c0', 'd0'] },
  { caption: 'A가 캐시의 key를 DEL해요. 캐시는 비었고 DB는 아직 10이에요.', show: ['c1', 'd0', ...S(1), 'h0'] },
  { caption: 'A가 DB를 고치기 전, 그 틈에 읽기 B가 GET해요. 캐시가 비어 있으니 miss예요.', show: ['c1', 'd0', ...S(2), 'h1'] },
  { caption: 'B가 DB에서 읽어요. A가 아직 안 고쳤으니 옛 값 10을 받아요.', show: ['c1', 'd0', ...S(3), 'h2'] },
  { caption: '이제야 A가 DB를 20으로 갱신해요. A 입장에선 할 일을 다 끝냈어요.', show: ['c1', 'd1', ...S(4), 'h3'] },
  { caption: 'B가 아까 읽은 10을 캐시에 SET해요. 캐시는 10(옛 값), DB는 20으로 어긋났어요.', show: ['c2', 'd1', ...S(5), 'h4'] },
  { caption: '아무도 이 캐시를 다시 지우지 않아요. TTL이 끝날 때까지 모든 읽기가 10을 봐요.', show: ['c2', 'd1', ...S(5), 'res'] },
  { caption: '대비: DB를 먼저 갱신하고 그다음 DEL하면, 지우는 일이 맨 마지막이라 이 틈이 거의 사라져요. 아주 드문 경우가 남아서 TTL도 함께 걸어요.', show: ['c2', 'd1', 'fix'] },
];
const lastY = T0 + (rows.length - 1) * GAP;
const resY = lastY + CH / 2 + 14;
const H = resY + 64;
const cell = { y: 58, h: 48 };
---
<Stepper title="캐시 먼저 지우면 생기는 틈" steps={steps}>
  <svg class="viz" viewBox={`0 0 320 ${H}`} role="img" aria-label="쓰기 A가 캐시를 지운 뒤 DB를 갱신하기 전에 읽기 B가 옛 값 10을 읽어 캐시에 다시 넣어, 캐시 10과 DB 20이 어긋나는 타임라인">
    <rect class="badge" x="50" y="6" width="220" height="26" rx="13" />
    <text class="on-badge" x="160" y="19">순서: 캐시 DEL → DB 갱신</text>

    <!-- 현재 값 -->
    <text class="sub" x="85" y="46">캐시</text>
    <text class="sub" x="235" y="46">DB</text>
    <rect class="box" x="20" y={cell.y} width="130" height={cell.h} rx="8" />
    <rect class="box" x="170" y={cell.y} width="130" height={cell.h} rx="8" />
    <g data-id="c0" class="hide"><text x="85" y={cell.y + 24}>10</text></g>
    <g data-id="c1" class="hide"><text class="sub" x="85" y={cell.y + 24}>비어 있음</text></g>
    <g data-id="c2" class="hide">
      <rect class="err" x="20" y={cell.y} width="130" height={cell.h} rx="8" />
      <text class="err-t" x="85" y={cell.y + 24}>10 (옛 값)</text>
    </g>
    <g data-id="d0" class="hide"><text x="235" y={cell.y + 24}>10</text></g>
    <g data-id="d1" class="hide">
      <rect class="chip" x="170" y={cell.y} width="130" height={cell.h} rx="8" />
      <text class="hi" x="235" y={cell.y + 24}>20 (새 값)</text>
    </g>

    <!-- 세션 열 -->
    <text x={AX} y="130" style="font-weight:700">쓰기 A</text>
    <text x={BX} y="130" style="font-weight:700">읽기 B</text>
    <line class="line" x1="160" y1="118" x2="160" y2={lastY + CH / 2} style="stroke-dasharray:3 4" />

    {rows.map((_, j) => <rect data-id={`h${j}`} class="hl" x="2" y={T0 + j * GAP - CH / 2 - 4} width="316" height={CH + 8} rx="8" />)}
    {rows.map((r, j) => {
      const y = T0 + j * GAP, cx = r.side === 'A' ? AX : BX;
      return (
        <g data-id={`r${j}`}>
          <rect class={r.cls ?? 'chip'} x={cx - CW / 2} y={y - CH / 2} width={CW} height={CH} rx="6" />
          <text class="sub" x={cx - CW / 2 + 12} y={y - 10} style="font-size:14px">{['①', '②', '③', '④', '⑤'][j]}</text>
          <text class="mono" x={cx + 6} y={y - 10}>{r.l1}</text>
          <text class={r.tc} x={cx} y={y + 11} style="font-size:14px;font-weight:700">{r.l2}</text>
        </g>
      );
    })}

    <g data-id="res" class="hide">
      <rect class="err" x="6" y={resY} width="308" height="56" rx="8" />
      <text class="err-t" x="160" y={resY + 18} style="font-size:14px">캐시 10 ≠ DB 20</text>
      <text x="160" y={resY + 39} style="font-size:14px">TTL 만료 전까지 모두가 10을 봐요</text>
    </g>
    <g data-id="fix" class="hide">
      <rect class="chip" x="6" y={resY} width="308" height="56" rx="8" />
      <text class="hi" x="160" y={resY + 18} style="font-size:14px">대비: DB 갱신 → 캐시 DEL</text>
      <text x="160" y={resY + 39} style="font-size:14px">DEL이 마지막이라 옛 값이 남기 어려움</text>
    </g>
  </svg>
</Stepper>
