---
// 멀티 스테이지 빌드: 스테이지 1(golang)에서 컴파일 → 실행 파일만 스테이지 2(scratch)로 복사 → 스테이지 1은 버려짐.
// 크기 막대는 실측 비율(3.41 / 407)대로 그리되 너무 얇으면 최소 4px.
import Stepper from '../Stepper.astro';
const W = 312;
const small = Math.max(4, (W * 3.41) / 407);
const steps = [
  { caption: '스테이지 1(build)은 golang 이미지에서 시작해요. 컴파일러·셸·패키지 관리자가 다 들어 있어 무거워요. 여기에 소스 코드를 복사해요.', show: ['s1', 's1-src'] },
  { caption: 'go build로 컴파일하면 실행 파일 하나(hello)가 나와요. 실제로 실행에 필요한 건 이것뿐이에요.', show: ['s1', 's1-src', 's1-bin'] },
  { caption: '스테이지 2는 scratch, 아무것도 없는 빈 이미지에서 시작해요.', show: ['s1', 's1-src', 's1-bin', 's2'] },
  { caption: 'COPY --from=build로 스테이지 1에서 실행 파일만 골라 스테이지 2로 옮겨요.', show: ['s1', 's1-src', 's1-bin', 's2', 'arrow', 's2-bin'] },
  { caption: '최종 이미지는 마지막 스테이지뿐이고, 스테이지 1은 버려져요. 단일 스테이지 407MB가 3.41MB로 줄었어요.', show: ['s2', 's2-bin', 'drop', 'bars'] },
];
---
<Stepper title="멀티 스테이지: 결과물만 옮겨 담기" steps={steps}>
  <svg class="viz" viewBox="0 0 320 400" role="img" aria-label="스테이지 1 golang 이미지에서 소스를 go build해 실행 파일을 만들고, COPY --from=build로 실행 파일만 빈 scratch 이미지인 스테이지 2로 옮긴다. 스테이지 1은 버려지고 최종 이미지는 단일 스테이지 407MB 대비 3.41MB">
    <g data-id="s1">
      <text class="l" x="4" y="12" style="font-weight:700">스테이지 1 · build</text>
      <rect class="frame" x="1" y="22" width="318" height="126" rx="6" />
      <rect class="box" x="6" y="28" width="308" height="46" rx="4" />
      <text class="mono" x="160" y="42">golang:1.23-alpine</text>
      <text class="sub" x="160" y="62">컴파일러 · 셸 · 패키지 관리자</text>
    </g>
    <text data-id="drop" class="err-t hide" x="316" y="12" style="text-anchor:end">버려짐</text>
    <g data-id="s1-src">
      <rect class="box" x="6" y="80" width="308" height="28" rx="4" />
      <text x="160" y="94">COPY 소스 코드</text>
    </g>
    <g data-id="s1-bin">
      <rect class="chip" x="6" y="114" width="308" height="28" rx="4" />
      <text x="160" y="128">go build → <tspan class="hi">hello</tspan> (실행 파일)</text>
    </g>

    <g data-id="arrow" class="hide">
      <line class="line" x1="60" y1="150" x2="60" y2="190" style="stroke:var(--sl-color-accent);stroke-width:2.4" />
      <polygon points="53,186 67,186 60,198" style="fill:var(--sl-color-accent)" />
      <text class="mono l hi" x="74" y="174">COPY --from=build</text>
    </g>

    <g data-id="s2" class="hide">
      <text class="l" x="4" y="214" style="font-weight:700">스테이지 2 · 최종 이미지</text>
      <rect class="frame" x="1" y="224" width="318" height="74" rx="6" style="stroke:var(--sl-color-accent);stroke-dasharray:none" />
      <rect class="box" x="6" y="230" width="308" height="28" rx="4" />
      <text x="160" y="244"><tspan class="mono">FROM scratch</tspan> (빈 이미지)</text>
    </g>
    <g data-id="s2-bin" class="hide">
      <rect class="chip" x="6" y="264" width="308" height="28" rx="4" />
      <text x="160" y="278"><tspan class="hi">hello</tspan> (실행 파일만)</text>
    </g>

    <g data-id="bars" class="hide">
      <text class="l" x="4" y="318">단일 스테이지</text>
      <text x="316" y="318" style="text-anchor:end;font-weight:700">407MB</text>
      <rect class="bad" x="4" y="328" width={W} height="18" rx="3" />
      <text class="l" x="4" y="364">멀티 스테이지</text>
      <text class="hi" x="316" y="364" style="text-anchor:end">3.41MB</text>
      <rect class="badge" x="4" y="374" width={small} height="18" rx="2" />
    </g>
  </svg>
</Stepper>
