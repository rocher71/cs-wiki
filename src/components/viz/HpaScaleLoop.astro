---
// HPA 계산 한 바퀴: 수집 → request 대비 사용률 → 목표와 비율 → ceil → replicas 변경 → 축소 안정화
import Stepper from '../Stepper.astro';
const pods = [{ m: 400, p: 80 }, { m: 500, p: 100 }, { m: 450, p: 90 }, { m: 450, p: 90 }];
const xs = [16, 90, 164, 238];
const R1 = 64, R2 = 164, PH = 68;   // Pod 행 top, 높이
const base = ['ms', 'pods'];
const steps = [
  { caption: 'HPA는 15초마다 Metrics Server에서 Pod별 CPU 사용량을 가져와요. 여기선 Pod 4개가 400m·500m·450m·450m를 쓰고 있어요.', show: [...base, 'use'] },
  { caption: '사용률은 노드 CPU가 아니라 각 Pod의 request(500m) 대비 비율이에요. 80%·100%·90%·90%, 평균 90%예요.', show: [...base, 'pct', 'c1'] },
  { caption: '목표 60%와 비교하면 90 ÷ 60 = 1.5예요. 허용오차(0.1) 범위인 0.9~1.1 밖이라 Pod 수를 바꿔요.', show: [...base, 'pct', 'c1', 'c2'] },
  { caption: '원하는 Pod 수 = ceil(현재 4 × 1.5) = 6이에요. ceil은 올림이라 소수점이 나오면 한 개 더 띄워요.', show: [...base, 'pct', 'c1', 'c2', 'c3'] },
  { caption: 'Deployment의 replicas를 4에서 6으로 바꿔요. 새 Pod는 Ready가 될 때까지, 스케일 업을 계산할 땐 0%를 쓴다고 보수적으로 가정해요(JVM 워밍업 CPU로 과하게 늘지 않게).', show: [...base, 'pct', 'c1', 'c2', 'c3', 'c4', 'new'] },
  { caption: '부하가 줄어 사용률이 40%로 떨어져도 바로 줄이지 않아요. 축소는 5분 안정화 기간 동안의 권고 중 가장 큰 값을 따라서, 5분 내내 낮게 나와야 줄여요.', show: [...base, 'low', 'c1', 'c2', 'c3', 'c4', 'new', 'stab'] },
];
---
<Stepper title="HPA가 Pod 수를 계산하는 순서" steps={steps}>
  <svg class="viz" viewBox="0 0 320 428" role="img" aria-label="HPA가 Pod별 CPU 사용량을 request 대비 비율로 바꿔 평균 90%를 구하고, 목표 60%와 비교한 비율 1.5로 ceil(4×1.5)=6을 계산해 replicas를 4에서 6으로 늘리고, 축소는 5분 안정화 뒤에 하는 과정">
    <g data-id="ms">
      <rect class="box" x="16" y="6" width="288" height="36" rx="8" />
      <text x="160" y="24">Metrics Server · 15초마다 수집</text>
    </g>

    <g data-id="pods">
      {xs.map((x, i) => (
        <g>
          <rect class="chip" x={x} y={R1} width="66" height={PH} rx="8" />
          <text x={x + 33} y={R1 + 16} style="font-weight:700">Pod{i + 1}</text>
        </g>
      ))}
      <text class="sub l" x="16" y={R1 + PH + 16}>각 Pod CPU request = 500m</text>
    </g>
    <g data-id="use" class="hide">
      {xs.map((x, i) => <text class="mono" x={x + 33} y={R1 + 44}>{pods[i].m}m</text>)}
    </g>
    <g data-id="pct" class="hide">
      {xs.map((x, i) => <text class="hi" x={x + 33} y={R1 + 44}>{pods[i].p}%</text>)}
    </g>

    <g data-id="low" class="hide">
      {xs.map((x) => <text class="sub" x={x + 33} y={R1 + 44}>40%</text>)}
    </g>

    <g data-id="new" class="hide">
      {[0, 1].map((k) => (
        <g>
          <rect class="bad" x={xs[k]} y={R2} width="66" height={PH} rx="8" />
          <text x={xs[k] + 33} y={R2 + 16} style="font-weight:700">Pod{k + 5}</text>
          <text class="sub" x={xs[k] + 33} y={R2 + 44}>시작 중</text>
        </g>
      ))}
      <text class="sub l" x="168" y={R2 + 22}>Ready 전에는</text>
      <text class="sub l" x="168" y={R2 + 46}>0%로 가정</text>
    </g>

    <rect class="frame" x="16" y="246" width="288" height="112" rx="10" />
    <text data-id="c1" class="l" x="30" y="266">평균 사용률 <tspan class="hi">90%</tspan></text>
    <text data-id="c2" class="l" x="30" y="290">90 ÷ 목표 60 = <tspan class="hi">1.5</tspan> (0.9~1.1 밖)</text>
    <text data-id="c3" class="mono l" x="30" y="314">ceil(4 × 1.5) = <tspan class="hi">6</tspan></text>
    <text data-id="c4" class="l" x="30" y="338">replicas 4 → <tspan class="hi">6</tspan></text>

    <g data-id="stab" class="hide">
      <text class="l" x="16" y="380" style="font-weight:700">축소 안정화 5분</text>
      <text class="l" x="16" y="404">최근 권고 6 · 5 · 4 · 4 → 최댓값 <tspan class="hi">6</tspan> 유지</text>
    </g>
  </svg>
</Stepper>
