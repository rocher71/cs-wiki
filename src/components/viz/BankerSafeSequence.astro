---
// 은행원 알고리즘 안전 순서: 본문 예제 1(자원 3종) 표 + Work 칸 막대, 마지막 단계는 예제 2(자원 1종, P0 요청 → 불안전).
// 값은 _workspace/exam/os/sync-deadlock/banker_check.py 출력과 같다(아래 assert로 확인).
// 예제 1·2는 같은 자리를 번갈아 쓰므로 class hide.
import Stepper from '../Stepper.astro';

const total = [9, 5, 6];
const alloc = [[1, 1, 0], [2, 0, 1], [1, 2, 1], [0, 0, 2]];
const max = [[5, 3, 2], [3, 2, 2], [2, 2, 3], [4, 1, 3]];
const need = max.map((m, i) => m.map((v, k) => v - alloc[i][k]));
const avail = total.map((t, k) => t - alloc.reduce((s, a) => s + a[k], 0));
// 순서 P0→P1→P2→P3로 Work 누적
const work = [avail];
for (const a of alloc) work.push(work[work.length - 1].map((v, k) => v + a[k]));
const eq = (a: number[], b: number[]) => a.join() === b.join();
if (!eq(avail, [5, 2, 2]) || !eq(work[1], [6, 3, 2]) || !eq(work[2], [8, 3, 3]) || !eq(work[3], [9, 5, 4]) || !eq(work[4], total)) throw new Error('banker 값 불일치');
need.forEach((n, i) => { if (!n.every((v, k) => v <= work[i][k])) throw new Error('Need > Work'); });

const t3 = (v: number[]) => v.join(' ');
const tp = (v: number[]) => `(${v.join(', ')})`;
const ROW = (i: number) => 72 + i * 30;
const COL = { p: 34, a: 112, n: 190, s: 272 };
const U = 22, BX = 58, BY = (k: number) => 236 + k * 32;
const res = ['A', 'B', 'C'];

const done = (n: number) => Array.from({ length: n }, (_, i) => `d${i}`);
const steps = [
  { caption: `시작: 전체 ${tp(total)}에서 모두가 쥔 합 (4, 3, 4)을 빼면 Available = ${tp(avail)}. 이걸 Work(지금 쓸 수 있는 몫)로 놓고 시작해요.`, show: ['ex1', 'w0', 'e0'] },
  ...[0, 1, 2, 3].map((i) => ({
    caption: `P${i}의 Need ${tp(need[i])} ≤ Work ${tp(work[i])}라 끝까지 돌 수 있어요. 끝나면 쥐고 있던 Allocation ${tp(alloc[i])}을 돌려줘서 Work = ${tp(work[i + 1])}${i === 3 ? '. 전체 자원과 같으니 검산도 맞아요.' : '.'}`,
    show: ['ex1', `c${i}`, ...done(i + 1), `w${i + 1}`, `e${i + 1}`],
  })),
  { caption: '네 프로세스가 모두 끝났으니 안전 상태예요. 안전 순서 P0 → P1 → P2 → P3. 이 예제는 순서가 이것 하나만은 아니에요.', show: ['ex1', ...done(4), 'w4', 'safe'] },
  { caption: '예제 2: 자원 1종 10개. P0가 1개를 더 받으면 Available이 2 → 1이 되고, Need 4·2·3이 모두 1보다 커서 아무도 못 끝내요. 불안전이니 요청을 거절하고 P0를 기다리게 해요.', show: ['ex2'] },
];

// 예제 2 (P0에 1개 준 뒤)
const ex2 = [{ p: 'P0', a: '3 → 4', n: '5 → 4' }, { p: 'P1', a: '2', n: '2' }, { p: 'P2', a: '3', n: '3' }];
const ex2Need = [4, 2, 3];
if (10 - (4 + 2 + 3) !== 1 || ex2Need.some((n) => n <= 1)) throw new Error('ex2 값 불일치');
---
<Stepper title="은행원 알고리즘: Work가 늘어나며 안전 순서 찾기" steps={steps}>
  <svg class="viz" viewBox="0 0 320 430" role="img" aria-label="예제 1: Available (5,2,2)에서 P0, P1, P2, P3 순서로 Need가 Work 이하인지 확인하고 끝날 때마다 Allocation을 돌려받아 Work가 (6,3,2), (8,3,3), (9,5,4), (9,5,6)으로 늘어 안전 상태. 예제 2: 자원 10개, P0가 1개 더 받으면 Available 1, Need 4, 2, 3 모두 1보다 커서 불안전이라 요청 거절.">
    <!-- 예제 1 -->
    <g data-id="ex1" class="hide">
      <text class="l" x="8" y="18" style="font-weight:700">예제 1 · 전체 (9, 5, 6)</text>
      <text class="sub" x={COL.p} y="46">프로세스</text>
      <text class="sub" x={COL.a} y="46">Allocation</text>
      <text class="sub" x={COL.n} y="46">Need</text>
      <text class="sub" x={COL.s} y="46">상태</text>
      <path class="line" d="M6 58 H314" />
      {alloc.map((a, i) => <>
        <text x={COL.p} y={ROW(i)}>P{i}</text>
        <text class="mono" x={COL.a} y={ROW(i)}>{t3(a)}</text>
        <text class="mono" x={COL.n} y={ROW(i)}>{t3(need[i])}</text>
      </>)}
      <text class="l" x="8" y="210" style="font-weight:700">Work (쓸 수 있는 몫 / 전체)</text>
      {res.map((r, k) => <>
        <text x="30" y={BY(k) + U / 2}>{r}</text>
        {Array.from({ length: total[k] }, (_, u) => <rect class="frame" x={BX + u * U + 1} y={BY(k) + 1} width={U - 2} height={U - 2} rx="3" />)}
      </>)}
    </g>

    {[0, 1, 2, 3].map((i) => <>
      <g data-id={`d${i}`} class="hide">
        <rect class="box" x="6" y={ROW(i) - 14} width="308" height="28" rx="4" style="opacity:.55" />
        <text x={COL.p} y={ROW(i)}>P{i}</text>
        <text class="mono" x={COL.a} y={ROW(i)}>{t3(alloc[i])}</text>
        <text class="mono" x={COL.n} y={ROW(i)}>{t3(need[i])}</text>
        <text class="hi" x={COL.s} y={ROW(i)}>끝 ({i + 1}번째)</text>
      </g>
      <rect data-id={`c${i}`} class="hl hide" x={COL.n - 36} y={ROW(i) - 14} width="72" height="28" rx="5" />
    </>)}

    {work.map((w, j) => <g data-id={`w${j}`} class="hide">
      {res.map((_, k) => <>
        {Array.from({ length: w[k] }, (_, u) => <rect class="chip" x={BX + u * U + 1} y={BY(k) + 1} width={U - 2} height={U - 2} rx="3" />)}
        {j > 0 && w[k] > work[j - 1][k] && <rect class="hl" x={BX + work[j - 1][k] * U - 1} y={BY(k) - 1} width={(w[k] - work[j - 1][k]) * U + 2} height={U + 2} rx="4" />}
        <text class="mono" x="312" y={BY(k) + U / 2} style="text-anchor:end">{w[k]}/{total[k]}</text>
      </>)}
    </g>)}

    <g data-id="e0" class="hide">
      <text class="mono l" x="8" y="348">(9,5,6) − (4,3,4)</text>
      <text class="mono l" x="8" y="372">= Available <tspan class="hi">(5,2,2)</tspan></text>
    </g>
    {[0, 1, 2, 3].map((i) => <g data-id={`e${i + 1}`} class="hide">
      <text class="mono l" x="8" y="348">P{i} Need {tp(need[i]).replace(/ /g, '')} ≤ {tp(work[i]).replace(/ /g, '')} 예</text>
      <text class="mono l" x="8" y="372">+ Alloc {tp(alloc[i]).replace(/ /g, '')} = <tspan class="hi">{tp(work[i + 1]).replace(/ /g, '')}</tspan></text>
      {i === 3 && <text class="sub l" x="8" y="396">= 전체 자원 (9,5,6) → 검산 OK</text>}
    </g>)}
    <g data-id="safe" class="hide">
      <rect class="badge" x="8" y="334" width="304" height="34" rx="17" />
      <text class="on-badge" x="160" y="351">안전 상태</text>
      <text x="160" y="392">안전 순서 P0 → P1 → P2 → P3</text>
    </g>

    <!-- 예제 2 -->
    <g data-id="ex2" class="hide">
      <text class="l" x="8" y="18" style="font-weight:700">예제 2 · 자원 1종 10개</text>
      <text class="sub l" x="8" y="40">P0가 1개 더 요청 → 임시로 줘 봄</text>
      <text class="sub" x={COL.p} y="66">프로세스</text>
      <text class="sub" x={COL.a} y="66">Allocation</text>
      <text class="sub" x={COL.n} y="66">Need</text>
      <text class="sub" x={COL.s} y="66">Need ≤ 1?</text>
      <path class="line" d="M6 78 H314" />
      {ex2.map((r, i) => <>
        <text x={COL.p} y={96 + i * 30}>{r.p}</text>
        <text class={`mono${i === 0 ? ' hi' : ''}`} x={COL.a} y={96 + i * 30}>{r.a}</text>
        <text class={`mono${i === 0 ? ' hi' : ''}`} x={COL.n} y={96 + i * 30}>{r.n}</text>
        <text class="err-t" x={COL.s} y={96 + i * 30}>✗ {ex2Need[i]} &gt; 1</text>
      </>)}
      <text class="l" x="8" y="200" style="font-weight:700">Available <tspan class="hi">2 → 1</tspan></text>
      {Array.from({ length: 10 }, (_, u) => <rect class={u < 9 ? 'box' : u === 9 ? 'chip' : 'frame'} x={42 + u * U + 1} y="216" width={U - 2} height={U - 2} rx="3" />)}
      <text class="sub l" x="42" y="256">회색 9개 = 쥔 것(4+2+3), 남은 1개</text>
      <rect class="err" x="8" y="290" width="304" height="40" rx="8" />
      <text class="err-t" x="160" y="310">불안전 → 요청 거절</text>
      <text class="sub" x="160" y="356">아무도 못 끝내니 첫 단계부터 막혀요</text>
      <text class="sub" x="160" y="380">P0는 자원이 풀릴 때까지 기다려요</text>
    </g>
  </svg>
</Stepper>
