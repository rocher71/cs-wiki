---
// 대기열 번호표 흐름: 동시 클릭 → ZADD NX → 새로고침(0, 순번 유지) → ZRANK → ZPOPMIN → 입장 토큰.
// 같은 자리에 번갈아 나오는 표 행(rowsA/rowsB)·명령 패널(c1~c6)·강조는 class="hide".
import Stepper from '../Stepper.astro';

const steps = [
  { caption: '티켓 오픈 순간, 사용자 3명이 거의 동시에 ‘예매하기’를 눌렀어요. 각자 대기열 서버에 번호표를 달라고 요청해요.', show: ['u', 'click', 'empty', 'c1'] },
  { caption: 'ZADD NX로 Sorted Set에 넣어요. 점수는 도착 시각(밀리초)이라 먼저 온 사람이 자동으로 앞에 정렬돼요.', show: ['u', 'rowsA', 'c2'] },
  { caption: 'user:2가 새로고침해서 다시 요청했어요. NX는 “없을 때만 추가”라 0을 돌려주고 점수 1003은 그대로예요. 뒤로 밀리지 않아요.', show: ['u', 'rowsA', 'c3', 'f5'] },
  { caption: 'user:3이 내 순번을 물어요. ZRANK는 0부터 세서 2를 돌려주니, 화면엔 +1 해서 “3번째, 내 앞에 2명”으로 보여 줘요.', show: ['u', 'rowsA', 'c4', 'r3'] },
  { caption: '스케줄러가 1초마다 ZPOPMIN으로 앞에서 N명(그림은 2명)을 꺼내며 지워요. 남은 user:3은 순위가 0으로 앞당겨져요.', show: ['u', 'rowsB', 'c5'] },
  { caption: '꺼낸 사용자에게 서버 비밀키로 서명한 입장 토큰을 줘요. 예매 서버는 요청마다 서명·만료를 검사하고, 통과해야 들여보내요.', show: ['u', 'rowsB', 'c6', 'tok'] },
];
const UX = [10, 115, 220]; // 사용자 상자 x (폭 90)
const RY = [128, 156, 184]; // 표 행 y (높이 24)
const rowsA = [['0', 'user:1', '1000'], ['1', 'user:2', '1003'], ['2', 'user:3', '1007']];
---
<Stepper title="대기열 번호표: Sorted Set으로 줄 세우기" steps={steps}>
  <svg class="viz" viewBox="0 0 320 368" role="img" aria-label="사용자 3명이 ZADD NX로 Redis Sorted Set에 도착 시각 점수로 들어가고, 새로고침해도 점수가 유지되며, ZRANK로 순번을 조회하고, 스케줄러가 ZPOPMIN으로 앞에서 꺼내 서명된 입장 토큰을 발급하는 과정">
    <!-- 사용자 -->
    <g data-id="u">
      {UX.map((x, i) => <><rect class="box" x={x} y="8" width="90" height="36" rx="6" /><text x={x + 45} y="26">user:{i + 1}</text></>)}
    </g>
    <g data-id="click" class="hide">
      {UX.map((x) => <path class="line" d={`M${x + 45} 46 V78 M${x + 39} 72 L${x + 45} 78 L${x + 51} 72`} />)}
    </g>

    <!-- Sorted Set 틀 -->
    <rect class="frame" x="6" y="84" width="308" height="128" rx="8" />
    <text class="l" x="16" y="98" style="font-weight:700">Sorted Set queue</text>
    <text class="sub" x="44" y="117">순위</text>
    <text class="sub" x="140" y="117">멤버</text>
    <text class="sub" x="250" y="117">점수(도착 ms)</text>

    <g data-id="empty" class="hide"><text class="sub" x="160" y="168">아직 비어 있음</text></g>
    <g data-id="rowsA" class="hide">
      {rowsA.map(([r, m, s], i) => <>
        <rect class="box" x="14" y={RY[i]} width="292" height="24" rx="4" />
        <text x="44" y={RY[i] + 12}>{r}</text><text x="140" y={RY[i] + 12}>{m}</text><text class="mono" x="250" y={RY[i] + 12}>{s}</text>
      </>)}
    </g>
    <g data-id="rowsB" class="hide">
      {[0, 1].map((i) => <>
        <rect class="bad" x="14" y={RY[i]} width="292" height="24" rx="4" />
        <text class="sub" x="160" y={RY[i] + 12}>user:{i + 1} 꺼냄 → 입장</text>
      </>)}
      <rect class="chip" x="14" y={RY[2]} width="292" height="24" rx="4" />
      <text class="hi" x="44" y={RY[2] + 12}>0</text><text x="140" y={RY[2] + 12}>user:3</text><text class="mono" x="250" y={RY[2] + 12}>1007</text>
    </g>
    <g data-id="f5" class="hide">
      <rect class="hl" x="113" y="6" width="94" height="40" rx="8" />
      <text class="hi" x="160" y="60">F5 새로고침</text>
      <rect class="hl" x="11" y={RY[1] - 3} width="298" height="30" rx="6" />
    </g>
    <g data-id="r3" class="hide">
      <rect class="hl" x="218" y="6" width="94" height="40" rx="8" />
      <text class="hi" x="265" y="60">내 순번?</text>
      <rect class="hl" x="11" y={RY[2] - 3} width="298" height="30" rx="6" />
    </g>

    <!-- 명령 패널 (같은 자리, 번갈아) -->
    <rect class="box" x="6" y="222" width="308" height="58" rx="8" />
    <g data-id="c1" class="hide"><text class="mono" x="160" y="240">POST /queue/concert/join</text><text class="sub" x="160" y="264">× 3명</text></g>
    <g data-id="c2" class="hide"><text class="mono" x="160" y="240">ZADD queue NX 1000 user:1</text><text class="sub" x="160" y="264">→ 1 (추가됨) · user:2, user:3도 같은 식</text></g>
    <g data-id="c3" class="hide"><text class="mono" x="160" y="240">ZADD queue NX 1250 user:2</text><text x="160" y="264"><tspan class="hi">→ 0</tspan> 이미 있음, 점수 1003 유지</text></g>
    <g data-id="c4" class="hide"><text class="mono" x="160" y="240">ZRANK queue user:3</text><text x="160" y="264"><tspan class="hi">→ 2</tspan> · 화면엔 “3번째, 앞에 2명”</text></g>
    <g data-id="c5" class="hide"><text class="mono" x="160" y="240">ZPOPMIN queue 2</text><text x="160" y="264"><tspan class="hi">→ user:1, user:2</tspan> 꺼내고 지움</text></g>
    <g data-id="c6" class="hide"><text x="160" y="240">스케줄러: 1초마다 N명 꺼냄</text><text class="sub" x="160" y="264">꺼낸 사람에게 토큰 발급</text></g>

    <!-- 입장 토큰 → 예매 서버 -->
    <g data-id="tok" class="hide">
      <rect class="chip" x="10" y="292" width="140" height="30" rx="6" /><text x="80" y="307">user:1 토큰</text>
      <rect class="chip" x="170" y="292" width="140" height="30" rx="6" /><text x="240" y="307">user:2 토큰</text>
      <path class="line" d="M160 324 V334 M154 328 L160 334 L166 328" />
      <rect class="box" x="6" y="336" width="308" height="28" rx="6" />
      <text x="160" y="350">예매 서버: 서명·만료 확인 → 입장</text>
    </g>
  </svg>
</Stepper>
