---
// 단방향 @OneToMany + @JoinColumn: 자식이 FK를 모르니 INSERT 뒤에 post_id UPDATE가 자식 수만큼 추가된다. 양방향(@ManyToOne 주인)과 비교. (실험 B: Hibernate 7.4 + H2)
import Stepper from '../Stepper.astro';
const s1 = ['obj', 'post', 'c1', 'c2', 'ar1', 'ar2', 'know', 'map'];
const s2 = [...s1, 'log', 'q1'];
const s3 = [...s2, 'q2'];
const s4 = [...s3, 'q3', 'totU'];
const steps = [
  { caption: 'Post만 comments 컬렉션을 갖고(@OneToMany + @JoinColumn(post_id)), Comment에는 Post 참조가 없어요. 그런데 post_id 외래키 칸은 COMMENT 테이블에 있어요.', show: [...s1, 'hl-obj'] },
  { caption: 'Post를 저장하면 먼저 INSERT Post가 나가요.', show: [...s2, 'hl-q1'] },
  { caption: '댓글 두 개도 INSERT돼요. 하지만 Comment 엔티티는 post_id를 모르니 이 칸은 비운 채로 들어가요.', show: [...s3, 'hl-q2'] },
  { caption: '그래서 Post 쪽 컬렉션을 보고 UPDATE Comment set post_id=?를 댓글 수만큼 따로 보내요. 댓글이 100개면 UPDATE도 100번이에요.', show: [...s4, 'hl-q3'] },
  { caption: '양방향으로 바꿔 Comment의 @ManyToOne을 주인으로 두면, INSERT할 때 post_id가 같이 들어가요. UPDATE 없이 INSERT 3번으로 끝나요.', show: [...s4, 'cmp', 'b1', 'b2', 'totB', 'hl-cmp'] },
];
---
<Stepper title="단방향 @OneToMany의 추가 UPDATE" steps={steps}>
  <svg class="viz" viewBox="0 0 320 420" role="img" aria-label="단방향 @OneToMany에서 Post와 댓글 2개를 저장하면 INSERT 3번 뒤 post_id를 채우는 UPDATE가 2번 더 나가고, 양방향이면 INSERT 3번으로 끝나는 비교">
    <defs>
      <marker id="uni-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-2)" />
      </marker>
    </defs>

    <text data-id="obj" class="sub l" x="8" y="10">객체 (메모리)</text>
    <g data-id="post">
      <rect class="box" x="8" y="22" width="120" height="78" rx="7" />
      <text x="68" y="46">Post</text>
      <text class="mono" x="68" y="72">comments</text>
    </g>
    <g data-id="c1"><rect class="box" x="192" y="22" width="120" height="34" rx="7" /><text x="252" y="39">Comment 1</text></g>
    <g data-id="c2"><rect class="box" x="192" y="66" width="120" height="34" rx="7" /><text x="252" y="83">Comment 2</text></g>
    <line data-id="ar1" class="line" x1="128" y1="64" x2="190" y2="40" marker-end="url(#uni-arr)" />
    <line data-id="ar2" class="line" x1="128" y1="70" x2="190" y2="83" marker-end="url(#uni-arr)" />
    <text data-id="know" class="sub" x="252" y="114">Post를 모름</text>
    <text data-id="map" class="sub l" x="8" y="114">단방향 · FK는 COMMENT에</text>

    <text data-id="log" class="sub l" x="8" y="140">단방향일 때 나가는 SQL</text>
    <g data-id="q1"><rect class="box" x="8" y="152" width="304" height="30" rx="7" /><text class="mono" x="160" y="167">INSERT Post</text></g>
    <g data-id="q2"><rect class="box" x="8" y="186" width="304" height="30" rx="7" /><text x="160" y="201"><tspan class="mono">INSERT Comment ×2</tspan> · post_id 없음</text></g>
    <g data-id="q3">
      <rect class="err" x="8" y="220" width="304" height="48" rx="7" />
      <text class="mono" x="160" y="235">UPDATE Comment ×2</text>
      <text class="err-t" x="160" y="256" style="font-size:14px">post_id 채우는 추가 쿼리</text>
    </g>
    <text data-id="totU" class="l" x="8" y="284">총 5번 <tspan class="err-t">(UPDATE 2)</tspan></text>

    <text data-id="cmp" class="sub l" x="8" y="310">양방향(@ManyToOne이 주인)이면</text>
    <g data-id="b1"><rect class="box" x="8" y="322" width="304" height="30" rx="7" /><text class="mono" x="160" y="337">INSERT Post</text></g>
    <g data-id="b2"><rect class="chip" x="8" y="356" width="304" height="30" rx="7" /><text x="160" y="371"><tspan class="mono">INSERT Comment ×2</tspan> · post_id 포함</text></g>
    <text data-id="totB" class="l" x="8" y="404">총 3번 <tspan class="hi">(UPDATE 없음)</tspan></text>

    <rect data-id="hl-obj" class="hl" x="4" y="18" width="312" height="104" rx="9" />
    <rect data-id="hl-q1" class="hl" x="4" y="148" width="312" height="38" rx="9" />
    <rect data-id="hl-q2" class="hl" x="4" y="182" width="312" height="38" rx="9" />
    <rect data-id="hl-q3" class="hl" x="4" y="216" width="312" height="56" rx="9" />
    <rect data-id="hl-cmp" class="hl" x="4" y="318" width="312" height="72" rx="9" />
  </svg>
</Stepper>
