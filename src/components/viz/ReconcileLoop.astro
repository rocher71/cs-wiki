---
// 조정 루프: 원하는 상태와 현재 상태를 비교해 차이를 메우고, 다시 관찰로 돌아간다.
import Stepper from '../Stepper.astro';
const base = ['want', 'cur', 'p1', 'p2', 'loop'];
const steps = [
  { caption: '원하는 상태는 Pod 3개, 현재도 3개예요. 차이가 없으니 컨트롤러는 지켜보기만 해요.', show: [...base, 'p3', 'ok', 'hl-watch'] },
  { caption: 'Pod 1개가 죽었어요(노드 고장, 프로세스 종료 등). 현재 상태는 2개가 됐어요.', show: [...base, 'dead', 'hl-watch', 'hl-dead'] },
  { caption: '컨트롤러가 비교해요. 원하는 3개 − 현재 2개 = 1개 부족.', show: [...base, 'dead', 'diff', 'hl-cmp'] },
  { caption: '부족한 1개를 만들어 달라고 API 서버에 요청해요. 그러면 스케줄러가 노드를 고르고, kubelet이 실제로 띄워요.', show: [...base, 'diff', 'pend', 'hl-act'] },
  { caption: '다시 3개가 됐어요. 그래도 루프는 끝나지 않고 다시 관찰로 돌아가요. 누가 시키지 않아도 계속 맞춰요.', show: [...base, 'p3', 'ok', 'hl-watch', 'ret'] },
];
---
<Stepper title="조정 루프: 원하는 상태로 계속 맞추기" steps={steps}>
  <svg class="viz" viewBox="0 0 320 340" role="img" aria-label="원하는 상태 Pod 3개와 현재 상태를 비교하고, 하나가 죽으면 차이만큼 새로 만든 뒤 다시 관찰로 돌아가는 조정 루프">
    <defs>
      <marker id="rl-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    <g data-id="want">
      <rect class="box" x="16" y="12" width="138" height="112" rx="10" />
      <text x="85" y="32" style="font-weight:700">원하는 상태</text>
      <text class="sub" x="85" y="54">spec: replicas 3</text>
      <rect class="chip" x="24" y="76" width="36" height="32" rx="6" /><text x="42" y="92">P</text>
      <rect class="chip" x="67" y="76" width="36" height="32" rx="6" /><text x="85" y="92">P</text>
      <rect class="chip" x="110" y="76" width="36" height="32" rx="6" /><text x="128" y="92">P</text>
    </g>
    <g data-id="cur">
      <rect class="box" x="166" y="12" width="138" height="112" rx="10" />
      <text x="235" y="32" style="font-weight:700">현재 상태</text>
      <text class="sub" x="235" y="54">실제로 도는 Pod</text>
    </g>
    <g data-id="p1"><rect class="chip" x="174" y="76" width="36" height="32" rx="6" /><text x="192" y="92">P</text></g>
    <g data-id="p2"><rect class="chip" x="217" y="76" width="36" height="32" rx="6" /><text x="235" y="92">P</text></g>
    <g data-id="p3" class="hide"><rect class="chip" x="260" y="76" width="36" height="32" rx="6" /><text x="278" y="92">P</text></g>
    <g data-id="dead" class="hide"><rect class="err" x="260" y="76" width="36" height="32" rx="6" /><text class="err-t" x="278" y="92">✕</text></g>
    <g data-id="pend" class="hide"><rect class="bad" x="260" y="76" width="36" height="32" rx="6" /><text class="sub" x="278" y="92">+1</text></g>

    <g data-id="ok" class="hide">
      <rect class="box" x="16" y="140" width="288" height="44" rx="10" />
      <text x="160" y="162">3 = 3, 차이 없음</text>
    </g>
    <g data-id="diff" class="hide">
      <rect class="err" x="16" y="140" width="288" height="44" rx="10" />
      <text class="err-t" x="160" y="162">원하는 3 − 현재 2 = 1개 부족</text>
    </g>

    <g data-id="loop">
      <rect class="box" x="16" y="216" width="84" height="44" rx="8" /><text x="58" y="238">① 관찰</text>
      <rect class="box" x="118" y="216" width="84" height="44" rx="8" /><text x="160" y="238">② 비교</text>
      <rect class="box" x="220" y="216" width="84" height="44" rx="8" /><text x="262" y="238">③ 조치</text>
      <line class="line" x1="102" y1="238" x2="116" y2="238" marker-end="url(#rl-arr)" />
      <line class="line" x1="204" y1="238" x2="218" y2="238" marker-end="url(#rl-arr)" />
      <path class="line" d="M262 262 V300 H58 V264" marker-end="url(#rl-arr)" />
      <text class="sub" x="160" y="316">다시 관찰 (끝나지 않음)</text>
    </g>
    <path data-id="ret" class="hl hide" d="M262 262 V300 H58 V266" />

    <rect data-id="hl-watch" class="hl" x="12" y="212" width="92" height="52" rx="10" />
    <rect data-id="hl-cmp" class="hl" x="114" y="212" width="92" height="52" rx="10" />
    <rect data-id="hl-act" class="hl" x="216" y="212" width="92" height="52" rx="10" />
    <rect data-id="hl-dead" class="hl" x="256" y="72" width="44" height="40" rx="8" />
  </svg>
</Stepper>
