---
// 두 Aspect의 어드바이스 실행 순서(양파): @Order(1) 재시도가 바깥, @Order(2) 로깅이 안쪽. 들어갈 땐 1→2, 나올 땐 2→1
import Stepper from '../Stepper.astro';
const base = ['ctrl', 'proxy', 'outer', 'inner', 'core'];
const steps = [
  { caption: 'Controller가 orderService.order()를 부르면 실제로 받는 건 프록시예요. 프록시 안에 Aspect 두 개가 양파 껍질처럼 겹쳐 있어요.', show: [...base, 'call', 'hl-call'] },
  { caption: '@Order 값이 작을수록 우선순위가 높아 바깥 껍질이에요. @Order(1) 재시도 Aspect의 Around가 가장 먼저 시작해요.', show: [...base, 'call', 'oIn', 'hl-oIn'] },
  { caption: '다음은 @Order(2) 로깅 Aspect예요. 같은 Aspect 안에서는 Around 전반이 먼저, 그다음 Before가 실행돼요.', show: [...base, 'call', 'oIn', 'iIn', 'hl-iIn'] },
  { caption: '가장 안쪽에서 진짜 order()가 실행돼요. Around가 proceed()를 불러야 여기까지 와요.', show: [...base, 'call', 'oIn', 'iIn', 'hl-core'] },
  { caption: '정상이면 AfterReturning → After → Around 후반 순서로 안쪽 껍질을 빠져나와요. 예외면 AfterThrowing → After를 거쳐 예외가 바깥으로 전파돼요.', show: [...base, 'call', 'oIn', 'iIn', 'iOut', 'iErr', 'hl-iOut'] },
  { caption: '바깥 재시도 Aspect의 Around 후반이에요. 성공이면 결과를 돌려주고, 예외면 proceed()를 다시 불러 2단계부터 재시도해요.', show: [...base, 'call', 'oIn', 'iIn', 'iOut', 'iErr', 'oOut', 'retry', 'hl-oOut'] },
  { caption: '프록시가 Controller에 결과를 돌려줘요. 핵심: 들어갈 땐 order 값이 작은 Aspect가 먼저, 나올 땐 그 Aspect가 마지막이에요.', show: [...base, 'call', 'oIn', 'iIn', 'iOut', 'iErr', 'oOut', 'retry', 'ret', 'key', 'hl-ret'] },
];
---
<Stepper title="어드바이스 실행 순서 (양파 구조)" steps={steps}>
  <svg class="viz" viewBox="0 0 320 512" role="img" aria-label="Controller의 order 호출을 프록시가 받아 @Order(1) 재시도 Aspect의 Around, @Order(2) 로깅 Aspect의 Around 전반과 Before를 거쳐 진짜 order가 실행되고, AfterReturning, After, Around 후반을 거쳐 나온 뒤 바깥 Around 후반에서 성공이면 반환, 예외면 재시도하는 그림">
    <defs>
      <marker id="ao-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
      <marker id="ao-arr-r" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-red)" />
      </marker>
    </defs>

    <g data-id="ctrl">
      <rect class="box" x="90" y="8" width="140" height="36" rx="8" />
      <text x="160" y="26" style="font-weight:700">Controller</text>
    </g>
    <g data-id="call">
      <line class="line" x1="120" y1="46" x2="120" y2="78" marker-end="url(#ao-arr)" />
      <text class="mono l" x="128" y="62">order()</text>
    </g>
    <g data-id="ret" class="hide">
      <line class="line" x1="214" y1="78" x2="214" y2="46" marker-end="url(#ao-arr)" />
      <text class="l hi" x="222" y="62">결과 반환</text>
    </g>

    <g data-id="proxy">
      <rect class="frame" x="6" y="80" width="308" height="392" rx="12" />
      <text x="160" y="96" style="font-weight:700">OrderService 프록시</text>
    </g>
    <g data-id="outer">
      <rect class="chip" x="16" y="108" width="288" height="354" rx="10" />
      <text x="160" y="124" style="font-weight:700">@Order(1) 재시도 Aspect</text>
    </g>
    <text data-id="oIn" class="l" x="28" y="146">Around 시작 (시도)</text>

    <g data-id="inner">
      <rect class="box" x="32" y="160" width="256" height="236" rx="8" />
      <text x="160" y="176" style="font-weight:700">@Order(2) 로깅 Aspect</text>
    </g>
    <g data-id="iIn">
      <text class="l" x="44" y="198">Around 전반</text>
      <text class="l" x="44" y="220">Before</text>
    </g>
    <g data-id="core">
      <rect class="chip" x="52" y="236" width="216" height="38" rx="8" />
      <text x="160" y="255" style="font-weight:700">진짜 order() 실행</text>
    </g>
    <g data-id="iOut">
      <text class="l" x="44" y="292">AfterReturning</text>
      <text class="l" x="44" y="314">After</text>
      <text class="l" x="44" y="336">Around 후반</text>
    </g>
    <g data-id="iErr" class="hide">
      <text class="err-t l" x="44" y="362">예외면: AfterThrowing → After</text>
      <text class="err-t l" x="44" y="382">→ 예외를 바깥으로 전파</text>
    </g>
    <g data-id="oOut">
      <text class="l" x="28" y="418">Around 후반: 성공 → 반환</text>
    </g>
    <g data-id="retry" class="hide">
      <text class="err-t l" x="28" y="442">예외 → 다시 시도</text>
      <path d="M156 442 H296 V146 H190" style="stroke:var(--sl-color-red);stroke-width:1.6;fill:none" marker-end="url(#ao-arr-r)" />
    </g>
    <text data-id="key" class="hi hide" x="160" y="494">들어갈 땐 1 → 2, 나올 땐 2 → 1</text>

    <rect data-id="hl-call" class="hl" x="84" y="4" width="152" height="74" rx="10" />
    <rect data-id="hl-oIn" class="hl" x="22" y="133" width="276" height="26" rx="6" />
    <rect data-id="hl-iIn" class="hl" x="38" y="185" width="244" height="48" rx="6" />
    <rect data-id="hl-core" class="hl" x="46" y="230" width="228" height="50" rx="10" />
    <rect data-id="hl-iOut" class="hl" x="38" y="279" width="244" height="112" rx="6" />
    <rect data-id="hl-oOut" class="hl" x="22" y="403" width="276" height="54" rx="6" />
    <rect data-id="hl-ret" class="hl" x="84" y="4" width="196" height="74" rx="10" />
  </svg>
</Stepper>
