---
// 재연결 동기화: lastSeq 기억 → 끊긴 동안 DB에 쌓임(실시간분은 유실) → 랜덤 대기 후 다른 서버로 재연결 → "103 다음부터" → DB에서 채움 → 실시간 중복은 순번으로 버림.
import Stepper from '../Stepper.astro';
const steps = [
  { caption: 'B는 방 42에서 #103까지 받았어요. 앱은 "마지막으로 받은 번호(lastSeq) = 103"을 기억해 둬요.', show: ['base', 'ws', 'seq103', 'm103'] },
  { caption: '지하철에서 연결이 끊겼어요. 그동안 #104, #105는 DB에 저장되지만, Pub/Sub로 보낸 실시간 알림은 받을 B가 없어서 그냥 사라져요.', show: ['base', 'cut', 'seq103', 'm103', 'm104'] },
  { caption: 'B는 바로 다시 붙지 않고 무작위로 조금 기다린 뒤 붙어요. 이번엔 다른 서버(서버3)에 연결됐어요.', show: ['base', 'cut', 'seq103', 'm103', 'm104', 'recon'] },
  { caption: 'B가 "방 42, 103 다음부터 줘"라고 요청해요. 어느 서버에 붙든 lastSeq만 있으면 돼요.', show: ['base', 'cut', 'seq103', 'm103', 'm104', 'recon', 'req'] },
  { caption: '서버3이 DB에서 #104, #105를 꺼내 보내 줘요. 끊긴 동안 놓친 메시지가 빈틈없이 채워지고, lastSeq는 105가 돼요.', show: ['base', 'cut', 'seq105', 'm103', 'm104', 'recon', 'req', 'fill'] },
  { caption: '같은 #105가 실시간 경로로도 한 번 더 올 수 있어요. B는 순번이 lastSeq(105) 이하라서 이미 받은 것으로 보고 버려요.', show: ['base', 'cut', 'seq105', 'm103', 'm104', 'recon', 'req', 'fill', 'dup'] },
];
const halo = 'paint-order:stroke;stroke:var(--sl-color-gray-7, var(--sl-color-black));stroke-width:5px;stroke-linejoin:round';
const acc = 'stroke:var(--sl-color-accent);stroke-width:2.4;fill:none';
---
<Stepper title="다시 연결되면 빠진 메시지 채우기" steps={steps}>
  <svg class="viz" viewBox="0 0 320 380" role="img" aria-label="B가 마지막으로 받은 순번 103을 기억하고, 끊긴 동안 104와 105가 DB에 쌓이며, 다른 서버로 재연결해 103 다음부터 요청해 받아 오고, 실시간으로 중복 도착한 105는 버리는 순서도">
    <defs>
      <marker id="crs-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
    </defs>
    <g data-id="base">
      <rect class="box" x="10" y="6" width="100" height="54" rx="8" />
      <text x="60" y="22" style="font-weight:700">B</text>
      <line class="line" x1="60" y1="62" x2="60" y2="276" style="stroke-dasharray:4 4" />
      <rect class="box" x="210" y="6" width="100" height="40" rx="8" />
      <text x="260" y="26" style="font-weight:700">서버2</text>
      <rect class="box" x="210" y="110" width="100" height="150" rx="8" />
      <text x="260" y="128" style="font-weight:700">서버3</text>
      <rect class="box" x="10" y="296" width="300" height="76" rx="8" />
      <text x="160" y="312" style="font-weight:700">메시지 DB (방 42)</text>
    </g>
    <g data-id="ws" class="hide">
      <line x1="110" y1="26" x2="210" y2="26" style={acc} />
      <text class="sub" x="160" y="14">WebSocket</text>
    </g>
    <g data-id="cut" class="hide">
      <line class="line" x1="110" y1="26" x2="210" y2="26" style="stroke-dasharray:5 4" />
      <text class="err-t" x="160" y="26" style={halo}>✕ 끊김</text>
      <text class="err-t" x="310" y="64" style={`text-anchor:end;font-size:14px;${halo}`}>실시간 #104·#105 유실</text>
    </g>
    <g data-id="seq103" class="hide">
      <text class="mono" x="60" y="44">lastSeq=103</text>
    </g>
    <g data-id="seq105" class="hide">
      <text class="mono hi" x="60" y="44">lastSeq=105</text>
    </g>
    <g data-id="m103">
      <rect class="box" x="24" y="330" width="80" height="30" rx="5" />
      <text class="mono" x="64" y="345">#103</text>
    </g>
    <g data-id="m104" class="hide">
      <rect class="chip" x="120" y="330" width="80" height="30" rx="5" />
      <text class="mono" x="160" y="345">#104</text>
      <rect class="chip" x="216" y="330" width="80" height="30" rx="5" />
      <text class="mono" x="256" y="345">#105</text>
    </g>
    <g data-id="recon" class="hide">
      <line x1="60" y1="148" x2="206" y2="148" style={acc} marker-end="url(#crs-a)" />
      <text class="hi" x="134" y="136" style={halo}>랜덤 대기 후 재연결</text>
    </g>
    <g data-id="req" class="hide">
      <line x1="60" y1="186" x2="206" y2="186" style={acc} marker-end="url(#crs-a)" />
      <text class="mono" x="134" y="174" style={halo}>after=103</text>
    </g>
    <g data-id="fill" class="hide">
      <line x1="260" y1="292" x2="260" y2="264" style={acc} marker-end="url(#crs-a)" />
      <text class="sub" x="252" y="278" style={`text-anchor:end;${halo}`}>조회</text>
      <line x1="208" y1="224" x2="64" y2="224" style={acc} marker-end="url(#crs-a)" />
      <text class="hi" x="134" y="212" style={halo}>#104, #105</text>
    </g>
    <g data-id="dup" class="hide">
      <line class="line" x1="208" y1="252" x2="64" y2="252" style="stroke-dasharray:5 4" />
      <text class="sub" x="134" y="240" style={halo}>실시간 #105 또 옴</text>
      <text class="err-t l" x="66" y="270" style={`font-size:14px;${halo}`}>이미 받음 → 버림</text>
    </g>
  </svg>
</Stepper>
