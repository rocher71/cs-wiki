---
// 10초 칸 A(0~10초)·B(10~20초), 한도 5. 9.5초에 5건, 10.5초에 5건.
// 고정 윈도: 둘 다 통과 → 약 1초에 10건(2N). 슬라이딩 윈도 카운터(10.5초): A 5건 × (10-0.5)/10 = 4.75,
// 추정 = 4.75 + B 이미 통과 수, 5 미만이면 통과(본문 Cloudflare 예시와 같은 규칙) → B 1번째 통과(4.75), 2번째부터 거절(5.75).
// 같은 자리에 번갈아 나오는 카운터·B 점·아래 패널은 class="hide".
import Stepper from '../Stepper.astro';

const X0 = 10, PX = 15; // 1초 = 15px, 0~20초
const tx = (t: number) => X0 + t * PX;
const XA = tx(9.5), XB = tx(10.5) + 4; // ponytail: 15px 간격이라 점 테두리가 붙어서 4px 띄움
const dy = (i: number) => 184 - i * 17;
const I5 = [0, 1, 2, 3, 4];
const steps = [
  { caption: '시간을 10초 칸 A(0~10초), B(10~20초)로 잘랐어요. 한도는 "10초 칸마다 5건"이고, 칸마다 카운터 하나로 개수를 세요.', show: ['cA0', 'cB0', 'p1'] },
  { caption: '칸 A가 끝나기 직전(9.5초)에 요청 5건이 몰렸어요. 카운터 A가 5가 됐고, 한도 안이라 모두 통과해요.', show: ['dA', 'cA5', 'cB0', 'p2'] },
  { caption: '10초에 칸 B가 시작되며 카운터가 0부터 다시 세요. 10.5초에 온 5건도 모두 통과. 9.5~10.5초, 약 1초 사이에 10건이 지나갔어요. 한도의 2배(2N)예요.', show: ['dA', 'cA5', 'dBok', 'cB5', 'hlB', 'twice', 'p3'] },
  { caption: '같은 상황을 슬라이딩 윈도 카운터로 다시 봐요. 10.5초 기준 "최근 10초" 창은 0.5~10.5초라서 칸 A와 9.5초만큼 겹쳐요. A의 5건 중 0.95 비율만큼, 4.75건을 이미 쓴 걸로 쳐요.', show: ['dA', 'cA5', 'dBq', 'cB0', 'slide', 'p4'] },
  { caption: 'B 첫 요청: 4.75 + 0 = 4.75 < 5라 통과. 둘째부터는 4.75 + 1 = 5.75 ≥ 5라 거절이에요. 경계 근처 통과가 10건에서 6건으로 줄었어요. 근사라서 1건이 더 들어왔지만, 요청 시각을 다 기록하는 로그 방식이면 정확히 5건에서 막혀요.', show: ['dA', 'cA5', 'dBs', 'cB1', 'slide', 'p5'] },
];
const counters = [
  { id: 'cA0', x: tx(5), t: 'A 카운터 0' }, { id: 'cA5', x: tx(5), t: 'A 카운터 5' },
  { id: 'cB0', x: tx(15), t: 'B 카운터 0' }, { id: 'cB5', x: tx(15), t: 'B 카운터 5' }, { id: 'cB1', x: tx(15), t: 'B 카운터 1' },
];
---
<Stepper title="고정 윈도 경계 2배 vs 슬라이딩 윈도 카운터" steps={steps}>
  <svg class="viz" viewBox="0 0 320 380" role="img" aria-label="10초당 5건 한도. 고정 윈도는 칸 A 끝 9.5초의 5건과 칸 B 시작 10.5초의 5건을 모두 통과시켜 약 1초에 10건이 지나간다. 슬라이딩 윈도 카운터는 A 5건에 겹침 비율 0.95를 곱한 4.75를 더해 B의 첫 요청만 통과시키고 나머지를 거절한다.">
    <text class="l" x="8" y="14" style="font-weight:700">한도: 10초에 5건</text>

    {[['A', 0, '0~10초'], ['B', 10, '10~20초']].map(([n, t, r]) => (
      <g>
        <rect class="frame" x={tx(+t)} y="30" width={10 * PX} height="176" rx="6" />
        <text x={tx(+t + 5)} y="46" style="font-weight:700">칸 {n}</text>
        <text class="sub" x={tx(+t + 5)} y="66">{r}</text>
      </g>
    ))}
    <rect data-id="hlB" class="hl hide" x={tx(10)} y="30" width={10 * PX} height="176" rx="6" />
    <rect data-id="slide" class="hl hide" x={tx(0.5)} y="24" width={XB + 10 - tx(0.5)} height="188" rx="8" />

    {counters.map((c) => (
      <g data-id={c.id} class="hide">
        <rect class="chip" x={c.x - 52} y="80" width="104" height="26" rx="13" />
        <text x={c.x} y="93" style="font-size:14px">{c.t}</text>
      </g>
    ))}

    <!-- 요청 점 -->
    <g data-id="dA">
      {I5.map((i) => <circle class="badge" cx={XA} cy={dy(i)} r="7" />)}
      <text class="l" x="56" y={dy(2)}>통과 5 →</text>
    </g>
    <g data-id="dBok" class="hide">
      {I5.map((i) => <circle class="badge" cx={XB} cy={dy(i)} r="7" />)}
      <text class="l" x={XB + 14} y={dy(2)}>← 통과 5</text>
    </g>
    <g data-id="dBq" class="hide">
      {I5.map((i) => <circle class="box" cx={XB} cy={dy(i)} r="7" />)}
      <text class="l sub" x={XB + 14} y={dy(2)}>← 판단 중</text>
    </g>
    <g data-id="dBs" class="hide">
      <circle class="badge" cx={XB} cy={dy(0)} r="7" />
      <text class="l" x={XB + 14} y={dy(0)}>← 1번째 통과</text>
      {I5.slice(1).map((i) => <circle class="err" cx={XB} cy={dy(i)} r="7" />)}
      <text class="l err-t" x={XB + 14} y={dy(3)}>← 2~5번째 거절</text>
    </g>

    <!-- 시간축 -->
    <line class="line" x1={tx(0)} y1="218" x2={tx(20)} y2="218" />
    {[0, 5, 10, 15, 20].map((t) => (
      <g>
        <line class="line" x1={tx(t)} y1="214" x2={tx(t)} y2="222" />
        <text class="sub" x={Math.min(tx(t), 298)} y="236">{t}초</text>
      </g>
    ))}
    <line x1={tx(10)} y1="24" x2={tx(10)} y2="224" style="stroke:var(--sl-color-gray-2);stroke-width:2;stroke-dasharray:3 3" />

    <g data-id="twice" class="hide">
      <path d={`M${XA} 246 V254 H${XB} V246`} style="fill:none;stroke:var(--sl-color-accent);stroke-width:2.2" />
    </g>

    <!-- 아래 패널 (같은 자리, 번갈아) -->
    <g data-id="p1" class="hide">
      <rect class="box" x="6" y="266" width="308" height="108" rx="8" />
      <text x="160" y="296">고정 윈도 카운터</text>
      <text class="sub" x="160" y="324">칸이 바뀌면 카운터가 0부터</text>
    </g>
    <g data-id="p2" class="hide">
      <rect class="box" x="6" y="266" width="308" height="108" rx="8" />
      <text x="160" y="296">9.5초: 5건 통과</text>
      <text class="sub" x="160" y="324">A 카운터 5 = 한도 꽉 참</text>
    </g>
    <g data-id="p3" class="hide">
      <rect class="err" x="6" y="266" width="308" height="108" rx="8" />
      <text x="160" y="292">10초: B 카운터 0으로 새로</text>
      <text x="160" y="320">10.5초: 5건 또 통과</text>
      <text class="err-t" x="160" y="350">약 1초에 10건 = 한도 2배</text>
    </g>
    <g data-id="p4" class="hide">
      <rect class="box" x="6" y="266" width="308" height="108" rx="8" />
      <text x="160" y="290">지금 10.5초 · 창 0.5~10.5초</text>
      <text x="160" y="318">A와 겹침 = 9.5 / 10 = 0.95</text>
      <text class="hi" x="160" y="348">A 몫 = 5 × 0.95 = 4.75</text>
    </g>
    <g data-id="p5" class="hide">
      <rect class="chip" x="6" y="266" width="308" height="108" rx="8" />
      <text x="160" y="290">1번째: 4.75 + 0 = 4.75 → 통과</text>
      <text x="160" y="318">2번째: 4.75 + 1 = <tspan class="err-t">5.75 → 거절</tspan></text>
      <text class="hi" x="160" y="348">경계 근처 10건 → 6건</text>
    </g>
  </svg>
</Stepper>
