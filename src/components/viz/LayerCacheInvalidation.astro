---
// 레이어 순서와 빌드 캐시. 위: 나쁜 순서(COPY . . 이 먼저) → 앱 수정 시 pip install까지 다시. 아래: 좋은 순서 → COPY . .만 다시.
// 레이어는 아래에서 위로 쌓인다(맨 아래가 FROM). CMD는 설정값이라 상태 칸을 두지 않는다.
import Stepper from '../Stepper.astro';
const bad = ['CMD python app.py', 'RUN pip install', 'COPY . .', 'WORKDIR /app', 'FROM python:3.12-slim'];
const good = ['CMD python app.py', 'COPY . .', 'RUN pip install', 'COPY requirements.txt .', 'WORKDIR /app', 'FROM python:3.12-slim'];
const by = (i: number) => 28 + i * 32;
const gy = (i: number) => 250 + i * 32;
// 상태 칸: [data-id, y, 다시 실행 여부]
const st = (id: string, y: number, redo: boolean) => ({ id, y, redo });
const status = [
  st('b-redo', by(1), true), st('b-redo', by(2), true), st('b-cached', by(3), false), st('b-cached', by(4), false),
  st('g-redo', gy(1), true), st('g-cached', gy(2), false), st('g-cached', gy(3), false), st('g-cached', gy(4), false), st('g-cached', gy(5), false),
];
const steps = [
  { caption: '나쁜 순서예요. 레이어는 아래(FROM)부터 위로 쌓여요. 소스 전체를 복사(COPY . .)한 다음에 라이브러리를 설치해요.', show: ['bad'] },
  { caption: 'app.py를 한 글자 고치면, 소스를 복사하는 COPY . . 레이어의 내용이 달라져서 캐시가 깨져요.', show: ['bad', 'b-edit', 'b-copy'] },
  { caption: '한 칸이 깨지면 그 위 칸은 전부 다시 만들어요. 코드만 고쳤는데 pip install까지 다시 돌아서 1.78초가 걸렸어요.', show: ['bad', 'b-edit', 'b-redo', 'b-cached', 'b-time'] },
  { caption: '좋은 순서예요. 잘 안 바뀌는 requirements.txt만 먼저 복사해 설치하고, 자주 바뀌는 소스는 맨 나중에 복사해요.', show: ['bad', 'b-redo', 'b-cached', 'b-time', 'good'] },
  { caption: '같은 수정을 해도 설치까지는 CACHED로 재사용하고 COPY . .만 다시 해요. 0.22초로 줄었어요. 자주 바뀌는 것일수록 위에 두는 게 요령이에요.', show: ['bad', 'b-redo', 'b-cached', 'b-time', 'good', 'g-edit', 'g-redo', 'g-cached', 'g-time'] },
];
---
<Stepper title="레이어 순서가 빌드 캐시를 가른다" steps={steps}>
  <svg class="viz" viewBox="0 0 320 476" role="img" aria-label="나쁜 순서 Dockerfile은 app.py 수정 시 COPY . . 과 그 위 RUN pip install까지 다시 실행해 1.78초, 좋은 순서는 requirements.txt 복사와 설치가 캐시되어 COPY . . 만 다시 실행해 0.22초">
    <!-- 나쁜 순서 -->
    <g data-id="bad">
      <text class="l" x="4" y="12" style="font-weight:700">나쁜 순서</text>
      {bad.map((t, i) => (
        <g>
          <rect class="box" x="4" y={by(i)} width="232" height="28" rx="4" />
          <text class="mono l" x="12" y={by(i) + 14}>{t}</text>
        </g>
      ))}
    </g>
    <text data-id="b-edit" class="err-t hide" x="316" y="12" style="text-anchor:end;font-size:14px">app.py 한 글자 수정</text>
    <g data-id="b-copy" class="hide">
      <rect class="err" x="240" y={by(2)} width="76" height="28" rx="4" />
      <text class="err-t" x="278" y={by(2) + 14} style="font-size:14px">깨짐</text>
    </g>
    <text data-id="b-time" class="err-t hide" x="4" y="200" style="text-anchor:start">빌드 1.78초 (pip install 다시)</text>

    <!-- 좋은 순서 -->
    <g data-id="good" class="hide">
      <text class="l" x="4" y="234" style="font-weight:700">좋은 순서</text>
      {good.map((t, i) => (
        <g>
          <rect class="box" x="4" y={gy(i)} width="232" height="28" rx="4" />
          <text class="mono l" x="12" y={gy(i) + 14}>{t}</text>
        </g>
      ))}
    </g>
    <text data-id="g-edit" class="err-t hide" x="316" y="234" style="text-anchor:end;font-size:14px">같은 수정</text>
    <text data-id="g-time" class="ok-t hide" x="4" y="458" style="text-anchor:start">빌드 0.22초 (설치는 재사용)</text>

    <!-- 상태 칸 -->
    {status.map((s) => (
      <g data-id={s.id} class="hide">
        <rect class={s.redo ? 'err' : 'ok'} x="240" y={s.y} width="76" height="28" rx="4" />
        <text class={s.redo ? 'err-t' : 'ok-t mono'} x="278" y={s.y + 14} style="font-size:14px">{s.redo ? '다시 실행' : 'CACHED'}</text>
      </g>
    ))}
  </svg>
</Stepper>

<style>
  svg.viz .ok { fill: var(--sl-color-green-low); stroke: var(--sl-color-green); stroke-width: 1.4; }
  svg.viz text.ok-t { fill: var(--sl-color-green-high); font-weight: 700; }
</style>
