---
// 스프링 컨테이너 시작: 설정 읽기 → 싱글톤 미리 생성 → 같은 타입 후보 고르기 → 준비 완료
import Stepper from '../Stepper.astro';
const steps = [
  { caption: '설정을 읽어요. @ComponentScan으로 @Component 클래스를 찾고, @Configuration 안의 @Bean 메서드도 모아 "빈 정의 목록"(설계도)을 만들어요.', show: ['scan', 'bean', 'toDefs', 'defs'] },
  { caption: '싱글톤 빈은 시작할 때 미리 만들어요. OrderService는 Pay가 필요하니, 의존하는 kakao·toss 빈을 먼저 만들고 그다음 생성자를 호출해요.', show: ['scan', 'bean', 'toDefs', 'defs', 'toCtr', 'ctr', 'beans', 'order', 'nums'] },
  { caption: 'Pay 타입 후보가 kakao, toss 두 개예요. @Qualifier → @Primary → 이름 일치 순으로 하나를 고르고, 다 없으면 NoUniqueBeanDefinitionException으로 시작이 실패해요.', show: ['scan', 'bean', 'toDefs', 'defs', 'toCtr', 'ctr', 'beans', 'order', 'ask', 'rules', 'hl-rules'] },
  { caption: '예를 들어 toss에 @Primary가 있으면 toss가 OrderService에 들어가요. 모든 빈이 만들어지고 연결되면 초기화가 끝나고, 앱이 요청을 받을 준비가 돼요.', show: ['scan', 'bean', 'toDefs', 'defs', 'toCtr', 'ctr', 'beans', 'order', 'pick', 'ready', 'hl-ready'] },
];
---
<Stepper title="스프링 컨테이너가 시작될 때" steps={steps}>
  <svg class="viz" viewBox="0 0 320 476" role="img" aria-label="설정에서 빈 정의 목록을 만들고, 컨테이너가 싱글톤 빈을 의존 순서대로 미리 만들고, 같은 타입 후보 중 하나를 골라 주입한 뒤 앱이 준비되는 그림">
    <defs>
      <marker id="cs-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    <g data-id="scan">
      <rect class="box" x="16" y="16" width="140" height="52" rx="8" />
      <text x="86" y="34">@Component</text>
      <text class="sub" x="86" y="54">스캔으로 찾기</text>
    </g>
    <g data-id="bean">
      <rect class="box" x="164" y="16" width="140" height="52" rx="8" />
      <text x="234" y="34">@Bean 메서드</text>
      <text class="sub" x="234" y="54">@Configuration 안</text>
    </g>
    <g data-id="toDefs">
      <line class="line" x1="86" y1="70" x2="130" y2="98" marker-end="url(#cs-arr)" />
      <line class="line" x1="234" y1="70" x2="190" y2="98" marker-end="url(#cs-arr)" />
    </g>
    <g data-id="defs">
      <rect class="chip" x="60" y="100" width="200" height="40" rx="8" />
      <text x="160" y="120">빈 정의 목록 (설계도)</text>
    </g>

    <g data-id="toCtr" class="hide">
      <line class="line" x1="160" y1="142" x2="160" y2="172" marker-end="url(#cs-arr)" />
    </g>
    <g data-id="ctr" class="hide">
      <rect class="frame" x="16" y="176" width="288" height="140" rx="10" />
      <text x="160" y="194" style="font-weight:700">컨테이너: 싱글톤 미리 생성</text>
    </g>
    <g data-id="beans" class="hide">
      <rect class="box" x="32" y="210" width="112" height="40" rx="8" />
      <text x="88" y="230">kakao 빈</text>
      <rect class="box" x="176" y="210" width="112" height="40" rx="8" />
      <text x="232" y="230">toss 빈</text>
    </g>
    <g data-id="order" class="hide">
      <rect class="box" x="76" y="270" width="168" height="36" rx="8" />
      <text x="160" y="288">OrderService(Pay)</text>
    </g>
    <g data-id="nums" class="hide">
      <circle class="badge" cx="32" cy="210" r="11" /><text class="on-badge" x="32" y="211">1</text>
      <circle class="badge" cx="176" cy="210" r="11" /><text class="on-badge" x="176" y="211">2</text>
      <circle class="badge" cx="76" cy="270" r="11" /><text class="on-badge" x="76" y="271">3</text>
    </g>
    <g data-id="ask" class="hide">
      <line class="line" x1="100" y1="252" x2="128" y2="268" stroke-dasharray="4 3" />
      <line class="line" x1="220" y1="252" x2="192" y2="268" stroke-dasharray="4 3" />
      <text class="err-t" x="160" y="256">?</text>
    </g>
    <g data-id="pick" class="hide">
      <line class="line" x1="220" y1="252" x2="194" y2="268" marker-end="url(#cs-arr)" style="stroke-width:2.4" />
      <text class="sub l" x="228" y="262">@Primary</text>
    </g>

    <g data-id="rules" class="hide">
      <rect class="box" x="16" y="330" width="288" height="136" rx="10" />
      <text class="l" x="30" y="350" style="font-weight:700">후보가 여럿이면 이 순서로</text>
      <text class="l" x="30" y="376">1. @Qualifier 지정</text>
      <text class="l" x="30" y="398">2. @Primary 붙은 빈</text>
      <text class="l" x="30" y="420">3. 이름 일치 (Pay toss)</text>
      <text class="l err-t" x="30" y="442">4. 다 없으면 시작 실패</text>
      <text class="sub l" x="30" y="460">NoUniqueBeanDefinitionException</text>
    </g>
    <g data-id="ready" class="hide">
      <rect class="chip" x="16" y="330" width="288" height="52" rx="10" />
      <text x="160" y="349" style="font-weight:700">초기화 끝, 앱 준비 완료</text>
      <text class="sub" x="160" y="369">이제 요청을 받기 시작해요</text>
    </g>

    <rect data-id="hl-rules" class="hl" x="12" y="326" width="296" height="144" rx="12" />
    <rect data-id="hl-ready" class="hl" x="12" y="326" width="296" height="60" rx="12" />
  </svg>
</Stepper>
