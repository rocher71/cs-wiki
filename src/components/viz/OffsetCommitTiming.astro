---
// 오프셋 커밋 시점에 따른 전달 보장 4단계: poll 10~14 → 먼저 커밋(최대 한 번, 유실) → 처리 후 커밋(최소 한 번, 중복·멱등 처리) → 트랜잭션(정확히 한 번, Kafka→Kafka).
// 같은 자리에 번갈아 나오는 칸 상태 줄·커밋 표시·아래 설명 패널은 class="hide".
import Stepper from '../Stepper.astro';

const steps = [
  { caption: '소비자가 poll()로 오프셋 10~14 다섯 건을 한꺼번에 가져왔어요. 커밋(“여기까지 읽었다” 기록)은 아직 10이에요. 이제 언제 커밋하느냐가 문제예요.', show: ['r1', 'm10', 'hlAll', 'p1'] },
  { caption: '최대 한 번(at-most-once): 처리 전에 15를 먼저 커밋했는데 12를 처리하다 죽었어요. 재시작하면 15부터 읽으니 12~14는 영영 처리되지 않아요(유실).', show: ['r2', 'm15', 'p2'] },
  { caption: '최소 한 번(at-least-once): 10~14를 다 처리했지만 커밋 직전에 죽었어요. 재시작하면 10부터 다시 읽어 10~14가 중복 처리돼요. 처리한 ID를 기록해 두고 이미 한 건 건너뛰면(멱등 소비자) 안전해요.', show: ['r3', 'm10', 'p3'] },
  { caption: '정확히 한 번(exactly-once): Kafka에서 읽어 Kafka에 쓸 때만, 결과 메시지 쓰기와 오프셋 커밋을 한 트랜잭션으로 묶어요. 둘 다 반영되거나 둘 다 취소돼요. 외부 DB·메일까지 묶어 주지는 않아요.', show: ['r4', 'm15', 'p4'] },
];
// 칸 x = 16 + 54i (폭 48), 커밋 15 자리 x 286
const X = [0, 1, 2, 3, 4].map((i) => 16 + i * 54);
type C = { cls: string; t: string; tc?: string };
const ok: C = { cls: 'chip', t: '처리' };
const plain: C = { cls: 'box', t: '' };
const lost: C = { cls: 'err', t: '유실', tc: 'err-t' };
const dup: C = { cls: 'bad', t: '중복', tc: 'hi' };
const variants: Record<string, C[]> = {
  r1: [plain, plain, plain, plain, plain],
  r2: [ok, ok, { cls: 'err', t: '죽음', tc: 'err-t' }, lost, lost],
  r3: [dup, dup, dup, dup, dup],
  r4: [ok, ok, ok, ok, ok],
};
---
<Stepper title="오프셋을 언제 커밋하나: 유실 vs 중복" steps={steps}>
  <svg class="viz" viewBox="0 0 320 330" role="img" aria-label="파티션의 오프셋 10부터 14까지 다섯 칸과 커밋 위치 표시. 먼저 커밋하면 12에서 죽었을 때 12~14가 유실되고, 처리 후 커밋하면 커밋 직전에 죽었을 때 10~14가 중복된다. 정확히 한 번은 결과 쓰기와 오프셋 커밋을 한 트랜잭션으로 묶는다.">
    <text class="l" x="8" y="12" style="font-weight:700">파티션 P0</text>

    <!-- 오프셋 칸 (기본 틀) -->
    {X.map((x, i) => <><rect class="box" x={x} y="26" width="48" height="48" rx="4" /><text x={x + 24} y="42" style="font-weight:700">{10 + i}</text></>)}
    <rect class="frame" x="286" y="26" width="30" height="48" rx="4" /><text class="sub" x="301" y="42">15</text>

    <!-- 단계별 칸 상태 -->
    {Object.entries(variants).map(([id, cs]) => (
      <g data-id={id} class="hide">
        {cs.map((c, i) => <>
          <rect class={c.cls} x={X[i]} y="26" width="48" height="48" rx="4" />
          <text x={X[i] + 24} y="42" style="font-weight:700">{10 + i}</text>
          {c.t && <text class={c.tc ?? 'sub'} x={X[i] + 24} y="62">{c.t}</text>}
        </>)}
      </g>
    ))}
    <rect data-id="hlAll" class="hl" x="12" y="22" width="268" height="56" rx="8" />

    <!-- 커밋 위치 표시 -->
    <g data-id="m10" class="hide"><path d="M40 82 L33 94 H47 Z" class="badge" /><text class="hi" x="40" y="106">커밋 10</text></g>
    <g data-id="m15" class="hide"><path d="M301 82 L294 94 H308 Z" class="badge" /><text class="hi" x="290" y="106">커밋 15</text></g>

    <!-- 아래 설명 패널 (같은 자리, 번갈아) -->
    <g data-id="p1" class="hide">
      <rect class="box" x="6" y="124" width="308" height="200" rx="8" />
      <text x="160" y="148" style="font-weight:700">poll(): 10~14 다섯 건</text>
      <text class="sub" x="160" y="176">커밋 위치는 아직 10</text>
      <text x="160" y="214">처리보다 커밋이 먼저?</text>
      <text x="160" y="240">처리보다 커밋이 나중?</text>
      <text class="hi" x="160" y="282">→ 유실이냐 중복이냐</text>
    </g>
    <g data-id="p2" class="hide">
      <rect class="err" x="6" y="124" width="308" height="200" rx="8" />
      <text x="160" y="148" style="font-weight:700">최대 한 번 · 먼저 커밋</text>
      <text class="l" x="24" y="184">① 커밋 15 먼저</text>
      <text class="l" x="24" y="212">② 12 처리 중 <tspan class="err-t">죽음</tspan></text>
      <text class="l" x="24" y="240">③ 재시작 → 15부터</text>
      <text class="err-t" x="160" y="282">12~14 유실</text>
    </g>
    <g data-id="p3" class="hide">
      <rect class="box" x="6" y="124" width="308" height="200" rx="8" />
      <text x="160" y="148" style="font-weight:700">최소 한 번 · 처리 후 커밋</text>
      <text class="l" x="24" y="180">① 10~14 처리 완료</text>
      <text class="l" x="24" y="206">② 커밋 직전 <tspan class="err-t">죽음</tspan></text>
      <text class="l" x="24" y="232">③ 재시작 → 10부터</text>
      <text class="hi" x="160" y="262">10~14 중복</text>
      <rect class="chip" x="22" y="278" width="276" height="34" rx="6" />
      <text x="160" y="295">처리한 ID 기록 → 건너뜀</text>
    </g>
    <g data-id="p4" class="hide">
      <rect class="chip" x="6" y="124" width="308" height="200" rx="8" />
      <text x="160" y="148" style="font-weight:700">정확히 한 번 · Kafka→Kafka</text>
      <rect class="frame" x="22" y="168" width="276" height="104" rx="8" />
      <text class="sub" x="160" y="184">트랜잭션 하나</text>
      <rect class="box" x="34" y="198" width="252" height="30" rx="6" /><text x="160" y="213">결과 토픽에 쓰기</text>
      <rect class="box" x="34" y="234" width="252" height="30" rx="6" /><text x="160" y="249">오프셋 15 커밋</text>
      <text class="hi" x="160" y="298">둘 다 되거나 둘 다 취소</text>
    </g>
  </svg>
</Stepper>
