---
// 스프링 이벤트 리스너 실행 시점: @EventListener(동기, 같은 트랜잭션) / @TransactionalEventListener(커밋 후, 롤백 시 버림) / +@Async(별도 스레드)
import Stepper from '../Stepper.astro';
const base = ['lane', 'tx', 'r1', 'r2', 'a1'];
const flow = [...base, 'a2', 'r4', 'a3', 'a4'];
const steps = [
  { caption: 'OrderService.complete()가 트랜잭션 안에서 주문 상태를 바꾸고 publishEvent(주문완료)를 불러요.', show: [...base, 'm1', 'hl-pub'] },
  { caption: '@EventListener(기본): 알림 리스너가 같은 스레드, 같은 트랜잭션 안에서 바로 실행돼요. 리스너가 끝나야 complete()로 돌아와 커밋하고 응답해요.', show: [...flow, 'm2', 'sync', 'n-sync', 'commit', 'a5', 'resp2', 'hl-sync'] },
  { caption: '@TransactionalEventListener: 이벤트는 보류 상태로 기다리고 complete()는 계속 진행돼요. 커밋이 끝난 뒤에 리스너가 실행돼요(AFTER_COMMIT, 여전히 같은 스레드).', show: [...flow, 'm3', 'pend', 'n-pend', 'commit', 'a5', 'after', 'a6', 'resp', 'hl-after'] },
  { caption: '롤백되면 보류된 이벤트는 버려져요. AFTER_COMMIT 리스너는 실행되지 않으니, 실패한 주문에 완료 알림이 나가지 않아요.', show: [...flow, 'm3', 'pend', 'rollback', 'n-drop', 'a5', 'nope', 'hl-nope'] },
  { caption: '@Async를 더하면 커밋 뒤 리스너가 별도 스레드에서 돌아요. 주문 응답은 알림을 기다리지 않고 먼저 나가요. 대신 리스너 예외는 발행한 쪽으로 오지 않아요.', show: [...flow, 'm4', 'pend', 'commit', 'a5', 'resp5', 'lane2', 'async', 'hl-async'] },
];
---
<Stepper title="스프링 이벤트: 리스너는 언제, 어느 스레드에서 도나" steps={steps}>
  <svg class="viz" viewBox="0 0 320 424" role="img" aria-label="트랜잭션 안에서 publishEvent를 부른 뒤, @EventListener는 같은 스레드·트랜잭션에서 바로 실행되고, @TransactionalEventListener는 커밋 후 실행되며 롤백 시 버려지고, @Async를 더하면 별도 스레드에서 실행되어 응답이 먼저 나가는 그림">
    <defs>
      <marker id="set-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    <!-- 모드 표시 -->
    <text data-id="m1" class="mono hide" x="160" y="16">publishEvent(주문완료)</text>
    <text data-id="m2" class="mono hi hide" x="160" y="16">@EventListener (기본)</text>
    <text data-id="m3" class="mono hi hide" x="160" y="16">@TransactionalEventListener</text>
    <text data-id="m4" class="mono hi hide" x="160" y="16">+ @Async (커밋 후, 별도 스레드)</text>

    <text data-id="lane" class="sub l" x="8" y="42">요청 스레드</text>
    <g data-id="lane2" class="hide">
      <text class="sub" x="260" y="42">별도 스레드</text>
      <line class="frame" x1="260" y1="56" x2="260" y2="376" />
    </g>

    <g data-id="tx">
      <rect class="frame" x="8" y="56" width="188" height="262" rx="10" />
      <text class="sub l" x="16" y="70">트랜잭션</text>
    </g>
    <g data-id="r1"><rect class="box" x="18" y="82" width="168" height="34" rx="7" /><text x="102" y="99">주문 상태 변경</text></g>
    <line data-id="a1" class="line" x1="102" y1="117" x2="102" y2="128" marker-end="url(#set-arr)" />
    <g data-id="r2"><rect class="chip" x="18" y="130" width="168" height="34" rx="7" /><text class="mono" x="102" y="147">publishEvent()</text></g>
    <line data-id="a2" class="line" x1="102" y1="165" x2="102" y2="176" marker-end="url(#set-arr)" />

    <!-- 3번째 칸: 동기 리스너 / 보류 -->
    <g data-id="sync" class="hide"><rect class="box" x="18" y="178" width="168" height="34" rx="7" /><text x="102" y="195">알림 리스너 실행</text></g>
    <g data-id="n-sync" class="hide"><text class="sub l" x="204" y="186">← 같은 스레드</text><text class="sub l" x="220" y="205">같은 트랜잭션</text></g>
    <g data-id="pend" class="hide"><rect class="bad" x="18" y="178" width="168" height="34" rx="7" /><text x="102" y="195">이벤트 보류 중</text></g>
    <g data-id="n-pend" class="hide"><text class="sub l" x="204" y="186">← 커밋까지</text><text class="sub l" x="220" y="205">대기</text></g>

    <line data-id="a3" class="line" x1="102" y1="213" x2="102" y2="224" marker-end="url(#set-arr)" />
    <g data-id="r4"><rect class="box" x="18" y="226" width="168" height="34" rx="7" /><text x="102" y="243">나머지 코드 실행</text></g>
    <line data-id="a4" class="line" x1="102" y1="261" x2="102" y2="272" marker-end="url(#set-arr)" />

    <g data-id="commit" class="hide"><rect class="chip" x="18" y="274" width="168" height="34" rx="7" /><text x="102" y="291">커밋 ✓</text></g>
    <g data-id="rollback" class="hide"><rect class="err" x="18" y="274" width="168" height="34" rx="7" /><text class="err-t" x="102" y="291">롤백 ✗</text></g>
    <g data-id="n-drop" class="hide"><text class="sub l" x="204" y="282">← 보류 이벤트</text><text class="sub l" x="220" y="301">버려짐</text></g>

    <line data-id="a5" class="line" x1="102" y1="309" x2="102" y2="332" marker-end="url(#set-arr)" />

    <!-- 트랜잭션 밖 -->
    <g data-id="after" class="hide"><rect class="box" x="18" y="334" width="168" height="34" rx="7" /><text x="102" y="351">알림 리스너 실행</text></g>
    <line data-id="a6" class="line hide" x1="102" y1="369" x2="102" y2="380" marker-end="url(#set-arr)" />
    <g data-id="nope" class="hide"><rect class="err" x="18" y="334" width="168" height="34" rx="7" /><text class="err-t" x="102" y="351">✗ 리스너 실행 안 됨</text></g>
    <g data-id="resp" class="hide"><rect class="box" x="18" y="382" width="168" height="34" rx="7" /><text x="102" y="399">응답 반환</text></g>
    <g data-id="resp2" class="hide"><rect class="box" x="18" y="334" width="168" height="34" rx="7" /><text x="102" y="351">응답 반환</text></g>
    <g data-id="resp5" class="hide"><rect class="chip" x="18" y="334" width="168" height="34" rx="7" /><text x="102" y="351">응답 먼저 반환</text></g>
    <g data-id="async" class="hide">
      <polyline class="line" points="188,291 260,291 260,380" stroke-dasharray="5 4" marker-end="url(#set-arr)" />
      <rect class="box" x="206" y="382" width="108" height="34" rx="7" />
      <text x="260" y="399">알림 리스너</text>
    </g>

    <rect data-id="hl-pub" class="hl" x="14" y="126" width="176" height="42" rx="9" />
    <rect data-id="hl-sync" class="hl" x="14" y="174" width="176" height="42" rx="9" />
    <rect data-id="hl-after" class="hl" x="14" y="330" width="176" height="42" rx="9" />
    <rect data-id="hl-nope" class="hl" x="14" y="270" width="176" height="102" rx="9" />
    <rect data-id="hl-async" class="hl" x="202" y="378" width="116" height="42" rx="9" />
  </svg>
</Stepper>
