---
// 컨테이너 memory limit 512Mi 안에 JVM 힙 + 힙 밖 메모리가 같이 들어간다.
// 숫자는 실험값만(512Mi에서 기본 힙 128MiB, MaxRAMPercentage=75면 384MiB). 힙 밖 크기는 앱마다 달라서 숫자 없음.
// 세로 막대 높이: 512Mi = 280 (y 90~370).
import Stepper from '../Stepper.astro';
const base = ['box'];
const steps = [
  { caption: '컨테이너에 memory limit 512Mi를 걸었어요. JDK 10 이상 JVM은 이 한도를 읽어서 힙 크기를 정해요.', show: [...base] },
  { caption: '옵션을 안 주면 MaxRAMPercentage 기본값 25%가 적용돼요. 최대 힙은 512Mi의 1/4인 128MiB이고, 위쪽 칸은 비어 있어요.', show: [...base, 'h128', 'empty'] },
  { caption: 'JVM은 힙만 쓰지 않아요. 메타스페이스·스레드 스택·코드 캐시·GC 자료구조·다이렉트 버퍼 같은 힙 밖 메모리도 같은 한도 안에 쌓여요.', show: [...base, 'h128', 'o128', 'empty', 'list'] },
  { caption: '-XX:MaxRAMPercentage=75로 올리면 최대 힙이 384MiB가 돼요. 힙 밖 몫은 남은 칸에 들어가요.', show: [...base, 'h384', 'o384', 'list'] },
  { caption: '잘못된 예: -Xmx512m처럼 힙을 limit과 똑같이 잡으면 힙 밖 메모리가 들어갈 자리가 없어요. 힙이 차오르면 합계가 512Mi를 넘고, 커널이 죽여요(OOMKilled, Exit 137).', show: [...base, 'h512', 'o512', 'list', 'oom'] },
];
---
<Stepper title="컨테이너 안의 JVM 메모리" steps={steps}>
  <svg class="viz" viewBox="0 0 320 432" role="img" aria-label="memory limit 512Mi 컨테이너에서 JVM 기본 힙은 25%인 128MiB다. 힙 밖 메모리도 같은 한도를 쓴다. MaxRAMPercentage=75면 힙 384MiB에 힙 밖 몫이 남은 칸에 들어가고, -Xmx512m이면 힙과 힙 밖의 합이 한도를 넘어 OOMKilled된다">
    <g data-id="box">
      <text x="160" y="16" style="font-weight:700">컨테이너 memory limit 512Mi</text>
      <rect class="box" x="50" y="90" width="220" height="280" />
      <path d="M40 90 H280" style="stroke:var(--sl-color-red);stroke-width:2.5" />
      <text class="sub" x="36" y="90" style="text-anchor:end">limit</text>
    </g>
    <text data-id="empty" class="sub hide" x="160" y="180">빈 칸</text>

    <!-- 기본 25% -->
    <g data-id="h128" class="hide">
      <rect class="chip" x="52" y="300" width="216" height="68" />
      <text class="hi" x="160" y="324">힙 128MiB</text>
      <text class="sub" x="160" y="346">기본 25%</text>
    </g>
    <g data-id="o128" class="hide">
      <rect class="bad" x="52" y="250" width="216" height="48" />
      <text x="160" y="274">힙 밖 메모리</text>
    </g>

    <!-- MaxRAMPercentage=75 -->
    <g data-id="h384" class="hide">
      <rect class="chip" x="52" y="160" width="216" height="208" />
      <text class="hi" x="160" y="250">힙 384MiB</text>
      <text class="mono sub" x="160" y="274">MaxRAMPercentage=75</text>
    </g>
    <g data-id="o384" class="hide">
      <rect class="bad" x="52" y="110" width="216" height="48" />
      <text x="160" y="134">힙 밖 메모리</text>
    </g>

    <!-- -Xmx512m: 힙이 한도 전체 -->
    <g data-id="h512" class="hide">
      <rect class="chip" x="52" y="92" width="216" height="276" />
      <text class="hi" x="160" y="200">힙 512MiB</text>
      <text class="mono sub" x="160" y="224">-Xmx512m</text>
    </g>
    <g data-id="o512" class="hide">
      <rect class="err" x="52" y="36" width="216" height="52" style="stroke-dasharray:5 3" />
      <text class="err-t" x="160" y="62">힙 밖 메모리 → 넘침</text>
    </g>
    <g data-id="oom" class="hide">
      <rect class="err" x="80" y="282" width="160" height="56" rx="6" />
      <text class="err-t" x="160" y="300">OOMKilled</text>
      <text class="mono" x="160" y="322">Exit 137</text>
    </g>

    <g data-id="list" class="hide">
      <text class="sub" x="160" y="394">힙 밖: 메타스페이스 · 스레드 스택</text>
      <text class="sub" x="160" y="416">코드 캐시 · GC 자료구조 · 다이렉트 버퍼</text>
    </g>
  </svg>
</Stepper>
