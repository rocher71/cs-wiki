---
// 컨테이너 = 칸막이(namespace) + 계량기(cgroup)를 두른 평범한 프로세스.
// 한도(memory.max=50MiB)를 넘기면 커널 OOM killer가 죽인다 → exit 137, OOMKilled=true.
import Stepper from '../Stepper.astro';
const base = ['kern', 'proc'];
const steps = [
  { caption: '시작은 호스트 커널 위에서 도는 평범한 프로세스 하나예요. 이 상태에선 다른 프로세스도 다 보여요.', show: [...base, 'pid-h'] },
  { caption: '칸막이(namespace)를 둘러요. PID·네트워크·파일시스템·호스트명 등이 나뉘어서, 안에선 자기가 PID 1이고 자기 호스트명만 보여요.', show: [...base, 'ns', 'pid-1'] },
  { caption: '계량기(cgroup)를 붙여요. memory.max=50MiB면 이 프로세스는 메모리를 50MiB까지만 쓸 수 있어요.', show: [...base, 'ns', 'pid-1', 'meter', 'm-low'] },
  { caption: '프로그램이 메모리를 계속 두 배씩 늘려요. 계량기 바늘이 한도 50MiB에 닿아요.', show: [...base, 'ns', 'pid-1', 'meter', 'm-full'] },
  { caption: '한도를 넘기면 커널의 OOM killer가 프로세스를 강제로 죽여요. 종료 코드는 137, docker inspect에선 OOMKilled=true로 보여요.', show: [...base, 'ns', 'meter', 'm-full', 'dead', 'oom'] },
];
---
<Stepper title="칸막이(namespace)와 계량기(cgroup)" steps={steps}>
  <svg class="viz" viewBox="0 0 320 282" role="img" aria-label="프로세스 하나에 namespace 칸막이를 둘러 자기가 PID 1로 보이게 하고, cgroup 계량기로 메모리를 50MiB로 제한하며, 한도를 넘으면 커널 OOM killer가 종료해 exit 137이 된다">
    <g data-id="ns">
      <rect class="frame" x="20" y="4" width="280" height="160" rx="8" style="stroke:var(--sl-color-accent);stroke-width:2" />
      <text class="l hi" x="32" y="22">칸막이 (namespace)</text>
      <text class="mono sub" x="160" y="44">PID·NET·MNT·UTS·IPC·cgroup</text>
      <text class="sub" x="160" y="146">호스트명: cswiki-box</text>
    </g>
    <g data-id="proc">
      <rect class="box" x="70" y="62" width="180" height="62" rx="6" />
      <text x="160" y="80">프로세스</text>
    </g>
    <text data-id="pid-h" class="sub hide" x="160" y="104">PID 4321 (남들도 보임)</text>
    <text data-id="pid-1" class="hi hide" x="160" y="104">PID 1 (나만 보임)</text>
    <g data-id="dead" class="hide">
      <rect class="err" x="70" y="62" width="180" height="62" rx="6" />
      <text class="err-t" x="160" y="80">✕ 강제 종료</text>
      <text class="mono" x="160" y="104">exit 137</text>
    </g>

    <g data-id="meter">
      <text class="l" x="20" y="184" style="font-weight:700">계량기 (cgroup)</text>
      <text class="mono sub" x="300" y="184" style="text-anchor:end">memory.max=50MiB</text>
      <rect class="frame" x="20" y="196" width="280" height="30" rx="4" style="stroke-dasharray:none" />
    </g>
    <g data-id="m-low" class="hide">
      <rect class="chip" x="22" y="198" width="44" height="26" rx="3" />
      <text class="sub l" x="76" y="211">조금 사용 중</text>
    </g>
    <g data-id="m-full" class="hide">
      <rect class="err" x="22" y="198" width="276" height="26" rx="3" />
      <text class="err-t" x="160" y="211">50MiB 한도 도달</text>
    </g>

    <g data-id="kern">
      <rect class="bad" x="4" y="240" width="312" height="36" rx="4" />
      <text class="l" x="14" y="258">호스트 커널</text>
    </g>
    <text data-id="oom" class="err-t hide" x="306" y="258" style="text-anchor:end">OOM killer 발동</text>
  </svg>
</Stepper>
