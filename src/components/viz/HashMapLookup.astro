---
// put 후 내용만 같은 새 객체로 get. 왼쪽: equals만 재정의 / 오른쪽: 둘 다 재정의. 버킷 4칸, 인덱스 = hash % 4.
import Stepper from '../Stepper.astro';
const cols = [
  { side: 'L', x: 10, cx: 80, title: 'equals만 재정의' },
  { side: 'R', x: 170, cx: 240, title: '둘 다 재정의' },
];
const Y0 = 112, H = 38; // 버킷 [0]의 y, 칸 높이
const steps = [
  { caption: 'put(new Point(1,2), "A"): hashCode()로 칸 [1]을 골라 저장해요. 여기까지는 두 경우가 똑같아요.', show: ['call-put', 'hashL-put', 'hashR-put', 'nodeL', 'nodeR', 'hl-L1', 'hl-R1'] },
  { caption: 'get(new Point(1,2)): 내용은 같지만 새로 만든 다른 객체예요. 이 객체로 hashCode()를 다시 불러요.', show: ['call-get', 'hashL-get', 'hashR-get', 'nodeL', 'nodeR'] },
  { caption: '왼쪽: Object 기본 hashCode라 해시가 달라 [3] 칸을 봐요. 비어 있으니 equals는 불리지도 않고 null이에요.', show: ['call-get', 'hashL-get', 'hashR-get', 'nodeL', 'nodeR', 'hl-L3', 'emptyL', 'resL'] },
  { caption: '오른쪽: 해시가 같아 [1] 칸을 봐요. 노드의 해시값이 같은지 보고, equals()가 true라서 "A"를 돌려줘요.', show: ['call-get', 'hashL-get', 'hashR-get', 'nodeL', 'nodeR', 'emptyL', 'resL', 'hl-R1', 'resR'] },
];
---
<Stepper title="HashMap.get이 키를 찾는 과정" steps={steps}>
  <svg class="viz" viewBox="0 0 320 372" role="img" aria-label="hashCode를 재정의하지 않으면 같은 내용의 키로도 값을 못 찾는 과정">
    <!-- 호출 -->
    <rect class="box" x="10" y="8" width="300" height="36" rx="8" />
    <text data-id="call-put" class="hide" x="160" y="27">put(new Point(1,2), "A")</text>
    <text data-id="call-get" class="hide" x="160" y="27">get(new Point(1,2))</text>

    <line class="frame" x1="160" y1="56" x2="160" y2="364" />

    {cols.map((c) => (
      <g>
        <text x={c.cx} y="66" style="font-weight:700">{c.title}</text>
        {[0, 1, 2, 3].map((i) => (
          <g>
            <rect class="box" x={c.x} y={Y0 + i * H} width="140" height={H - 4} rx="6" />
            <text class="sub l" x={c.x + 6} y={Y0 + i * H + 17}>[{i}]</text>
          </g>
        ))}
        <g data-id={`node${c.side}`}>
          <rect class="chip" x={c.x + 36} y={Y0 + H + 4} width="98" height="26" rx="6" />
          <text x={c.x + 85} y={Y0 + H + 17} style="font-size:14px">(1,2) → A</text>
        </g>
      </g>
    ))}

    <!-- 해시값 (인덱스 = hash % 4) -->
    <text data-id="hashL-put" class="sub hide" x="80" y="92">hash 5813 → [1]</text>
    <text data-id="hashL-get" class="sub hide" x="80" y="92">hash 9271 → [3]</text>
    <text data-id="hashR-put" class="sub hide" x="240" y="92">hash 993 → [1]</text>
    <text data-id="hashR-get" class="sub hide" x="240" y="92">hash 993 → [1]</text>

    <text data-id="emptyL" class="sub hide" x="98" y={Y0 + 3 * H + 17}>비어 있음</text>

    <!-- 결과 -->
    <g data-id="resL" class="hide">
      <text class="sub" x="80" y="282">다른 칸이라</text>
      <text class="sub" x="80" y="304">equals 호출 안 됨</text>
      <rect class="bad" x="20" y="322" width="120" height="34" rx="17" />
      <text x="80" y="340" style="font-weight:700">null ✗</text>
    </g>
    <g data-id="resR" class="hide">
      <text class="sub" x="240" y="282">① 해시 같음 ✓</text>
      <text class="sub" x="240" y="304">② equals true ✓</text>
      <rect class="badge" x="180" y="322" width="120" height="34" rx="17" />
      <text class="on-badge" x="240" y="340">"A" 반환</text>
    </g>

    {cols.map((c) => [1, 3].map((i) => (
      <rect data-id={`hl-${c.side}${i}`} class="hl" x={c.x - 3} y={Y0 + i * H - 3} width="146" height={H + 2} rx="8" />
    )))}
  </svg>
</Stepper>
