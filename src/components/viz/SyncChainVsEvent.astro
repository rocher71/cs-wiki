---
// 동기 호출 체인(줄줄이 기다림, 장애 전파) vs 비동기 이벤트(브로커에 맡기고 바로 응답, 각자 처리).
// 두 그림이 같은 자리에 번갈아 나오므로 모든 그룹에 class="hide".
import Stepper from '../Stepper.astro';
const steps = [
  { caption: '동기: 클라이언트 → 주문 → 포인트 → 알림 → 통계를 차례로 불러요. 앞 서비스는 뒤 서비스가 답할 때까지 기다려서, 위로 갈수록 대기 시간이 쌓여요.', show: ['s-base', 's-wait'] },
  { caption: '동기: 알림 서비스가 느려지거나 죽으면 포인트·주문도 답을 못 받고 같이 멈춰요. 결국 클라이언트는 타임아웃. 장애가 앞쪽으로 번지는 거예요(장애 전파).', show: ['s-base', 's-down', 's-fail'] },
  { caption: '비동기: 주문 서비스는 ① DB에 저장하고 ② OrderCreated 이벤트를 브로커에 맡긴 뒤 ③ 바로 "접수됨"으로 응답해요. 뒷일을 기다리지 않아요.', show: ['a-base', 'a-db', 'a-pub', 'a-reply'] },
  { caption: '비동기: 포인트·알림·통계 서비스가 각자 브로커에서 이벤트를 꺼내 처리해요. 서로의 존재도, 주문 서비스도 몰라요.', show: ['a-base', 'a-db', 'a-pub', 'a-reply', 'a-cons', 'pull-p', 'pull-n', 'pull-s', 'a-note'] },
  { caption: '비동기: 알림 서비스가 죽어 있어도 주문은 이미 끝났어요. 알림 몫 이벤트는 브로커에 남아 있다가, 알림이 살아나면 그때 처리돼요.', show: ['a-base', 'a-db', 'a-pub', 'a-reply', 'a-cons', 'pull-p', 'pull-s', 'a-down', 'a-queued'] },
];
const halo = 'paint-order:stroke;stroke:var(--sl-color-gray-7, var(--sl-color-black));stroke-width:5px;stroke-linejoin:round';
const acc = 'stroke:var(--sl-color-accent);stroke-width:2.4;fill:none';
// 동기 체인: 세로로 5칸
const chain = ['클라이언트', '주문', '포인트', '알림', '통계'];
const Y = (i: number) => 34 + i * 66; // 박스 top
const fails = ['타임아웃', '같이 멈춤', '같이 멈춤'];
const cons = [{ x: 10, t: '포인트', id: 'pull-p' }, { x: 114, t: '알림', id: 'pull-n' }, { x: 218, t: '통계', id: 'pull-s' }];
---
<Stepper title="동기 호출 체인 vs 비동기 이벤트" steps={steps}>
  <svg class="viz" viewBox="0 0 320 390" role="img" aria-label="동기 호출은 서비스가 줄줄이 기다려 장애가 앞으로 번지고, 비동기 이벤트는 브로커에 맡기고 바로 응답한 뒤 각 서비스가 따로 처리하는 모습">
    <defs>
      <marker id="sce-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
      <marker id="sce-g" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    <!-- 동기 -->
    <g data-id="s-base" class="hide">
      <text class="hi" x="160" y="14">동기 호출(REST): 줄줄이 기다림</text>
      {chain.map((t, i) => (
        <>
          <rect class="box" x="20" y={Y(i)} width="130" height="38" rx="8" />
          <text x="85" y={Y(i) + 19} style="font-weight:700">{t}</text>
          {i < 4 && <line class="line" x1="85" y1={Y(i) + 40} x2="85" y2={Y(i + 1) - 3} marker-end="url(#sce-g)" />}
        </>
      ))}
    </g>
    <g data-id="s-wait" class="hide">
      {[0, 1, 2, 3].map((i) => (
        <>
          <rect class="chip" x="165" y={Y(i) + 7} width={40 + (3 - i) * 32} height="24" rx="5" />
          <text class="l" x="172" y={Y(i) + 19} style="font-size:14px">대기</text>
        </>
      ))}
      <text class="sub" x="160" y="376">응답 시간 = 뒤 호출들의 합</text>
    </g>
    <g data-id="s-down" class="hide">
      <rect class="err" x="20" y={Y(3)} width="130" height="38" rx="8" />
      <text class="err-t" x="85" y={Y(3) + 19}>✕ 알림 장애</text>
    </g>
    <g data-id="s-fail" class="hide">
      {fails.map((t, i) => (
        <>
          <rect class="err" x="165" y={Y(i) + 7} width="136" height="24" rx="5" />
          <text class="err-t" x="233" y={Y(i) + 19} style="font-size:14px">{t}</text>
        </>
      ))}
      <text class="sub" x="160" y="376">통계는 호출조차 못 받아요</text>
    </g>

    <!-- 비동기 -->
    <g data-id="a-base" class="hide">
      <text class="hi" x="160" y="14">비동기 이벤트: 맡기고 끝</text>
      <rect class="box" x="20" y="34" width="120" height="38" rx="8" />
      <text x="80" y="53" style="font-weight:700">클라이언트</text>
      <line class="line" x1="60" y1="74" x2="60" y2="117" marker-end="url(#sce-g)" />
      <rect class="box" x="20" y="120" width="120" height="44" rx="8" />
      <text x="80" y="142" style="font-weight:700">주문</text>
      <rect class="box" x="20" y="212" width="280" height="62" rx="8" />
      <text x="160" y="230" style="font-weight:700">브로커 (Kafka 등)</text>
    </g>
    <g data-id="a-db" class="hide">
      <rect class="box" x="222" y="120" width="78" height="44" rx="8" />
      <text x="261" y="142">DB</text>
      <line x1="142" y1="142" x2="218" y2="142" style={acc} marker-end="url(#sce-a)" />
      <text class="hi" x="180" y="126" style={halo}>① 저장</text>
    </g>
    <g data-id="a-pub" class="hide">
      <line x1="60" y1="166" x2="60" y2="208" style={acc} marker-end="url(#sce-a)" />
      <text class="hi l" x="68" y="188" style={halo}>② 이벤트 발행</text>
      <rect class="chip" x="90" y="242" width="140" height="24" rx="5" />
      <text class="mono" x="160" y="254">OrderCreated</text>
    </g>
    <g data-id="a-reply" class="hide">
      <line x1="110" y1="118" x2="110" y2="76" style={acc} marker-end="url(#sce-a)" />
      <text class="hi l" x="118" y="97" style={halo}>③ "접수됨"</text>
    </g>
    <g data-id="a-cons" class="hide">
      {cons.map((c) => (
        <>
          <rect class="box" x={c.x} y="312" width="92" height="42" rx="8" />
          <text x={c.x + 46} y="333" style="font-weight:700">{c.t}</text>
        </>
      ))}
    </g>
    {cons.map((c) => (
      <g data-id={c.id} class="hide">
        <line x1={c.x + 46} y1="276" x2={c.x + 46} y2="309" style={acc} marker-end="url(#sce-a)" />
      </g>
    ))}
    <g data-id="a-note" class="hide">
      <text class="sub" x="160" y="376">④ 각자 꺼내 처리, 서로 몰라요</text>
    </g>
    <g data-id="a-down" class="hide">
      <rect class="err" x="114" y="312" width="92" height="42" rx="8" />
      <text class="err-t" x="160" y="333">✕ 장애</text>
    </g>
    <g data-id="a-queued" class="hide">
      <line class="line" x1="160" y1="276" x2="160" y2="309" style="stroke-dasharray:4 4" />
      <text class="sub" x="160" y="376">이벤트는 남아서 복구를 기다려요</text>
    </g>
  </svg>
</Stepper>
