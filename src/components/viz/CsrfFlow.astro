---
// CSRF: 로그인 쿠키를 가진 브라우저가 evil 페이지의 숨은 폼 때문에 bank로 POST, 쿠키 자동 첨부 → 송금 / 방어 시 쿠키 안 붙거나 토큰 없어 403.
import Stepper from '../Stepper.astro';
const steps = [
  { caption: '사용자가 bank.example에 로그인해요. 서버가 세션 쿠키(sid)를 주고, 브라우저가 보관해요.', show: ['base', 'login', 'cookie'] },
  { caption: '로그아웃하지 않은 채, 같은 브라우저로 evil.example 페이지를 열어요. 그 안에 사용자 눈에 안 보이는 폼이 숨어 있어요.', show: ['base', 'login', 'cookie', 'visit'] },
  { caption: '페이지가 열리자마자 숨은 폼이 bank.example/transfer로 POST를 자동 제출해요. 요청을 보내는 건 사용자 브라우저예요.', show: ['base', 'login', 'cookie', 'visit', 'post'] },
  { caption: '브라우저는 bank.example로 가는 요청이니 bank 쿠키를 알아서 붙여요(SameSite가 막지 않으면). 공격자는 쿠키 값을 몰라도 돼요.', show: ['base', 'login', 'cookie', 'visit', 'post', 'ck-on'] },
  { caption: '서버는 로그인된 사용자의 정상 요청으로 보고 송금해요. 응답은 evil이 못 읽지만, 송금은 이미 끝났어요.', show: ['base', 'login', 'cookie', 'visit', 'post', 'ck-on', 'done'] },
  { caption: '방어: SameSite=Lax면 다른 사이트에서 온 POST엔 쿠키가 안 붙어요. 붙더라도 서버가 "우리 화면에서 받은 CSRF 토큰"이 없으면 403으로 거절해요.', show: ['base', 'login', 'cookie', 'visit', 'post', 'ck-off', 'deny'] },
];
const halo = 'paint-order:stroke;stroke:var(--sl-color-gray-7, var(--sl-color-black));stroke-width:5px;stroke-linejoin:round';
const acc = 'stroke:var(--sl-color-accent);stroke-width:2.4;fill:none';
const red = 'stroke:var(--sl-color-red);stroke-width:2.4;fill:none';
---
<Stepper title="CSRF: 남의 사이트가 내 쿠키로 송금시키기" steps={steps}>
  <svg class="viz" viewBox="0 0 320 360" role="img" aria-label="은행에 로그인한 브라우저가 악성 페이지의 숨은 폼 때문에 은행으로 송금 요청을 보내고 쿠키가 자동으로 붙는 순서와, SameSite와 CSRF 토큰으로 거절되는 모습">
    <defs>
      <marker id="csf-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
      <marker id="csf-r" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-red)" />
      </marker>
    </defs>
    <g data-id="base">
      <rect class="box" x="4" y="6" width="92" height="36" rx="8" />
      <text x="50" y="24" style="font-weight:700">은행 서버</text>
      <rect class="box" x="114" y="6" width="92" height="36" rx="8" />
      <text x="160" y="24" style="font-weight:700">내 브라우저</text>
      <rect class="box" x="224" y="6" width="92" height="36" rx="8" />
      <text x="270" y="24" style="font-weight:700">악성 사이트</text>
      <text class="sub mono" x="50" y="56">bank.example</text>
      <text class="sub mono" x="270" y="56">evil.example</text>
      <line class="line" x1="50" y1="66" x2="50" y2="354" style="stroke-dasharray:4 4" />
      <line class="line" x1="160" y1="44" x2="160" y2="354" style="stroke-dasharray:4 4" />
      <line class="line" x1="270" y1="66" x2="270" y2="354" style="stroke-dasharray:4 4" />
    </g>
    <g data-id="login">
      <line x1="160" y1="86" x2="54" y2="86" style={acc} marker-end="url(#csf-a)" />
      <text x="105" y="74" style={`font-size:14px;${halo}`}>로그인</text>
      <line x1="50" y1="112" x2="156" y2="112" style={acc} marker-end="url(#csf-a)" />
      <text class="mono" x="105" y="126" style={halo}>Set-Cookie</text>
    </g>
    <g data-id="cookie">
      <rect class="chip" x="114" y="138" width="92" height="26" rx="5" />
      <text x="160" y="151" style="font-size:14px">쿠키 sid 보관</text>
    </g>
    <g data-id="visit">
      <line x1="160" y1="188" x2="266" y2="188" style={acc} marker-end="url(#csf-a)" />
      <text x="215" y="176" style={`font-size:14px;${halo}`}>페이지 열기</text>
      <line x1="270" y1="214" x2="164" y2="214" style={red} marker-end="url(#csf-r)" />
      <text class="err-t" x="215" y="228" style={`font-size:14px;${halo}`}>숨은 폼</text>
    </g>
    <g data-id="post">
      <line x1="160" y1="256" x2="54" y2="256" style={red} marker-end="url(#csf-r)" />
      <text class="mono" x="105" y="244" style={halo}>POST /transfer</text>
    </g>
    <g data-id="ck-on" class="hide">
      <text class="err-t" x="105" y="270" style={`font-size:14px;${halo}`}>+ 쿠키 자동 첨부</text>
    </g>
    <g data-id="ck-off" class="hide">
      <text class="hi" x="105" y="270" style={`font-size:14px;${halo}`}>SameSite → 쿠키 X</text>
    </g>
    <g data-id="done" class="hide">
      <rect class="err" x="4" y="290" width="150" height="50" rx="6" />
      <text class="err-t" x="79" y="306" style="font-size:14px">정상 요청으로 보고</text>
      <text class="err-t" x="79" y="326" style="font-size:14px">송금 처리!</text>
    </g>
    <g data-id="deny" class="hide">
      <rect class="chip" x="4" y="290" width="150" height="50" rx="6" />
      <text x="79" y="306" style="font-size:14px">CSRF 토큰 없음</text>
      <text class="hi" x="79" y="326" style="font-size:14px">→ 403 거절</text>
    </g>
  </svg>
</Stepper>
