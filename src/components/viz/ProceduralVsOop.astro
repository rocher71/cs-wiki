---
// 절차지향(전역 데이터를 여러 함수가 직접 수정) → 객체지향(Account가 데이터와 메서드를 묶고 바깥은 메서드로만 접근)
import Stepper from '../Stepper.astro';
const steps = [
  { caption: '절차지향: 데이터 balance는 따로 있고, 함수 세 개가 각자 balance를 직접 읽고 바꿔요.', show: ['fns', 'pArrows', 'global'] },
  { caption: '누구나 balance에 손댈 수 있어서, 엉뚱한 코드가 -500을 넣어도 막을 곳이 없어요. 버그가 나면 모든 함수를 뒤져야 해요.', show: ['fns', 'pArrows', 'global', 'bad'] },
  { caption: '객체지향: balance와 이를 다루는 메서드를 Account 객체 하나에 묶어요. balance는 바깥에서 못 보는 비공개(private) 데이터예요.', show: ['acct', 'bal', 'methods', 'inner'] },
  { caption: '바깥 코드는 메서드(버튼)로만 들어와요. withdraw()가 "잔액보다 많이 못 뺀다"는 규칙을 스스로 지키니, 잔액이 틀리면 Account만 보면 돼요.', show: ['acct', 'bal', 'methods', 'inner', 'outside'] },
];
---
<Stepper title="절차지향 vs 객체지향: 데이터는 누가 지키나" steps={steps}>
  <svg class="viz" viewBox="0 0 320 300" role="img" aria-label="절차지향에서는 함수 세 개가 전역 balance를 직접 바꾸고, 객체지향에서는 Account 객체 안에 balance와 메서드가 함께 있어 바깥 코드는 메서드로만 접근하는 그림">
    <defs>
      <marker id="pvo-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
      <marker id="pvo-red" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-red)" />
      </marker>
    </defs>

    <!-- 절차지향 -->
    <g data-id="fns" class="hide">
      <rect class="box" x="8" y="20" width="96" height="40" rx="8" />
      <text class="mono" x="56" y="40">deposit()</text>
      <rect class="box" x="112" y="20" width="96" height="40" rx="8" />
      <text class="mono" x="160" y="40">withdraw()</text>
      <rect class="box" x="216" y="20" width="96" height="40" rx="8" />
      <text class="mono" x="264" y="40">report()</text>
      <text class="sub" x="160" y="80">함수 (따로따로)</text>
    </g>
    <g data-id="pArrows" class="hide">
      <line class="line" x1="56" y1="62" x2="118" y2="146" marker-end="url(#pvo-arr)" />
      <line class="line" x1="160" y1="92" x2="160" y2="146" marker-end="url(#pvo-arr)" />
      <line class="line" x1="264" y1="62" x2="202" y2="146" marker-end="url(#pvo-arr)" />
    </g>
    <g data-id="global" class="hide">
      <rect class="chip" x="80" y="150" width="160" height="56" rx="8" />
      <text class="sub" x="160" y="166">전역 데이터</text>
      <text class="mono" x="160" y="188">balance = 1000</text>
    </g>
    <g data-id="bad" class="hide">
      <rect class="err" x="70" y="250" width="180" height="40" rx="8" />
      <text class="mono err-t" x="160" y="270">balance = -500</text>
      <line class="line" x1="160" y1="248" x2="160" y2="210" style="stroke:var(--sl-color-red)" marker-end="url(#pvo-red)" />
      <text class="err-t l" x="170" y="228" style="font-size:14px">막을 곳 없음</text>
    </g>

    <!-- 객체지향 -->
    <g data-id="acct" class="hide">
      <rect class="box" x="4" y="8" width="312" height="200" rx="12" />
      <text x="160" y="30" style="font-weight:700">Account 객체</text>
    </g>
    <g data-id="bal" class="hide">
      <rect class="chip" x="90" y="48" width="140" height="44" rx="8" />
      <g transform="translate(104 61)">
        <path d="M3 7V4a4 4 0 0 1 8 0v3" fill="none" stroke="var(--sl-color-accent-high)" stroke-width="2" />
        <rect x="0" y="7" width="14" height="10" rx="2" fill="var(--sl-color-accent-high)" />
      </g>
      <text class="mono" x="172" y="71">balance</text>
      <text class="sub" x="160" y="106">비공개(private)</text>
    </g>
    <g data-id="inner" class="hide">
      <line class="line" x1="58" y1="140" x2="110" y2="94" />
      <line class="line" x1="160" y1="140" x2="160" y2="118" />
      <line class="line" x1="264" y1="140" x2="210" y2="94" />
    </g>
    <g data-id="methods" class="hide">
      <rect class="box" x="12" y="140" width="94" height="40" rx="20" />
      <text x="59" y="160" style="font-size:14px">deposit()</text>
      <rect class="box" x="113" y="140" width="94" height="40" rx="20" />
      <text x="160" y="160" style="font-size:14px">withdraw()</text>
      <rect class="box" x="214" y="140" width="98" height="40" rx="20" />
      <text x="263" y="160" style="font-size:14px">getBalance()</text>
    </g>
    <g data-id="outside" class="hide">
      <rect class="frame" x="70" y="250" width="180" height="40" rx="8" />
      <text x="160" y="270">바깥 코드</text>
      <line class="line" x1="110" y1="248" x2="66" y2="184" marker-end="url(#pvo-arr)" />
      <line class="line" x1="160" y1="248" x2="160" y2="184" marker-end="url(#pvo-arr)" />
      <line class="line" x1="210" y1="248" x2="256" y2="184" marker-end="url(#pvo-arr)" />
      <text class="sub l" x="6" y="226">버튼으로만</text>
    </g>
  </svg>
</Stepper>
