---
// Java 스레드 6가지 상태 전이. 위: NEW / TERMINATED, 가운데: RUNNABLE, 아래: BLOCKED·WAITING(2열), 맨 아래: TIMED_WAITING.
// 화살표 라벨은 pill(.box) 위에 올려서 다른 선과 겹쳐도 읽히게 한다.
import Stepper from '../Stepper.astro';
const ALL = ['new', 'run', 'blk', 'wt', 'tw', 'term'];
const steps = [
  { caption: 'new Thread(r)로 객체만 만든 상태가 NEW예요. 아직 OS 스레드도, 스택도 없어요.', show: ['new', 'hl-new'] },
  { caption: 'start()를 부르면 RUNNABLE이 돼요. OS 입장에선 "준비(CPU 대기)"와 "실행"이 다르지만 Java는 둘 다 RUNNABLE로 봐요.', show: ['new', 'run', 'a-start', 'inner', 'hl-run'] },
  { caption: 'synchronized 블록에 들어가려는데 다른 스레드가 락을 쥐고 있으면 BLOCKED. 락을 얻으면 다시 RUNNABLE이에요.', show: ['new', 'run', 'blk', 'a-blk', 'hl-blk'] },
  { caption: 'wait(), join(), park()처럼 다른 스레드의 행동을 기한 없이 기다리면 WAITING. notify, 대상 스레드 종료, unpark, interrupt로 깨어나요.', show: ['new', 'run', 'blk', 'wt', 'a-wt', 'hl-wt'] },
  { caption: 'sleep(ms), wait(ms), join(ms), parkNanos처럼 시간을 정해 기다리면 TIMED_WAITING. 시간이 끝나거나 notify·interrupt로 돌아와요.', show: ['new', 'run', 'blk', 'wt', 'tw', 'a-tw', 'hl-tw'] },
  { caption: 'wait()는 락을 놓고 기다려요. 그래서 notify로 깨어나도 락을 다시 잡아야 해서 WAITING → BLOCKED → RUNNABLE 순서로 돌아와요.', show: ['new', 'run', 'blk', 'wt', 'tw', 'a-wb', 'a-blk', 'hl-wt', 'hl-blk'] },
  { caption: 'run()이 정상으로 끝나거나 예외로 빠져나오면 TERMINATED. 끝난 스레드에 다시 start()를 부르면 IllegalThreadStateException이에요.', show: [...ALL, 'inner', 'a-start', 'a-blk', 'a-wt', 'a-tw', 'a-wb', 'a-end', 'a-re', 'hl-term'] },
];
// 화살표 라벨 pill: [x중심, y, 글자, mono?]
// ponytail: 폭은 손으로 맞춘 값. 라벨 바꾸면 360px 렌더로 다시 확인
const pill = (x: number, y: number, t: string, w: number, mono = false) => ({ x, y, t, w, mono });
const pBlk = [pill(74, 228, '↓ synchronized 대기', 142), pill(72, 268, '↑ 락 획득', 76)];
const pWt = [pill(248, 228, '↓ wait()', 84, true), pill(248, 268, '↑ 깨어남', 76)];
const pTw = [pill(160, 378, '↓ sleep(ms)', 108, true), pill(160, 400, '↑ 시간 만료', 92)];
const arr = 'fill:none;stroke:var(--sl-color-accent);stroke-width:2';
---
<Stepper title="Java 스레드의 6가지 상태" steps={steps}>
  <svg class="viz" viewBox="0 0 320 460" role="img" aria-label="NEW, RUNNABLE, BLOCKED, WAITING, TIMED_WAITING, TERMINATED 사이의 전이">
    <defs>
      <marker id="tsf-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
    </defs>

    <!-- 화살표 (상태 박스보다 먼저 그려서 뒤에 깔림) -->
    <g data-id="a-start">
      <path d="M61 42 L61 94" style={arr} marker-end="url(#tsf-a)" />
      <text class="mono l" x="70" y="68">start()</text>
    </g>
    <g data-id="a-end">
      <path d="M254 96 L254 44" style={arr} marker-end="url(#tsf-a)" />
      <text class="sub" x="245" y="68" style="text-anchor:end">run() 종료</text>
    </g>
    <g data-id="a-re" class="hide">
      <path d="M194 25 L110 25" style={arr + ';stroke-dasharray:5 4'} marker-end="url(#tsf-a)" />
      <rect class="err" x="111" y="15" width="82" height="20" rx="10" />
      <text class="err-t mono" x="152" y="25">start() ✕</text>
    </g>
    <g data-id="a-blk">
      <path d="M44 198 L44 296" style={arr} marker-end="url(#tsf-a)" />
      <path d="M100 298 L100 200" style={arr} marker-end="url(#tsf-a)" />
      {pBlk.map((p) => <g><rect class="box" x={p.x - p.w / 2} y={p.y - 10} width={p.w} height="20" rx="10" /><text class={p.mono ? 'mono' : ''} x={p.x} y={p.y} style="font-size:14px">{p.t}</text></g>)}
    </g>
    <g data-id="a-wt">
      <path d="M220 198 L220 296" style={arr} marker-end="url(#tsf-a)" />
      <path d="M276 298 L276 200" style={arr} marker-end="url(#tsf-a)" />
      {pWt.map((p) => <g><rect class="box" x={p.x - p.w / 2} y={p.y - 10} width={p.w} height="20" rx="10" /><text class={p.mono ? 'mono' : ''} x={p.x} y={p.y} style={p.mono ? '' : 'font-size:14px'}>{p.t}</text></g>)}
    </g>
    <g data-id="a-tw">
      <path d="M150 198 L150 414" style={arr} marker-end="url(#tsf-a)" />
      <path d="M170 416 L170 200" style={arr} marker-end="url(#tsf-a)" />
      {pTw.map((p) => <g><rect class="box" x={p.x - p.w / 2} y={p.y - 10} width={p.w} height="20" rx="10" /><text class={p.mono ? 'mono' : ''} x={p.x} y={p.y} style="font-size:14px">{p.t}</text></g>)}
    </g>
    <g data-id="a-wb" class="hide">
      <path d="M184 318 L140 318" style={arr} marker-end="url(#tsf-a)" />
      <rect class="box" x="124" y="340" width="72" height="20" rx="10" />
      <text x="160" y="350" style="font-size:14px">락 재획득</text>
    </g>

    <!-- 상태 -->
    <g data-id="new">
      <rect class="box" x="16" y="8" width="90" height="34" rx="8" />
      <text x="61" y="25" style="font-weight:700">NEW</text>
    </g>
    <g data-id="term">
      <rect class="box" x="196" y="8" width="116" height="34" rx="8" />
      <text x="254" y="25" style="font-weight:700">TERMINATED</text>
    </g>
    <g data-id="run">
      <rect class="chip" x="24" y="96" width="272" height="100" rx="10" />
      <text x="160" y="113" style="font-weight:700">RUNNABLE</text>
    </g>
    <g data-id="inner">
      <rect class="frame" x="36" y="124" width="248" height="64" rx="8" />
      <rect class="box" x="52" y="130" width="84" height="26" rx="6" />
      <text x="94" y="143">준비</text>
      <text x="160" y="143">⇄</text>
      <rect class="box" x="184" y="130" width="84" height="26" rx="6" />
      <text x="226" y="143">실행</text>
      <text class="sub" x="160" y="174">OS는 나누지만 Java는 구분 안 함</text>
    </g>
    <g data-id="blk">
      <rect class="box" x="8" y="300" width="128" height="36" rx="8" />
      <text x="72" y="318" style="font-weight:700">BLOCKED</text>
    </g>
    <g data-id="wt">
      <rect class="box" x="184" y="300" width="128" height="36" rx="8" />
      <text x="248" y="318" style="font-weight:700">WAITING</text>
    </g>
    <g data-id="tw">
      <rect class="box" x="84" y="418" width="152" height="36" rx="8" />
      <text x="160" y="436" style="font-weight:700">TIMED_WAITING</text>
    </g>

    <rect data-id="hl-new" class="hl" x="13" y="5" width="96" height="40" rx="10" />
    <rect data-id="hl-run" class="hl" x="21" y="93" width="278" height="106" rx="12" />
    <rect data-id="hl-blk" class="hl" x="5" y="297" width="134" height="42" rx="10" />
    <rect data-id="hl-wt" class="hl" x="181" y="297" width="134" height="42" rx="10" />
    <rect data-id="hl-tw" class="hl" x="81" y="415" width="158" height="42" rx="10" />
    <rect data-id="hl-term" class="hl" x="193" y="5" width="122" height="40" rx="10" />
  </svg>
</Stepper>
