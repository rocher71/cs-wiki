---
// Deployment → ReplicaSet → Pod 계층, Pod 안 컨테이너 공유, Pod 재생성
import Stepper from '../Stepper.astro';
const top = ['dep', 'a1', 'rs', 'a2', 'lbl'];
const pods = ['p1', 'p2', 'p3'];
const steps = [
  { caption: 'Deployment에 "Pod 4개, 이미지 v1"이라고 원하는 상태를 적어요. 아직 실제로 도는 건 없어요.', show: ['dep', 'hl-dep'] },
  { caption: 'Deployment가 ReplicaSet web-abc12를 만들어요. abc12는 Pod 템플릿으로 계산한 해시(pod-template-hash)예요.', show: ['dep', 'a1', 'rs', 'hl-rs'] },
  { caption: 'ReplicaSet이 Pod 4개를 만들어요. 모두 app=web, pod-template-hash=abc12 라벨을 달아서 "내 Pod"를 알아봐요.', show: [...top, ...pods, 'p4', 'hl-pods'] },
  { caption: 'Pod 하나를 열어 보면: 앱 컨테이너와 사이드카가 IP 하나를 같이 쓰고, 서로 localhost로 통신해요.', show: [...top, ...pods, 'p4', 'zoom', 'hl-p1'] },
  { caption: 'Pod 하나가 사라졌어요(노드 고장, 삭제 등). 지금은 3개뿐이라 원하는 4개보다 1개 적어요.', show: [...top, ...pods, 'dead', 'n-dead', 'hl-p4'] },
  { caption: 'ReplicaSet이 바로 새 Pod를 만들어 다시 4개로 맞춰요. 고쳐 쓰는 게 아니라 새 이름·새 IP의 새 Pod예요.', show: [...top, ...pods, 'p4n', 'n-new', 'hl-p4'] },
];
const xs = [16, 92, 168, 244];
---
<Stepper title="Deployment → ReplicaSet → Pod" steps={steps}>
  <svg class="viz" viewBox="0 0 320 400" role="img" aria-label="Deployment가 ReplicaSet을 만들고, ReplicaSet이 Pod 4개를 만들어 유지한다. Pod 안의 컨테이너는 IP를 공유한다.">
    <defs>
      <marker id="drp-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    <g data-id="dep">
      <rect class="box" x="16" y="10" width="288" height="60" rx="10" />
      <text x="160" y="31" style="font-weight:700">Deployment: web</text>
      <text class="sub" x="160" y="53">replicas 4 · image v1</text>
    </g>
    <g data-id="a1">
      <line class="line" x1="160" y1="72" x2="160" y2="92" marker-end="url(#drp-arr)" />
      <text class="sub l" x="172" y="82">만듦</text>
    </g>
    <g data-id="rs">
      <rect class="box" x="16" y="94" width="288" height="60" rx="10" />
      <text x="160" y="115" style="font-weight:700">ReplicaSet: web-abc12</text>
      <text class="sub" x="160" y="137">pod-template-hash=abc12</text>
    </g>
    <g data-id="a2">
      <line class="line" x1="160" y1="156" x2="160" y2="174" marker-end="url(#drp-arr)" />
      <text class="sub l" x="172" y="165">4개 유지</text>
    </g>

    {['.11', '.12', '.13'].map((ip, i) => (
      <g data-id={`p${i + 1}`}>
        <rect class="chip" x={xs[i]} y="176" width="60" height="52" rx="8" />
        <text x={xs[i] + 30} y="193">Pod</text>
        <text class="sub" x={xs[i] + 30} y="213">IP {ip}</text>
      </g>
    ))}
    <g data-id="p4" class="hide">
      <rect class="chip" x="244" y="176" width="60" height="52" rx="8" />
      <text x="274" y="193">Pod</text><text class="sub" x="274" y="213">IP .14</text>
    </g>
    <g data-id="dead" class="hide">
      <rect class="err" x="244" y="176" width="60" height="52" rx="8" />
      <text class="err-t" x="274" y="193">✕</text><text class="err-t" x="274" y="213" style="font-size:14px">사라짐</text>
    </g>
    <g data-id="p4n" class="hide">
      <rect class="chip" x="244" y="176" width="60" height="52" rx="8" />
      <text x="274" y="193">새 Pod</text><text class="sub" x="274" y="213">IP .27</text>
    </g>
    <text data-id="lbl" class="sub" x="160" y="246">라벨 app=web · hash=abc12</text>

    <g data-id="zoom" class="hide">
      <rect class="frame" x="16" y="262" width="288" height="128" rx="10" />
      <text x="160" y="282" style="font-weight:700">첫 Pod 안 · IP 10.1.0.11 공유</text>
      <rect class="box" x="28" y="300" width="112" height="52" rx="8" />
      <text x="84" y="317">앱 컨테이너</text><text class="sub" x="84" y="337">:8080</text>
      <rect class="box" x="180" y="300" width="112" height="52" rx="8" />
      <text x="236" y="317">사이드카</text><text class="sub" x="236" y="337">로그 수집 등</text>
      <line class="line" x1="144" y1="326" x2="176" y2="326" marker-end="url(#drp-arr)" marker-start="url(#drp-arr)" />
      <text class="sub" x="160" y="372">localhost로 서로 호출</text>
    </g>
    <g data-id="n-dead" class="hide">
      <rect class="err" x="16" y="262" width="288" height="60" rx="10" />
      <text class="err-t" x="160" y="283">원하는 4 − 현재 3</text>
      <text class="err-t" x="160" y="305">= 1개 부족</text>
    </g>
    <g data-id="n-new" class="hide">
      <rect class="box" x="16" y="262" width="288" height="60" rx="10" />
      <text x="160" y="283">새 Pod: web-abc12-q8m3z</text>
      <text class="sub" x="160" y="305">새 이름 · 새 IP · 다시 4개</text>
    </g>

    <rect data-id="hl-dep" class="hl" x="12" y="6" width="296" height="68" rx="12" />
    <rect data-id="hl-rs" class="hl" x="12" y="90" width="296" height="68" rx="12" />
    <rect data-id="hl-pods" class="hl" x="12" y="172" width="296" height="60" rx="10" />
    <rect data-id="hl-p1" class="hl" x="12" y="172" width="68" height="60" rx="10" />
    <rect data-id="hl-p4" class="hl" x="240" y="172" width="68" height="60" rx="10" />
  </svg>
</Stepper>
