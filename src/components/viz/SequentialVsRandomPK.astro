---
// 순차 PK는 맨 오른쪽 리프에만 붙어 페이지가 거의 꽉 차고, 랜덤 PK는 중간 페이지를 쪼개 반쯤 빈 페이지가 생긴다.
import Stepper from '../Stepper.astro';
const acc = 'stroke:var(--sl-color-accent);stroke-width:3;fill:none';
const PW = 68, PH = 44, px = (i: number) => 12 + i * (PW + 8);
type P = { label: string; f: number; frac: string };
const seqA: P[] = [{ label: '1~15', f: .94, frac: '꽉 참' }, { label: '16~30', f: .94, frac: '꽉 참' }, { label: '31~38', f: .5, frac: '채우는 중' }];
const seqB: P[] = [{ label: '1~15', f: .94, frac: '15/16' }, { label: '16~30', f: .94, frac: '15/16' }, { label: '31~45', f: .94, frac: '15/16' }, { label: '46', f: .08, frac: '새 페이지' }];
const rndA: P[] = [{ label: '0~4', f: .94, frac: '꽉 참' }, { label: '5~9', f: .94, frac: '꽉 참' }, { label: 'a~f', f: .94, frac: '꽉 참' }];
const rndB: P[] = [{ label: '0~4', f: .94, frac: '꽉 참' }, { label: '5~7', f: .5, frac: '1/2' }, { label: '7c~9', f: .5, frac: '1/2' }, { label: 'a~f', f: .94, frac: '꽉 참' }];
const SY = 34, RY = 176;
const steps = [
  { caption: '순차 PK(AUTO_INCREMENT): 새 키는 항상 가장 큰 값이라 맨 오른쪽 리프 끝에 붙어요.', show: ['seqA', 'kSeq'] },
  { caption: '그 페이지가 차면 오른쪽에 새 페이지를 하나 붙여요. 앞 페이지들은 약 15/16 찬 채로 그대로 남아요.', show: ['seqB', 'nSeq'] },
  { caption: '랜덤 PK(UUIDv4 같은 값): 새 키 7c는 크기 순서상 이미 꽉 찬 중간 페이지에 들어가야 해요.', show: ['seqB', 'rndA', 'kRnd'] },
  { caption: '자리가 없으니 페이지를 둘로 쪼개 반씩 옮겨요(페이지 분할). 이게 반복되면 반쯤 빈 페이지가 여기저기 생겨요.', show: ['seqB', 'rndB', 'nRnd'] },
  { caption: '같은 행 수를 넣은 실험: 리프 페이지 9,901개 vs 13,897개, INSERT 시간 3.7초 vs 8.5초. 랜덤 쪽이 공간도 시간도 더 들어요.', show: ['seqB', 'rndB', 'bars'] },
];
---
<Stepper title="순차 PK vs 랜덤 PK: 리프 페이지에 새 키 넣기" steps={steps}>
  <svg class="viz" viewBox="0 0 320 432" role="img" aria-label="순차 PK는 오른쪽 끝에 새 페이지를 붙이고, 랜덤 PK는 중간 페이지를 분할해 반쯤 빈 페이지가 생기는 과정과 실험 결과">
    <defs>
      <marker id="svr-a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
    </defs>

    <text class="l" x="12" y="16" style="font-weight:700">순차 PK</text>
    <text class="l" x="12" y={RY - 18} style="font-weight:700">랜덤 PK</text>

    {[['seqA', seqA, SY], ['seqB', seqB, SY], ['rndA', rndA, RY], ['rndB', rndB, RY]].map(([id, pages, y]) => (
      <g data-id={id as string} class="hide">
        {(pages as P[]).map((p, i) => (
          <>
            <rect class="box" x={px(i)} y={y as number} width={PW} height={PH} rx="5" />
            <rect class="chip" x={px(i) + 3} y={(y as number) + 3} width={(PW - 6) * p.f} height={PH - 6} rx="3" />
            <text x={px(i) + PW / 2} y={(y as number) + PH / 2} style="font-size:14px">{p.label}</text>
            <text class="sub" x={px(i) + PW / 2} y={(y as number) + PH + 14}>{p.frac}</text>
          </>
        ))}
      </g>
    ))}

    <!-- 순차: 새 키 39가 오른쪽 끝으로 -->
    <g data-id="kSeq" class="hide">
      <rect class="chip" x="248" y="4" width="62" height="24" rx="4" />
      <text x="279" y="16" style="font-size:14px">새 키 39</text>
      <path d="M262 28 Q250 36 226 42" style={acc} marker-end="url(#svr-a)" />
    </g>
    <g data-id="nSeq" class="hide">
      <rect class="hl" x={px(3) - 3} y={SY - 3} width={PW + 6} height={PH + 6} rx="7" />
      <text class="sub" x="160" y={SY + PH + 38}>꽉 찬 페이지가 그대로, 분할 없음</text>
    </g>

    <!-- 랜덤: 새 키 7c가 가운데 꽉 찬 페이지로 -->
    <g data-id="kRnd" class="hide">
      <rect class="chip" x="248" y={RY - 30} width="62" height="24" rx="4" />
      <text x="279" y={RY - 18} style="font-size:14px">새 키 7c</text>
      <path d={`M256 ${RY - 6} Q200 ${RY - 4} ${px(1) + PW / 2 + 6} ${RY + 2}`} style={acc} marker-end="url(#svr-a)" />
      <text class="sub" x="160" y={RY + PH + 38}>들어갈 자리가 없어요 ✗</text>
    </g>
    <g data-id="nRnd" class="hide">
      <rect class="hl" x={px(1) - 3} y={RY - 3} width={PW * 2 + 14} height={PH + 6} rx="7" />
      <text class="sub" x="160" y={RY + PH + 38}>분할: 반씩 나뉨, 빈 공간 생김</text>
    </g>

    <!-- 실험 결과 -->
    <g data-id="bars" class="hide">
      <rect class="box" x="10" y="282" width="300" height="144" rx="8" />
      <text class="sub l" x="20" y="298">리프 페이지 수</text>
      <text class="sub l" x="20" y="320">순차</text>
      <rect class="chip" x="62" y="311" width="121" height="18" rx="3" />
      <text class="l" x="189" y="320" style="font-size:14px">9,901</text>
      <text class="sub l" x="20" y="342">랜덤</text>
      <rect class="bad" x="62" y="333" width="170" height="18" rx="3" />
      <text class="l" x="238" y="342" style="font-size:14px">13,897</text>
      <text class="sub l" x="20" y="366">INSERT 시간</text>
      <text class="sub l" x="20" y="386">순차</text>
      <rect class="chip" x="62" y="377" width="74" height="18" rx="3" />
      <text class="l" x="142" y="386" style="font-size:14px">3.7s</text>
      <text class="sub l" x="20" y="408">랜덤</text>
      <rect class="bad" x="62" y="399" width="170" height="18" rx="3" />
      <text class="l" x="238" y="408" style="font-size:14px">8.5s</text>
    </g>
  </svg>
</Stepper>
