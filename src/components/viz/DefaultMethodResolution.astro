---
// obj.hi() 호출 시 어느 hi()가 실행되나: 클래스 우선 → 더 구체적인 인터페이스 → 모호하면 컴파일 에러
import Stepper from '../Stepper.astro';
const steps = [
  { caption: 'obj.hi()를 호출했어요. 어느 hi()를 실행할지 차례대로 따져 봐요.', show: ['call', 'hl-call'] },
  { caption: '먼저 클래스와 그 부모 클래스들에 hi()가 있는지 봐요. 있으면 그걸 실행해요(클래스 우선).', show: ['call', 'q1', 'yes', 'hl-q1'] },
  { caption: '클래스 쪽에 없으면, 구현한 인터페이스들의 default hi()를 후보로 모아요. 여기선 A와, A를 상속한 B예요.', show: ['call', 'q1', 'no', 'cands', 'hl-cands'] },
  { caption: '다른 후보의 상위 인터페이스인 후보는 지워요. B가 A를 상속하니 A를 지우고 더 구체적인 B를 남겨요.', show: ['call', 'q1', 'no', 'cands', 'strike', 'hl-cands'] },
  { caption: '후보가 1개(B)만 남으면 B의 default hi()를 실행해요.', show: ['call', 'q1', 'no', 'cands', 'strike', 'one', 'hl-one'] },
  { caption: '만약 관계없는 C에도 hi()가 있으면 후보가 2개(B, C)라 컴파일 에러예요. 클래스가 직접 오버라이드하고 B.super.hi()처럼 골라 불러요.', show: ['call', 'q1', 'no', 'cands', 'strike', 'c', 'err', 'hl-err'] },
];
---
<Stepper title="default 메서드 충돌, 누가 이기나" steps={steps}>
  <svg class="viz" viewBox="0 0 320 440" role="img" aria-label="hi() 호출 시 실행할 메서드를 고르는 순서">
    <defs>
      <marker id="dmr-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    <g data-id="call">
      <rect class="box" x="60" y="6" width="200" height="38" rx="8" />
      <text x="160" y="25"><tspan class="mono" style="font-family:var(--sl-font-mono,monospace)">obj.hi()</tspan> 호출</text>
      <line class="line" x1="104" y1="44" x2="104" y2="62" marker-end="url(#dmr-arr)" />
    </g>

    <g data-id="q1">
      <rect class="box" x="8" y="64" width="192" height="58" rx="8" />
      <text x="104" y="83">클래스 계층에</text>
      <text x="104" y="105">hi()가 있나?</text>
    </g>
    <g data-id="yes">
      <line class="line" x1="200" y1="93" x2="218" y2="93" marker-end="url(#dmr-arr)" />
      <rect class="chip" x="220" y="64" width="92" height="58" rx="8" />
      <text x="266" y="83">있음: 실행</text>
      <text class="sub" x="266" y="105">클래스 우선</text>
    </g>
    <g data-id="no">
      <line class="line" x1="104" y1="122" x2="104" y2="146" marker-end="url(#dmr-arr)" />
      <text class="sub l" x="112" y="134">없음</text>
    </g>

    <g data-id="cands">
      <rect class="frame" x="8" y="148" width="304" height="110" rx="10" />
      <text class="sub" x="160" y="166">default hi() 후보</text>
      <rect class="chip" x="24" y="184" width="76" height="40" rx="6" />
      <text class="mono" x="62" y="204">A</text>
      <rect class="chip" x="122" y="184" width="76" height="40" rx="6" />
      <text class="mono" x="160" y="204">B</text>
      <line class="line" x1="122" y1="204" x2="102" y2="204" marker-end="url(#dmr-arr)" />
      <text class="sub" x="111" y="242">B extends A</text>
    </g>
    <g data-id="strike" class="hide">
      <line x1="20" y1="222" x2="104" y2="186" stroke="var(--sl-color-red)" stroke-width="3" />
      <text class="err-t" x="62" y="176" style="font-size:14px">지움</text>
    </g>
    <g data-id="c" class="hide">
      <rect class="chip" x="220" y="184" width="76" height="40" rx="6" />
      <text class="mono" x="258" y="204">C</text>
      <text class="sub" x="258" y="242">관계없음</text>
    </g>

    <line class="line" data-id="no" x1="160" y1="258" x2="160" y2="276" marker-end="url(#dmr-arr)" />

    <g data-id="one" class="hide">
      <rect class="chip" x="40" y="278" width="240" height="44" rx="8" />
      <text x="160" y="300">1개(B) 남음 → B의 hi() 실행</text>
    </g>

    <g data-id="err" class="hide">
      <rect class="err" x="8" y="278" width="304" height="44" rx="8" />
      <text class="err-t" x="160" y="300">2개(B, C) → 컴파일 에러</text>
      <text class="sub" x="160" y="342">해결: 클래스가 직접 오버라이드</text>
      <rect class="box" x="8" y="358" width="304" height="76" rx="6" />
      <text class="mono l" x="18" y="376">public String hi() {"{"}</text>
      <text class="mono l" x="34" y="396">return <tspan class="hi">B.super.hi()</tspan>;</text>
      <text class="mono l" x="18" y="416">{"}"}</text>
    </g>

    <rect data-id="hl-call" class="hl" x="56" y="2" width="208" height="46" rx="10" />
    <rect data-id="hl-q1" class="hl" x="4" y="60" width="312" height="66" rx="10" />
    <rect data-id="hl-cands" class="hl" x="4" y="144" width="312" height="118" rx="12" />
    <rect data-id="hl-one" class="hl" x="36" y="274" width="248" height="52" rx="10" />
    <rect data-id="hl-err" class="hl" x="4" y="274" width="312" height="164" rx="10" />
  </svg>
</Stepper>
