---
// VM vs 컨테이너 층 구조. 위: VM(게스트 OS가 여러 벌), 아래: 컨테이너(호스트 커널 한 벌 공유).
// 마지막 단계: Mac에서는 컨테이너 쪽 전체가 Docker Desktop의 리눅스 VM 안에 들어간다.
import Stepper from '../Stepper.astro';
const vms = [4, 164];
const cts = [4, 110, 216];
const steps = [
  { caption: '바닥은 둘 다 같아요. 실제 하드웨어(CPU·메모리·디스크)예요.', show: ['hw-v', 'hw-c'] },
  { caption: 'VM: 하드웨어 위에 하이퍼바이저가 있고, VM마다 게스트 OS(커널 포함)를 따로 부팅해요. OS가 VM 개수만큼 여러 벌이에요.', show: ['hw-v', 'hw-c', 'hv', 'vm', 'hl-vm'] },
  { caption: '컨테이너: 호스트 OS 커널은 한 벌뿐이에요. 그 위 컨테이너 엔진(dockerd → containerd → runc)이 컨테이너를 띄우고, 컨테이너에는 라이브러리와 앱만 들어가요.', show: ['hw-v', 'hw-c', 'hv', 'vm', 'kern', 'eng', 'ct'] },
  { caption: '핵심: 컨테이너들은 커널 한 벌을 함께 써요. 그래서 가볍고 빨리 뜨지만, 커널에 문제가 생기면 모두 영향을 받아 격리는 VM보다 약해요.', show: ['hw-v', 'hw-c', 'hv', 'vm', 'kern', 'eng', 'ct', 'hl-k'] },
  { caption: 'Mac에서는 리눅스 커널이 없어서, Docker Desktop이 macOS 위에 리눅스 VM을 하나 띄우고 그 안에 컨테이너 쪽 그림 전체를 넣어요.', show: ['hw-v', 'hw-m', 'hv', 'vm', 'kern', 'eng', 'ct', 'mac'] },
];
---
<Stepper title="VM과 컨테이너는 어디까지 따로 갖나" steps={steps}>
  <svg class="viz" viewBox="0 0 320 466" role="img" aria-label="VM은 하드웨어 위 하이퍼바이저 위에 VM마다 게스트 OS·라이브러리·앱을 갖고, 컨테이너는 하드웨어 위 호스트 커널 한 벌과 컨테이너 엔진 위에 라이브러리·앱만 갖는다. Mac에서는 macOS 위 리눅스 VM 안에 컨테이너 쪽 전체가 들어간다">
    <!-- VM -->
    <text class="l" x="4" y="12" style="font-weight:700">VM</text>
    <g data-id="vm">
      {vms.map((x, i) => (
        <g>
          <rect class="frame" x={x} y="24" width="152" height="98" rx="6" />
          <rect class="box" x={x + 4} y="28" width="144" height="28" rx="4" />
          <text x={x + 76} y="42">앱 {i + 1}</text>
          <rect class="box" x={x + 4} y="60" width="144" height="28" rx="4" />
          <text x={x + 76} y="74">라이브러리</text>
          <rect class="chip" x={x + 4} y="92" width="144" height="26" rx="4" />
          <text x={x + 76} y="105">게스트 OS(커널)</text>
        </g>
      ))}
    </g>
    <g data-id="hl-vm" class="hide">
      {vms.map((x) => <rect class="hl" x={x + 1} y="89" width="150" height="32" rx="6" />)}
    </g>
    <g data-id="hv">
      <rect class="box" x="4" y="128" width="312" height="28" rx="4" />
      <text x="160" y="142">하이퍼바이저</text>
    </g>
    <g data-id="hw-v">
      <rect class="bad" x="4" y="162" width="312" height="28" rx="4" />
      <text x="160" y="176">하드웨어</text>
    </g>

    <!-- 컨테이너 -->
    <text class="l" x="8" y="222" style="font-weight:700">컨테이너</text>
    <g data-id="mac" class="hide">
      <rect class="frame" x="1" y="208" width="318" height="182" rx="8" style="stroke:var(--sl-color-accent);stroke-width:2" />
      <text class="hi" x="312" y="222" style="text-anchor:end;font-size:14px">리눅스 VM (Docker Desktop)</text>
      <rect class="box" x="4" y="396" width="312" height="28" rx="4" />
      <text x="160" y="410">macOS</text>
    </g>
    <g data-id="ct">
      {cts.map((x, i) => (
        <g>
          <rect class="frame" x={x} y="234" width="100" height="66" rx="6" />
          <rect class="box" x={x + 4} y="238" width="92" height="28" rx="4" />
          <text x={x + 50} y="252">앱 {i + 1}</text>
          <rect class="box" x={x + 4} y="268" width="92" height="28" rx="4" />
          <text x={x + 50} y="282">라이브러리</text>
        </g>
      ))}
    </g>
    <g data-id="eng">
      <rect class="box" x="4" y="306" width="312" height="44" rx="4" />
      <text x="160" y="319">컨테이너 엔진</text>
      <text class="mono sub" x="160" y="339">dockerd → containerd → runc</text>
    </g>
    <g data-id="kern">
      <rect class="chip" x="4" y="356" width="312" height="28" rx="4" />
      <text x="160" y="370">호스트 OS 커널 (한 벌, 모두 공유)</text>
    </g>
    <rect data-id="hl-k" class="hl" x="1" y="353" width="318" height="34" rx="6" />
    <!-- 하드웨어 위치별 복제: 1~4단계는 커널 바로 아래, 5단계(Mac)는 macOS 아래 -->
    <g data-id="hw-c" class="hide">
      <rect class="bad" x="4" y="390" width="312" height="28" rx="4" />
      <text x="160" y="404">하드웨어</text>
    </g>
    <g data-id="hw-m" class="hide">
      <rect class="bad" x="4" y="432" width="312" height="28" rx="4" />
      <text x="160" y="446">하드웨어</text>
    </g>
  </svg>
</Stepper>
