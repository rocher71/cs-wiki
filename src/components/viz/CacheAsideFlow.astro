---
// Cache-Aside 시퀀스: 앱 | 캐시 | DB 세 생명선. 위 = 읽기(hit/miss 분기), 아래 = 쓰기(DB UPDATE → DEL).
import Stepper from '../Stepper.astro';
const X = { app: 55, cache: 160, db: 265 };
type Msg = { id: string; from: keyof typeof X; to: keyof typeof X; y: number; t: string; back?: boolean; cls?: string };
const msgs: Msg[] = [
  { id: 'r1', from: 'app', to: 'cache', y: 82, t: 'GET key' },
  { id: 'hit', from: 'cache', to: 'app', y: 124, t: 'hit: 값', back: true },
  { id: 'miss', from: 'cache', to: 'app', y: 124, t: 'miss: 없음', back: true, cls: 'err-t' },
  { id: 'r3', from: 'app', to: 'db', y: 166, t: 'SELECT' },
  { id: 'r3', from: 'db', to: 'app', y: 196, t: '값', back: true },
  { id: 'r4', from: 'app', to: 'cache', y: 238, t: 'SET key 값 EX 600' },
  { id: 'r6', from: 'app', to: 'db', y: 350, t: 'UPDATE' },
  { id: 'r7', from: 'app', to: 'cache', y: 392, t: 'DEL key' },
];
// 강조 테두리(단계마다 바뀐 줄)
const hl: [string, number, number][] = [['h1', 56, 34], ['h2', 98, 34], ['h3', 140, 64], ['h4', 212, 34], ['h5', 262, 34], ['h6', 326, 32], ['h7', 366, 34]];
const read = ['r1', 'miss', 'r3', 'r4', 'r5'];
const steps = [
  { caption: '읽기 요청이 오면 앱은 DB가 아니라 캐시에 먼저 GET key를 보내요.', show: ['r1', 'h1'] },
  { caption: '캐시에 있으면(hit) 캐시가 값을 바로 돌려줘요. DB는 안 가고 여기서 끝이에요.', show: ['r1', 'hit', 'h2'] },
  { caption: '캐시에 없으면(miss) 빈손으로 돌아와요. 이제부터가 miss 경로예요.', show: ['r1', 'miss', 'h2'] },
  { caption: '앱이 DB에 SELECT로 직접 물어 값을 받아 와요.', show: ['r1', 'miss', 'r3', 'h3'] },
  { caption: '앱이 받은 값을 캐시에 SET하면서 TTL(EX 600 = 600초 뒤 자동 삭제)을 같이 걸어요. 다음 읽기는 hit이에요.', show: ['r1', 'miss', 'r3', 'r4', 'h4'] },
  { caption: '사용자에게 응답해요. miss 한 번에 캐시 → DB → 캐시로 왕복 3번이 들어요(miss penalty).', show: [...read, 'h5'] },
  { caption: '값을 고칠 때는 앱이 DB를 먼저 UPDATE해요.', show: ['wr', 'r6', 'h6'] },
  { caption: '그다음 캐시의 key를 DEL로 지워요. 다음 읽기는 miss가 나서 DB의 새 값으로 다시 채워져요.', show: ['wr', 'r6', 'r7', 'h7', 'note'] },
];
const W = 43;
---
<Stepper title="Cache-Aside: 읽을 때 채우고, 쓸 때 지우기" steps={steps}>
  <svg class="viz caf" viewBox="0 0 320 470" role="img" aria-label="앱이 캐시에 GET, hit이면 바로 반환, miss면 DB SELECT 후 캐시에 SET EX로 채우고 응답. 쓰기는 DB UPDATE 후 캐시 DEL.">
    <defs>
      <marker id="caf-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" /></marker>
      <marker id="caf-g" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-2)" /></marker>
    </defs>

    {Object.entries({ app: '앱', cache: '캐시(Redis)', db: 'DB' }).map(([k, t]) => (
      <g>
        <line class="life" x1={X[k as keyof typeof X]} y1="46" x2={X[k as keyof typeof X]} y2="420" />
        <rect class={k === 'cache' ? 'chip' : 'box'} x={X[k as keyof typeof X] - W} y="10" width={W * 2} height="36" rx="8" />
        <text x={X[k as keyof typeof X]} y="28" style="font-weight:700;font-size:14px">{t}</text>
      </g>
    ))}

    {hl.map(([id, y, h]) => <rect data-id={id} class="hl" x="2" y={y} width="316" height={h} rx="8" />)}

    {msgs.map((m) => {
      const x1 = X[m.from], x2 = X[m.to], d = x2 > x1 ? -3 : 3;
      return (
        <g data-id={m.id} class={m.id === 'hit' || m.id === 'miss' ? 'hide' : ''}>
          <line x1={x1} y1={m.y} x2={x2 + d} y2={m.y} class={m.back ? 'ret' : 'req'} marker-end={`url(#caf-${m.back ? 'g' : 'a'})`} />
          <text class={`halo ${m.back ? m.cls ?? '' : 'mono'}`} x={(x1 + x2) / 2} y={m.y - 11} style="font-size:14px">{m.t}</text>
        </g>
      );
    })}

    <g data-id="r5">
      <rect class="chip" x="6" y="266" width="140" height="26" rx="13" />
      <text x="76" y="279" style="font-size:14px">사용자에게 응답</text>
    </g>

    <g data-id="wr">
      <line class="line" x1="10" y1="314" x2="310" y2="314" style="stroke-dasharray:4 4" />
      <rect class="badge" x="110" y="302" width="100" height="24" rx="12" />
      <text class="on-badge" x="160" y="314">쓰기 경로</text>
    </g>

    <g data-id="note" class="hide">
      <rect class="box" x="10" y="424" width="300" height="40" rx="8" />
      <text x="160" y="444" style="font-size:14px">다음 GET은 miss → DB 새 값으로 채움</text>
    </g>
  </svg>
</Stepper>

<style>
  .caf .life { stroke: var(--sl-color-gray-4); stroke-width: 1.4; stroke-dasharray: 3 4; }
  .caf .req { stroke: var(--sl-color-accent); stroke-width: 2; }
  .caf .ret { stroke: var(--sl-color-gray-2); stroke-width: 1.8; stroke-dasharray: 5 4; }
  /* 생명선 위에 글자가 겹쳐도 읽히게 배경색 테두리 */
  .caf .halo { paint-order: stroke; stroke: var(--sl-color-gray-7, var(--sl-color-black)); stroke-width: 5px; stroke-linejoin: round; }
</style>
