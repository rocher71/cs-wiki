---
// DB 리더 장애 조치(failover) 5단계: 정상 → 타임아웃 → B 승격(A에만 있던 쓰기 유실) → A 복귀로 스플릿 브레인 → 펜싱 후 재합류.
// 노드 역할 글자·아래 정리 상자처럼 같은 자리에 번갈아 나오는 요소는 class="hide".
import Stepper from '../Stepper.astro';
const steps = [
  { caption: '정상: 리더 A만 쓰기를 받고, 팔로워 B·C에 변경을 보내요. 비동기라 B는 #100까지, C는 #99까지만 받았어요.', show: ['wA', 'repAB', 'repAC', 'aLeader', 'bFol', 'cFol'] },
  { caption: 'A가 응답하지 않아요. 정해 둔 타임아웃(예: 30초)이 지나면 "A가 죽었다"고 판단해요. 정말 죽었는지, 잠깐 느린 건지는 알 수 없어요.', show: ['aX', 'timer', 'bFol', 'cFol'] },
  { caption: '가장 최신인 B를 새 리더로 올려요. 클라이언트와 C는 이제 B를 바라봐요. A에만 있던 #101은 B에 없어서 사라져요(유실).', show: ['aX', 'wB', 'repBC', 'bLeader', 'cFol', 'nLost'] },
  { caption: '그런데 A가 네트워크가 회복돼 돌아와 "내가 리더"라며 쓰기를 받아요. A와 B 둘 다 리더라서 같은 데이터가 양쪽에서 다르게 바뀌어요. 이게 스플릿 브레인이에요.', show: ['wA', 'wB', 'repBC', 'aZombie', 'bLeader', 'cFol', 'nSplit'] },
  { caption: '대응: 펜싱으로 A의 쓰기를 막고 강제로 팔로워로 내려요. A는 B의 데이터를 받아 따라가고, B만 리더로 남아요.', show: ['wB', 'repBC', 'repBA', 'aFenced', 'bLeader', 'cFol', 'nFence'] },
];
---
<Stepper title="리더 장애 조치와 스플릿 브레인" steps={steps}>
  <svg class="viz" viewBox="0 0 320 400" role="img" aria-label="클라이언트 아래에 리더 A, 그 아래에 팔로워 B와 C가 있는 그림. A가 응답하지 않아 타임아웃 후 가장 최신인 B가 새 리더가 되고 A에만 있던 쓰기는 유실된다. A가 돌아와 리더처럼 쓰기를 받으면 리더가 둘인 스플릿 브레인이 되고, 펜싱으로 A를 막아 B의 팔로워로 되돌린다.">
    <defs>
      <marker id="fsb-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
      <marker id="fsb-arr-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
    </defs>

    <!-- 클라이언트 -->
    <rect class="box" x="110" y="6" width="100" height="36" rx="6" /><text x="160" y="25">클라이언트</text>

    <!-- 쓰기 화살표 -->
    <g data-id="wA">
      <line class="line acc" x1="160" y1="42" x2="160" y2="94" marker-end="url(#fsb-arr-a)" />
      <text class="sub" x="190" y="68">쓰기</text>
    </g>
    <g data-id="wB" class="hide">
      <path class="line acc" d="M110 24 H40 V240" marker-end="url(#fsb-arr-a)" />
      <text class="sub" x="72" y="12">쓰기</text>
    </g>

    <!-- 노드 A -->
    <rect class="box" x="110" y="96" width="100" height="62" rx="8" />
    <text x="160" y="116"><tspan font-weight="700">A</tspan></text>
    <text class="sub" x="160" y="146">#1~101</text>
    <text data-id="aLeader" class="hi hide" x="160" y="131">리더</text>
    <text data-id="aZombie" class="err-t hide" x="160" y="131">"내가 리더"</text>
    <text data-id="aFenced" class="hide" x="160" y="131">팔로워</text>
    <g data-id="aX" class="hide">
      <rect class="err" x="110" y="96" width="100" height="62" rx="8" />
      <path class="x" d="M125 104 L195 150 M195 104 L125 150" />
      <text class="err-t" x="160" y="127">응답 없음</text>
    </g>
    <g data-id="timer" class="hide">
      <rect class="chip" x="222" y="102" width="92" height="50" rx="8" />
      <text x="268" y="119">타임아웃</text>
      <text class="sub" x="268" y="138">30초 경과</text>
    </g>

    <!-- 복제 화살표 -->
    <line data-id="repAB" class="line hide" x1="135" y1="158" x2="88" y2="238" marker-end="url(#fsb-arr)" />
    <line data-id="repAC" class="line hide" x1="185" y1="158" x2="232" y2="238" marker-end="url(#fsb-arr)" />
    <line data-id="repBC" class="line hide" x1="132" y1="272" x2="186" y2="272" marker-end="url(#fsb-arr)" />
    <g data-id="repBA" class="hide">
      <line class="line acc" x1="92" y1="240" x2="128" y2="162" marker-end="url(#fsb-arr-a)" />
      <text class="hi" x="200" y="200">B를 따라감</text>
    </g>

    <!-- 노드 B -->
    <rect class="box" x="30" y="242" width="100" height="62" rx="8" />
    <text x="80" y="262"><tspan font-weight="700">B</tspan></text>
    <text class="sub" x="80" y="292">#1~100</text>
    <text data-id="bFol" class="hide" x="80" y="277">팔로워</text>
    <text data-id="bLeader" class="hi hide" x="80" y="277">새 리더</text>

    <!-- 노드 C -->
    <rect class="box" x="190" y="242" width="100" height="62" rx="8" />
    <text x="240" y="262"><tspan font-weight="700">C</tspan></text>
    <text data-id="cFol" x="240" y="277">팔로워</text>
    <text class="sub" x="240" y="292">#1~99</text>

    <!-- 아래 정리 상자 (같은 자리, 번갈아) -->
    <g data-id="nLost" class="hide"><rect class="err" x="10" y="322" width="300" height="70" rx="8" /><text class="err-t" x="160" y="345">#101은 A에만 있었음</text><text class="sub" x="160" y="370">B가 리더가 되며 유실</text></g>
    <g data-id="nSplit" class="hide"><rect class="err" x="10" y="322" width="300" height="70" rx="8" /><text class="err-t" x="160" y="345">스플릿 브레인: 리더가 둘</text><text class="sub" x="160" y="370">A·B가 따로 쓰기 → 데이터 갈라짐</text></g>
    <g data-id="nFence" class="hide"><rect class="chip" x="10" y="322" width="300" height="70" rx="8" /><text x="160" y="345">A 쓰기 차단 · 강제 강등</text><text class="sub" x="160" y="370">B의 팔로워로 재합류</text></g>
  </svg>
</Stepper>

<style>
  .acc { stroke: var(--sl-color-accent) !important; stroke-width: 2 !important; }
  .x { stroke: var(--sl-color-red); stroke-width: 3; fill: none; opacity: .55; }
</style>
