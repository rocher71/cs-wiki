---
// 30만 행에서 email 한 건 찾기: 인덱스 없음(전부 읽음) vs 있음(정렬된 인덱스로 1건). 숫자는 MySQL 9.6.0 실험 1회값.
import Stepper from '../Stepper.astro';
const RY = 96, RH = 28;
const rows = ['행 1', '행 2', '행 3', '⋮', '행 300,000'];
const idx = ['user000001', '⋮', 'user123456', '⋮', 'user300000'];
const steps = [
  { caption: "30만 행 회원 테이블에서 email = 'user123456@ex.com'인 회원을 찾아요.", show: [] },
  { caption: '인덱스가 없으면 1번 행부터 30만 번째 행까지 전부 확인해요. 실험에서 30만 행을 읽고 1건을 찾는 데 약 46ms 걸렸어요.', show: ['scanL', 'resL'] },
  { caption: 'email 인덱스가 있으면 정렬된 인덱스에서 위치를 바로 찾아 그 행 1건만 읽어요. 실험에서 1행, 약 0.007ms였어요.', show: ['scanL', 'resL', 'hlIdx', 'arrR', 'rowR', 'resR'] },
];
---
<Stepper title="풀 스캔 vs 인덱스" steps={steps}>
  <svg class="viz" viewBox="0 0 320 352" role="img" aria-label="인덱스가 없으면 30만 행을 모두 읽고, 인덱스가 있으면 1행만 읽는 비교">
    <defs>
      <marker id="fs-a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
    </defs>
    <rect class="box" x="10" y="8" width="300" height="36" rx="8" />
    <text x="160" y="27" style="font-size:14px">email = 'user123456@ex.com'</text>

    <line class="frame" x1="160" y1="56" x2="160" y2="344" />
    <text x="80" y="72" style="font-weight:700">인덱스 없음</text>
    <text x="240" y="72" style="font-weight:700">인덱스 있음</text>
    <text class="sub" x="80" y="88" style="font-size:14px">테이블</text>
    <text class="sub" x="240" y="88" style="font-size:14px">email 인덱스 (정렬)</text>

    {rows.map((r, i) => (
      <g>
        <rect class="box" x="15" y={RY + 4 + i * RH} width="130" height={RH - 4} rx="4" />
        <text x="80" y={RY + 16 + i * RH} style="font-size:14px">{r}</text>
      </g>
    ))}
    {idx.map((r, i) => (
      <g>
        <rect class="box" x="175" y={RY + 4 + i * RH} width="130" height={RH - 4} rx="4" />
        <text x="240" y={RY + 16 + i * RH} style="font-size:14px">{r}</text>
      </g>
    ))}

    <!-- 왼쪽: 전부 훑기 -->
    <rect data-id="scanL" class="hl" x="11" y={RY} width="138" height={rows.length * RH + 4} rx="8" />
    <g data-id="resL" class="hide">
      <text class="sub" x="80" y="260">30만 행 전부 읽음</text>
      <rect class="bad" x="20" y="300" width="120" height="34" rx="17" />
      <text x="80" y="318" style="font-weight:700">약 46ms</text>
    </g>

    <!-- 오른쪽: 위치 찾아 1건 -->
    <rect data-id="hlIdx" class="hl" x="171" y={RY + 2 * RH} width="138" height={RH + 4} rx="6" />
    <!-- 인덱스 칸 오른쪽에서 테이블 행으로 (인덱스 아래 칸을 가리지 않게 바깥으로 돌아감) -->
    <path data-id="arrR" class="hide" d="M309 168 C318 168 318 264 299 264" style="stroke:var(--sl-color-accent);stroke-width:3;fill:none" marker-end="url(#fs-a)" />
    <g data-id="rowR" class="hide">
      <rect class="chip" x="185" y="250" width="110" height="28" rx="6" />
      <text x="240" y="264" style="font-size:14px">그 행 1건</text>
    </g>
    <g data-id="resR" class="hide">
      <rect class="badge" x="180" y="300" width="120" height="34" rx="17" />
      <text class="on-badge" x="240" y="318">약 0.007ms</text>
    </g>
  </svg>
</Stepper>
