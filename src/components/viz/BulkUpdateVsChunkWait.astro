---
// 한 문장 UPDATE vs 청크 vs 청크+쉼: 락 쥔 구간과 다른 요청 최대 대기. 수치는 본문 실험 표와 같음.
// ponytail: 청크 100개는 20칸으로 줄여 그림(칸 폭·간격 비율은 실측 시간 비율 그대로)
import Stepper from '../Stepper.astro';
const X0 = 16, S = 60;                 // x 시작, 1초당 px
const X = (t: number) => X0 + t * S;
const R = (i: number) => 46 + i * 108;  // 행 i의 위쪽 y
const blocks = (total: number, busy: number) =>
  Array.from({ length: 20 }, (_, k) => ({ x: X((total / 20) * k), w: (total / 20) * busy * S }));
const c2 = blocks(2.38, 0.8), c3 = blocks(4.71, 2.38 / 4.71);
const base = ['axis'];
const steps = [
  { caption: '한 문장 UPDATE: 약 2초 내내 한 트랜잭션이라 잠긴 행이 0에서 100만까지 늘기만 해요. 중간에 온 서비스 요청은 커밋될 때까지 최대 약 2초, 즉 끝날 때까지 기다려요.', show: [...base, 'r1', 'h1'] },
  { caption: '1만 행 청크 100번, 청크마다 커밋(쉬지 않음): 전체는 2.38초로 비슷해요. 락을 청크 하나만큼만 쥐니 최대 대기는 0.11초예요.', show: [...base, 'r1', 'r2', 'h2'] },
  { caption: '청크 사이에 20ms씩 쉬면 전체는 4.71초로 2배가 돼요. 그 틈에 서비스 요청이 먼저 지나가서 최대 대기는 0.03초까지 줄어요.', show: [...base, 'r1', 'r2', 'r3', 'h3'] },
  { caption: '정리: 총 시간은 2.0 → 2.38 → 4.71초로 같거나 늘어요. 대신 다른 요청 최대 대기가 2초 → 0.1초 → 0.03초로 줄어요. 목표는 빨리 끝내기가 아니라 기다림 쪼개기예요.', show: [...base, 'r1', 'r2', 'r3', 'sum', 'h4'] },
];
---
<Stepper title="한 문장 vs 청크: 다른 요청이 기다리는 시간" steps={steps}>
  <svg class="viz buc" viewBox="0 0 320 446" role="img" aria-label="100만 행 실험 예시. 한 문장 UPDATE는 전체 약 2초, 다른 세션 최대 대기도 약 2초. 1만 행 청크 100번은 전체 2.38초, 최대 대기 0.11초. 청크 사이 20ms 쉼은 전체 4.71초, 최대 대기 0.03초.">
    <g data-id="axis">
      <text class="sub l" x="8" y="10">시간(초) · 100만 행 실험 예시</text>
      {[0, 1, 2, 3, 4].map((t) => <text class="sub" x={X(t)} y="28">{t}</text>)}
      <line class="line" x1={X0} y1="38" x2="310" y2="38" />
    </g>

    <g data-id="r1">
      <text class="l" x="8" y={R(0) + 10}>① 한 문장 UPDATE</text>
      <polygon class="chip" points={`${X(0)},${R(0) + 52} ${X(2)},${R(0) + 22} ${X(2)},${R(0) + 52}`} />
      <text class="sub l" x={X(2) + 8} y={R(0) + 38}>잠긴 행 0→100만</text>
      <rect class="err" x={X(0)} y={R(0) + 58} width={2.02 * S} height="14" />
      <text class="err-t l" x={X(2.02) + 8} y={R(0) + 66}>대기 약 2초</text>
      <text class="l" x="8" y={R(0) + 86}>전체 <tspan class="hi">약 2초</tspan></text>
    </g>

    <g data-id="r2">
      <text class="l" x="8" y={R(1) + 10}>② 1만 행 청크 × 100</text>
      {c2.map((b) => <rect class="chip" x={b.x} y={R(1) + 40} width={b.w} height="12" />)}
      <text class="sub l" x={X(2.38) + 8} y={R(1) + 46}>청크마다 커밋</text>
      <rect class="err" x={X(1)} y={R(1) + 58} width={0.11 * S} height="14" />
      <text class="err-t l" x={X(1.11) + 8} y={R(1) + 66}>최대 대기 0.11초</text>
      <text class="l" x="8" y={R(1) + 86}>전체 <tspan class="hi">2.38초</tspan></text>
    </g>

    <g data-id="r3">
      <text class="l" x="8" y={R(2) + 10}>③ 청크 사이 20ms 쉼</text>
      {c3.map((b) => <rect class="chip" x={b.x} y={R(2) + 40} width={b.w} height="12" />)}
      <rect class="err" x={X(2)} y={R(2) + 58} width="3" height="14" />
      <text class="err-t l" x={X(2) + 11} y={R(2) + 66}>최대 대기 0.03초</text>
      <text class="l" x="8" y={R(2) + 86}>전체 <tspan class="hi">4.71초</tspan> (빈칸 = 쉼)</text>
    </g>

    <g data-id="sum" class="hide">
      <rect class="box" x="8" y="374" width="304" height="62" rx="8" />
      <text x="160" y="394">최대 대기 <tspan class="err-t">약 2 → 0.11 → 0.03초</tspan></text>
      <text class="sub" x="160" y="418">총 시간은 2.0 → 2.38 → 4.71초</text>
    </g>

    {[0, 1, 2].map((i) => <rect data-id={`h${i + 1}`} class="hl" x="4" y={R(i) - 6} width="312" height="102" rx="8" />)}
    <rect data-id="h4" class="hl" x="4" y="370" width="312" height="70" rx="10" />
  </svg>
</Stepper>
