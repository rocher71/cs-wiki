---
// 앱의 요청 하나가 API 게이트웨이에서 라우트 찾기 → JWT 검증 → 처리율 제한 → 인스턴스 선택을 거쳐 주문 서비스에 닿고, 응답이 정리되어 돌아오는 길. 각 검사의 실패 응답(401/429/503) 병기.
import Stepper from '../Stepper.astro';
const rows = [
  ['r1', '① 라우트 찾기', '/orders/** → 주문', true, null],
  ['r2', '② JWT 검증', '서명·만료 확인', false, ['e401', '401', '인증 실패']],
  ['r3', '③ 처리율 제한', 'Redis 토큰 버킷', false, ['e429', '429', '요청 초과']],
  ['r4', '④ 인스턴스 고르기', '살아 있는 것 중 1개', false, ['e503', '503', '갈 곳 없음']],
] as const;
const RY = (i: number) => 104 + i * 56;
const s1 = ['app', 'req', 'aReq'];
const s2 = [...s1, 'r1'];
const s3 = [...s2, 'r2'];
const s4 = [...s3, 'r3'];
const s5 = [...s4, 'r4', 'inst', 'aDown'];
const steps = [
  { caption: '앱은 주소 api.shop.com 하나만 알아요. 여기로 GET /orders/42 요청을 토큰(JWT)과 함께 보내요.', show: [...s1, 'hlApp'] },
  { caption: '게이트웨이가 경로 규칙표에서 /orders/** 규칙을 찾아요. 이 요청은 "주문 서비스로 보낼 것"으로 정해져요.', show: [...s2, 'hlR1'] },
  { caption: 'JWT의 서명과 만료 시간을 확인해요. 위조됐거나 만료됐으면 주문 서비스까지 가지 않고 여기서 401로 돌려보내요.', show: [...s3, 'e401', 'hlR2'] },
  { caption: 'Redis의 토큰 버킷에서 이 사용자의 남은 토큰을 확인해요. 너무 자주 보냈으면 429(요청이 너무 많음)로 막아요.', show: [...s4, 'e429', 'hlR3'] },
  { caption: '주문 서비스 인스턴스 중 살아 있는 하나(주소 B)를 골라 넘겨요. 고를 인스턴스가 하나도 없으면 503으로 응답해요.', show: [...s5, 'e503', 'hlR4', 'hlInst'] },
  { caption: '주문 서비스의 응답을 받아 내부용 헤더를 지우는 등 정리한 뒤 앱에 돌려줘요. 앱은 안쪽에 서버가 몇 대인지 끝까지 몰라요.', show: [...s5.filter((x) => x !== 'req'), 'res', 'aUp', 'aRes', 'hlApp', 'hlGw'] },
];
---
<Stepper title="요청 하나가 API 게이트웨이를 지나는 길" steps={steps}>
  <svg class="viz" viewBox="0 0 320 428" role="img" aria-label="모바일 앱이 api.shop.com으로 GET /orders/42와 토큰을 보내면, API 게이트웨이가 경로 규칙으로 주문 서비스를 고르고, JWT를 검증하고(실패 시 401), Redis 토큰 버킷으로 처리율을 제한하고(초과 시 429), 살아 있는 주문 서비스 인스턴스 하나를 골라 전달한다(없으면 503). 응답은 헤더를 정리해 앱으로 돌려준다">
    <defs><marker id="grf-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" style="fill:var(--sl-color-gray-3)" /></marker></defs>

    <g data-id="app">
      <rect class="box" x="8" y="4" width="304" height="52" rx="8" />
      <text x="160" y="20" style="font-weight:700">모바일 앱</text>
    </g>
    <text data-id="req" class="mono hide" x="160" y="42">GET /orders/42 + JWT</text>
    <text data-id="res" class="mono hide" x="160" y="42"><tspan class="hi">200 OK</tspan> 주문 42 정보</text>

    <line data-id="aReq" class="line" x1="110" y1="56" x2="110" y2="78" marker-end="url(#grf-arr)" />
    <g data-id="aRes">
      <line class="line" x1="210" y1="78" x2="210" y2="58" marker-end="url(#grf-arr)" />
      <text class="sub l" x="218" y="68">헤더 정리</text>
    </g>

    <rect class="frame" x="8" y="80" width="304" height="250" rx="10" />
    <text class="sub l" x="16" y="94">API 게이트웨이 · <tspan class="mono">api.shop.com</tspan></text>

    {rows.map(([id, t, sub, mono, err], i) => (
      <g>
        <g data-id={id}>
          <rect class="box" x="16" y={RY(i)} width="204" height="48" rx="7" />
          <text x="118" y={RY(i) + 15}>{t}</text>
          <text class={mono ? 'mono' : 'sub'} x="118" y={RY(i) + 35}>{sub}</text>
        </g>
        {err && (
          <g data-id={err[0]}>
            <rect class="err" x="228" y={RY(i)} width="76" height="48" rx="7" />
            <text class="err-t" x="266" y={RY(i) + 15}>✗ {err[1]}</text>
            <text class="sub" x="266" y={RY(i) + 35}>{err[2]}</text>
          </g>
        )}
        <rect data-id={'hlR' + (i + 1)} class="hl" x="12" y={RY(i) - 4} width="296" height="56" rx="9" />
      </g>
    ))}

    <line data-id="aDown" class="line" x1="145" y1="330" x2="145" y2="366" marker-end="url(#grf-arr)" />
    <g data-id="aUp">
      <line class="line" x1="175" y1="366" x2="175" y2="332" marker-end="url(#grf-arr)" />
      <text class="sub l" x="183" y="349">응답</text>
    </g>

    <g data-id="inst">
      <text class="sub l" x="8" y="346">주문 서비스</text>
      {['A', 'B', 'C'].map((a, i) => (
        <g>
          <rect class={i === 1 ? 'chip' : 'box'} x={8 + i * 104} y="368" width="96" height="52" rx="7" />
          <text x={56 + i * 104} y="385">주문 #{i + 1}</text>
          <text class="sub" x={56 + i * 104} y="406">주소 {a}</text>
        </g>
      ))}
    </g>
    <rect data-id="hlInst" class="hl" x="108" y="364" width="104" height="60" rx="9" />
    <rect data-id="hlApp" class="hl" x="4" y="0" width="312" height="60" rx="10" />
    <rect data-id="hlGw" class="hl" x="4" y="76" width="312" height="258" rx="12" />
  </svg>
</Stepper>
