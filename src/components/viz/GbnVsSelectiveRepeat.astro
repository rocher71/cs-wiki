---
// 프레임 1~6 전송 중 3번 손상: Go-Back-N은 3·4·5·6(n − k + 1 = 4개), 선택적 반복은 3번 1개만 재전송.
// 같은 자리에 번갈아 나오는 수신 칸 상태·화살표·아래 설명은 class="hide".
import Stepper from '../Stepper.astro';

const F = [1, 2, 3, 4, 5, 6];
const X = F.map((_, i) => 16 + i * 50); // 칸 폭 44
const cx = (f: number) => X[f - 1] + 22;
const SY = 40, RY = 160, CH = 40;
type C = { cls: string; t: string; tc?: string };
const ok: C = { cls: 'chip', t: '정상' };
const bad: C = { cls: 'err', t: '손상', tc: 'err-t' };
const v = (rest: C): C[] => [ok, ok, bad, rest, rest, rest];
const recv: Record<string, C[]> = {
  r2: v({ cls: 'box', t: '도착' }),
  r4: v({ cls: 'bad', t: '버림' }),
  r5: v({ cls: 'chip', t: '보관', tc: 'hi' }),
  r6: F.map(() => ({ cls: 'chip', t: '전달', tc: 'hi' })),
};

const steps = [
  { caption: '송신자가 ACK를 기다리지 않고 프레임 1~6을 연달아 보내요(슬라이딩 윈도).', show: ['base', 'arr', 'p1'] },
  { caption: '1·2번은 잘 도착했는데 3번이 오는 길에 손상됐어요. 4·5·6번은 멀쩡히 도착했어요.', show: ['base', 'arr', 'r2', 'p2'] },
  { caption: '수신자가 "3번이 잘못됐다"고 알려요(NAK 3). NAK가 없으면 송신자가 3번 ACK를 못 받아 타임아웃으로 알아채요.', show: ['base', 'r2', 'nak', 'p3'] },
  { caption: 'Go-Back-N: 수신자는 순서가 어긋난 4·5·6을 버려요. 송신자는 3번부터 다시, 즉 3·4·5·6 = 4개를 재전송해요(6 − 3 + 1 = 4).', show: ['base', 'r4', 'hGbn', 'p4'] },
  { caption: '선택적 반복: 수신자는 4·5·6을 버퍼에 보관해 둬요. 송신자는 손상된 3번 1개만 다시 보내요.', show: ['base', 'r5', 'hSr', 'p5'] },
  { caption: '선택적 반복: 3번이 도착하면 버퍼에 있던 4·5·6과 합쳐 1~6 순서대로 위 계층에 넘겨요. 대신 수신 버퍼가 더 필요해요.', show: ['base', 'r6', 'p6'] },
];
---
<Stepper title="3번 프레임이 깨졌을 때: Go-Back-N vs 선택적 반복" steps={steps}>
  <svg class="viz" viewBox="0 0 320 340" role="img" aria-label="프레임 1부터 6까지 보냈는데 3번이 손상됐다. Go-Back-N은 4·5·6을 버리고 3·4·5·6 네 개를 다시 보내고, 선택적 반복은 4·5·6을 보관하고 3번 하나만 다시 보낸다.">
    <g data-id="base">
      <text class="l" x="16" y="24" style="font-weight:700">송신자</text>
      {F.map((f, i) => <><rect class="box" x={X[i]} y={SY} width="44" height={CH} rx="4" /><text x={X[i] + 22} y={SY + 20} style="font-weight:700">{f}</text></>)}
      <text class="l" x="16" y="144" style="font-weight:700">수신자</text>
      {F.map((_, i) => <rect class="frame" x={X[i]} y={RY} width="44" height={CH} rx="4" />)}
    </g>

    <!-- 보내는 화살표 -->
    <g data-id="arr" class="hide">
      {F.map((f) => <><line class="line" x1={cx(f)} y1="86" x2={cx(f)} y2="118" /><path class="badge" d={`M${cx(f) - 5} 116 L${cx(f) + 5} 116 L${cx(f)} 124 Z`} /></>)}
    </g>
    <!-- NAK 3 (위로) -->
    <g data-id="nak" class="hide">
      <line class="line" x1={cx(3)} y1="124" x2={cx(3)} y2="92" style="stroke:var(--sl-color-red)" />
      <path d={`M${cx(3) - 5} 94 L${cx(3) + 5} 94 L${cx(3)} 86 Z`} style="fill:var(--sl-color-red)" />
      <text class="l err-t" x={cx(3) + 12} y="106">NAK 3</text>
    </g>

    <!-- 수신 칸 상태 -->
    {Object.entries(recv).map(([id, cs]) => (
      <g data-id={id} class="hide">
        {cs.map((c, i) => <>
          <rect class={c.cls} x={X[i]} y={RY} width="44" height={CH} rx="4" />
          <text x={X[i] + 22} y={RY + 20} style="font-weight:700">{F[i]}</text>
          <text class={c.tc ?? 'sub'} x={X[i] + 22} y={RY + 58}>{c.t}</text>
        </>)}
      </g>
    ))}

    <!-- 다시 보내는 프레임 강조 -->
    <rect data-id="hGbn" class="hl hide" x={X[2] - 3} y={SY - 3} width="200" height={CH + 6} rx="6" />
    <rect data-id="hSr" class="hl hide" x={X[2] - 3} y={SY - 3} width="50" height={CH + 6} rx="6" />

    <!-- 아래 설명 패널 (같은 자리, 번갈아) -->
    <g data-id="p1" class="hide">
      <rect class="box" x="6" y="240" width="308" height="92" rx="8" />
      <text x="160" y="270">1~6을 연달아 전송</text>
      <text class="sub" x="160" y="302">ACK를 하나씩 기다리지 않음</text>
    </g>
    <g data-id="p2" class="hide">
      <rect class="box" x="6" y="240" width="308" height="92" rx="8" />
      <text x="160" y="270"><tspan class="err-t">3번 손상</tspan>, 4·5·6은 도착</text>
      <text class="sub" x="160" y="302">수신자는 3번을 못 받은 셈</text>
    </g>
    <g data-id="p3" class="hide">
      <rect class="box" x="6" y="240" width="308" height="92" rx="8" />
      <text x="160" y="270">NAK 3 또는 타임아웃</text>
      <text class="sub" x="160" y="302">이제 몇 개를 다시 보낼까?</text>
    </g>
    <g data-id="p4" class="hide">
      <rect class="err" x="6" y="240" width="308" height="92" rx="8" />
      <text x="160" y="266" style="font-weight:700">Go-Back-N</text>
      <text x="160" y="294">다시 보냄: 3 4 5 6</text>
      <text class="hi" x="160" y="318">4개 (n − k + 1)</text>
    </g>
    <g data-id="p5" class="hide">
      <rect class="chip" x="6" y="240" width="308" height="92" rx="8" />
      <text x="160" y="266" style="font-weight:700">선택적 반복</text>
      <text x="160" y="294">다시 보냄: 3</text>
      <text class="hi" x="160" y="318">1개</text>
    </g>
    <g data-id="p6" class="hide">
      <rect class="chip" x="6" y="240" width="308" height="92" rx="8" />
      <text x="160" y="266" style="font-weight:700">선택적 반복</text>
      <text x="160" y="294">3 도착 → 1~6 순서대로</text>
      <text class="sub" x="160" y="318">대가: 수신 버퍼 필요</text>
    </g>
  </svg>
</Stepper>
