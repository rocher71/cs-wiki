---
// member 4행 + orders 5행을 INNER / LEFT / RIGHT / LEFT+WHERE / LEFT+ON조건으로 이어 붙인 결과. 데이터는 sql-basics-join 페이지 표와 같다.
import Stepper from '../Stepper.astro';
const RH = 26, TY = 40; // 위쪽 원본 표: 헤더 y, 행 간격
const ty = (i: number) => TY + 26 + i * RH;
const members = [['1', 'kim'], ['2', 'lee'], ['3', 'park'], ['4', 'choi']];
const orders = [['10', '1', 'PAID'], ['11', '1', 'CANCEL'], ['12', '2', 'PAID'], ['13', 'NULL', 'PAID'], ['14', '9', 'PAID']];
// 결과 표: [name, o.id, o.status, 표시] 표시 = 'del'(지워짐) | 'new'(새로 붙은 행) | 'keep'(NULL로 살아남은 행)
type R = [string, string, string, string?];
const RY = 214;
const ry = (i: number) => RY + 48 + i * RH;
const results: [string, string, R[]][] = [
  ['rInner', 'INNER JOIN → 3행', [['kim', '10', 'PAID'], ['kim', '11', 'CANCEL'], ['lee', '12', 'PAID']]],
  ['rLeft', 'LEFT JOIN → 5행', [['kim', '10', 'PAID'], ['kim', '11', 'CANCEL'], ['lee', '12', 'PAID'], ['park', 'NULL', 'NULL', 'new'], ['choi', 'NULL', 'NULL', 'new']]],
  ['rRight', 'RIGHT JOIN → 5행', [['kim', '10', 'PAID'], ['kim', '11', 'CANCEL'], ['lee', '12', 'PAID'], ['NULL', '13', 'PAID', 'new'], ['NULL', '14', 'PAID', 'new']]],
  ['rWhere', "LEFT JOIN + WHERE status='PAID' → 2행", [['kim', '10', 'PAID'], ['kim', '11', 'CANCEL', 'del'], ['lee', '12', 'PAID'], ['park', 'NULL', 'NULL', 'del'], ['choi', 'NULL', 'NULL', 'del']]],
  ['rOn', "ON ... AND status='PAID' → 4행", [['kim', '10', 'PAID'], ['lee', '12', 'PAID'], ['park', 'NULL', 'NULL', 'keep'], ['choi', 'NULL', 'NULL', 'keep']]],
];
const L = ['l10', 'l11', 'l12'];
const steps = [
  { caption: '왼쪽은 회원(member) 4명, 오른쪽은 주문(orders) 5건이에요. 주문의 member_id가 "누가 주문했나"를 가리켜요.', show: [] },
  { caption: 'ON o.member_id = m.id로 짝을 찾아요. kim은 주문 10·11, lee는 주문 12와 짝이에요. INNER JOIN은 짝이 있는 행만 남겨 3행이에요. kim은 주문이 2건이라 2줄이 됐어요.', show: [...L, 'rInner'] },
  { caption: 'LEFT JOIN은 왼쪽(회원)을 전부 남겨요. 짝이 없는 park, choi는 주문 칸을 NULL로 채워 붙여요. 3행 + 2행 = 5행이에요.', show: [...L, 'noM', 'rLeft'] },
  { caption: 'RIGHT JOIN은 반대로 오른쪽(주문)을 전부 남겨요. 짝이 없는 주문 13(member_id가 NULL)과 14(없는 회원 9번)는 회원 칸이 NULL이 돼요.', show: [...L, 'noO', 'rRight'] },
  { caption: "LEFT JOIN을 끝낸 뒤 WHERE o.status = 'PAID'로 거르면, CANCEL 행과 status가 NULL인 park·choi 행이 지워져 2행만 남아요. 결국 INNER JOIN과 같아져요.", show: [...L, 'cancel', 'rWhere'] },
  { caption: "같은 조건을 ON에 넣으면 '짝을 고르는 조건'이 돼요. 주문 11은 짝에서 빠지지만 회원은 그대로 남아서 park·choi도 NULL로 살아 있어요. 4행이에요.", show: ['l10', 'l12', 'cancel', 'noM', 'rOn'] },
];
---
<Stepper title="JOIN 결과는 몇 행일까" steps={steps}>
  <svg class="viz" viewBox="0 0 320 396" role="img" aria-label="회원 4명과 주문 5건을 INNER, LEFT, RIGHT JOIN으로 이었을 때 결과 행이 3, 5, 5행이 되고, LEFT JOIN 뒤 WHERE로 거르면 2행, 같은 조건을 ON에 두면 4행이 되는 과정">
    <!-- 원본 표 2개 (항상 보임) -->
    <text x="64" y="14" style="font-weight:700">member</text>
    <text x="238" y="14" style="font-weight:700">orders</text>
    <rect class="box" x="4" y={TY - 13} width="120" height={26 + 4 * RH} rx="6" />
    <rect class="box" x="160" y={TY - 13} width="156" height={26 + 5 * RH} rx="6" />
    <text class="sub" x="22" y={TY}>id</text>
    <text class="sub l" x="44" y={TY}>name</text>
    <text class="sub" x="178" y={TY}>id</text>
    <text class="sub" x="224" y={TY}>member_id</text>
    <text class="sub" x="286" y={TY}>status</text>

    <!-- 짝 없는 행 표시 -->
    <g data-id="noM" class="hide">
      {[2, 3].map((i) => <rect class="err" x="7" y={ty(i) - 11} width="114" height="22" rx="4" />)}
      {[2, 3].map((i) => <text class="err-t" x="104" y={ty(i)} style="font-size:14px">없음</text>)}
    </g>
    <g data-id="noO" class="hide">
      {[3, 4].map((i) => <rect class="err" x="163" y={ty(i) - 11} width="150" height="22" rx="4" />)}
    </g>
    <g data-id="cancel" class="hide">
      <rect class="err" x="163" y={ty(1) - 11} width="150" height="22" rx="4" />
    </g>

    {members.map(([id, n], i) => (
      <g>
        <text x="22" y={ty(i)}>{id}</text>
        <text class="l" x="44" y={ty(i)}>{n}</text>
      </g>
    ))}
    {orders.map(([id, m, s], i) => (
      <g>
        <text x="178" y={ty(i)}>{id}</text>
        <text class={m === 'NULL' ? 'nul' : (i === 4 ? 'err-t' : '')} x="224" y={ty(i)}>{m}</text>
        <text class={s === 'CANCEL' ? 'err-t' : ''} x="286" y={ty(i)} style="font-size:14px;font-weight:400">{s}</text>
      </g>
    ))}

    <!-- 짝 연결선 (member 행 → orders 행) -->
    {[['l10', 0, 0], ['l11', 0, 1], ['l12', 1, 2]].map(([id, a, b]: any) => (
      <g data-id={id} class="hide">
        <path class="link" d={`M124 ${ty(a)} L160 ${ty(b)}`} />
        <circle class="dot" cx="124" cy={ty(a)} r="3" />
        <circle class="dot" cx="160" cy={ty(b)} r="3" />
      </g>
    ))}

    <!-- 결과 표 -->
    {results.map(([id, title, rows]) => (
      <g data-id={id} class="hide">
        <text class="hi" x="160" y={RY} style="font-size:14px">{title}</text>
        <text class="sub" x="56" y={RY + 24}>m.name</text>
        <text class="sub" x="140" y={RY + 24}>o.id</text>
        <text class="sub" x="224" y={RY + 24}>o.status</text>
        <path class="line" d={`M4 ${RY + 36} H316`} style="stroke-width:1" />
        {rows.map(([n, o, s, mark], i) => (
          <g>
            {(mark === 'new' || mark === 'keep') && <rect class="chip" x="4" y={ry(i) - 11} width="312" height="22" rx="4" />}
            {mark === 'del' && <rect class="err" x="4" y={ry(i) - 11} width="312" height="22" rx="4" />}
            <text class={n === 'NULL' ? 'nul' : ''} x="56" y={ry(i)}>{n}</text>
            <text class={o === 'NULL' ? 'nul' : ''} x="140" y={ry(i)}>{o}</text>
            <text class={s === 'NULL' ? 'nul' : ''} x="224" y={ry(i)} style="font-size:14px">{s}</text>
            {mark === 'del' && <path class="strike" d={`M24 ${ry(i)} H260`} />}
            {mark === 'del' && <text class="err-t" x="290" y={ry(i)} style="font-size:14px">제거</text>}
            {(mark === 'new' || mark === 'keep') && <text class="hi" x="290" y={ry(i)} style="font-size:14px">{mark === 'new' ? '추가' : '남음'}</text>}
          </g>
        ))}
      </g>
    ))}
  </svg>
</Stepper>

<style>
  svg.viz text.nul { fill: var(--sl-color-gray-3); font-style: italic; font-size: 14px; }
  svg.viz .link { stroke: var(--sl-color-accent); stroke-width: 2.2; fill: none; }
  svg.viz .dot { fill: var(--sl-color-accent); }
  svg.viz .strike { stroke: var(--sl-color-red); stroke-width: 1.8; }
</style>
