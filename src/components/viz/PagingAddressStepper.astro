---
// 페이징 주소 변환: 논리 주소 3500, 페이지 1KB, 페이지 테이블 0→5, 1→2, 2→7, 3→1 → 물리 주소 1452.
// 왼쪽 아래 페이지 테이블, 오른쪽 아래 실제 메모리(프레임 0~3). 강조 테두리는 class hl.
import Stepper from '../Stepper.astro';

const steps = [
  { caption: '프로그램이 논리 주소 3500을 읽으려 해요. 페이지 크기는 1024바이트예요.', show: ['la'] },
  { caption: '3500 ÷ 1024 = 3, 나머지 428. 몫이 페이지 번호 p = 3, 나머지가 페이지 안 위치(오프셋) d = 428이에요.', show: ['la', 'split', 'p', 'd'] },
  { caption: '페이지 테이블에서 페이지 3 행을 찾아요.', show: ['la', 'split', 'p', 'd', 'pt', 'hlP', 'hlRow'] },
  { caption: '페이지 3은 프레임 1에 들어 있어요. 실제 메모리의 프레임 1로 가요.', show: ['la', 'split', 'p', 'd', 'pt', 'mem', 'hlF', 'arrow', 'hlMem'] },
  { caption: '물리 주소 = 프레임 번호 × 페이지 크기 + 오프셋 = 1 × 1024 + 428 = 1452. 프레임 1의 시작(1024)에서 428칸 들어간 자리예요.', show: ['la', 'split', 'p', 'd', 'pt', 'mem', 'arrow', 'hlMem', 'off', 'sum', 'hlD'] },
];
const table = [5, 2, 7, 1];
const ty = (i: number) => 164 + i * 28;
const MX = 176, MW = 128;
const tick = MX + Math.round((428 / 1024) * MW);
---
<Stepper title="페이징 주소 변환: 3500 → 1452" steps={steps}>
  <svg class="viz" viewBox="0 0 320 340" role="img" aria-label="논리 주소 3500을 1024로 나눠 페이지 번호 3, 오프셋 428로 나눈다. 페이지 테이블에서 페이지 3은 프레임 1이므로 물리 주소는 1 곱하기 1024 더하기 428, 1452다.">
    <g data-id="la">
      <rect class="box" x="96" y="16" width="128" height="34" rx="6" />
      <text x="160" y="33">논리 주소 3500</text>
    </g>

    <path data-id="split" class="line" d="M130 50L76 92M190 50L244 92" />
    <g data-id="p">
      <rect class="chip" x="24" y="92" width="104" height="34" rx="6" />
      <text x="76" y="109">p = 3</text>
      <text class="sub" style="text-anchor:end" x="92" y="66">몫</text>
    </g>
    <g data-id="d">
      <rect class="chip" x="192" y="92" width="112" height="34" rx="6" />
      <text x="248" y="109">d = 428</text>
      <text class="sub l" x="228" y="66">나머지</text>
    </g>
    <rect data-id="hlP" class="hl" x="20" y="88" width="112" height="42" rx="8" />
    <rect data-id="hlD" class="hl" x="188" y="88" width="120" height="42" rx="8" />

    <g data-id="pt">
      <text class="sub" x="76" y="150">페이지 테이블</text>
      {table.map((f, i) => <>
        <rect class="box" x="16" y={ty(i)} width="60" height="28" />
        <rect class="box" x="76" y={ty(i)} width="60" height="28" />
        <text class="sub" x="46" y={ty(i) + 14}>p{i}</text>
        <text x="106" y={ty(i) + 14}>{f}</text>
      </>)}
      <text class="sub" x="46" y="304">페이지</text>
      <text class="sub" x="106" y="304">프레임</text>
    </g>
    <rect data-id="hlRow" class="hl" x="13" y={ty(3) - 3} width="126" height="34" rx="5" />
    <g data-id="hlF" class="hide">
      <rect class="chip" x="77" y={ty(3) + 1} width="58" height="26" />
      <text class="hi" x="106" y={ty(3) + 14}>1</text>
    </g>

    <g data-id="mem">
      <text class="sub" x="240" y="150">실제 메모리</text>
      {[0, 1, 2, 3].map((n) => <>
        <rect class="box" x={MX} y={ty(n)} width={MW} height="28" />
        <text class="sub" x="298" y={ty(n) + 14} style="text-anchor:end">{n}</text>
      </>)}
      <text class="sub" x="240" y="304">프레임 0~3 …</text>
    </g>
    <path data-id="arrow" class="line" d={`M140 ${ty(3) + 14}L170 ${ty(1) + 14}`} />
    <rect data-id="hlMem" class="hl" x={MX - 3} y={ty(1) - 3} width={MW + 6} height="34" rx="5" />
    <g data-id="off" class="hide">
      <rect class="chip" x={MX + 1} y={ty(1) + 2} width={tick - MX - 1} height="24" />
      <text class="hi" x={(MX + tick) / 2} y={ty(1) + 14}>428</text>
      <path class="line" d={`M${tick} ${ty(1)}V${ty(1) + 28}`} style="stroke:var(--sl-color-accent);stroke-width:3" />
    </g>
    <g data-id="sum" class="hide">
      <text class="hi" x="160" y="326">1 × 1024 + 428 = 1452</text>
    </g>
  </svg>
</Stepper>
