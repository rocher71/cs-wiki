---
// TCP HOL(HTTP/2) vs QUIC 스트림별 순서(HTTP/3). 숫자는 스트림 번호, 왼쪽부터 먼저 보낸 패킷.
import Stepper from '../Stepper.astro';
const titles = ['HTTP/2 · TCP 줄 1개', 'HTTP/2 · TCP 줄 1개', 'HTTP/2 · TCP 줄 1개', 'HTTP/3 · QUIC 스트림별 줄', 'HTTP/3 · QUIC 스트림별 줄'];
const captions = [
  'HTTP/2: 스트림 1·3·5의 프레임이 TCP라는 바이트 줄 하나에 섞여서 보내져요.',
  '맨 앞, 스트림 1의 패킷 하나가 네트워크에서 사라졌어요.',
  'TCP는 바이트를 반드시 순서대로 앱에 넘겨요. 뒤에 도착한 3·5 데이터도 버퍼에서 1을 기다리며 전부 멈춰요. 이게 TCP HOL이에요.',
  'HTTP/3: 같은 상황을 QUIC(UDP 위) 위에서 보면, 스트림 1·3·5가 각자 따로 순서를 맞추는 줄을 가져요.',
  '스트림 1 패킷이 사라져도 스트림 1만 재전송을 기다려요. 3·5는 바로 앱에 전달돼요.',
];
const pk = ['1', '3', '5', '1', '3', '5'];
const PX = (i: number) => 14 + i * 50;
const scene = [['tcp'], ['tcp', 'x'], ['tcp', 'x', 'buf'], ['quic'], ['quic', 'xq', 'res']];
const steps = captions.map((caption, i) => ({ caption, show: [`t${i}`, ...scene[i]] }));
---
<Stepper title="TCP HOL vs QUIC" steps={steps}>
  <svg class="viz" viewBox="0 0 320 250" role="img" aria-label="HTTP/2는 TCP 줄 하나에 스트림이 섞여 패킷 하나가 사라지면 모두 멈추고, HTTP/3는 QUIC 스트림마다 줄이 따로라 사라진 스트림만 기다리는 비교">
    {titles.map((t, i) => (
      <g data-id={`t${i}`} class="hide">
        <rect class="chip" x="10" y="6" width="300" height="30" rx="15" />
        <text x="160" y="21" style="font-weight:700">{t}</text>
      </g>
    ))}

    <g data-id="tcp" class="hide">
      <text class="sub l" x="12" y="58">TCP 바이트 줄 (먼저 보낸 것 ←)</text>
      <rect class="frame" x="10" y="70" width="300" height="44" rx="6" />
      {pk.map((p, i) => (
        <g>
          <rect class="box" x={PX(i)} y="74" width="44" height="36" rx="4" />
          <text x={PX(i) + 22} y="92">{p}</text>
        </g>
      ))}
      <text class="sub" x="160" y="236">숫자 = 스트림 번호</text>
    </g>

    <g data-id="x" class="hide">
      <rect class="err" x={PX(0)} y="74" width="44" height="36" rx="4" />
      <path d="M22 80L50 104M50 80L22 104" style="stroke:var(--sl-color-red);stroke-width:3" />
      <text class="err-t" x="36" y="130">손실</text>
    </g>

    <g data-id="buf" class="hide">
      <text class="sub l" x="12" y="156">수신 버퍼: 1이 올 때까지 대기</text>
      <rect class="frame" x="60" y="166" width="250" height="40" rx="6" />
      {pk.slice(1).map((p, i) => (
        <g>
          <rect class="bad" x={PX(i + 1)} y="170" width="44" height="32" rx="4" />
          <text x={PX(i + 1) + 22} y="186">{p}</text>
        </g>
      ))}
      <text class="err-t" x="34" y="186">멈춤</text>
    </g>

    <g data-id="quic" class="hide">
      {['1', '3', '5'].map((s, i) => (
        <g>
          <text class="l" x="12" y={74 + i * 58}>스트림 {s}</text>
          <rect class="frame" x="86" y={54 + i * 58} width="104" height="40" rx="6" />
          {[0, 1].map((k) => (
            <g>
              <rect class="box" x={90 + k * 50} y={58 + i * 58} width="44" height="32" rx="4" />
              <text x={112 + k * 50} y={74 + i * 58}>{s}</text>
            </g>
          ))}
        </g>
      ))}
      <text class="sub" x="160" y="236">숫자 = 스트림 번호 · 줄마다 순서 따로</text>
    </g>

    <g data-id="xq" class="hide">
      <rect class="err" x="90" y="58" width="44" height="32" rx="4" />
      <path d="M98 62L126 86M126 62L98 86" style="stroke:var(--sl-color-red);stroke-width:3" />
    </g>

    <g data-id="res" class="hide">
      <rect class="err" x="198" y="56" width="112" height="36" rx="18" />
      <text class="err-t" x="254" y="74">재전송 대기</text>
      {[1, 2].map((i) => (
        <g>
          <rect class="chip" x="198" y={56 + i * 58} width="112" height="36" rx="18" />
          <text x="254" y={74 + i * 58}>앱 전달 ✓</text>
        </g>
      ))}
    </g>
  </svg>
</Stepper>
