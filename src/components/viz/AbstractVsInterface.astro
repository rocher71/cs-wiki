---
// 추상 클래스(골조, 1개만 상속) vs 인터페이스(자격증 카드, 여러 개 구현)
import Stepper from '../Stepper.astro';
const steps = [
  { caption: '추상 클래스 Animal은 필드(name), 생성자, 완성된 메서드 breathe()를 갖고, sound()만 빈칸(abstract)으로 남겨 둬요.', show: ['animal', 'hl-animal'] },
  { caption: 'Dog extends Animal: 부모는 하나만 고를 수 있어요. Dog가 빈칸 sound()를 채워야 객체를 만들 수 있어요.', show: ['animal', 'dog', 'ext', 'hl-dog'] },
  { caption: '인터페이스 Swimmable, Walkable은 "~할 수 있음" 자격증이에요. 무엇을 하는지(메서드 이름)만 있고 필드는 없어요.', show: ['animal', 'dog', 'ext', 'ifs', 'hl-ifs'] },
  { caption: 'Dog implements Swimmable, Walkable: 자격증은 여러 장을 동시에 가질 수 있어요.', show: ['animal', 'dog', 'ext', 'ifs', 'impl'] },
  { caption: '정리: 추상 클래스는 상태를 가진 골조 1개, 인터페이스는 상태 없는 자격증 여러 장이에요.', show: ['animal', 'dog', 'ext', 'ifs', 'impl', 'sum'] },
];
---
<Stepper title="추상 클래스 vs 인터페이스" steps={steps}>
  <svg class="viz" viewBox="0 0 320 384" role="img" aria-label="Dog가 추상 클래스 Animal 하나를 상속하고 인터페이스 두 개를 구현하는 구조">
    <defs>
      <marker id="avi-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    <text x="83" y="14" style="font-weight:700">추상 클래스</text>
    <text x="240" y="14" style="font-weight:700">인터페이스</text>

    <g data-id="animal">
      <rect class="box" x="8" y="28" width="150" height="150" rx="8" />
      <text x="83" y="48" style="font-weight:700">Animal</text>
      <text class="sub l" x="18" y="76">필드 name</text>
      <text class="sub l" x="18" y="100">생성자</text>
      <text class="sub l" x="18" y="124">breathe() 완성</text>
      <rect class="bad" x="14" y="140" width="138" height="30" rx="4" />
      <text class="sub" x="83" y="155">sound() 빈칸</text>
    </g>

    <g data-id="ifs">
      <rect class="chip" x="176" y="28" width="128" height="58" rx="8" />
      <text x="240" y="48">Swimmable</text>
      <text class="sub" x="240" y="70">swim()</text>
      <rect class="chip" x="176" y="102" width="128" height="58" rx="8" />
      <text x="240" y="122">Walkable</text>
      <text class="sub" x="240" y="144">walk()</text>
    </g>

    <g data-id="ext">
      <line class="line" x1="110" y1="236" x2="88" y2="182" marker-end="url(#avi-arr)" />
      <text class="sub" x="46" y="200">extends</text>
      <text class="sub" x="46" y="220">1개만</text>
    </g>

    <g data-id="impl">
      <line class="line" x1="210" y1="236" x2="232" y2="164" stroke-dasharray="5 4" marker-end="url(#avi-arr)" />
      <polyline class="line" points="230,264 312,264 312,57 308,57" stroke-dasharray="5 4" marker-end="url(#avi-arr)" />
      <text class="sub" x="268" y="190">implements</text>
      <text class="sub" x="268" y="210">여러 개</text>
    </g>

    <g data-id="dog">
      <rect class="box" x="90" y="236" width="140" height="58" rx="8" />
      <text x="160" y="254" style="font-weight:700">Dog</text>
      <text class="sub" x="160" y="276">sound() 멍멍</text>
    </g>

    <g data-id="sum" class="hide">
      <text class="l" x="8" y="326">추상 클래스 = 골조 1개, 상태 O</text>
      <text class="l" x="8" y="356">인터페이스 = 자격증 여러 장, 상태 X</text>
    </g>

    <rect data-id="hl-animal" class="hl" x="4" y="24" width="158" height="158" rx="10" />
    <rect data-id="hl-dog" class="hl" x="86" y="232" width="148" height="66" rx="10" />
    <rect data-id="hl-ifs" class="hl" x="172" y="24" width="136" height="140" rx="10" />
  </svg>
</Stepper>
