---
// 글을 쓰자마자 레플리카에서 읽으면 안 보이는 상황(read-your-writes 위반)과 해결.
// 위: 사용자 / 가운데: 리더·레플리카와 복제 화살표 / 아래: 사용자 화면 결과.
import Stepper from '../Stepper.astro';
const notes = [
  '① 리더에 저장·커밋 완료',
  '② 레플리카로 가는 중 (아직 미도착)',
  '③ 목록 조회는 레플리카로',
  '④ 레플리카엔 아직 새 글이 없음',
  '⑤ 도착·적용 → 이제 보임',
  '해결: 쓴 직후엔 리더에서 읽기',
];
const base = ['user', 'L', 'R', 'rep', 'scr'];
const steps = [
  { caption: '사용자가 글 저장을 눌러요. 쓰기는 리더로 가서 INSERT 후 커밋돼요. 리더에는 새 글이 들어갔어요.', show: [...base, 'arrL', 'lb-w', 'L-new', 'hl-L', 'n1'] },
  { caption: '리더는 변경 기록을 레플리카로 보내요. 하지만 네트워크·적용 시간 때문에 아직 레플리카에 도착하지 않았어요.', show: [...base, 'L-new', 'pkt', 'n2'] },
  { caption: '저장이 끝나자 화면이 글 목록을 다시 불러와요. 조회는 부하를 나누려고 레플리카로 보내도록 되어 있어요.', show: [...base, 'L-new', 'pkt', 'arrR', 'lb-r', 'hl-R', 'n3'] },
  { caption: '레플리카에는 아직 새 글이 없어서 목록에서 빠져 있어요. 사용자는 "내 글이 사라졌다"고 느끼고 다시 쓰기도 해요.', show: [...base, 'L-new', 'pkt', 'arrR', 'lb-r', 'miss', 'n4'] },
  { caption: '잠시 뒤 변경이 레플리카에 도착해 적용돼요. 새로고침하면 글이 보여요. 데이터가 사라진 게 아니라 늦게 온 거예요.', show: [...base, 'L-new', 'R-new', 'arrR', 'lb-r', 'ok', 'hl-R', 'n5'] },
  { caption: '해결(read-your-writes): 글을 쓴 직후 잠깐은 그 사용자의 조회를 리더로 보내요. 복제가 아직 안 끝났어도 자기 글은 바로 보여요.', show: [...base, 'L-new', 'pkt', 'arrL', 'lb-rL', 'ok2', 'hl-L', 'n6'] },
];
---
<Stepper title="방금 쓴 글이 안 보이는 이유" steps={steps}>
  <svg class="viz" viewBox="0 0 320 320" role="img" aria-label="사용자가 리더에 글을 쓴 직후 레플리카에서 목록을 읽으면 복제가 아직 안 와서 글이 안 보이고, 잠시 뒤 보이며, 쓴 직후엔 리더에서 읽어 해결하는 과정">
    <defs>
      <marker id="wr-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0,0 L10,5 L0,10 z" style="fill:var(--sl-color-gray-3)" />
      </marker>
    </defs>
    <g data-id="user">
      <rect class="box" x="110" y="8" width="100" height="36" rx="6" />
      <text x="160" y="27" style="font-weight:700">사용자</text>
    </g>
    <!-- 사용자 → 리더 / 레플리카 -->
    <line data-id="arrL" class="line" x1="130" y1="46" x2="78" y2="104" marker-end="url(#wr-arrow)" />
    <text data-id="lb-w" class="hi hide" x="62" y="66">저장</text>
    <text data-id="lb-rL" class="hi hide" x="58" y="66">조회</text>
    <line data-id="arrR" class="line" x1="190" y1="46" x2="242" y2="104" marker-end="url(#wr-arrow)" />
    <text data-id="lb-r" class="hi hide" x="262" y="66">조회</text>

    <!-- 리더 / 레플리카 -->
    <g data-id="L">
      <rect class="box" x="10" y="110" width="120" height="104" rx="8" />
      <text x="70" y="128" style="font-weight:700">리더</text>
      <text class="sub" x="70" y="152">글 1</text>
      <text class="sub" x="70" y="176">글 2</text>
    </g>
    <g data-id="L-new" class="hide">
      <rect class="chip" x="30" y="188" width="80" height="22" rx="4" />
      <text x="70" y="199" style="font-size:14px">새 글</text>
    </g>
    <g data-id="R">
      <rect class="box" x="190" y="110" width="120" height="104" rx="8" />
      <text x="250" y="128" style="font-weight:700">레플리카</text>
      <text class="sub" x="250" y="152">글 1</text>
      <text class="sub" x="250" y="176">글 2</text>
    </g>
    <g data-id="R-new" class="hide">
      <rect class="chip" x="210" y="188" width="80" height="22" rx="4" />
      <text x="250" y="199" style="font-size:14px">새 글</text>
    </g>
    <rect data-id="hl-L" class="hl" x="7" y="107" width="126" height="110" rx="10" />
    <rect data-id="hl-R" class="hl" x="187" y="107" width="126" height="110" rx="10" />
    <g data-id="rep">
      <line class="line" x1="132" y1="140" x2="186" y2="140" marker-end="url(#wr-arrow)" style="stroke-dasharray:4 3" />
      <text class="sub" x="160" y="124">복제</text>
    </g>
    <g data-id="pkt" class="hide">
      <rect class="chip" x="137" y="154" width="46" height="24" rx="4" />
      <text x="160" y="166" style="font-size:14px">변경</text>
      <text class="sub" x="160" y="190">가는 중</text>
    </g>

    <!-- 사용자 화면 -->
    <g data-id="scr">
      <rect class="frame" x="10" y="230" width="300" height="46" rx="6" />
      <text class="sub l" x="20" y="253">화면</text>
    </g>
    <g data-id="miss" class="hide">
      <rect class="err" x="64" y="236" width="240" height="34" rx="5" />
      <text class="err-t" x="184" y="253">글 1, 글 2 … 내 글이 없어요?!</text>
    </g>
    <g data-id="ok" class="hide">
      <rect class="chip" x="64" y="236" width="240" height="34" rx="5" />
      <text x="184" y="253">새로고침: 새 글이 보여요</text>
    </g>
    <g data-id="ok2" class="hide">
      <rect class="chip" x="64" y="236" width="240" height="34" rx="5" />
      <text x="184" y="253">리더에서 읽어 바로 보여요</text>
    </g>

    {notes.map((t, i) => <text data-id={`n${i + 1}`} class="hi hide" x="160" y="302" style="font-size:14px">{t}</text>)}
  </svg>
</Stepper>
