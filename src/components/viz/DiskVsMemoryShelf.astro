---
// 디스크 기반 DB vs Redis: 데이터가 어디 있느냐 = 가지러 가는 길의 길이.
// 수치 근거가 없어 숫자는 넣지 않고 길이 차이로만 표현한다.
import Stepper from '../Stepper.astro';
const steps = [
  { caption: '디스크 기반 DB: 요청이 오면 창고(디스크)까지 가서 데이터를 꺼내 와야 해요. 오가는 길이 길어요.', show: ['d', 'd-path', 'hl-d'] },
  { caption: 'Redis: 데이터가 계산대 바로 옆 선반(메모리)에 있어서 손만 뻗어 집어 줘요. 길이 훨씬 짧아요.', show: ['d', 'd-path', 'r', 'r-path', 'hl-r'] },
  { caption: '대가: 선반(메모리) 크기보다 많은 물건은 못 둬요. 창고(디스크)는 전원이 꺼질 때를 대비해 복사본을 맡겨 두는 보관용으로만 써요.', show: ['r', 'r-path', 'cap', 'full', 'bk', 'hl-cap'] },
];
---
<Stepper title="창고(디스크) vs 선반(메모리)" steps={steps}>
  <svg class="viz" viewBox="0 0 320 336" role="img" aria-label="디스크 기반 DB는 창고까지 먼 길을 다녀오고, Redis는 계산대 옆 선반에서 바로 집으며, 대신 선반 크기가 한정되고 창고는 보관용으로만 쓰는 모습">
    <defs>
      <marker id="dm-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0,0 L10,5 L0,10 z" style="fill:var(--sl-color-gray-3)" />
      </marker>
    </defs>
    <!-- 디스크 기반 DB -->
    <g data-id="d">
      <text class="l" x="10" y="14" style="font-weight:700">디스크 기반 DB</text>
      <rect class="box" x="10" y="28" width="84" height="52" rx="6" />
      <text x="52" y="46">계산대</text>
      <text class="sub" x="52" y="66">요청</text>
      <rect class="box" x="226" y="28" width="84" height="52" rx="6" />
      <text x="268" y="46">창고</text>
      <text class="sub" x="268" y="66">디스크</text>
    </g>
    <g data-id="d-path">
      <line class="line" x1="98" y1="44" x2="220" y2="44" marker-end="url(#dm-arrow)" />
      <line class="line" x1="222" y1="64" x2="100" y2="64" marker-end="url(#dm-arrow)" />
      <text class="sub" x="160" y="98">먼 길을 다녀와야 해요</text>
    </g>
    <rect data-id="hl-d" class="hl" x="95" y="32" width="128" height="44" rx="8" />

    <!-- Redis -->
    <g data-id="r">
      <text class="l" x="10" y="130" style="font-weight:700">Redis</text>
      <rect class="box" x="10" y="144" width="84" height="52" rx="6" />
      <text x="52" y="162">계산대</text>
      <text class="sub" x="52" y="182">요청</text>
      <rect class="chip" x="122" y="144" width="84" height="52" rx="6" />
      <text x="164" y="162">선반</text>
      <text class="sub" x="164" y="182">메모리</text>
    </g>
    <g data-id="r-path">
      <line class="line" x1="98" y1="160" x2="116" y2="160" marker-end="url(#dm-arrow)" />
      <line class="line" x1="118" y1="180" x2="100" y2="180" marker-end="url(#dm-arrow)" />
      <text class="sub l" x="216" y="162">바로 옆,</text>
      <text class="sub l" x="216" y="182">손만 뻗음</text>
    </g>
    <rect data-id="hl-r" class="hl" x="95" y="148" width="26" height="44" rx="6" />

    <!-- 대가: 선반 크기 한정 + 창고는 보관용 -->
    <g data-id="cap" class="hide">
      <text class="l" x="10" y="222" style="font-weight:700">선반 크기 = 메모리 크기</text>
      <text class="sub" x="310" y="222" style="text-anchor:end">가득 참</text>
      <rect class="frame" x="10" y="236" width="212" height="40" rx="6" />
      {[0, 1, 2, 3].map((i) => <rect class="chip" x={16 + i * 51} y="242" width="45" height="28" rx="4" />)}
      
    </g>
    <g data-id="full" class="hide">
      <rect class="err" x="234" y="242" width="76" height="28" rx="4" />
      <text class="err-t" x="272" y="256">✕ 못 둠</text>
    </g>
    <g data-id="bk" class="hide">
      <line class="line" x1="116" y1="280" x2="116" y2="292" marker-end="url(#dm-arrow)" />
      <rect class="bad" x="10" y="296" width="300" height="34" rx="6" />
      <text class="sub" x="160" y="313">창고(디스크)는 꺼질 때 대비 보관용</text>
    </g>
    <rect data-id="hl-cap" class="hl" x="7" y="233" width="306" height="46" rx="8" />
  </svg>
</Stepper>
