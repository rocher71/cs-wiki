---
// 서버 여러 대 + WebSocket: A(서버1)와 B(서버2)가 다른 서버에 붙어 있을 때 브로커가 메시지를 나눠 주는 과정.
import Stepper from '../Stepper.astro';
const steps = [
  { caption: '사용자 A는 서버1, B는 서버2에 WebSocket으로 연결돼 있어요. 연결은 맺은 그 서버의 메모리에만 있어요.', show: ['base'] },
  { caption: 'A가 "안녕"을 보내면 서버1이 받아요. 그런데 서버1 메모리엔 B의 연결이 없어요. 브로커가 없으면 여기서 끝이고 B는 못 받아요.', show: ['base', 'send', 'stuck'] },
  { caption: '그래서 서버1은 받은 메시지를 브로커(Redis Pub/Sub)의 채팅방 채널 room:1에 발행(PUBLISH)해요. 서버들은 미리 이 채널을 구독해 두었어요.', show: ['base', 'send', 'sub', 'pub', 'lpub'] },
  { caption: '구독 중인 서버1·서버2가 모두 메시지를 받아요. 서버2는 자기 메모리에 있는 B의 연결로 "안녕"을 보내요. B 도착!', show: ['base', 'send', 'sub', 'pub', 'fan', 'lfan', 'deliver'] },
];
const halo = 'paint-order:stroke;stroke:var(--sl-color-gray-7, var(--sl-color-black));stroke-width:5px;stroke-linejoin:round';
const acc = 'stroke:var(--sl-color-accent);stroke-width:2.4;fill:none';
---
<Stepper title="서버가 여러 대일 때 메시지 나눠 주기" steps={steps}>
  <svg class="viz" viewBox="0 0 320 356" role="img" aria-label="사용자 A와 B가 다른 서버에 연결돼 있을 때, 서버1이 Redis Pub/Sub 채널에 발행하고 구독 중인 서버2가 B에게 전달하는 과정">
    <defs>
      <marker id="ps-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
    </defs>
    <g data-id="base">
      <rect class="box" x="20" y="8" width="120" height="36" rx="8" />
      <text x="80" y="26" style="font-weight:700">사용자 A</text>
      <rect class="box" x="180" y="8" width="120" height="36" rx="8" />
      <text x="240" y="26" style="font-weight:700">사용자 B</text>
      <line class="line" x1="60" y1="44" x2="60" y2="120" style="stroke-width:3" />
      <line class="line" x1="260" y1="44" x2="260" y2="120" style="stroke-width:3" />
      <text class="sub" x="160" y="82">WebSocket 연결</text>
      <rect class="box" x="20" y="120" width="120" height="64" rx="8" />
      <text x="80" y="140" style="font-weight:700">서버1</text>
      <text class="sub" x="80" y="166">메모리: A</text>
      <rect class="box" x="180" y="120" width="120" height="64" rx="8" />
      <text x="240" y="140" style="font-weight:700">서버2</text>
      <text class="sub" x="240" y="166">메모리: B</text>
      <rect class="box" x="50" y="282" width="220" height="62" rx="8" />
      <text x="160" y="302" style="font-weight:700">브로커 Redis Pub/Sub</text>
      <text class="mono" x="160" y="326">채널 room:1</text>
    </g>
    <g data-id="send">
      <line x1="100" y1="46" x2="100" y2="116" style={acc} marker-end="url(#ps-a)" />
      <text class="hi l" x="108" y="104" style={halo}>"안녕"</text>
    </g>
    <g data-id="sub">
      <line class="line" x1="110" y1="184" x2="130" y2="282" style="stroke-dasharray:4 4" />
      <line class="line" x1="210" y1="184" x2="190" y2="282" style="stroke-dasharray:4 4" />
      <text class="sub" x="160" y="268" style={halo}>구독</text>
    </g>
    <g data-id="stuck" class="hide">
      <rect class="err" x="10" y="208" width="300" height="56" rx="8" />
      <text class="err-t" x="160" y="226">✕ 서버1엔 B 연결이 없어요</text>
      <text x="160" y="248" style="font-size:14px">브로커가 없으면 B는 못 받아요</text>
    </g>
    <g data-id="pub" class="hide">
      <line x1="44" y1="186" x2="72" y2="278" style={acc} marker-end="url(#ps-a)" />
    </g>
    <g data-id="lpub" class="hide">
      <text class="mono hi" x="160" y="240" style={halo}>① PUBLISH room:1</text>
    </g>
    <g data-id="fan" class="hide">
      <line x1="134" y1="280" x2="114" y2="188" style={acc} marker-end="url(#ps-a)" />
      <line x1="186" y1="280" x2="206" y2="188" style={acc} marker-end="url(#ps-a)" />
    </g>
    <g data-id="lfan" class="hide">
      <text class="hi" x="160" y="240" style={halo}>② 구독자 모두에게</text>
    </g>
    <g data-id="deliver" class="hide">
      <line x1="220" y1="118" x2="220" y2="48" style={acc} marker-end="url(#ps-a)" />
      <text class="hi" x="212" y="104" style={`text-anchor:end;${halo}`}>"안녕"</text>
    </g>
  </svg>
</Stepper>
