---
// 토큰 없이 DEL로 풀면 남의 락을 지운다(실험 E2 흐름). 세로축=시간(0~1.0초), 열=A·B·C 클라이언트 + Redis 락 값.
// 6단계는 "토큰+Lua 해제였다면" 비교, 7단계는 그래도 남는 A·B 겹침. 대안 요소는 .hide라 단계 밖에서 완전히 숨는다.
import Stepper from '../Stepper.astro';
const T = (t: number) => 64 + t * 280; // 0초→64, 1.0초→344
const BW = 20;
const C = { A: 52, B: 100, C: 148 };
const RX = 236, RW = 76, RC = RX + RW / 2;
const PY = 372, PH = 84;
const steps = [
  { caption: 'A가 SET lock A NX PX 500으로 락을 잡아요. 값은 A, 0.5초 뒤 저절로 사라지는 락이에요.', show: ['aBar', 'aSet', 'rA', 'p1'] },
  { caption: 'A가 GC로 0.8초 멈춰요. 그 사이 0.5초에 TTL이 끝나 락이 자동으로 풀려요. A는 이걸 몰라요.', show: ['aBar', 'aSet', 'rA', 'aPause', 'rExp', 'p2'] },
  { caption: '0.6초, B가 SET NX를 보내요. 락이 비어 있으니 OK. 이제 락 값은 B예요.', show: ['aBar', 'aSet', 'rA', 'aPause', 'rExp', 'bBar', 'bSet', 'rB1', 'rB2', 'p3'] },
  { caption: '0.8초, A가 깨어나 작업을 마치고 그냥 DEL lock을 보내요. 값을 확인하지 않으니 B의 락이 지워져요.', show: ['aBar', 'aSet', 'rA', 'aPause', 'rExp', 'bBar', 'bSet', 'rB1', 'aDel', 'rDel', 'p4'] },
  { caption: '0.9초, C가 SET NX를 보내면 락이 비어 있어서 OK예요. B와 C가 동시에 락을 쥐었다고 믿어요. 상호 배제가 깨졌어요.', show: ['aBar', 'aSet', 'rA', 'aPause', 'rExp', 'bBar', 'bSet', 'rB1', 'aDel', 'rDel', 'cBar', 'cSet', 'rC', 'both', 'p5'] },
  { caption: '비교: "값이 내 토큰일 때만 지우는" Lua 해제였다면 A의 해제는 0(안 지움)이 돼요. B 락이 남아 있으니 C의 SET NX는 nil로 실패해요.', show: ['aBar', 'aSet', 'rA', 'aPause', 'rExp', 'bBar', 'bSet', 'rB1', 'rB2', 'rKeep', 'aSafe', 'cNil', 'p6'] },
  { caption: '그래도 0.6~0.8초에는 A(아직 락을 가졌다고 믿음)와 B가 함께 작업 중이에요. 토큰 해제로는 이 겹침을 못 막아서 펜싱 토큰이 필요해요.', show: ['aBar', 'aSet', 'rA', 'aPause', 'rExp', 'bBar', 'bSet', 'rB1', 'rB2', 'rKeep', 'aSafe', 'cNil', 'overlap', 'p7'] },
];
const ticks: [number, string][] = [[0, '0'], [0.5, '0.5'], [0.6, '0.6'], [0.8, '0.8'], [0.9, '0.9']];
// 요청 화살표: 클라이언트 열 → Redis 열
const arrows = [
  { id: 'aSet', x: C.A, t: 0, label: 'SET → OK', cls: '' },
  { id: 'bSet', x: C.B, t: 0.6, label: 'SET → OK', cls: '' },
  { id: 'aDel', x: C.A, t: 0.8, label: 'DEL → 1', cls: 'bad-a', lx: C.B + 14 },
  { id: 'aSafe', x: C.A, t: 0.8, label: 'Lua → 0', cls: '', lx: C.B + 14 },
  { id: 'cSet', x: C.C, t: 0.9, label: 'SET → OK', cls: '' },
  { id: 'cNil', x: C.C, t: 0.9, label: 'SET → nil', cls: '' },
];
const alt = new Set(['aDel', 'aSafe', 'cSet', 'cNil']);
const panels = [
  { id: 'p1', k: 'chip', l: ['A: SET lock A NX PX 500 → OK', '0.5초 뒤 자동 만료되는 락'] },
  { id: 'p2', k: 'box', l: ['A가 GC로 0.8초 멈춤', '0.5초에 락이 저절로 풀림(A는 모름)'] },
  { id: 'p3', k: 'chip', l: ['B: SET lock B NX → OK', '지금 락 주인은 B'] },
  { id: 'p4', k: 'err', l: ['A: DEL lock (값 확인 없음)', 'B의 락이 지워짐'] },
  { id: 'p5', k: 'err', l: ['C: SET lock C NX → OK', 'B와 C가 동시에 락을 쥠'] },
  { id: 'p6', k: 'chip', l: ['토큰 확인 + Lua 해제였다면', 'A 해제 → 0, C의 SET → nil', 'B의 락은 그대로 유지'] },
  { id: 'p7', k: 'err', l: ['남는 문제: 0.6~0.8초 A·B 겹침', 'TTL 락만으로는 못 막음', '→ 펜싱 토큰이 필요'] },
];
---
<Stepper title="토큰 없이 DEL하면 남의 락을 지운다" steps={steps}>
  <svg class="viz" viewBox="0 0 320 466" role="img" aria-label="A가 0.5초짜리 락을 잡고 GC로 0.8초 멈추는 사이 락이 만료되고 B가 락을 잡는다. 깨어난 A가 값 확인 없이 DEL해서 B의 락을 지우고 C까지 락을 잡는다. 토큰 확인 Lua 해제라면 A의 해제는 0, C는 실패하지만 0.6~0.8초 A와 B의 겹침은 남는다.">
    <defs>
      <marker id="ldt-g" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-2)" />
      </marker>
      <marker id="ldt-r" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-red)" />
      </marker>
    </defs>

    <!-- 머리글 -->
    <text class="sub l" x="4" y="30">초</text>
    {Object.entries(C).map(([k, x]) => <text x={x} y="30" style="font-weight:700">{k}</text>)}
    <text x={RC} y="30" style="font-weight:700">Redis 락</text>

    <!-- 시간 눈금 -->
    {ticks.map(([t, s]) => (
      <g>
        <line x1="30" y1={T(t)} x2="316" y2={T(t)} style="stroke:var(--sl-color-gray-5);stroke-width:1;stroke-dasharray:2 4" />
        <text class="sub l" x="4" y={T(t)}>{s}</text>
      </g>
    ))}
    <line x1={RX} y1={T(0)} x2={RX} y2={T(1)} style="stroke:var(--sl-color-gray-4);stroke-width:1" />

    <!-- 겹침(7단계), 동시 보유(5단계) 띠: 막대 뒤에 -->
    <g data-id="overlap" class="hide">
      <rect class="err" x={C.A - 16} y={T(0.6)} width={C.B - C.A + 32} height={T(0.8) - T(0.6)} rx="4" style="fill-opacity:.6" />
    </g>
    <g data-id="both" class="hide">
      <rect class="err" x={C.B - 16} y={T(0.9) - 4} width={C.C - C.B + 32} height={T(1) - T(0.9) + 8} rx="4" style="fill-opacity:.6" />
    </g>

    <!-- 클라이언트 막대 -->
    <rect data-id="aBar" class="chip" x={C.A - BW / 2} y={T(0)} width={BW} height={T(0.08) - T(0)} />
    <g data-id="aPause">
      <rect class="bad" x={C.A - BW / 2} y={T(0.08)} width={BW} height={T(0.8) - T(0.08)} />
      <text class="sub" x={C.A} y={T(0.44)} transform={`rotate(-90 ${C.A} ${T(0.44)})`}>GC 멈춤 0.8초</text>
    </g>
    <rect data-id="bBar" class="chip" x={C.B - BW / 2} y={T(0.6)} width={BW} height={T(1) - T(0.6)} />
    <rect data-id="cBar" class="chip hide" x={C.C - BW / 2} y={T(0.9)} width={BW} height={T(1) - T(0.9)} />

    <!-- Redis 락 값 -->
    <g data-id="rA">
      <rect class="chip" x={RX + 4} y={T(0)} width={RW - 8} height={T(0.5) - T(0)} rx="4" />
      <text x={RC} y={T(0.2)} style="font-weight:700">값 A</text>
      <text class="sub" x={RC} y={T(0.3)}>PX 500</text>
    </g>
    <text data-id="rExp" class="sub" x={RC} y={(T(0.5) + T(0.6)) / 2}>자동 만료</text>
    <g data-id="rB1">
      <rect class="chip" x={RX + 4} y={T(0.6)} width={RW - 8} height={T(0.8) - T(0.6)} rx="4" />
      <text x={RC} y={(T(0.6) + T(0.8)) / 2} style="font-weight:700">값 B</text>
    </g>
    <g data-id="rB2" class="hide">
      <rect class="chip" x={RX + 4} y={T(0.8)} width={RW - 8} height={T(1) - T(0.8)} rx="4" />
    </g>
    <text data-id="rKeep" class="hi hide" x={RC} y={(T(0.8) + T(1)) / 2}>B 유지</text>
    <g data-id="rDel" class="hide">
      <rect class="err" x={RX + 4} y={T(0.8)} width={RW - 8} height={T(0.9) - T(0.8)} rx="4" style="stroke-dasharray:4 3" />
      <text class="err-t" x={RC} y={(T(0.8) + T(0.9)) / 2}>삭제됨</text>
    </g>
    <g data-id="rC" class="hide">
      <rect class="err" x={RX + 4} y={T(0.9)} width={RW - 8} height={T(1) - T(0.9)} rx="4" />
      <text x={RC} y={(T(0.9) + T(1)) / 2} style="font-weight:700">값 C</text>
    </g>

    <!-- 요청 화살표 -->
    {arrows.map((a) => (
      <g data-id={a.id} class={alt.has(a.id) ? 'hide' : undefined}>
        <line x1={a.x + BW / 2} y1={T(a.t)} x2={RX - 2} y2={T(a.t)}
          style={a.cls ? 'stroke:var(--sl-color-red);stroke-width:2' : 'stroke:var(--sl-color-gray-2);stroke-width:1.6'}
          marker-end={a.cls ? 'url(#ldt-r)' : 'url(#ldt-g)'} />
        <text class={`l halo ${a.cls ? 'err-t' : 'sub'}`} x={a.lx ?? a.x + BW / 2 + 4} y={T(a.t) - 10}>{a.label}</text>
      </g>
    ))}

    <!-- 아래 설명 패널 -->
    {panels.map((p) => (
      <g data-id={p.id} class="hide">
        <rect class={p.k} x="6" y={PY} width="308" height={PH} rx="8" />
        {p.l.map((s, i) => (
          <text class={i === 0 ? (p.k === 'err' ? 'err-t' : 'hi') : i === 1 ? '' : 'sub'} x="160"
            y={p.l.length === 2 ? PY + 28 + i * 28 : PY + 20 + i * 22} style={i ? 'font-size:14px' : undefined}>{s}</text>
        ))}
      </g>
    ))}
  </svg>
</Stepper>

<style>
  .viz :global(.halo) { paint-order: stroke; stroke: var(--sl-color-gray-7, var(--sl-color-black)); stroke-width: 4px; stroke-linejoin: round; }
</style>
