---
// Pod 종료 경쟁: 위 레인은 라우팅(EndpointSlice→Ingress) 반영, 아래 레인은 컨테이너 종료. 같은 30초 축 위에서 비교.
import Stepper from '../Stepper.astro';
const X = (t: number) => 16 + t * 9.6;   // 0~30초 → x 16~304
const SYNC = 8;                           // 라우팅 반영이 끝나는 시점(예시, 실제론 몇 초로 들쭉날쭉)
const A = 98, B = 172, H = 36;            // 레인 top, 높이
const steps = [
  { caption: '롤링 배포가 옛 Pod 삭제를 요청해요. 그 순간 유예 시간(기본 30초) 타이머가 시작돼요.', show: ['timer', 'res1'] },
  { caption: '동시에 두 갈래가 시작돼요. 컨트롤 플레인은 EndpointSlice에서 이 Pod를 terminating·ready=false로 표시하고, kubelet은 컨테이너 종료를 시작해요. 그런데 kube-proxy·Ingress가 바뀐 목록을 반영하는 데는 몇 초가 걸려요.', show: ['timer', 'laneA', 'laneB', 'sync', 'res2'] },
  { caption: 'preStop이 없으면 SIGTERM이 바로 가요. 앱은 새 연결을 거부하는데, 아직 반영 못 한 Ingress가 요청을 보내서 502가 나요.', show: ['timer', 'laneA', 'laneB', 'sync', 'bNo', 'noPre', 'res3'] },
  { caption: 'preStop에 sleep 10초를 넣으면 그동안 컨테이너는 그대로 요청을 받아요. 그사이 라우팅 반영이 끝나서 새 요청이 끊겨요.', show: ['timer', 'laneA', 'laneB', 'sync', 'bPre', 'pre', 'res4'] },
  { caption: 'sleep이 끝난 뒤에야 SIGTERM이 와요. Spring은 우아한 종료로 새 요청은 거부하고, 처리 중인 요청만 마무리해요.', show: ['timer', 'laneA', 'laneB', 'sync', 'bPre', 'pre', 'term', 'res5'] },
  { caption: '유예 시간이 끝났는데도 살아 있으면 SIGKILL로 강제 종료돼요. 유예 시간에는 preStop 시간도 포함되니 preStop 10초 + 앱 종료 시간보다 넉넉하게 잡아요.', show: ['timer', 'laneA', 'laneB', 'sync', 'bPre', 'pre', 'term', 'kill', 'res6'] },
];
const res = [
  ['t = 0: Pod 삭제 요청', '유예 타이머 30초 시작'],
  ['두 갈래가 동시에 시작', '라우팅 반영은 몇 초 늦어요'],
  ['반영 전에 SIGTERM', '→ 들어온 요청이 502'],
  ['sleep 동안 라우팅 반영 완료', '→ 새 요청이 끊겨요'],
  ['SIGTERM → 새 요청 거부,', '처리 중 요청은 마무리'],
  ['30초가 지나도 살아 있으면', 'SIGKILL (강제 종료)'],
];
---
<Stepper title="Pod가 종료될 때 생기는 틈과 preStop" steps={steps}>
  <svg class="viz" viewBox="0 0 320 324" role="img" aria-label="Pod 삭제 후 라우팅 반영과 컨테이너 종료가 동시에 진행되는 두 레인 타임라인. preStop이 없으면 SIGTERM이 먼저 가서 502가 나고, preStop sleep 10초가 있으면 반영 후 SIGTERM이 간다.">
    <g data-id="timer">
      <text class="l" x="16" y="16" style="font-weight:700">유예 시간 30초</text>
      <rect class="chip" x={X(0)} y="30" width={X(30) - X(0)} height="12" rx="6" />
      <text class="sub l" x={X(0)} y="58">0초 삭제</text>
      <text class="sub" x={X(10)} y="58">10초</text>
      <text class="sub" x={X(30)} y="58" style="text-anchor:end">30초</text>
    </g>

    <!-- 레인 A: 라우팅 -->
    <g data-id="laneA">
      <text class="l" x="16" y={A - 14} style="font-weight:700">라우팅 (EndpointSlice → Ingress)</text>
      <rect class="bad" x={X(0)} y={A} width={X(SYNC) - X(0)} height={H} rx="6" />
      <text class="sub" x={(X(0) + X(SYNC)) / 2} y={A + H / 2}>반영 중</text>
      <rect class="box" x={X(SYNC)} y={A} width={X(30) - X(SYNC)} height={H} rx="6" />
      <text x={(X(SYNC) + X(30)) / 2} y={A + H / 2}>목록에서 빠짐 · 새 요청 없음</text>
    </g>

    <!-- 레인 B: 컨테이너 -->
    <g data-id="laneB">
      <text class="l" x="16" y={B - 14} style="font-weight:700">컨테이너 (kubelet)</text>
      <rect class="frame" x={X(0)} y={B} width={X(30) - X(0)} height={H} rx="6" />
    </g>
    <text data-id="bNo" class="err-t l hide" x="170" y={B - 14}>preStop 없음</text>
    <text data-id="bPre" class="hi l hide" x="170" y={B - 14}>preStop sleep 10초</text>

    <g data-id="noPre" class="hide">
      <rect class="err" x={X(0)} y={B} width={X(SYNC) - X(0)} height={H} rx="6" />
      <text class="err-t" x={(X(0) + X(SYNC)) / 2} y={B + H / 2}>502 ✕</text>
      <rect class="box" x={X(SYNC)} y={B} width={X(20) - X(SYNC)} height={H} rx="6" />
      <text x={(X(SYNC) + X(20)) / 2} y={B + H / 2}>SIGTERM 후 종료</text>
    </g>
    <g data-id="pre" class="hide">
      <rect class="box" x={X(0)} y={B} width={X(10) - X(0)} height={H} rx="6" />
      <text x={(X(0) + X(10)) / 2} y={B + H / 2}>sleep 10초</text>
    </g>
    <g data-id="term" class="hide">
      <rect class="chip" x={X(10)} y={B} width={X(28) - X(10)} height={H} rx="6" />
      <text x={(X(10) + X(28)) / 2} y={B + H / 2}>SIGTERM · 우아한 종료</text>
    </g>
    <g data-id="kill" class="hide">
      <rect class="err" x={X(28)} y={B} width={X(30) - X(28)} height={H} rx="3" />
      <text class="err-t" x={X(30)} y={B + H + 18} style="text-anchor:end">30초: 남아 있으면 SIGKILL ✕</text>
    </g>

    <!-- 라우팅 반영 완료 시점 기준선 -->
    <path data-id="sync" class="line" d={`M${X(SYNC)} ${A - 4} L${X(SYNC)} ${A + H + 4} M${X(SYNC)} ${B - 4} L${X(SYNC)} ${B + H + 4}`} style="stroke-dasharray:4 3" />

    <rect class="frame" x="16" y="250" width="288" height="66" rx="10" />
    {res.map(([a, b], i) => (
      <g data-id={`res${i + 1}`} class="hide">
        <text class="hi l" x="30" y="272" style="font-size:15px">{a}</text>
        <text class="l" x="30" y="296">{b}</text>
      </g>
    ))}
  </svg>
</Stepper>
