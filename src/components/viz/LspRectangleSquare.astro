---
// LSP: Rectangle 자리에 Square를 넣으면 setWidth/setHeight 후 넓이가 기대(20)와 달라짐(16)
import Stepper from '../Stepper.astro';
const steps = [
  { caption: 'Rectangle에 너비 5, 높이 4를 넣으면 넓이는 20이에요. 클라이언트가 기대한 그대로예요.', show: ['c1', 's1', 'r1'] },
  { caption: '같은 Rectangle 변수에 Square를 넣고 setWidth(5)를 불러요. 정사각형은 변을 맞춰야 해서 높이까지 5가 돼요.', show: ['c2', 's2', 'expect'] },
  { caption: '이어서 setHeight(4)를 부르면 너비까지 4로 바뀌어요. 앞에서 넣은 너비 5가 사라졌어요.', show: ['c3', 's3', 'expect'] },
  { caption: 'area()는 16이에요. 부모 타입으로 기대한 20이 안 나오니 Square는 Rectangle 자리를 대신할 수 없어요 = LSP 위반.', show: ['c4', 's3', 'expect', 'r4'] },
];
---
<Stepper title="LSP: 직사각형 자리에 정사각형을 넣으면" steps={steps}>
  <svg class="viz" viewBox="0 0 320 320" role="img" aria-label="Rectangle은 5×4로 넓이 20이지만, Square를 넣으면 setHeight(4) 뒤 4×4가 되어 넓이 16이 나오는 그림">
    <g data-id="c1" class="hide">
      <text class="mono l" x="8" y="20">Rectangle r = new <tspan class="hi">Rectangle</tspan>();</text>
      <text class="mono l" x="8" y="44">r.setWidth(5); r.setHeight(4);</text>
    </g>
    <g data-id="c2" class="hide">
      <text class="mono l" x="8" y="20">Rectangle r = new <tspan class="hi">Square</tspan>();</text>
      <text class="mono l" x="8" y="44"><tspan class="hi">r.setWidth(5);</tspan></text>
    </g>
    <g data-id="c3" class="hide">
      <text class="mono l" x="8" y="20">Rectangle r = new Square();</text>
      <text class="mono l" x="8" y="44">r.setWidth(5); <tspan class="hi">r.setHeight(4);</tspan></text>
    </g>
    <g data-id="c4" class="hide">
      <text class="mono l" x="8" y="20">Rectangle r = new Square(); ...</text>
      <text class="mono l" x="8" y="44"><tspan class="hi">r.area();</tspan></text>
    </g>

    <!-- 한 칸 = 20 -->
    <g data-id="s1" class="hide">
      <rect class="chip" x="30" y="80" width="100" height="80" />
      <text class="sub" x="80" y="176">너비 5</text>
      <text class="sub l" x="138" y="120">높이 4</text>
    </g>
    <g data-id="s2" class="hide">
      <rect class="chip" x="30" y="80" width="100" height="100" />
      <text class="sub" x="80" y="196">너비 5</text>
      <text class="sub l" x="138" y="130">높이 <tspan class="hi">5</tspan></text>
      <text class="sub l" x="190" y="96">높이도</text>
      <text class="sub l" x="190" y="116">따라 바뀜</text>
    </g>
    <g data-id="s3" class="hide">
      <rect class="frame" x="30" y="80" width="100" height="100" />
      <rect class="chip" x="30" y="80" width="80" height="80" />
      <text class="sub" x="70" y="196">너비 <tspan class="hi">4</tspan></text>
      <text class="sub l" x="138" y="120">높이 4</text>
      <text class="sub l" x="190" y="96">너비 5가</text>
      <text class="sub l" x="190" y="116">사라짐</text>
    </g>

    <g data-id="r1" class="hide">
      <rect class="box" x="8" y="222" width="304" height="44" rx="8" />
      <text x="160" y="244">area() = 20 ✓ 기대대로</text>
    </g>
    <g data-id="expect" class="hide">
      <rect class="box" x="8" y="222" width="304" height="40" rx="8" />
      <text class="sub" x="160" y="242">클라이언트 기대: 5 × 4 = 20</text>
    </g>
    <g data-id="r4" class="hide">
      <rect class="err" x="8" y="272" width="304" height="40" rx="8" />
      <text class="err-t" x="160" y="292">area() = 16 ✗ 치환 불가 (LSP 위반)</text>
    </g>
  </svg>
</Stepper>
