---
// 긴 트랜잭션 하나가 purge를 막아 History list length가 쌓이는 과정 (실험 E4 수치)
import Stepper from '../Stepper.astro';
const base = ['t1-box', 'oth-box', 'undo', 'purge-box', 'n-label'];
const steps = [
  { caption: '세션 T1이 트랜잭션을 열고 아무것도 하지 않아요. REPEATABLE READ라서 T1은 이 순간의 데이터를 끝까지 봐야 해요.', show: [...base, 't1-open', 'oth-idle', 'n-low', 'p-idle', 'hl-t1'] },
  { caption: '다른 세션들이 UPDATE·COMMIT을 303번 해요. 바뀌기 전 옛 버전이 undo에 남고, History list length가 303이 돼요.', show: [...base, 't1-open', 'oth-r1', 'b1', 'n303', 'p-block', 'hl-b1', 'hl-n'] },
  { caption: '한 번 더 303건을 커밋해요. 606이 돼요. 커밋은 끝났지만 옛 버전은 지워지지 않아요.', show: [...base, 't1-open', 'oth-r2', 'b1', 'b2', 'n606', 'p-block', 'hl-b2', 'hl-n'] },
  { caption: '세 번째 라운드 뒤 909예요. 아무 작업 없이 5초를 더 기다려도 910이에요. purge(정리 작업)가 손을 못 대고 있어요.', show: [...base, 't1-open', 'oth-r3', 'b1', 'b2', 'b3', 'n909', 'p-block', 'hl-b3', 'hl-n', 'hl-p'] },
  { caption: '이유는 T1이에요. T1이 합계를 읽으면 시작 시점 값 81300이 나와요. 실제 합계는 172200인데, 옛 버전을 undo에서 꺼내 보여주는 거예요. 그러니 purge가 지울 수 없어요.', show: [...base, 't1-read', 'oth-r3', 'b1', 'b2', 'b3', 'n909', 'p-block', 'cmp', 'hl-cmp'] },
  { caption: 'T1이 COMMIT하면 붙잡던 읽기 시점이 사라져요. purge가 쌓인 옛 버전을 한꺼번에 정리해서, 5초 뒤 History list length는 0이 돼요.', show: [...base, 't1-commit', 'oth-r3', 'n0', 'p-clean', 'hl-t1', 'hl-n', 'hl-p'] },
];
---
<Stepper title="긴 트랜잭션 하나가 undo 정리를 막는 과정" steps={steps}>
  <svg class="viz" viewBox="0 0 320 404" role="img" aria-label="세션 T1이 트랜잭션을 열어 둔 동안 다른 세션의 커밋으로 옛 버전이 쌓여 History list length가 303, 606, 909로 늘고 purge가 지우지 못하다가, T1이 커밋하자 0으로 정리되는 그림">
    <rect data-id="t1-box" class="chip" x="8" y="4" width="304" height="36" rx="7" />
    <text data-id="t1-open" class="hide" x="160" y="22">T1: 트랜잭션 열고 대기 중</text>
    <text data-id="t1-read" class="hide" x="160" y="22">T1: SELECT SUM(bal) 실행</text>
    <text data-id="t1-commit" class="hi hide" x="160" y="22">T1: COMMIT</text>

    <rect data-id="oth-box" class="box" x="8" y="50" width="304" height="34" rx="7" />
    <text data-id="oth-idle" class="sub hide" x="160" y="67">다른 세션들: 아직 없음</text>
    <text data-id="oth-r1" class="hide" x="160" y="67">다른 세션: UPDATE·COMMIT 303건</text>
    <text data-id="oth-r2" class="hide" x="160" y="67">다른 세션: 303건 더 (2라운드)</text>
    <text data-id="oth-r3" class="hide" x="160" y="67">다른 세션: 303건 더 (3라운드)</text>

    <g data-id="undo">
      <rect class="frame" x="8" y="94" width="304" height="176" rx="10" />
      <text class="sub l" x="16" y="109">undo에 남은 옛 버전</text>
    </g>
    <g data-id="b3" class="hide"><rect class="chip" x="18" y="122" width="180" height="40" rx="6" /><text x="108" y="142">3라운드 옛 버전</text></g>
    <g data-id="b2" class="hide"><rect class="chip" x="18" y="168" width="180" height="40" rx="6" /><text x="108" y="188">2라운드 옛 버전</text></g>
    <g data-id="b1" class="hide"><rect class="chip" x="18" y="214" width="180" height="40" rx="6" /><text x="108" y="234">1라운드 옛 버전</text></g>

    <g data-id="n-label"><text class="sub" x="256" y="150">History list</text><text class="sub" x="256" y="168">length</text></g>
    <text data-id="n-low" class="big hide" x="256" y="204">낮음</text>
    <text data-id="n303" class="big hide" x="256" y="204">303</text>
    <text data-id="n606" class="big hide" x="256" y="204">606</text>
    <text data-id="n909" class="big hide" x="256" y="204">909</text>
    <text data-id="n0" class="big hide" x="256" y="204">0</text>

    <rect data-id="purge-box" class="box" x="8" y="280" width="304" height="50" rx="7" />
    <text class="sub l" x="18" y="295">purge 스레드 (옛 버전 정리)</text>
    <text data-id="p-idle" class="hide" x="160" y="316">정리할 것 없음</text>
    <text data-id="p-block" class="err-t hide" x="160" y="316">못 지움: T1이 아직 볼 수 있음</text>
    <text data-id="p-clean" class="hi hide" x="160" y="316">한꺼번에 정리 → 0</text>

    <g data-id="cmp" class="hide">
      <rect class="box" x="8" y="340" width="304" height="58" rx="7" />
      <text class="l" x="18" y="358">T1이 본 합계: <tspan class="hi">81300</tspan> (시작 시점)</text>
      <text class="l" x="18" y="382">지금 실제 합계: 172200</text>
    </g>

    <rect data-id="hl-t1" class="hl" x="4" y="1" width="312" height="42" rx="9" />
    <rect data-id="hl-b1" class="hl" x="14" y="210" width="188" height="48" rx="8" />
    <rect data-id="hl-b2" class="hl" x="14" y="164" width="188" height="48" rx="8" />
    <rect data-id="hl-b3" class="hl" x="14" y="118" width="188" height="48" rx="8" />
    <rect data-id="hl-n" class="hl" x="208" y="130" width="98" height="96" rx="8" />
    <rect data-id="hl-p" class="hl" x="4" y="276" width="312" height="58" rx="9" />
    <rect data-id="hl-cmp" class="hl" x="4" y="336" width="312" height="66" rx="9" />
  </svg>
</Stepper>

<style>
  svg.viz text.big { font-size: 30px; font-weight: 700; fill: var(--sl-color-accent-high); }
</style>
