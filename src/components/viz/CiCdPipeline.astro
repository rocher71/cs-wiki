---
// CI/CD 파이프라인 한 줄 띠: merge → 빌드 → 테스트 → 이미지 → 스테이징 → (승인 게이트) → 운영.
// 오른쪽 세로 막대로 CI / 지속적 전달 / 지속적 배포가 띠의 어디까지인지 표시한다.
import Stepper from '../Stepper.astro';
const steps = [
  { caption: '1. 개발자가 변경을 main 브랜치에 합쳐요(merge·push). 이 이벤트가 파이프라인을 자동으로 시작시켜요.', show: ['r1', 'hl1'] },
  { caption: '2. CI가 코드를 빌드해요(컴파일·패키징). 사람이 손대지 않아요.', show: ['r1', 'r2', 'hl2'] },
  { caption: '3. 자동 테스트를 돌려요. 하나라도 실패하면 여기서 멈추고 빨간불로 알려요. 통과해야 다음으로 가요.', show: ['r1', 'r2', 'r3', 'fail', 'hl3'] },
  { caption: '4. 컨테이너 이미지를 딱 한 번 만들어 레지스트리에 올려요(app:v1.4.2). 이후 모든 환경은 이 이미지 하나만 써요. 여기까지 ②~③이 CI 범위예요.', show: ['r1', 'r2', 'r3', 'r4', 'band-ci', 'hl4'] },
  { caption: '5. 스테이징에 같은 이미지를 배포하고 통합·E2E 테스트를 돌려요. 운영과 비슷한 환경에서 한 번 더 확인해요.', show: ['r1', 'r2', 'r3', 'r4', 'r5', 'band-ci', 'hl5'] },
  { caption: '6. 지속적 전달은 운영 직전에 사람이 승인 버튼을 눌러요(수동 게이트). 지속적 배포는 이 게이트 없이 끝까지 자동으로 가요.', show: ['r1', 'r2', 'r3', 'r4', 'r5', 'r6', 'band-ci', 'band-cd', 'band-dp', 'legend', 'hl6'] },
  { caption: '7. 운영에도 스테이징에서 검증한 그 이미지(app:v1.4.2)를 그대로 배포해요. 다시 빌드하지 않아서 "검사한 것 = 나가는 것"이 보장돼요.', show: ['r1', 'r2', 'r3', 'r4', 'r5', 'r6', 'r7', 'band-ci', 'band-cd', 'band-dp', 'legend', 'hl7'] },
];
// 행 i(1~7)의 윗변 y
const top = (i: number) => 36 + (i - 1) * 58;
const rows = [
  ['① main에 merge', 'push 이벤트로 시작', false],
  ['② 빌드', '컴파일·패키징', false],
  ['③ 자동 테스트', '단위 테스트 등', false],
  ['④ 이미지 → 레지스트리', 'app:v1.4.2', true],
  ['⑤ 스테이징 + E2E', '같은 app:v1.4.2', true],
  ['⑥ 운영 앞 승인 게이트', '사람이 승인 버튼', false],
  ['⑦ 운영 배포', '같은 app:v1.4.2', true],
] as const;
---
<Stepper title="CI/CD 파이프라인: 한 번 빌드, 여러 번 배포" steps={steps}>
  <svg class="viz" viewBox="0 0 320 506" role="img" aria-label="merge, 빌드, 자동 테스트, 이미지 빌드와 레지스트리 push, 스테이징 배포와 E2E, 운영 승인 게이트, 운영 배포 순서의 파이프라인. CI는 빌드와 테스트, 지속적 전달은 운영 앞에 사람 승인이 있고, 지속적 배포는 끝까지 자동이다">
    <defs>
      <marker id="cp-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    {rows.map(([main, sub, mono], k) => {
      const i = k + 1, y = top(i);
      return (
        <g data-id={`r${i}`}>
          {i > 1 && <line class="line" x1="105" y1={y - 12} x2="105" y2={y - 1} marker-end="url(#cp-arr)" />}
          <rect class="box" x="10" y={y} width="190" height="46" rx="8" />
          <text x="105" y={y + 15}>{main}</text>
          <text class={mono ? 'mono hi' : 'sub'} x="105" y={y + 33}>{sub}</text>
        </g>
      );
    })}

    <g data-id="fail" class="hide">
      <rect class="err" x="210" y={top(3)} width="104" height="46" rx="8" />
      <text class="err-t" x="262" y={top(3) + 15}>✕ 실패하면</text>
      <text class="err-t" x="262" y={top(3) + 33}>여기서 멈춤</text>
    </g>

    <!-- CI: ②~③ -->
    <g data-id="band-ci" class="hide">
      <text x="228" y="18" style="font-weight:700">CI</text>
      <rect class="chip" x="222" y={top(2)} width="12" height={top(3) + 46 - top(2)} rx="6" />
    </g>
    <!-- 지속적 전달: ②~⑤ 자동, ⑥ 수동 게이트, ⑦ 승인 뒤 -->
    <g data-id="band-cd" class="hide">
      <text x="264" y="18" style="font-weight:700">전달</text>
      <rect class="chip" x="258" y={top(2)} width="12" height={top(5) + 46 - top(2)} rx="6" />
      <rect class="err" x="246" y={top(6) + 6} width="36" height="34" rx="6" />
      <text class="err-t" x="264" y={top(6) + 23} style="font-size:14px">수동</text>
      <rect class="chip" x="258" y={top(7)} width="12" height="46" rx="6" />
    </g>
    <!-- 지속적 배포: ②~⑦ 끝까지 자동 -->
    <g data-id="band-dp" class="hide">
      <text x="300" y="18" style="font-weight:700">배포</text>
      <rect class="chip" x="294" y={top(2)} width="12" height={top(7) + 46 - top(2)} rx="6" />
    </g>

    <g data-id="legend" class="hide">
      <text class="sub l" x="10" y="452">CI = 지속적 통합 (②~③)</text>
      <text class="sub l" x="10" y="472">전달 = 지속적 전달 (⑥ 사람 승인)</text>
      <text class="sub l" x="10" y="492">배포 = 지속적 배포 (승인 없이 자동)</text>
    </g>

    {[1, 2, 3, 4, 5, 6, 7].map((i) => (
      <rect data-id={`hl${i}`} class="hl" x="6" y={top(i) - 4} width="198" height="54" rx="10" />
    ))}
  </svg>
</Stepper>
