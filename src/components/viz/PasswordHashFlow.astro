---
// 비밀번호 저장: 가입(솔트 생성 → bcrypt → DB 저장), 같은 비번 다른 사용자, 로그인(저장된 솔트·비용으로 재해시 → 비교). 값은 짧게 줄인 예시.
import Stepper from '../Stepper.astro';
const S = (...ids: string[]) => ids;
const signA = ['phA', 'inA', 'saltNew'];
const login = ['phL', 'saltDb', 'sL', 'hash', 'rowA', 'rowB', 'hlA'];
const steps = [
  { caption: '가입: 사용자 A가 비밀번호 hunter2를 입력해요. 서버는 이걸 그대로 저장하지 않아요.', show: S(...signA) },
  { caption: '서버가 A만을 위한 랜덤 솔트(16바이트)를 새로 만들어요. 그림의 Xq9r…는 짧게 줄인 예시 값이에요.', show: S(...signA, 'sA') },
  { caption: 'bcrypt에 비번·솔트·비용(10)을 넣어요. 비용 10은 2¹⁰ = 1,024번 반복이라는 뜻이고, 일부러 느리게 만들어 무차별 대입을 막아요.', show: S(...signA, 'sA', 'hash', 'oA') },
  { caption: '결과 한 줄에 알고리즘($2a)·비용($10)·솔트·해시가 다 들어 있어요. 앞에 {bcrypt}를 붙여 A행에 저장해요. 솔트는 비밀이 아니라 함께 저장해요.', show: S(...signA, 'sA', 'hash', 'oA', 'brk', 'rowA') },
  { caption: '사용자 B도 똑같이 hunter2로 가입해요. 그런데 솔트가 달라서(pT2w…) 저장값도 완전히 달라요. 그래서 해시만 보고 "같은 비번 쓰는 사람"을 찾을 수 없어요.', show: S('phB', 'inB', 'saltNew', 'sB', 'hash', 'oB', 'rowA', 'rowB', 'noteB') },
  { caption: '로그인: A가 hunter2를 입력해요. 서버는 A행 저장값에서 솔트(Xq9r…)와 비용(10)을 꺼내요.', show: S(...login, 'inL') },
  { caption: '같은 비번·같은 솔트·같은 비용으로 다시 해시하면 저장값과 똑같이 나와요. 일치하면 로그인 성공. 원래 비번은 DB 어디에도 없어요.', show: S(...login, 'inL', 'oL', 'cmpOk', 'noteL') },
  { caption: '비번을 hunter3으로 틀리면 솔트가 같아도 해시가 완전히 달라져요(Zk0p…). 저장값과 다르니 로그인 실패예요.', show: S(...login, 'inW', 'oW', 'cmpNg', 'noteL') },
];
---
<Stepper title="비밀번호를 솔트 + 느린 해시로 저장하고 확인하기" steps={steps}>
  <svg class="viz" viewBox="0 0 320 420" role="img" aria-label="가입 때 랜덤 솔트와 bcrypt로 해시해 저장하고, 같은 비밀번호라도 사용자마다 저장값이 다르며, 로그인 때 저장된 솔트와 비용으로 다시 해시해 비교하는 과정">
    <defs>
      <marker id="phf-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
    </defs>
    <!-- 단계 이름 (같은 자리 번갈아) -->
    <text data-id="phA" class="l hi hide" x="10" y="18">가입: 사용자 A</text>
    <text data-id="phB" class="l hi hide" x="10" y="18">가입: 사용자 B (같은 비번)</text>
    <text data-id="phL" class="l hi hide" x="10" y="18">로그인: 사용자 A</text>

    <!-- 입력 / 솔트 칸 -->
    <rect class="box" x="10" y="36" width="145" height="60" rx="8" />
    <text class="sub" x="82" y="54">비밀번호 입력</text>
    <rect class="box" x="165" y="36" width="145" height="60" rx="8" />
    <text data-id="saltNew" class="sub hide" x="238" y="54">솔트(랜덤 16바이트)</text>
    <text data-id="saltDb" class="sub hide" x="238" y="54">저장된 솔트(A행)</text>
    <text data-id="inA" class="mono hide" x="82" y="78">hunter2</text>
    <text data-id="inB" class="mono hide" x="82" y="78">hunter2</text>
    <text data-id="inL" class="mono hide" x="82" y="78">hunter2</text>
    <text data-id="inW" class="mono err-t hide" x="82" y="78">hunter3</text>
    <text data-id="sA" class="mono hi hide" x="238" y="78">Xq9r…</text>
    <text data-id="sB" class="mono hi hide" x="238" y="78">pT2w…</text>
    <text data-id="sL" class="mono hi hide" x="238" y="78">Xq9r…</text>

    <!-- 느린 해시 -->
    <g data-id="hash">
      <line x1="82" y1="96" x2="82" y2="118" style="stroke:var(--sl-color-accent);stroke-width:2.4" marker-end="url(#phf-a)" />
      <line x1="238" y1="96" x2="238" y2="118" style="stroke:var(--sl-color-accent);stroke-width:2.4" marker-end="url(#phf-a)" />
      <rect class="chip" x="40" y="120" width="240" height="50" rx="8" />
      <text x="160" y="138">bcrypt(비번, 솔트, 비용 10)</text>
      <text class="sub" x="160" y="158">1,024번 반복 → 일부러 느림</text>
      <line x1="160" y1="170" x2="160" y2="194" style="stroke:var(--sl-color-accent);stroke-width:2.4" marker-end="url(#phf-a)" />
      <rect class="box" x="30" y="196" width="260" height="30" rx="6" />
    </g>
    <text data-id="oA" class="mono hide" x="160" y="211">$2a$10$Xq9r…Lm4k…</text>
    <text data-id="oB" class="mono hide" x="160" y="211">$2a$10$pT2w…c8Vn…</text>
    <text data-id="oL" class="mono hide" x="160" y="211">$2a$10$Xq9r…Lm4k…</text>
    <text data-id="oW" class="mono err-t hide" x="160" y="211">$2a$10$Xq9r…Zk0p…</text>

    <!-- 결과 풀이 / 비교 (같은 자리 번갈아) -->
    <g data-id="brk" class="hide">
      <text class="sub" x="85" y="250"><tspan class="hi">$2a</tspan> = 알고리즘</text>
      <text class="sub" x="240" y="250"><tspan class="hi">$10</tspan> = 비용</text>
      <text class="sub" x="85" y="274"><tspan class="hi">Xq9r…</tspan> = 솔트</text>
      <text class="sub" x="240" y="274"><tspan class="hi">Lm4k…</tspan> = 해시</text>
    </g>
    <g data-id="cmpOk" class="hide">
      <text class="sub" x="160" y="250">A행 저장값과 똑같아요</text>
      <text class="hi" x="160" y="274">일치 ✓ 로그인 성공</text>
    </g>
    <g data-id="cmpNg" class="hide">
      <text class="sub" x="160" y="250">A행 저장값과 달라요</text>
      <text class="err-t" x="160" y="274">불일치 ✕ 로그인 실패</text>
    </g>

    <!-- DB -->
    <text class="l" x="10" y="304" style="font-weight:700">users 테이블 (DB)</text>
    <g data-id="rowA" class="hide">
      <rect class="box" x="10" y="316" width="300" height="30" rx="5" />
      <text x="26" y="331" style="font-weight:700">A</text>
      <text class="mono l" x="44" y="331">{'{bcrypt}$2a$10$Xq9r…Lm4k…'}</text>
    </g>
    <g data-id="rowB" class="hide">
      <rect class="box" x="10" y="354" width="300" height="30" rx="5" />
      <text x="26" y="369" style="font-weight:700">B</text>
      <text class="mono l" x="44" y="369">{'{bcrypt}$2a$10$pT2w…c8Vn…'}</text>
    </g>
    <rect data-id="hlA" class="hl" x="7" y="313" width="306" height="36" rx="7" />
    <text data-id="noteB" class="hi hide" x="160" y="404">같은 hunter2인데 저장값이 달라요</text>
    <text data-id="noteL" class="sub hide" x="160" y="404">원래 비번은 어디에도 저장 안 돼요</text>
  </svg>
</Stepper>
