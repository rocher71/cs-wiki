---
// "API가 느려요" 판별 흐름: 증상 → DB 구간 분리 → 갈래 4개 → 연쇄 → 공통 마무리.
// 갈래는 연쇄 순서(쿼리 → 락 → 커넥션)대로 위에서 아래로 쌓고, N+1을 맨 아래에 둔다.
import Stepper from '../Stepper.astro';
const all = ['sym', 'trunk', 'b1', 'b2', 'b3', 'b4'];
const steps = [
  { caption: '증상: API p99(느린 쪽 1%의 응답 시간)가 오르고 타임아웃이 나요. APM·로그로 DB 구간이 느린 건지부터 먼저 갈라요.', show: ['sym', 'hl0'] },
  { caption: '갈래 1 — 쿼리 한 번이 길다: 슬로우 로그와 sys.statement_analysis 상위 쿼리를 찾고, EXPLAIN ANALYZE로 이유를 읽은 뒤 조건·인덱스를 고쳐요.', show: ['sym', 'trunk', 'b1', 'hl1'] },
  { caption: '갈래 2 — 락을 기다린다: PROCESSLIST의 TIME이 계속 늘고 innodb_trx에 LOCK WAIT가 보여요. data_lock_waits로 막는 세션을 찾고 트랜잭션을 짧게 해요.', show: ['sym', 'trunk', 'b1', 'b2', 'hl2'] },
  { caption: '갈래 3 — 커넥션을 못 얻는다: Hikari pending이 늘고 30초 뒤 "Connection is not available" 예외가 나요. 풀 크기보다 커넥션을 오래 쥐는 코드를 찾아요.', show: ['sym', 'trunk', 'b1', 'b2', 'b3', 'hl3'] },
  { caption: '갈래 4 — 쿼리는 빠른데 개수가 많다: digest의 COUNT_STAR(실행 횟수)가 폭증하면 N+1이에요. fetch join이나 batch size로 묶어요.', show: [...all, 'hl4'] },
  { caption: '갈래끼리 연쇄돼요: 느린 쿼리가 락을 오래 쥐면, 기다리는 요청이 커넥션을 쥔 채 멈추고, 결국 풀이 고갈돼요. 그래서 제일 위 원인부터 봐요.', show: [...all, 'ch1', 'ch2', 'chain', 'hl1', 'hl2', 'hl3'] },
  { caption: '공통 마무리: 슬로우 로그 기준(long_query_time)을 낮추고, 대시보드 알림을 걸고, 배포 전에 EXPLAIN 리뷰를 해서 재발을 막아요.', show: [...all, 'wrap', 'hl5'] },
];
const boxes = [
  { n: 1, t: '쿼리 한 번이 길다', s1: '슬로우 로그 · digest 상위', s2: '→ EXPLAIN ANALYZE → 조건 수정' },
  { n: 2, t: '락을 기다린다', s1: 'TIME↑ · innodb_trx LOCK WAIT', s2: '→ 막는 세션 찾기 → 트랜잭션 단축' },
  { n: 3, t: '커넥션을 못 얻는다', s1: 'Hikari pending↑ · 30초 뒤 예외', s2: '→ 커넥션 오래 쥐는 코드 찾기' },
  { n: 4, t: '쿼리는 빠른데 개수가 많다', s1: 'digest COUNT_STAR 폭증 = N+1', s2: '→ fetch join · batch size' },
].map((b, i) => ({ ...b, y: 74 + i * 80 }));
const BX = 26, BW = 256, BH = 72, END = 74 + 3 * 80 + 36;
---
<Stepper title='"API가 느려요" 어느 갈래인지 가르기' steps={steps}>
  <svg class="viz" viewBox="0 0 320 478" role="img" aria-label="API 지연 증상에서 DB 구간을 분리한 뒤 쿼리가 길다, 락 대기, 커넥션 고갈, N+1 네 갈래로 판별하고, 쿼리에서 락, 락에서 커넥션 고갈로 연쇄되는 모습과 재발 방지책을 보여주는 그림">
    <defs>
      <marker id="sad-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
      <marker id="sad-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
    </defs>
    <g data-id="sym">
      <rect class="box" x="8" y="6" width="304" height="54" rx="7" />
      <text x="160" y="24" style="font-weight:700">API가 느려요 (p99↑ · 타임아웃)</text>
      <text class="sub" x="160" y="45">APM·로그로 DB 구간인지 먼저 분리</text>
    </g>
    <g data-id="trunk">
      <path class="line" d={`M14 60 V${END}`} />
      {boxes.map((b) => <path class="line" d={`M14 ${b.y + 36} H${BX - 1}`} marker-end="url(#sad-arr)" />)}
    </g>
    {boxes.map((b) => (
      <g data-id={'b' + b.n}>
        <rect class="box" x={BX} y={b.y} width={BW} height={BH} rx="7" />
        <circle class="badge" cx={BX + 18} cy={b.y + 18} r="11" />
        <text class="on-badge" x={BX + 18} y={b.y + 19}>{b.n}</text>
        <text x={BX + BW / 2 + 10} y={b.y + 18} style="font-weight:700">{b.t}</text>
        <text class="sub" x={BX + BW / 2} y={b.y + 40}>{b.s1}</text>
        <text class="sub" x={BX + BW / 2} y={b.y + 58}>{b.s2}</text>
      </g>
    ))}
    {[0, 1].map((i) => (
      <path data-id={'ch' + (i + 1)} class="hide" d={`M${BX + BW + 6} ${boxes[i].y + 30} C316 ${boxes[i].y + 30} 316 ${boxes[i + 1].y + 42} ${BX + BW + 9} ${boxes[i + 1].y + 42}`}
        style="fill:none;stroke:var(--sl-color-accent);stroke-width:2.4" marker-end="url(#sad-acc)" />
    ))}
    <g data-id="chain" class="hide">
      <rect class="chip" x="8" y="398" width="304" height="74" rx="7" />
      <text x="160" y="416" style="font-weight:700">연쇄: 1 → 2 → 3</text>
      <text class="sub" x="160" y="438">느린 쿼리가 락을 오래 쥠 → 대기 요청이</text>
      <text class="sub" x="160" y="457">커넥션을 쥔 채 멈춤 → 풀 고갈</text>
    </g>
    <g data-id="wrap" class="hide">
      <rect class="chip" x="8" y="398" width="304" height="74" rx="7" />
      <text x="160" y="416" style="font-weight:700">공통 마무리 (재발 방지)</text>
      <text class="sub" x="160" y="438">슬로우 로그 기준 낮추기 · 대시보드 알림</text>
      <text class="sub" x="160" y="457">배포 전 EXPLAIN 리뷰</text>
    </g>
    <rect data-id="hl0" class="hl" x="4" y="2" width="312" height="62" rx="9" />
    {boxes.map((b) => <rect data-id={'hl' + b.n} class="hl" x={BX - 3} y={b.y - 3} width={BW + 6} height={BH + 6} rx="9" />)}
    <rect data-id="hl5" class="hl" x="4" y="394" width="312" height="82" rx="9" />
  </svg>
</Stepper>
