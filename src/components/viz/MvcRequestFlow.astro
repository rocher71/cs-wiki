---
// 스프링 MVC 요청 하나의 흐름: 톰캣 워커 스레드 → 필터 → DispatcherServlet → HandlerMapping → preHandle → HandlerAdapter → 컨트롤러~리포 → 반환 처리 → postHandle → afterCompletion → 필터 역순 응답
import Stepper from '../Stepper.astro';
const s1 = ['client', 'a0', 'outer', 'thread'];
const s2 = [...s1, 'filter'];
const s3 = [...s2, 'a1', 'inner', 'ds'];
const s4 = [...s3, 'a2', 'hm'];
const s5 = [...s4, 'a3', 'pre'];
const s6 = [...s5, 'a4', 'ha'];
const s7 = [...s6, 'a5', 'chain'];
const s8 = [...s7, 'a6', 'rest', 'ctrl'];
const s9 = [...s8, 'a7', 'post'];
const s10 = [...s9, 'a8', 'after'];
const s11 = [...s10, 'a9', 'back'];
const steps = [
  { caption: '클라이언트가 HTTP 요청을 보내요. 서블릿 컨테이너(톰캣)가 스레드 풀에서 워커 스레드 하나를 꺼내 이 요청을 끝까지 맡겨요.', show: [...s1, 'hl-client'] },
  { caption: '먼저 필터 체인을 지나요(인코딩, Spring Security, 로깅 등). 필터가 doFilter()로 다음을 부르지 않으면 요청은 여기서 끝나요.', show: [...s2, 'hl-filter'] },
  { caption: '필터를 통과하면 DispatcherServlet에 도착해요. 여기서부터가 스프링 MVC 영역이에요.', show: [...s3, 'hl-ds'] },
  { caption: 'HandlerMapping이 URL과 HTTP 메서드로 처리할 컨트롤러 메서드를 찾고, 이 요청에 걸릴 인터셉터 목록도 함께 돌려줘요.', show: [...s4, 'hl-hm'] },
  { caption: '인터셉터의 preHandle()이 불려요. false를 반환하면 컨트롤러까지 가지 않고 여기서 멈춰요.', show: [...s5, 'hl-pre'] },
  { caption: 'HandlerAdapter가 메서드 인자를 준비해요. @RequestBody면 HttpMessageConverter가 Content-Type을 보고 JSON을 객체로 바꾸고, @Valid 검증에 실패하면 400이에요.', show: [...s6, 'hl-ha'] },
  { caption: '이제 컨트롤러가 실행되고, AOP 프록시(@Transactional 등)를 거쳐 서비스와 리포지토리까지 호출돼요.', show: [...s7, 'hl-chain'] },
  { caption: '반환값 처리: @RestController면 HttpMessageConverter가 Accept를 보고 객체를 JSON으로 바꿔 어댑터 안에서 바로 응답을 써요(커밋). @Controller면 ViewResolver가 뷰를 찾아 화면을 그려요.', show: [...s8, 'hl-ret'] },
  { caption: 'postHandle()이 불려요. 단, @RestController는 응답이 이미 커밋돼서 여기서 응답 내용을 바꿀 수 없어요.', show: [...s9, 'hl-post'] },
  { caption: 'afterCompletion()은 요청이 끝나면 예외가 났든 아니든 항상 불려요. 정리 작업(로그, ThreadLocal 비우기)은 여기서 해요.', show: [...s10, 'hl-after'] },
  { caption: '응답은 필터를 들어온 반대 순서로 지나 클라이언트에 가요. 일을 마친 워커 스레드는 풀로 돌아가 다음 요청을 기다려요.', show: [...s11, 'hl-back'] },
];
---
<Stepper title="요청 하나가 스프링 MVC를 지나가는 길" steps={steps}>
  <svg class="viz" viewBox="0 0 320 600" role="img" aria-label="클라이언트 요청을 톰캣 워커 스레드가 맡아 필터 체인을 지나 DispatcherServlet에 도착하고, HandlerMapping, 인터셉터 preHandle, HandlerAdapter 인자 준비, 컨트롤러부터 리포지토리까지 실행, 반환값을 JSON 또는 화면으로 처리, postHandle, afterCompletion을 거쳐 필터를 거꾸로 지나 응답하는 그림">
    <defs>
      <marker id="mvc-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    <g data-id="client"><rect class="box" x="8" y="4" width="304" height="32" rx="7" /><text x="160" y="20">클라이언트 · HTTP 요청</text></g>
    <line data-id="a0" class="line" x1="160" y1="36" x2="160" y2="48" marker-end="url(#mvc-arr)" />

    <g data-id="outer">
      <rect class="frame" x="8" y="50" width="304" height="544" rx="10" />
      <text class="sub l" x="16" y="65">서블릿 컨테이너(톰캣)</text>
    </g>
    <g data-id="thread"><rect class="chip" x="192" y="54" width="112" height="22" rx="6" /><text x="248" y="65" style="font-size:14px">워커 스레드 1개</text></g>

    <g data-id="filter">
      <rect class="box" x="18" y="80" width="284" height="44" rx="7" />
      <text x="160" y="95">필터 체인</text>
      <text class="sub" x="160" y="114">인코딩 · Security · 로깅</text>
    </g>
    <line data-id="a1" class="line" x1="160" y1="124" x2="160" y2="134" marker-end="url(#mvc-arr)" />

    <g data-id="inner">
      <rect class="frame" x="14" y="136" width="292" height="394" rx="9" />
      <text class="sub l" x="22" y="150">스프링 MVC</text>
    </g>
    <g data-id="ds"><rect class="chip" x="22" y="160" width="276" height="32" rx="7" /><text class="mono" x="160" y="176">DispatcherServlet</text></g>
    <line data-id="a2" class="line" x1="160" y1="192" x2="160" y2="200" marker-end="url(#mvc-arr)" />
    <g data-id="hm">
      <rect class="box" x="22" y="202" width="276" height="44" rx="7" />
      <text class="mono" x="160" y="217">HandlerMapping</text>
      <text class="sub" x="160" y="236">URL → 컨트롤러 메서드 + 인터셉터</text>
    </g>
    <line data-id="a3" class="line" x1="160" y1="246" x2="160" y2="254" marker-end="url(#mvc-arr)" />
    <g data-id="pre"><rect class="box" x="22" y="256" width="276" height="32" rx="7" /><text x="160" y="272"><tspan class="mono">preHandle</tspan> (false면 중단)</text></g>
    <line data-id="a4" class="line" x1="160" y1="288" x2="160" y2="296" marker-end="url(#mvc-arr)" />
    <g data-id="ha">
      <rect class="box" x="22" y="298" width="276" height="44" rx="7" />
      <text x="160" y="313"><tspan class="mono">HandlerAdapter</tspan> · 인자 준비</text>
      <text class="sub" x="160" y="332">JSON → 객체(컨버터) · @Valid</text>
    </g>
    <line data-id="a5" class="line" x1="160" y1="342" x2="160" y2="350" marker-end="url(#mvc-arr)" />
    <g data-id="chain"><rect class="box" x="22" y="352" width="276" height="32" rx="7" /><text x="160" y="368" style="font-size:14px">컨트롤러 → 프록시 → 서비스 → 리포</text></g>
    <line data-id="a6" class="line" x1="160" y1="384" x2="160" y2="392" marker-end="url(#mvc-arr)" />
    <g data-id="rest">
      <rect class="chip" x="22" y="394" width="134" height="44" rx="7" />
      <text class="mono" x="89" y="409">@RestController</text>
      <text class="sub" x="89" y="428">JSON 작성·커밋</text>
    </g>
    <g data-id="ctrl">
      <rect class="box" x="164" y="394" width="134" height="44" rx="7" />
      <text class="mono" x="231" y="409">@Controller</text>
      <text class="sub" x="231" y="428">ViewResolver</text>
    </g>
    <line data-id="a7" class="line" x1="160" y1="438" x2="160" y2="446" marker-end="url(#mvc-arr)" />
    <g data-id="post"><rect class="box" x="22" y="448" width="276" height="32" rx="7" /><text x="160" y="464"><tspan class="mono">postHandle</tspan> (이미 커밋됨)</text></g>
    <line data-id="a8" class="line" x1="160" y1="480" x2="160" y2="488" marker-end="url(#mvc-arr)" />
    <g data-id="after"><rect class="box" x="22" y="490" width="276" height="32" rx="7" /><text x="160" y="506"><tspan class="mono">afterCompletion</tspan> (항상)</text></g>
    <line data-id="a9" class="line" x1="160" y1="530" x2="160" y2="540" marker-end="url(#mvc-arr)" />
    <g data-id="back">
      <rect class="box" x="18" y="542" width="284" height="44" rx="7" />
      <text x="160" y="557">필터를 거꾸로 지나 응답</text>
      <text class="sub" x="160" y="576">스레드는 풀로 복귀</text>
    </g>

    <rect data-id="hl-client" class="hl" x="4" y="0" width="312" height="80" rx="9" />
    <rect data-id="hl-filter" class="hl" x="14" y="76" width="292" height="52" rx="9" />
    <rect data-id="hl-ds" class="hl" x="18" y="156" width="284" height="40" rx="9" />
    <rect data-id="hl-hm" class="hl" x="18" y="198" width="284" height="52" rx="9" />
    <rect data-id="hl-pre" class="hl" x="18" y="252" width="284" height="40" rx="9" />
    <rect data-id="hl-ha" class="hl" x="18" y="294" width="284" height="52" rx="9" />
    <rect data-id="hl-chain" class="hl" x="18" y="348" width="284" height="40" rx="9" />
    <rect data-id="hl-ret" class="hl" x="18" y="390" width="284" height="52" rx="9" />
    <rect data-id="hl-post" class="hl" x="18" y="444" width="284" height="40" rx="9" />
    <rect data-id="hl-after" class="hl" x="18" y="486" width="284" height="40" rx="9" />
    <rect data-id="hl-back" class="hl" x="14" y="538" width="292" height="52" rx="9" />
  </svg>
</Stepper>
