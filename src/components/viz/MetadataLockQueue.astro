---
// 메타데이터 락 줄서기: 긴 트랜잭션 A 뒤에 ALTER B가 서면, 평범한 쿼리 C·D까지 B 뒤에서 막힌다.
// 세션 한 줄 = 한 칸. 칸 색(+상태 글자)이 락 보유/대기/완료를 뜻한다. 수치는 노트북 MySQL로 한 번 잰 실험 예시.
import Stepper from '../Stepper.astro';
const RY = [56, 128, 200, 272], RH = 64;      // 세션 칸 y, 높이
// 상태 변형: [id, 칸 index, class, 2번째 줄, 3번째 줄]
const WAIT = 'Waiting for table metadata lock';
const states: [string, number, string, string, string][] = [
  ['a-hold', 0, 'ok', '공유 락 쥔 채 트랜잭션 열림', '(아직 COMMIT 안 함)'],
  ['a-done', 0, 'box', 'COMMIT → 공유 락 반납', ''],
  ['b-wait', 1, 'err', '배타 락이 필요해 A 뒤에서 대기', WAIT],
  ['b-get', 1, 'ok', '배타 락 획득 → 바로 실행', ''],
  ['b-done', 1, 'chip', '완료', '실험 예시: 평소 1ms → 약 11초'],
  ['b-out', 1, 'err', '2초 뒤 포기 (ERROR 1205)', 'ALTER만 실패, 나중에 재시도'],
  ['c-wait', 2, 'err', 'B 뒤에서 대기', WAIT],
  ['c-done', 2, 'chip', '완료', '실험 예시: 단건 조회가 약 10초'],
  ['c-run', 2, 'chip', 'B가 빠지자 바로 실행', ''],
  ['d-wait', 3, 'err', 'B 뒤에서 대기', WAIT],
  ['d-done', 3, 'chip', '완료', '실험 예시: 단건 INSERT가 약 10초'],
  ['d-run', 3, 'chip', 'B가 빠지자 바로 실행', ''],
];
// [id, 칸 index, 이름, SQL, class(hide 여부)]
const sqls: [string, number, string, string, string][] = [
  ['sa', 0, 'A', 'BEGIN; SELECT … FROM t', ''],
  ['sb', 1, 'B', 'ALTER TABLE t … INSTANT', 'hide'],
  ['sb2', 1, 'B', 'lock_wait_timeout=2; ALTER', 'hide'],
  ['sc', 2, 'C', 'SELECT … WHERE id=1', ''],
  ['sd', 3, 'D', 'INSERT INTO t …', ''],
];
const notes = ['A가 락을 쥐고 안 놓음', 'ALTER가 A 뒤에 줄 섬', '평범한 쿼리까지 줄 섬', 'A 커밋 → 줄이 풀림', '실험 예시: 1ms짜리가 약 11초', '대책: 짧게 기다리고 포기'];
const steps = [
  { caption: '세션 A가 BEGIN 후 테이블 t를 SELECT하고 커밋하지 않은 채 두었어요. 트랜잭션이 끝날 때까지 t의 공유 메타데이터 락을 쥐고 있어요.', show: ['tbl', 'sa', 'a-hold', 'n1'] },
  { caption: '세션 B가 ALTER TABLE을 보내요. ALGORITHM=INSTANT여도 시작할 때 잠깐 배타 락이 필요해서, A가 끝나길 기다려요.', show: ['tbl', 'sa', 'a-hold', 'sb', 'b-wait', 'n2'] },
  { caption: '이제 평범한 SELECT(C), INSERT(D)도 들어와요. 공유 락만 있으면 되는데도, 먼저 줄 선 B의 배타 락 요청 뒤에서 같이 기다려요. 줄이 계속 길어져요.', show: ['tbl', 'sa', 'a-hold', 'sb', 'b-wait', 'sc', 'sd', 'c-wait', 'd-wait', 'n3'] },
  { caption: 'A가 COMMIT하면서 공유 락을 놓아요. 맨 앞에 선 B가 배타 락을 얻어요.', show: ['tbl', 'sa', 'a-done', 'sb', 'b-get', 'sc', 'sd', 'c-wait', 'd-wait', 'n4'] },
  { caption: 'B는 순식간에 끝나고 C·D도 곧바로 실행돼요. 실험 예시(노트북 MySQL, 한 번 측정)에서 평소 1ms인 ALTER가 약 11초, 단건 SELECT·INSERT가 약 10초 걸렸어요. 전부 기다린 시간이에요.', show: ['tbl', 'sa', 'a-done', 'sb', 'b-done', 'sc', 'sd', 'c-done', 'd-done', 'n5'] },
  { caption: '대책: B가 SET SESSION lock_wait_timeout=2를 걸고 ALTER해요. A가 그대로여도 B만 2초 뒤 ERROR 1205로 포기하고 빠지니, C·D는 바로 실행돼요. ALTER는 나중에 다시 시도해요.', show: ['tbl', 'sa', 'a-hold', 'sb2', 'b-out', 'sc', 'sd', 'c-run', 'd-run', 'n6'] },
];
---
<Stepper title="메타데이터 락 줄서기: ALTER 하나가 테이블 전체를 막는다" steps={steps}>
  <svg class="viz mdl" viewBox="0 0 320 380" role="img" aria-label="긴 트랜잭션 A가 공유 메타데이터 락을 쥐고 있을 때 ALTER B가 배타 락을 기다리고, 그 뒤에 온 SELECT C와 INSERT D까지 줄을 서는 모습. A가 커밋하면 모두 풀리고, lock_wait_timeout을 짧게 주면 B만 포기하고 C와 D는 바로 실행된다">
    <g data-id="tbl">
      <rect class="box" x="10" y="8" width="300" height="38" rx="8" />
      <text x="160" y="27" style="font-weight:700">테이블 t · 락 요청은 온 순서대로 줄</text>
    </g>
    <!-- 상태별 칸(같은 자리 번갈아) -->
    {states.map(([id, r, cls, l2, l3]) => (
      <g data-id={id} class="hide">
        <rect class={cls} x="10" y={RY[r]} width="300" height={RH} rx="6" />
        <text class={cls === 'err' ? 'l err-t' : cls === 'ok' ? 'l ok-t' : 'l'} x="58" y={RY[r] + 36} style="font-size:14px">{l2}</text>
        {l3 && <text class="l sub" x="58" y={RY[r] + 54}>{l3}</text>}
      </g>
    ))}
    <!-- 세션 이름 + SQL -->
    {sqls.map(([id, r, n, q, cls]) => (
      <g data-id={id} class={cls}>
        <rect class="badge" x="18" y={RY[r] + 6} width="30" height="30" rx="15" />
        <text class="on-badge" x="33" y={RY[r] + 22}>{n}</text>
        <text class="l mono" x="58" y={RY[r] + 16}>{q}</text>
      </g>
    ))}
    {notes.map((t, i) => <text data-id={`n${i + 1}`} class="hi hide" x="160" y="362" style="font-size:14px">{t}</text>)}
  </svg>
</Stepper>

<style>
  .mdl .ok { fill: var(--sl-color-green-low); stroke: var(--sl-color-green); stroke-width: 1.4; }
  .mdl text.ok-t { fill: var(--sl-color-green-high); font-weight: 700; }
</style>
