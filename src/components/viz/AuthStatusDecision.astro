---
// 요청 하나가 인증 → 인가 → 소유권 검사를 거쳐 401/403/404/200 중 어디로 가는지. 위쪽 요청 문구(req*)와 강조 테두리(h*)는 같은 자리에 번갈아 나와서 class="hide".
import Stepper from '../Stepper.astro';

const QX = 6, QW = 104, AX = 162, AW = 152, QH = 50, AH = 66;
const rows = [
  { n: 1, y: 64, q: '① 인증', qs: '토큰 있고 유효?', a: '401 인증 실패', a1: 'WWW-Authenticate', mono: true, a2: '출입증 없음·가짜' },
  { n: 2, y: 150, q: '② 인가', qs: '이 행동 권한?', a: '403 권한 없음', a1: '누군지는 알아요', a2: '그 층은 출입 금지' },
  { n: 3, y: 236, q: '③ 소유권', qs: '내 자원인가?', a: '404 존재 숨김', a1: '남의 자원이면', a2: '"그런 방 없어요"' },
];
const reqs = [
  '요청: 토큰 없이 GET /orders/7',
  '요청: 만료되거나 위조된 토큰',
  '요청: 유효한 토큰 → 사용자 kim',
  'kim(일반) → DELETE /admin/users',
  'kim → GET /orders/9 (남의 주문)',
  'kim → GET /orders/7 (내 주문)',
];
const path = (n: number) => Array.from({ length: n }, (_, k) => [`v${k + 1}`, `q${k + 1}`]).flat();
const steps = [
  { caption: '토큰·세션 없이 들어온 요청이에요. 누군지 확인이 안 되니 401이고, 응답에 WWW-Authenticate 헤더로 "이 방식으로 인증하세요"를 알려줘요. 건물 비유: 출입증 없이 게이트 앞에 선 상태예요.', show: ['req1', ...path(1), 'a1', 'h1'] },
  { caption: '토큰은 있지만 만료됐거나 서명이 안 맞아요. 이것도 "누군지 모름"이라 401이에요. 건물 비유: 기한 지난 출입증, 위조한 출입증은 게이트가 안 열려요.', show: ['req2', ...path(1), 'a1', 'h1'] },
  { caption: '토큰이 유효해서 사용자가 kim이라고 확인됐어요. 인증은 통과했고, 이제 "이 행동을 해도 되나"(인가)를 따져요. 건물 비유: 게이트는 통과했어요.', show: ['req3', ...path(2), 'hq2'] },
  { caption: '일반 사용자 kim이 관리자 API를 불렀어요. 누군지는 알지만 권한이 없으니 403이에요. 같은 계정으로 다시 로그인해도 결과는 같아요. 건물 비유: 진짜 출입증으로 임원실 층 문을 찍으니 빨간불이에요.', show: ['req4', ...path(2), 'a2', 'h2'] },
  { caption: 'kim이 남의 주문 번호를 넣었어요. 이 확인을 빼먹으면 IDOR예요. 403으로 막아도 되지만, 그 주문이 있다는 사실까지 숨기려고 404를 주기도 해요. 건물 비유: 경비원이 "그런 방은 없는데요"라고 답해요.', show: ['req5', ...path(3), 'a3', 'h3'] },
  { caption: '인증·인가·소유권을 모두 통과했으니 200으로 내 주문을 돌려줘요. 건물 비유: 진짜 출입증 + 들어갈 수 있는 층 + 내 사무실이라 문이 열려요.', show: ['req6', ...path(3), 'v4', 'a4', 'h4'] },
];
---
<Stepper title="401 · 403 · 404 · 200, 어디서 갈리나" steps={steps}>
  <svg class="viz" viewBox="0 0 320 378" role="img" aria-label="요청이 오면 먼저 인증을 본다. 토큰이 없거나 유효하지 않으면 401과 WWW-Authenticate 헤더. 인증되면 인가를 본다. 이 행동 권한이 없으면 403. 권한이 있어도 남의 자원이면 존재를 숨기려 404를 주기도 한다. 모두 통과하면 200.">
    <defs>
      <marker id="asd-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    <rect class="box" x="6" y="8" width="308" height="36" rx="7" />
    {reqs.map((r, i) => <text data-id={'req' + (i + 1)} class="hide" x="160" y="26" style="font-weight:700">{r}</text>)}

    {rows.map((r) => <>
      <g data-id={'v' + r.n}>
        <line class="line" x1={QX + QW / 2} y1={r.y - (r.n === 1 ? 20 : 34)} x2={QX + QW / 2} y2={r.y + 6} marker-end="url(#asd-arr)" />
        {r.n > 1 && <text class="l sub" x={QX + QW / 2 + 8} y={r.y - 12}>예</text>}
      </g>
      <g data-id={'q' + r.n}>
        <rect class="box" x={QX} y={r.y + 8} width={QW} height={QH} rx="7" />
        <text x={QX + QW / 2} y={r.y + 25} style="font-weight:700">{r.q}</text>
        <text class="sub" x={QX + QW / 2} y={r.y + 44}>{r.qs}</text>
      </g>
      <rect data-id={'hq' + r.n} class="hl hide" x={QX - 3} y={r.y + 5} width={QW + 6} height={QH + 6} rx="9" />
      <g data-id={'a' + r.n}>
        <line class="line" x1={QX + QW} y1={r.y + 44} x2={AX - 2} y2={r.y + 44} marker-end="url(#asd-arr)" />
        <text class="sub" x={(QX + QW + AX) / 2} y={r.y + 28}>{r.n === 3 ? '남의 것' : '아니오'}</text>
        <rect class="chip" x={AX} y={r.y} width={AW} height={AH} rx="7" />
        <text x={AX + AW / 2} y={r.y + 16} style="font-weight:700">{r.a}</text>
        <text class={r.mono ? 'sub mono' : 'sub'} x={AX + AW / 2} y={r.y + 35}>{r.a1}</text>
        <text class="sub" x={AX + AW / 2} y={r.y + 53}>{r.a2}</text>
      </g>
      <rect data-id={'h' + r.n} class="hl hide" x={AX - 3} y={r.y - 3} width={AW + 6} height={AH + 6} rx="9" />
    </>)}

    <g data-id="v4">
      <line class="line" x1={QX + QW / 2} y1="294" x2={QX + QW / 2} y2="318" marker-end="url(#asd-arr)" />
      <text class="l sub" x={QX + QW / 2 + 8} y="306">예</text>
    </g>
    <g data-id="a4">
      <rect class="chip" x="6" y="320" width="308" height="50" rx="7" />
      <text x="160" y="337" style="font-weight:700">200 OK · 요청 성공</text>
      <text class="sub" x="160" y="356">출입증 + 층 권한 + 내 방 → 문 열림</text>
    </g>
    <rect data-id="h4" class="hl hide" x="3" y="317" width="314" height="56" rx="9" />
  </svg>
</Stepper>
