---
import Stepper from '../Stepper.astro';
// 결제 요청 하나의 트레이스 폭포. 시간 값은 설명용 예시(측정값 아님).
const X0 = 16, W = 288, T = 1200; // 0~1200ms를 288 단위에
const x = (ms: number) => X0 + (ms / T) * W;
const rows = [
  { id: 'r1', name: '게이트웨이 (루트 span)', a: 0, b: 1200 },
  { id: 'r2', name: '주문 서비스', a: 40, b: 1170 },
  { id: 'r3', name: '결제 서비스', a: 100, b: 1140 },
  { id: 'r4', name: 'DB 쿼리 (결제 안)', a: 140, b: 1040, long: true },
].map((r, i) => ({ ...r, y: 72 + i * 52 }));
const steps = [
  { caption: '사용자가 결제를 요청하면 게이트웨이가 traceId를 새로 만들고 첫 구간(루트 span)을 시작해요.', show: ['tid', 'axis', 'r1'] },
  { caption: '게이트웨이가 traceparent 헤더에 traceId와 자기 spanId를 실어 주문 서비스를 불러요. 주문 서비스는 그걸 부모로 삼아 자식 span을 만들어요.', show: ['tid', 'axis', 'r1', 'r2', 'hdr'] },
  { caption: '주문 서비스도 같은 방식으로 결제 서비스를 불러요. 결제 서비스에 또 자식 span이 생겨요.', show: ['tid', 'axis', 'r1', 'r2', 'hdr', 'r3'] },
  { caption: '결제 서비스 안의 DB 쿼리 span이 길게 늘어나요. 위쪽 span들도 이걸 기다리느라 같이 길어져요.', show: ['tid', 'axis', 'r1', 'r2', 'hdr', 'r3', 'r4'] },
  { caption: '같은 traceId로 묶인 막대를 한눈에 보면, 1200ms 중 900ms를 DB 쿼리가 쓴 게 보여요. 여기부터 고치면 돼요.', show: ['tid', 'axis', 'r1', 'r2', 'hdr', 'r3', 'r4', 'hl', 'note'] },
];
---
<Stepper title="트레이스 폭포: 결제 요청 하나가 지나간 길" steps={steps}>
  <svg class="viz" viewBox="0 0 320 386" role="img" aria-label="게이트웨이, 주문, 결제, DB 쿼리 네 span이 같은 traceId로 묶인 폭포 그림. 예시 시간으로 전체 1200ms 중 DB 쿼리가 900ms.">
    <g data-id="tid">
      <text class="l" x="16" y="16">traceId</text>
      <text class="l mono hi" x="78" y="16">4bf92f35…e4736</text>
      <text class="l sub" x="16" y="36">모든 span이 이 번호를 같이 가져요</text>
    </g>
    <g data-id="axis">
      <line class="line" x1={x(0)} y1="62" x2={x(1200)} y2="62" />
      {[0, 600, 1200].map((ms) => (
        <text class="sub" x={x(ms)} y="52" style={`text-anchor:${ms === 0 ? 'start' : ms === 1200 ? 'end' : 'middle'}`}>{`${ms}ms`}</text>
      ))}
    </g>
    {rows.map((r) => (
      <g data-id={r.id}>
        <text class="l" x="16" y={r.y + 10}>{r.name}</text>
        <text class="sub" x="304" y={r.y + 10} style="text-anchor:end">{`${r.b - r.a}ms`}</text>
        <rect class={r.long ? 'badge' : 'chip'} x={x(r.a)} y={r.y + 22} width={x(r.b) - x(r.a)} height="20" rx="4" />
      </g>
    ))}
    <rect data-id="hl" class="hl" x="8" y={rows[3].y - 4} width="304" height="52" rx="6" />
    <text data-id="note" class="l hi" x="16" y="296">가장 긴 span = DB 쿼리 (900ms)</text>
    <g data-id="hdr">
      <rect class="box" x="8" y="312" width="304" height="68" rx="6" />
      <text class="l" x="16" y="328">다음 서비스로 보내는 헤더</text>
      <text class="l mono" x="16" y="348">traceparent: 00-4bf9…-00f0…-01</text>
      <text class="l sub" x="16" y="368">버전 - traceId - 부모 spanId - 플래그</text>
    </g>
  </svg>
</Stepper>
<p class="tw-note">시간은 이해를 돕기 위한 예시 값이에요. traceparent 값은 W3C 문서의 예시를 줄여 쓴 거예요.</p>

<style>
  .tw-note { font-size: .85rem; color: var(--sl-color-gray-3); margin-top: -.6rem !important; }
</style>
