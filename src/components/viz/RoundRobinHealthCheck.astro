---
// 라운드 로빈 분산 + 능동 헬스 체크(AWS ALB 기본값: 30초 간격, 연속 2회 실패 → 제외, 연속 5회 성공 → 복귀).
import Stepper from '../Stepper.astro';
const SX = [14, 118, 222], SW = 84, SY = 104, SH = 58;
// 단계별 [상태 문구, 상태 종류, 받은 요청]  종류: ok | err | hi
const st: [string, string, string][][] = [
  [['정상', 'ok', '1, 4'], ['정상', 'ok', '2'], ['정상', 'ok', '3']],
  [['200 OK', 'ok', ''], ['200 OK', 'ok', ''], ['실패 1/2', 'err', '']],
  [['200 OK', 'ok', ''], ['200 OK', 'ok', ''], ['비정상', 'err', '']],
  [['정상', 'ok', '5, 7'], ['정상', 'ok', '6, 8'], ['비정상', 'err', '없음']],
  [['정상', 'ok', '9'], ['정상', 'ok', '10'], ['성공 5/5', 'hi', '11']],
];
const notes = [
  ['라운드 로빈: 1→A, 2→B, 3→C, 4→A', '차례대로 한 대씩 돌아가며 보내요'],
  ['30초마다 GET /health, C가 응답 없음', '1번 실패로는 아직 빼지 않아요'],
  ['연속 2번 실패 → C는 비정상', 'C로 가는 길을 끊어요'],
  ['요청 5→A, 6→B, 7→A, 8→B', '건강한 A·B만 번갈아 받아요'],
  ['C 복구: 연속 5번 성공 → 다시 투입', '숫자는 AWS ALB 기본값이에요'],
];
const lb = ['', 'hc', 'hc', '', 'hc'];
const cut = [false, false, true, true, false];
const steps = [
  'LB가 요청을 A, B, C 순서로 하나씩 돌려가며 보내요. 4번째 요청은 다시 A예요. 이게 라운드 로빈이에요.',
  'LB는 손님 요청과 별개로 30초마다 각 서버에 GET /health를 보내 봐요. A·B는 200으로 답했지만 C는 응답이 없어요. 한 번은 봐줘요.',
  'C가 연속 2번 실패하자 LB가 C를 비정상(unhealthy)으로 표시하고 C로는 요청을 보내지 않아요.',
  '이후 요청은 남은 A와 B만 번갈아 받아요. 손님은 C가 죽었는지 몰라요.',
  'C가 살아나도 바로 넣지 않아요. 헬스 체크를 연속 5번 통과해야 다시 요청을 받아요. (30초·2회·5회는 AWS ALB 기본값)',
].map((caption, i) => ({
  caption,
  show: [`n${i}`, cut[i] ? 'cut' : 'aC', ...(lb[i] ? ['hc'] : []), ...(cut[i] ? ['cErr'] : []), ...(i === 4 ? ['hlC'] : []),
    ...[0, 1, 2].map((s) => `s${s}-${i}`)],
}));
---
<Stepper title="라운드 로빈과 헬스 체크" steps={steps}>
  <svg class="viz" viewBox="0 0 320 276" role="img" aria-label="로드밸런서가 서버 A, B, C에 차례로 요청을 보내다가, 헬스 체크에 연속 2번 실패한 C를 빼고 A와 B에만 보내며, C가 연속 5번 성공하면 다시 넣는다">
    <defs><marker id="rr-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" style="fill:var(--sl-color-gray-3)" /></marker></defs>
    <rect class="box" x="70" y="4" width="180" height="50" rx="8" />
    <text x="160" y="22" style="font-weight:700">로드밸런서</text>
    <text data-id="hc" class="hi hide" x="160" y="42" style="font-size:14px">30초마다 GET /health</text>

    <line class="line" x1="120" y1="54" x2="60" y2="102" marker-end="url(#rr-arr)" />
    <line class="line" x1="160" y1="54" x2="160" y2="102" marker-end="url(#rr-arr)" />
    <line data-id="aC" class="line hide" x1="200" y1="54" x2="260" y2="102" marker-end="url(#rr-arr)" />
    <g data-id="cut" class="hide">
      <line x1="200" y1="54" x2="260" y2="102" style="stroke:var(--sl-color-red);stroke-width:1.6;stroke-dasharray:4 4" />
      <text class="err-t" x="262" y="72" style="text-anchor:start;font-size:14px">✕ 끊김</text>
    </g>

    {['A', 'B', 'C'].map((s, i) => (
      <g>
        <rect class="box" x={SX[i]} y={SY} width={SW} height={SH} rx="6" />
        <text x={SX[i] + SW / 2} y={SY + 18} style="font-weight:700">서버 {s}</text>
      </g>
    ))}
    <rect data-id="cErr" class="err hide" x={SX[2]} y={SY} width={SW} height={SH} rx="6" />
    <text data-id="cErr" class="err-t hide" x={SX[2] + SW / 2} y={SY + 18}>서버 C</text>
    <rect data-id="hlC" class="hl" x={SX[2] - 3} y={SY - 3} width={SW + 6} height={SH + 6} rx="8" />

    <text class="sub l" x="4" y="186">받은 요청 번호</text>
    {st.map((row, i) => row.map(([t, k, r], s) => (
      <g data-id={`s${s}-${i}`} class="hide">
        <text class={k === 'err' ? 'err-t' : k === 'hi' ? 'hi' : 'sub'} x={SX[s] + SW / 2} y={SY + 40} style="font-size:14px">{t}</text>
        <text class="mono" x={SX[s] + SW / 2} y="210">{r || '·'}</text>
      </g>
    )))}

    {notes.map(([a, b], i) => (
      <g data-id={`n${i}`} class="hide">
        <text class="l hi" x="4" y="240" style="font-size:15px">{a}</text>
        <text class="l" x="4" y="264" style="font-size:14px">{b}</text>
      </g>
    ))}
  </svg>
</Stepper>
