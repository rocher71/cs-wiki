---
// 예제 C 최대 힙: 50·20 삽입(위로 올리기)과 루트 삭제(아래로 내리기). 트리와 배열(1번부터)을 같은 단계 묶음으로 그려
// 같은 번호 칸이 같이 바뀌는 걸 보여 준다. 단계별 스냅숏 s{i}는 같은 자리에 번갈아 나와서 class="hide".
import Stepper from '../Stepper.astro';

const raw = [
  { a: [40, 10, 30, 5], hl: [], note: '10·40·30·5를 넣은 상태', cap: '10, 40, 30, 5를 넣은 최대 힙이에요. 배열 i번 칸의 자식은 2i, 2i+1번 칸이에요. 모든 부모가 자식보다 커요.' },
  { a: [40, 10, 30, 5, 50], hl: [5, 2], note: '50 > 부모 10 → 교환', cap: '50을 넣어요. 완전 이진 트리를 유지하려고 맨 끝(5번 칸, 2번 노드 10의 오른쪽 자식)에 먼저 놓고, 부모 10과 비교해요.' },
  { a: [40, 50, 30, 5, 10], hl: [2, 1], note: '10↔50 교환. 50 > 부모 40', cap: '50이 부모 10보다 커서 자리를 바꿨어요(5번 ↔ 2번 칸). 이제 2번 칸의 50을 새 부모 40과 비교해요.' },
  { a: [50, 40, 30, 5, 10], hl: [1], note: '40↔50 교환. 루트 도착 → 멈춤', cap: '50이 40보다 커서 또 바꿔요(2번 ↔ 1번 칸). 루트까지 올라왔으니 멈춰요. 결과 50 40 30 5 10.' },
  { a: [50, 40, 30, 5, 10, 20], hl: [6, 3], note: '20 < 부모 30 → 멈춤', cap: '20을 6번 칸(3번 노드 30의 왼쪽 자식)에 넣어요. 부모 30보다 작아서 바로 멈춰요. 결과 50 40 30 5 10 20.' },
  { a: [20, 40, 30, 5, 10], hl: [1], out: 50, note: '50 꺼냄, 마지막 20을 루트로', cap: '삭제는 항상 루트(최댓값 50)를 꺼내요. 빈 루트 자리에 마지막 칸의 20을 옮겨 오고, 6번 칸은 비워요.' },
  { a: [40, 20, 30, 5, 10], hl: [1, 2], out: 50, note: '자식 40·30 중 큰 40과 교환', cap: '20을 자식 40·30과 비교해요. 둘 중 더 큰 40과 바꿔야 새 부모 40이 30보다도 커요(1번 ↔ 2번 칸).' },
  { a: [40, 20, 30, 5, 10], hl: [2, 4, 5], out: 50, note: '20 > 자식 5·10 → 멈춤', cap: '2번 칸의 20이 자식 5·10보다 크니 멈춰요. 삭제 결과 40 20 30 5 10이에요.' },
];
const steps = raw.map((_, i) => ({ caption: raw[i].cap, show: ['base', `s${i}`] }));

// 배열 번호 i(1~6)의 트리 좌표
const P: Record<number, [number, number]> = { 1: [160, 50], 2: [84, 112], 3: [244, 112], 4: [44, 174], 5: [124, 174], 6: [204, 174] };
const CX = (i: number) => 28 + (i - 1) * 44, CY = 246;
---
<Stepper title="최대 힙: 삽입은 위로, 삭제는 아래로" steps={steps}>
  <svg class="viz" viewBox="0 0 320 324" role="img" aria-label="최대 힙 40 10 30 5에 50을 넣으면 5번 칸에서 10, 40과 차례로 교환되어 루트로 올라가 50 40 30 5 10이 된다. 20은 6번 칸에서 부모 30보다 작아 멈춘다. 루트 50을 삭제하면 마지막 20이 루트로 와서 더 큰 자식 40과 교환되고, 자식 5와 10보다 커서 멈춰 40 20 30 5 10이 된다.">
    <g data-id="base">
      <text class="l sub" x="16" y="214">배열 (1번 칸부터)</text>
      {[1, 2, 3, 4, 5, 6].map((i) => <><text class="sub" x={CX(i) + 21} y="234">{i}</text><rect class="frame" x={CX(i)} y={CY} width="42" height="34" rx="4" /></>)}
    </g>
    {raw.map((s, n) => <g data-id={`s${n}`} class="hide">
      {s.a.map((_, k) => k + 1).filter((i) => i > 1).map((i) => <line class="line" x1={P[Math.floor(i / 2)][0]} y1={P[Math.floor(i / 2)][1]} x2={P[i][0]} y2={P[i][1]} />)}
      {s.a.map((v, k) => { const i = k + 1, on = s.hl.includes(i), [x, y] = P[i]; return <>
        <circle class={on ? 'chip' : 'box'} cx={x} cy={y} r="19" />{on && <circle class="hl" cx={x} cy={y} r="24" />}
        <text class={on ? 'hi' : ''} x={x} y={y}>{v}</text>
        <text class="sub" x={x + (i % 2 ? 28 : -28)} y={y - 16}>{i}</text>
        <rect class={on ? 'chip' : 'box'} x={CX(i)} y={CY} width="42" height="34" rx="4" />{on && <rect class="hl" x={CX(i) - 3} y={CY - 3} width="48" height="40" rx="6" />}
        <text class={on ? 'hi' : ''} x={CX(i) + 21} y={CY + 17}>{v}</text>
      </>; })}
      {s.out && <><rect class="err" x="12" y="30" width="78" height="34" rx="6" /><text class="err-t" x="51" y="47">꺼냄 {s.out}</text></>}
      <text x="160" y="306" style="font-weight:700">{s.note}</text>
    </g>)}
  </svg>
</Stepper>
