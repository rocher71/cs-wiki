---
// 쓰기 한 건이 클라이언트·리더·팔로워 사이를 오가는 순서. 동기/비동기/반동기에서 "OK"가 언제 나가는지, 팔로워·리더가 죽으면 어떻게 되는지.
// 같은 자리에 번갈아 나오는 화살표·문구는 class="hide"(단계에 없으면 완전히 숨김).
import Stepper from '../Stepper.astro';
const base = ['req', 'disk'];
const sync = [...base, 'mS', 'sSend', 'sWait', 'sAck', 'sOk'];
const async = [...base, 'mA', 'aOk', 'aSend'];
const steps = [
  { caption: '클라이언트가 리더에 쓰기(INSERT)를 보내요. 쓰기는 리더 한 대만 받아요.', show: ['req'] },
  { caption: '리더가 먼저 자기 디스크에 기록해요. 여기까지는 동기든 비동기든 같아요.', show: base },
  { caption: '동기: 리더가 변경을 팔로워에 보내고 "받았음" 답장을 기다려요. 답장이 온 뒤에야 클라이언트에 OK를 줘요. 그래서 OK를 받은 쓰기는 두 곳에 있어요.', show: sync },
  { caption: '비동기: 리더가 클라이언트에 바로 OK를 주고, 팔로워에는 조금 뒤에 보내요. 응답은 빠르지만 그 사이엔 리더에만 있어요.', show: async },
  { caption: '동기에서 팔로워가 죽으면: 답장이 안 오니 리더가 OK를 못 줘요. 팔로워 한 대 때문에 쓰기 전체가 멈춰요.', show: [...base, 'mS', 'sSend', 'sWait', 'fDead', 'sStuck', 'nS'] },
  { caption: '비동기에서 팔로워가 죽으면: 리더는 답장을 안 기다리니 계속 OK를 줘요. 팔로워는 살아나면 밀린 변경을 따라잡아요.', show: [...base, 'mA', 'aOk', 'fDead', 'nA'] },
  { caption: '비동기에서 리더가 죽으면: OK까지 줬는데 팔로워에 보내기 전에 죽은 쓰기는 팔로워에 없어요. 팔로워가 새 리더가 되면 이 쓰기는 사라져요(유실).', show: [...base, 'mA', 'aOk', 'lDead', 'lost', 'nL'] },
  { caption: '반동기(MySQL semi-sync): 레플리카 1대가 변경을 relay log(받은 변경을 적어 두는 파일)에 디스크로 썼다는 답장만 기다려요. 적용까지는 안 기다려요. 답장이 타임아웃 안에 안 오면 비동기로 내려가요.', show: [...base, 'mSemi', 'sSend', 'sWait', 'relay', 'sAck', 'sOk', 'nSemi'] },
];
// 레인 x: 클라이언트 50, 리더 165, 팔로워 275
---
<Stepper title="동기 vs 비동기: OK는 언제 나가나" steps={steps}>
  <svg class="viz" viewBox="0 0 320 384" role="img" aria-label="클라이언트, 리더, 팔로워 세 줄의 시간 흐름 그림. 동기는 팔로워 답장을 받은 뒤 OK, 비동기는 바로 OK 후 나중에 전송, 반동기는 relay log 기록 답장만 기다린다. 팔로워가 죽으면 동기는 쓰기가 멈추고, 리더가 죽으면 비동기는 마지막 쓰기를 잃는다.">
    <defs>
      <marker id="sva-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
      <marker id="sva-arr-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
    </defs>

    <!-- 모드 이름표 (같은 자리, 번갈아) -->
    <g data-id="mS" class="hide"><rect class="chip" x="100" y="4" width="120" height="28" rx="14" /><text x="160" y="19">동기 복제</text></g>
    <g data-id="mA" class="hide"><rect class="chip" x="100" y="4" width="120" height="28" rx="14" /><text x="160" y="19">비동기 복제</text></g>
    <g data-id="mSemi" class="hide"><rect class="chip" x="90" y="4" width="140" height="28" rx="14" /><text x="160" y="19">반동기 (MySQL)</text></g>

    <!-- 세 레인 -->
    <rect class="box" x="4" y="42" width="92" height="34" rx="6" /><text x="50" y="60">클라이언트</text>
    <rect class="box" x="119" y="42" width="92" height="34" rx="6" /><text x="165" y="60">리더</text>
    <rect class="box" x="229" y="42" width="88" height="34" rx="6" /><text x="273" y="60">팔로워</text>
    <line class="life" x1="50" y1="76" x2="50" y2="306" />
    <line class="life" x1="165" y1="76" x2="165" y2="306" />
    <line class="life" x1="273" y1="76" x2="273" y2="306" />

    <!-- 1. 쓰기 요청 -->
    <g data-id="req">
      <text x="107" y="96">INSERT</text>
      <line class="line" x1="50" y1="110" x2="161" y2="110" marker-end="url(#sva-arr)" />
    </g>
    <!-- 2. 리더 디스크 -->
    <g data-id="disk"><rect class="box" x="125" y="122" width="80" height="28" rx="6" /><text x="165" y="137">디스크 기록</text></g>

    <!-- 동기 / 반동기 -->
    <g data-id="sSend" class="hide">
      <text x="219" y="171">변경 전송</text>
      <line class="line" x1="165" y1="185" x2="269" y2="185" marker-end="url(#sva-arr)" />
    </g>
    <g data-id="sWait" class="hide">
      <rect class="wait" x="160" y="185" width="10" height="50" rx="3" />
      <text class="sub" x="122" y="210">기다림</text>
    </g>
    <g data-id="sAck" class="hide">
      <text x="204" y="223">받았음</text>
      <line class="line acc" x1="273" y1="235" x2="169" y2="235" marker-end="url(#sva-arr-a)" />
    </g>
    <g data-id="sOk" class="hide">
      <text class="hi" x="107" y="256">OK</text>
      <line class="line acc" x1="165" y1="270" x2="54" y2="270" marker-end="url(#sva-arr-a)" />
    </g>
    <g data-id="relay" class="hide">
      <rect class="chip" x="232" y="196" width="82" height="26" rx="6" /><text class="mono" x="273" y="209">relay log</text>
    </g>
    <g data-id="sStuck" class="hide">
      <text class="err-t" x="219" y="223">답장 없음</text>
      <text class="err-t" x="107" y="256">OK 못 줌</text>
    </g>

    <!-- 비동기 -->
    <g data-id="aOk" class="hide">
      <text class="hi" x="107" y="171">바로 OK</text>
      <line class="line acc" x1="165" y1="185" x2="54" y2="185" marker-end="url(#sva-arr-a)" />
    </g>
    <g data-id="aSend" class="hide">
      <text x="219" y="223">나중에 전송</text>
      <line class="line dash" x1="165" y1="235" x2="269" y2="235" marker-end="url(#sva-arr)" />
    </g>

    <!-- 장애 -->
    <g data-id="fDead" class="hide">
      <rect class="err" x="229" y="42" width="88" height="34" rx="6" />
      <text class="err-t" x="273" y="60">팔로워 ✕</text>
    </g>
    <g data-id="lDead" class="hide">
      <path class="x" d="M155 215 L175 235 M175 215 L155 235" />
      <text class="err-t" x="219" y="225">리더 다운</text>
    </g>
    <g data-id="lost" class="hide">
      <rect class="err" x="231" y="256" width="84" height="28" rx="6" /><text class="err-t" x="273" y="270">이 쓰기 없음</text>
    </g>

    <!-- 아래 한 줄 정리 (같은 자리, 번갈아) -->
    <g data-id="nS" class="hide"><rect class="err" x="10" y="322" width="300" height="52" rx="8" /><text class="err-t" x="160" y="348">팔로워 1대 다운 = 쓰기 전체 멈춤</text></g>
    <g data-id="nA" class="hide"><rect class="chip" x="10" y="322" width="300" height="52" rx="8" /><text x="160" y="339">팔로워가 없어도 계속 OK</text><text class="sub" x="160" y="360">살아나면 밀린 변경을 따라잡음</text></g>
    <g data-id="nL" class="hide"><rect class="err" x="10" y="322" width="300" height="52" rx="8" /><text class="err-t" x="160" y="339">OK 받은 쓰기가 사라짐</text><text class="sub" x="160" y="360">팔로워가 새 리더가 되면 유실</text></g>
    <g data-id="nSemi" class="hide"><rect class="chip" x="10" y="322" width="300" height="52" rx="8" /><text x="160" y="339">적용 말고 "받아 적음"만 확인</text><text class="sub" x="160" y="360">타임아웃 지나면 비동기로 내려감</text></g>
  </svg>
</Stepper>

<style>
  .life { stroke: var(--sl-color-gray-4); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .acc { stroke: var(--sl-color-accent) !important; stroke-width: 2 !important; }
  .dash { stroke-dasharray: 5 4; }
  .wait { fill: var(--sl-color-accent-low); stroke: var(--sl-color-accent); stroke-width: 1.2; }
  .x { stroke: var(--sl-color-red); stroke-width: 3.5; fill: none; }
</style>
