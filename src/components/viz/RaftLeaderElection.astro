---
// Raft 리더 선출 7단계: 하트비트 → S1 다운·타이머 감소 → S3 후보(임기 2) → 투표 요청 → 과반 찬성 → 하트비트 리셋 → 옛 리더 S1 강등.
// 같은 자리에 번갈아 나오는 역할 글자·임기·타이머·아래 정리 상자는 class="hide".
import Stepper from '../Stepper.astro';

// 노드 중심 좌표 (상자 84x64). 화살표 좌표 계산용.
const P = { s1: [160, 48], s2: [270, 140], s3: [226, 282], s4: [94, 282], s5: [50, 140] } as const;
type K = keyof typeof P;
const seg = (a: K, b: K) => {
  const [ax, ay] = P[a], [bx, by] = P[b];
  const dx = bx - ax, dy = by - ay;
  const t = Math.min(42 / Math.abs(dx || 1e-6), 32 / Math.abs(dy || 1e-6)) + 0.03;
  return { x1: ax + dx * t, y1: ay + dy * t, x2: bx - dx * t, y2: by - dy * t };
};
// 타이머 막대(남은 시간 비율). 0이면 만료.
const bar = (k: K, r: number) => ({ x: P[k][0] - 30, y: P[k][1] + 15, w: 60 * r });

const steps = [
  { caption: '평상시(임기 1): 리더 S1이 팔로워 S2~S5에게 하트비트("나 살아 있어요")를 계속 보내요. 받을 때마다 팔로워의 선거 타이머가 가득 찬 상태로 되돌아가요.', show: ['cur1', 's1L', 's1t1', 's2t1', 's3F', 's3t1', 's4t1', 's5t1', 'hb1', 'tm1', 'n1'] },
  { caption: 'S1이 죽어 하트비트가 끊겼어요. 팔로워의 타이머가 줄어드는데, 길이를 각자 무작위로 정해 둬서 끝나는 순간이 서로 달라요.', show: ['cur1', 's1D', 's1t1', 's2t1', 's3F', 's3t1', 's4t1', 's5t1', 'tm2', 'n2'] },
  { caption: '타이머가 가장 먼저 끝난 S3이 임기를 2로 올리고 후보가 돼요. 먼저 자기 자신에게 1표를 줘요.', show: ['cur2', 's1D', 's1t1', 's2t1', 's3C', 's3t2', 's4t1', 's5t1', 'tm3', 'n3'] },
  { caption: 'S3이 모두에게 "임기 2 선거야, 나 뽑아 줘"(투표 요청, RequestVote)를 보내요. 받은 S2·S4는 자기 임기도 2로 올려요. S1은 죽어 있어 답이 없어요.', show: ['cur2', 's1D', 's1t1', 's2t2', 's3C', 's3t2', 's4t2', 's5t1', 'rv', 'n4'] },
  { caption: 'S2·S4가 찬성해요. S3 자신까지 3표, 5대 중 과반이라 S3이 임기 2의 리더가 돼요. S5의 답은 늦지만 이미 과반이라 기다리지 않아요.', show: ['cur2', 's1D', 's1t1', 's2t2', 's3L', 's3t2', 's4t2', 's5t1', 'vt', 'n5'] },
  { caption: '새 리더 S3이 하트비트를 보내요. 받은 팔로워는 타이머를 다시 채우고 임기 2를 따라요. 그래서 다른 서버가 또 출마하지 않아요.', show: ['cur2', 's1D', 's1t1', 's2t2', 's3L', 's3t2', 's4t2', 's5t2', 'hb3', 'tm6', 'n6'] },
  { caption: '옛 리더 S1이 돌아왔어요. 아직 임기 1이라 자기가 리더라고 믿지만, S3의 하트비트에 적힌 임기 2가 더 커요. S1은 바로 팔로워로 내려가고 임기 2를 따라요.', show: ['cur2', 's1F', 's1t2', 's2t2', 's3L', 's3t2', 's4t2', 's5t2', 'hb3', 'hb31', 'tm6', 'n7'] },
];
const a = {
  hb1: [seg('s1', 's2'), seg('s1', 's3'), seg('s1', 's4'), seg('s1', 's5')],
  rv: [seg('s3', 's1'), seg('s3', 's2'), seg('s3', 's4'), seg('s3', 's5')],
  vt: [seg('s2', 's3'), seg('s4', 's3')],
  hb3: [seg('s3', 's2'), seg('s3', 's4'), seg('s3', 's5')],
  hb31: seg('s3', 's1'),
};
const tm1 = [bar('s2', 1), bar('s3', 1), bar('s4', 1), bar('s5', 1)];
const tm2 = [bar('s2', .6), bar('s3', .25), bar('s4', .75), bar('s5', .45)];
const tm3 = [bar('s2', .35), bar('s4', .5), bar('s5', .2)];
const tm6 = [bar('s2', 1), bar('s4', 1), bar('s5', 1)];
const track = (k: K) => ({ x: P[k][0] - 30, y: P[k][1] + 15 });
---
<Stepper title="Raft 리더 선출: 타이머 → 후보 → 과반 투표" steps={steps}>
  <svg class="viz" viewBox="0 0 320 400" role="img" aria-label="서버 S1부터 S5까지 다섯 대가 원형으로 놓인 그림. 리더 S1이 죽어 하트비트가 끊기면 타이머가 가장 먼저 끝난 S3이 임기 2 후보가 되어 투표를 요청하고, S2와 S4의 찬성으로 3/5 과반을 얻어 리더가 된다. 돌아온 S1은 임기 1이라 임기 2를 보고 팔로워로 내려간다.">
    <defs>
      <marker id="rle-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
      <marker id="rle-arr-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-accent)" />
      </marker>
    </defs>

    <!-- 현재 임기 -->
    <g data-id="cur1" class="hide"><rect class="box" x="6" y="6" width="98" height="34" rx="6" /><text x="55" y="24">현재 임기 1</text></g>
    <g data-id="cur2" class="hide"><rect class="chip" x="6" y="6" width="98" height="34" rx="6" /><text x="55" y="24">현재 임기 <tspan class="hi">2</tspan></text></g>

    <!-- 화살표 -->
    <g data-id="hb1" class="hide">{a.hb1.map((l) => <line class="line" {...l} marker-end="url(#rle-arr)" />)}</g>
    <g data-id="rv" class="hide">{a.rv.map((l) => <line class="line acc" {...l} marker-end="url(#rle-arr-a)" />)}</g>
    <g data-id="vt" class="hide">{a.vt.map((l) => <line class="line acc" {...l} marker-end="url(#rle-arr-a)" />)}</g>
    <g data-id="hb3" class="hide">{a.hb3.map((l) => <line class="line" {...l} marker-end="url(#rle-arr)" />)}</g>
    <line data-id="hb31" class="line acc hide" {...a.hb31} marker-end="url(#rle-arr-a)" />

    <!-- 노드 상자 -->
    {(Object.keys(P) as K[]).map((k) => <rect class="box" x={P[k][0] - 42} y={P[k][1] - 32} width="84" height="64" rx="8" />)}

    <!-- S1 -->
    <text data-id="s1L" class="hide" x="160" y="32">S1 <tspan class="hi">리더</tspan></text>
    <g data-id="s1D" class="hide">
      <rect class="err" x="118" y="16" width="84" height="64" rx="8" />
      <text x="160" y="32">S1 <tspan class="err-t">다운</tspan></text>
    </g>
    <text data-id="s1F" class="hide" x="160" y="32">S1 팔로워</text>
    <text data-id="s1t1" class="sub hide" x="160" y="52">임기 1</text>
    <text data-id="s1t2" class="hide" x="160" y="52"><tspan class="hi">임기 2</tspan></text>

    <!-- S2 -->
    <text x="270" y="124">S2 팔로워</text>
    <text data-id="s2t1" class="sub hide" x="270" y="144">임기 1</text>
    <text data-id="s2t2" class="hide" x="270" y="144"><tspan class="hi">임기 2</tspan></text>

    <!-- S3 -->
    <text data-id="s3F" class="hide" x="226" y="266">S3 팔로워</text>
    <text data-id="s3C" class="hide" x="226" y="266">S3 <tspan class="hi">후보</tspan></text>
    <text data-id="s3L" class="hide" x="226" y="266">S3 <tspan class="hi">리더</tspan></text>
    <text data-id="s3t1" class="sub hide" x="226" y="286">임기 1</text>
    <text data-id="s3t2" class="hide" x="226" y="286"><tspan class="hi">임기 2</tspan></text>

    <!-- S4 -->
    <text x="94" y="266">S4 팔로워</text>
    <text data-id="s4t1" class="sub hide" x="94" y="286">임기 1</text>
    <text data-id="s4t2" class="hide" x="94" y="286"><tspan class="hi">임기 2</tspan></text>

    <!-- S5 -->
    <text x="50" y="124">S5 팔로워</text>
    <text data-id="s5t1" class="sub hide" x="50" y="144">임기 1</text>
    <text data-id="s5t2" class="hide" x="50" y="144"><tspan class="hi">임기 2</tspan></text>

    <!-- 선거 타이머 막대 (남은 시간) -->
    <g data-id="tm1" class="hide">{tm1.map((b) => <><rect class="trk" x={b.x} y={b.y} width="60" height="7" rx="3" /><rect class="bar" x={b.x} y={b.y} width={b.w} height="7" rx="3" /></>)}</g>
    <g data-id="tm2" class="hide">{tm2.map((b) => <><rect class="trk" x={b.x} y={b.y} width="60" height="7" rx="3" /><rect class="bar" x={b.x} y={b.y} width={b.w} height="7" rx="3" /></>)}</g>
    <g data-id="tm3" class="hide">
      {tm3.map((b) => <><rect class="trk" x={b.x} y={b.y} width="60" height="7" rx="3" /><rect class="bar" x={b.x} y={b.y} width={b.w} height="7" rx="3" /></>)}
      <rect class="err" x={track('s3').x} y={track('s3').y} width="60" height="7" rx="3" />
    </g>
    <g data-id="tm6" class="hide">{tm6.map((b) => <><rect class="trk" x={b.x} y={b.y} width="60" height="7" rx="3" /><rect class="bar" x={b.x} y={b.y} width={b.w} height="7" rx="3" /></>)}</g>

    <!-- 아래 정리 상자 (같은 자리, 번갈아) -->
    <g data-id="n1" class="hide"><rect class="box" x="6" y="332" width="308" height="62" rx="8" /><text x="160" y="352">S1 → 모두: 하트비트</text><text class="sub" x="160" y="376">막대 = 선거 타이머(가득 참)</text></g>
    <g data-id="n2" class="hide"><rect class="err" x="6" y="332" width="308" height="62" rx="8" /><text class="err-t" x="160" y="352">하트비트 끊김</text><text class="sub" x="160" y="376">타이머 길이는 서버마다 무작위</text></g>
    <g data-id="n3" class="hide"><rect class="chip" x="6" y="332" width="308" height="62" rx="8" /><text x="160" y="352">S3 타이머 만료 → 출마</text><text class="sub" x="160" y="376">임기 1 → 2, 자기에게 1표</text></g>
    <g data-id="n4" class="hide"><rect class="chip" x="6" y="332" width="308" height="62" rx="8" /><text x="160" y="352">투표 요청(RequestVote)</text><text class="sub" x="160" y="376">"임기 2 선거, 나 뽑아 줘"</text></g>
    <g data-id="n5" class="hide"><rect class="chip" x="6" y="332" width="308" height="62" rx="8" /><text x="160" y="352">찬성 <tspan class="hi">3/5</tspan> = 과반 → 리더</text><text class="sub" x="160" y="376">S3(자기) + S2 + S4</text></g>
    <g data-id="n6" class="hide"><rect class="box" x="6" y="332" width="308" height="62" rx="8" /><text x="160" y="352">S3 → 하트비트</text><text class="sub" x="160" y="376">팔로워 타이머 리셋 · 임기 2</text></g>
    <g data-id="n7" class="hide"><rect class="chip" x="6" y="332" width="308" height="62" rx="8" /><text x="160" y="352">S1: 내 임기 1 &lt; 2</text><text class="sub" x="160" y="376">더 큰 임기를 보면 바로 팔로워로</text></g>
  </svg>
</Stepper>

<style>
  .acc { stroke: var(--sl-color-accent) !important; stroke-width: 2 !important; }
  .trk { fill: var(--sl-color-gray-5); }
  .bar { fill: var(--sl-color-accent); }
</style>
