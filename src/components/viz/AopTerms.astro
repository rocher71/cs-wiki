---
// AOP 용어: 빈의 모든 메서드(JoinPoint 후보) ⊃ Pointcut으로 고른 메서드 ← Advice 부착, Pointcut+Advice = Aspect, 빈은 프록시로 감싸짐
import Stepper from '../Stepper.astro';
const base = ['bean', 'methods'];
const steps = [
  { caption: 'OrderService 빈의 메서드 4개가 모두 JoinPoint 후보예요. 스프링 AOP에서 JoinPoint는 항상 "메서드 실행" 지점이에요.', show: [...base, 'jpLabel'] },
  { caption: 'Pointcut이 그중 조건(@LogTime이 붙은 메서드)에 맞는 것만 골라요. Pointcut은 JoinPoint의 부분집합, 즉 "어디에"예요.', show: [...base, 'pointcut', 'pick'] },
  { caption: 'Advice는 고른 메서드에 "언제 + 무엇을" 할지예요. 여기선 @Around로 실행 앞뒤에서 시간을 재요.', show: [...base, 'pointcut', 'pick', 'advice', 'tags'] },
  { caption: 'Pointcut + Advice를 묶은 클래스가 Aspect예요. 컨테이너가 이 빈을 프록시로 감싸고, order()·cancel()이 불릴 때만 Advice를 끼워 넣어요.', show: [...base, 'pointcut', 'pick', 'advice', 'tags', 'aspect', 'proxy'] },
];
---
<Stepper title="AOP 용어 한 장 정리" steps={steps}>
  <svg class="viz" viewBox="0 0 320 400" role="img" aria-label="OrderService 빈의 메서드 4개가 모두 JoinPoint 후보이고, Pointcut이 @LogTime이 붙은 order와 cancel만 고르며, Advice가 그 메서드에 시간 측정을 붙이고, Pointcut과 Advice를 묶은 것이 Aspect이며 빈은 프록시로 감싸지는 그림">
    <g data-id="aspect" class="hide">
      <rect class="frame" x="4" y="4" width="312" height="112" rx="10" />
      <text x="160" y="20" style="font-weight:700">Aspect = Pointcut + Advice</text>
    </g>
    <g data-id="pointcut">
      <rect class="chip" x="16" y="32" width="288" height="34" rx="8" />
      <text class="l" x="28" y="49" style="font-weight:700">Pointcut</text>
      <text class="mono l" x="108" y="49">@annotation(LogTime)</text>
    </g>
    <g data-id="advice">
      <rect class="chip" x="16" y="74" width="288" height="34" rx="8" />
      <text class="l" x="28" y="91" style="font-weight:700">Advice</text>
      <text class="l" x="108" y="91">@Around 시간 측정</text>
    </g>

    <g data-id="proxy" class="hide">
      <rect class="frame" x="6" y="132" width="308" height="262" rx="12" />
      <text x="160" y="148" style="font-weight:700">OrderService 프록시</text>
    </g>
    <g data-id="bean">
      <rect class="box" x="20" y="162" width="280" height="222" rx="8" />
      <text x="160" y="182" style="font-weight:700">OrderService 빈</text>
    </g>
    <g data-id="methods">
      <circle cx="40" cy="212" r="5" fill="var(--sl-color-gray-2)" />
      <text class="mono l" x="54" y="212">@LogTime order()</text>
      <circle cx="40" cy="248" r="5" fill="var(--sl-color-gray-2)" />
      <text class="mono l" x="54" y="248">@LogTime cancel()</text>
      <circle cx="40" cy="284" r="5" fill="var(--sl-color-gray-2)" />
      <text class="mono l" x="54" y="284">find()</text>
      <circle cx="40" cy="320" r="5" fill="var(--sl-color-gray-2)" />
      <text class="mono l" x="54" y="320">count()</text>
    </g>
    <text data-id="jpLabel" class="sub hide" x="160" y="360">● = JoinPoint 후보 (모든 메서드)</text>

    <g data-id="pick" class="hide">
      <rect class="hl" x="28" y="196" width="264" height="68" rx="8" />
      <text class="sub" x="160" y="360">Pointcut이 고른 것: 테두리 안 2개</text>
    </g>
    <g data-id="tags" class="hide">
      <rect class="badge" x="216" y="201" width="70" height="22" rx="6" />
      <text class="on-badge" x="251" y="212">+측정</text>
      <rect class="badge" x="216" y="237" width="70" height="22" rx="6" />
      <text class="on-badge" x="251" y="248">+측정</text>
    </g>
  </svg>
</Stepper>
