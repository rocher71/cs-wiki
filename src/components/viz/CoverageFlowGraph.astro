---
// testing.mdx 예제 2·3. 앞 4단계: if (a>0 && b>0) { x=1; } y=2; 흐름 그래프에서 구문(TT)·결정(TT,FT)·조건(TF,FT) 경로.
// 뒤 4단계: 예제 3 그래프(노드 7, 간선 8: 1→2, 2→3, 2→4, 3→5, 4→5, 5→6, 6→2, 6→7)로 V(G)=3.
// 두 그래프, 경로 강조, 아래 설명 줄은 같은 자리 번갈아 → class="hide".
import Stepper from '../Stepper.astro';

// 그래프 2 좌표
const R = 16;
const P: Record<number, [number, number]> = { 1: [130, 28], 2: [130, 82], 3: [70, 134], 4: [190, 134], 5: [130, 186], 6: [130, 238], 7: [130, 290] };
const E2: [number, number][] = [[1, 2], [2, 3], [2, 4], [3, 5], [4, 5], [5, 6], [6, 7]]; // 6→2는 따로 곡선
const seg = (a: number, b: number) => {
  const [x1, y1] = P[a], [x2, y2] = P[b];
  const d = Math.hypot(x2 - x1, y2 - y1), ux = (x2 - x1) / d, uy = (y2 - y1) / d;
  return { x1: x1 + ux * R, y1: y1 + uy * R, x2: x2 - ux * (R + 3), y2: y2 - uy * (R + 3) };
};
const LOOP = `M${P[6][0] + R} ${P[6][1]} H270 V${P[2][1]} H${P[2][0] + R + 3}`;
const poly = (ids: number[]) => ids.map((i) => P[i].join(',')).join(' ');

type Ln = [string, string?];
const T = (k: string, lines: Ln[]) => lines.map(([t, c], i) => ({ k, t, c: `l hide ${c ?? ''}`, y: 326 + i * 25 }));

const steps = [
  { caption: '코드의 흐름 그래프예요. 결정 노드에서 참이면 x = 1을 거쳐 y = 2로, 거짓이면 바로 y = 2로 가요. T는 참, F는 거짓이고 TF는 "조건 A 참, B 거짓"이에요.', show: ['g1', 't1'] },
  { caption: '구문 커버리지: 모든 문장을 한 번씩 실행하면 돼요. TT 하나면 x = 1과 y = 2를 다 지나서 1개로 충분해요. 거짓 길은 한 번도 안 지나가요.', show: ['g1', 'true', 'nX', 'nY', 'tagTT', 't2'] },
  { caption: '결정 커버리지: 결정 결과가 참 한 번, 거짓 한 번 나와야 해요. TT로 참 길, FT로 거짓 길을 지나서 최소 2개예요.', show: ['g1', 'true', 'false', 'tagTT', 'tagFT', 't3'] },
  { caption: '조건 커버리지의 함정: TF·FT로 A와 B가 각각 참·거짓을 다 가졌어요. 그런데 결정은 두 번 다 거짓이라 참 길(x = 1)은 한 번도 안 지나가요. 결정도, 구문도 만족 못 해요.', show: ['g1', 'false', 'miss', 'tagTF', 't4'] },
  { caption: '이제 예제 3 그래프예요(do-while 안에 if-else). 노드 7개, 간선 8개라 V(G) = E − N + 2 = 8 − 7 + 2 = 3이에요. 판단 노드(화살표 2개가 나가는 2와 6)로 세도 2 + 1 = 3이에요.', show: ['g2', 'dec', 't5'] },
  { caption: '영역으로 세 볼게요. if-else가 갈라졌다 다시 모이는 2-3-5-4가 닫힌 영역 1이에요.', show: ['g2', 'z1', 't6'] },
  { caption: '6에서 2로 돌아가는 반복 화살표가 2-4-5-6과 함께 닫힌 영역 2를 만들어요. 닫힌 영역은 2개예요.', show: ['g2', 'z1', 'z2', 't7'] },
  { caption: '그래프 바깥 영역을 1개 더해요. 2 + 1 = 3. 세 공식 모두 V(G) = 3이고, 기본 경로 테스트에 최소 3개 케이스가 필요해요.', show: ['g2', 'z1', 'z2', 'z3', 't8'] },
];
---
<Stepper title="커버리지별로 지나가는 길, 그리고 V(G) 세기" steps={steps}>
  <svg class="viz" viewBox="0 0 320 400" role="img" aria-label="if (a>0 && b>0) x=1; y=2; 흐름 그래프에서 구문 커버리지는 TT 1개, 결정 커버리지는 TT와 FT 2개, 조건 커버리지 TF와 FT는 둘 다 거짓 길만 지나 참 길을 놓친다. 노드 7개 간선 8개 그래프는 닫힌 영역 2개와 바깥 1개로 V(G)=3.">
    <defs>
      <marker id="cov-a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>

    <!-- ===== 그래프 1: 예제 2 ===== -->
    <path data-id="true" class="pth hide" d="M210 92 H250 V140" />
    <path data-id="true" class="pth hide" d="M250 180 V232 H184" />
    <path data-id="miss" class="miss hide" d="M210 92 H250 V140 M250 180 V232 H184" />
    <path data-id="false" class="pth hide" d="M130 120 V212" />
    <g data-id="g1" class="hide">
      <text class="mono" x="160" y="18">if (a&gt;0 &amp;&amp; b&gt;0) x=1; y=2;</text>
      <polygon class="box" points="130,64 210,92 130,120 50,92" />
      <text class="mono" x="130" y="92">a&gt;0 &amp;&amp; b&gt;0</text>
      <rect class="box" x="200" y="140" width="100" height="40" rx="6" />
      <text class="mono" x="250" y="160">x = 1</text>
      <rect class="box" x="80" y="212" width="100" height="40" rx="6" />
      <text class="mono" x="130" y="232">y = 2</text>
      <path class="line" d="M210 92 H250 V137" marker-end="url(#cov-a)" />
      <path class="line" d="M250 180 V232 H184" marker-end="url(#cov-a)" />
      <path class="line" d="M130 120 V209" marker-end="url(#cov-a)" />
      <text class="sub" x="232" y="76">참</text>
      <text class="sub" x="118" y="150" style="text-anchor:end">거짓</text>
    </g>
    <rect data-id="nX" class="hl hide" x="196" y="136" width="108" height="48" rx="8" />
    <rect data-id="nY" class="hl hide" x="76" y="208" width="108" height="48" rx="8" />
    <text data-id="tagTT" class="hi l hide" x="260" y="112">TT</text>
    <text data-id="tagFT" class="hi hide" x="118" y="180" style="text-anchor:end">FT</text>
    <g data-id="tagTF" class="hide">
      <text class="hi" x="118" y="180" style="text-anchor:end">TF, FT</text>
      <text class="err-t l" x="260" y="112">0번</text>
    </g>

    <!-- ===== 그래프 2: 예제 3 ===== -->
    <polygon data-id="z1" class="zone-c hide" points={poly([2, 4, 5, 3])} />
    <path data-id="z2" class="zone-c hide" d={`M${poly([2, 4, 5, 6])} L270,${P[6][1]} L270,${P[2][1]} Z`} />
    <g data-id="g2" class="hide">
      {E2.map(([a, b]) => <line class="line" {...seg(a, b)} marker-end="url(#cov-a)" />)}
      <path class="line" d={LOOP} marker-end="url(#cov-a)" />
      {Object.entries(P).map(([k, [x, y]]) => <><circle class="box" cx={x} cy={y} r={R} /><text x={x} y={y}>{k}</text></>)}
      <text class="sub" x="106" y={P[1][1]} style="text-anchor:end">시작</text>
      <text class="sub" x="106" y={P[7][1]} style="text-anchor:end">끝</text>
      <text class="sub l" x="278" y="160">반복</text>
    </g>
    <g data-id="dec" class="hide">
      <circle class="hl" cx={P[2][0]} cy={P[2][1]} r={R + 4} />
      <circle class="hl" cx={P[6][0]} cy={P[6][1]} r={R + 4} />
      <text class="hi" x="98" y={P[2][1]} style="text-anchor:end">판단</text>
      <text class="hi" x="98" y={P[6][1]} style="text-anchor:end">판단</text>
    </g>
    <text data-id="z1" class="hi hide" x="130" y="134">영역1</text>
    <text data-id="z2" class="hi hide" x="236" y="186">영역2</text>
    <g data-id="z3" class="hide">
      <text class="hi" x="34" y="200">영역3</text>
      <text class="hi" x="34" y="222">바깥</text>
    </g>

    <!-- ===== 아래 설명 ===== -->
    {[T('t1', [['결정 노드 1개, 나가는 길 2개'], ['참 길: x = 1 → y = 2'], ['거짓 길: 바로 y = 2']]),
    T('t2', [['구문: TT 1개', 'hi'], ['x = 1, y = 2 모두 실행 ✓'], ['거짓 길은 안 지나감', 'sub']]),
    T('t3', [['결정: TT, FT 2개', 'hi'], ['TT → 참 길, FT → 거짓 길'], ['결정 참·거짓 모두 나옴 ✓']]),
    T('t4', [['조건: TF, FT 2개', 'hi'], ['A: T·F ✓   B: F·T ✓'], ['결정은 둘 다 거짓 → 참 길 0번 ✗', 'err-t']]),
    T('t5', [['N = 7, E = 8', 'hi'], ['E − N + 2 = 8 − 7 + 2 = 3'], ['판단 노드 2개 + 1 = 3']]),
    T('t6', [['닫힌 영역 1: 2-3-5-4', 'hi'], ['if-else가 갈라졌다 모임'], ['지금까지 1개', 'sub']]),
    T('t7', [['닫힌 영역 2: 6 → 2 반복', 'hi'], ['반복 화살표가 둘러싼 칸'], ['닫힌 영역 2개', 'sub']]),
    T('t8', [['바깥 영역(3번째) +1', 'hi'], ['V(G) = 2 + 1 = 3'], ['기본 경로 테스트 최소 3개']])].flat().map((d) => <text data-id={d.k} class={d.c} x="12" y={d.y}>{d.t}</text>)}
  </svg>
</Stepper>

<style>
  .pth { stroke: var(--sl-color-accent); stroke-width: 6; fill: none; opacity: .85; }
  .miss { stroke: var(--sl-color-red); stroke-width: 3; stroke-dasharray: 7 5; fill: none; }
</style>
