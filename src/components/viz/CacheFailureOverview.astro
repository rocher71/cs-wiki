---
// 캐시 장애 4종 비교 카드(정적). 폰은 1열, 넓은 화면은 2열. 카드마다 위=문제, 아래=대응.
const five = [0, 1, 2, 3, 4];
const nodes = [20, 115, 210]; // 핫키 카드 노드 x (폭 70)
const spread = [70, 95, 118, 150, 172, 205, 230, 262];
---
<div class="cfo">
  <figure class="cfo-card">
    <figcaption><b>1. 스탬피드</b> 인기 키 하나가 만료</figcaption>
    <svg class="viz" viewBox="0 0 300 180" role="img" aria-label="인기 키 하나가 만료된 순간 여러 요청이 동시에 DB로 가는 모습">
      <rect class="bad" x="90" y="10" width="120" height="36" rx="6" />
      <text x="150" y="28"><tspan class="mono">hot</tspan> 만료</text>
      {five.map((i) => <line class="cfo-red" x1={110 + i * 20} y1="50" x2={40 + i * 55} y2="106" />)}
      <rect class="err" x="20" y="110" width="260" height="36" rx="6" />
      <text class="err-t" x="150" y="128">DB: 같은 쿼리 동시에 N번</text>
      <text class="hi" x="150" y="166">대응: 락(SET NX) · 조기 갱신</text>
    </svg>
  </figure>

  <figure class="cfo-card">
    <figcaption><b>2. 관통</b> DB에도 없는 키</figcaption>
    <svg class="viz" viewBox="0 0 300 180" role="img" aria-label="없는 키 요청이 캐시를 그냥 지나 매번 DB로 가고, 앞단 블룸 필터가 있으면 바로 막히는 모습">
      <text class="sub l" x="10" y="12">필터 없음</text>
      <rect class="box" x="10" y="24" width="80" height="34" rx="6" /><text class="mono" x="50" y="41">id=-1</text>
      <rect class="bad" x="115" y="24" width="70" height="34" rx="6" /><text x="150" y="41">캐시</text>
      <rect class="err" x="210" y="24" width="80" height="34" rx="6" /><text class="err-t" x="250" y="41">DB 매번</text>
      <line class="cfo-red" x1="92" y1="41" x2="113" y2="41" /><line class="cfo-red" x1="187" y1="41" x2="208" y2="41" />
      <text class="sub l" x="10" y="80">블룸 필터</text>
      <rect class="box" x="10" y="92" width="80" height="34" rx="6" /><text class="mono" x="50" y="109">id=-1</text>
      <rect class="chip" x="115" y="92" width="70" height="34" rx="6" /><text x="150" y="109">필터</text>
      <line class="line" x1="92" y1="109" x2="113" y2="109" />
      <text class="hi" x="245" y="109">✕ 차단</text>
      <text class="hi" x="150" y="166">대응: null 캐싱 · 블룸 필터</text>
    </svg>
  </figure>

  <figure class="cfo-card">
    <figcaption><b>3. 눈사태</b> 많은 키가 한꺼번에</figcaption>
    <svg class="viz" viewBox="0 0 300 180" role="img" aria-label="TTL이 같으면 만료 시각이 한 점에 몰려 높은 막대가 되고, 지터를 넣으면 막대가 낮게 넓게 퍼지는 모습">
      <text class="sub l" x="10" y="14">지터 없음</text>
      <rect class="err" x="140" y="8" width="20" height="50" />
      <text class="err-t l" x="168" y="34">한 시각에 몰림</text>
      <line class="line" x1="60" y1="58" x2="290" y2="58" />
      <text class="sub l" x="10" y="82">지터 있음</text>
      {spread.map((x) => <rect class="chip" x={x} y="108" width="14" height="14" />)}
      <line class="line" x1="60" y1="122" x2="290" y2="122" />
      <text class="sub" x="175" y="138">만료 시각 →</text>
      <text class="hi" x="150" y="166">대응: TTL 지터 · 캐시 이중화</text>
    </svg>
  </figure>

  <figure class="cfo-card">
    <figcaption><b>4. 핫키</b> 키 하나에 요청 집중</figcaption>
    <svg class="viz" viewBox="0 0 300 180" role="img" aria-label="클러스터 노드 3개 중 핫키가 있는 노드 하나만 과부하이고, 키를 hot:1~3으로 복제하면 노드 3개에 고르게 나뉘는 모습">
      {nodes.map((x, i) => i === 1
        ? <g><rect class="err" x={x} y="14" width="70" height="40" rx="6" /><text class="err-t" x={x + 35} y="34">노드B</text></g>
        : <g><rect class="box" x={x} y="14" width="70" height="40" rx="6" /><text x={x + 35} y="34">노드{i ? 'C' : 'A'}</text></g>)}
      <text class="err-t" x="150" y="68" style="font-size:14px">hot 키 하나 → CPU 100%</text>
      {nodes.map((x, i) => <g><rect class="chip" x={x} y="88" width="70" height="40" rx="6" /><text class="mono" x={x + 35} y="108">hot:{i + 1}</text></g>)}
      <text class="sub" x="150" y="142">복제해 나눠 읽기</text>
      <text class="hi" x="150" y="166">대응: 로컬 캐시 · 키 복제</text>
    </svg>
  </figure>
</div>

<style>
  .cfo { display: grid; grid-template-columns: 1fr; gap: .75rem; margin: 1.25rem 0; }
  @media (min-width: 640px) and (max-width: 799px), (min-width: 1200px) { .cfo { grid-template-columns: 1fr 1fr; } }
  .cfo :global(*) { margin-top: 0 !important; }
  .cfo-card {
    margin: 0; padding: .6rem .75rem; border-radius: .75rem;
    border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-gray-7, var(--sl-color-black));
  }
  .cfo-card figcaption { font-size: .95rem; margin-bottom: .4rem !important; }
  .cfo-card svg { width: 100%; height: auto; display: block; }
  .cfo :global(.cfo-red) { stroke: var(--sl-color-red); stroke-width: 1.8; }
</style>
