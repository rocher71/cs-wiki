---
// 예제 쿼리(SELECT member_id, SUM(amount) AS total ... LIMIT 2)가 논리적 처리 순서대로 줄어드는 모습.
// 왼쪽: 절 목록(현재 단계 테두리), 오른쪽: 그 단계까지의 중간 결과.
import Stepper from '../Stepper.astro';
const clauses = ['FROM', 'WHERE', 'GROUP BY', 'HAVING', 'SELECT', 'ORDER BY', 'LIMIT'];
const py = (i: number) => 34 + i * 32; // 절 알약 중심 y
const HY = 30;
const ry = (i: number) => HY + 28 + i * 28;
// 오른쪽 표. mark: 'del'(이번에 빠짐) | 'new'(주목)
type Row = { c: string[]; mark?: 'del' | 'new' };
const four = { cols: [['id', 124], ['member_id', 172], ['amount', 236], ['status', 290]] as [string, number][] };
const two = { cols: [['member_id', 170], ['SUM(amount)', 262]] as [string, number][] };
const sel = { cols: [['member_id', 170], ['total', 262]] as [string, number][] };
const o = [['10', '1', '5000', 'PAID'], ['11', '1', '3000', 'CANCEL'], ['12', '2', '7000', 'PAID'], ['13', 'NULL', '1000', 'PAID'], ['14', '9', '2000', 'PAID']];
const g = [['1', '5000'], ['2', '7000'], ['NULL', '1000'], ['9', '2000']];
const panels: { id: string; t: typeof four; rows: Row[]; note: string; newHead?: boolean }[] = [
  { id: 'd1', t: four, rows: o.map((c) => ({ c })), note: 'orders 전체 5행' },
  { id: 'd2', t: four, rows: o.map((c, i) => ({ c, mark: i === 1 ? 'del' : undefined })), note: '남은 행: 4' },
  { id: 'd3', t: two, rows: g.map((c, i) => ({ c, mark: i === 2 ? 'new' : undefined })), note: 'NULL끼리도 한 그룹 → 4그룹' },
  { id: 'd4', t: two, rows: g.map((c, i) => ({ c, mark: i === 2 ? 'del' : undefined })), note: '1000 < 2000 탈락 → 3그룹' },
  { id: 'd5', t: sel, rows: [['1', '5000'], ['2', '7000'], ['9', '2000']].map((c) => ({ c })), note: '', newHead: true },
  { id: 'd6', t: sel, rows: [['2', '7000'], ['1', '5000'], ['9', '2000']].map((c) => ({ c })), note: 'total 큰 순서로 정렬' },
  { id: 'd7', t: sel, rows: [['2', '7000'], ['1', '5000'], ['9', '2000']].map((c, i) => ({ c, mark: i === 2 ? 'del' : undefined })), note: '앞의 2행만 → 최종 결과' },
];
const steps = [
  { caption: 'FROM orders: 먼저 테이블을 통째로 가져와요. 주문 5행이에요.', show: ['p1', 'd1'] },
  { caption: "WHERE status = 'PAID': 행을 하나씩 보고 걸러요. CANCEL인 주문 11이 빠져 4행이 남아요.", show: ['p2', 'd2'] },
  { caption: 'GROUP BY member_id: 같은 member_id끼리 묶어요. member_id가 NULL인 주문 13도 따로 버리지 않고 NULL 그룹 하나로 묶여요. 4그룹이에요.', show: ['p3', 'd3'] },
  { caption: 'HAVING SUM(amount) >= 2000: 이번엔 묶은 그룹을 걸러요. 합계 1000인 NULL 그룹이 탈락해 3그룹이 남아요.', show: ['p4', 'd4'] },
  { caption: 'SELECT: 보여 줄 값을 계산하고, 별칭 total이 여기서 처음 생겨요. 그래서 이보다 먼저 도는 WHERE에서는 total을 쓸 수 없어요.', show: ['p5', 'd5', 'alias'] },
  { caption: 'ORDER BY total DESC: total 큰 순서로 정렬해요. SELECT 뒤라서 별칭 total을 쓸 수 있어요.', show: ['p6', 'd6'] },
  { caption: 'LIMIT 2: 앞의 2행만 남겨요. 최종 결과는 (2, 7000), (1, 5000)이에요.', show: ['p7', 'd7'] },
];
---
<Stepper title="SQL이 처리되는 순서 따라가기" steps={steps}>
  <svg class="viz" viewBox="0 0 320 262" role="img" aria-label="FROM, WHERE, GROUP BY, HAVING, SELECT, ORDER BY, LIMIT 순서로 주문 5행이 4행, 4그룹, 3그룹, 정렬, 최종 2행으로 줄어드는 과정">
    <defs>
      <marker id="lo-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L10 5 L0 10 z" style="fill: var(--sl-color-red)" />
      </marker>
    </defs>

    <!-- 왼쪽: 절 순서 -->
    {clauses.map((c, i) => (
      <g>
        <rect class="box" x="4" y={py(i) - 12} width="92" height="24" rx="12" />
        <text x="50" y={py(i)} style="font-size:14px">{c}</text>
        {i < clauses.length - 1 && <path class="line" d={`M50 ${py(i) + 12} V${py(i) + 20}`} style="stroke-width:1.2" />}
      </g>
    ))}
    {clauses.map((_, i) => (
      <rect data-id={`p${i + 1}`} class="hl" x="1" y={py(i) - 15} width="98" height="30" rx="15" />
    ))}

    <!-- 오른쪽: 중간 결과 -->
    {panels.map((p) => (
      <g data-id={p.id} class="hide">
        {p.t.cols.map(([h, x], k) => (
          <text class={p.newHead && k === 1 ? 'hi' : 'sub'} x={x} y={HY} style={h.length > 9 ? 'font-size:14px' : ''}>{h}</text>
        ))}
        {p.newHead && <rect class="hl" x="232" y={HY - 13} width="60" height="26" rx="6" style="stroke-width:2" />}
        <path class="line" d={`M104 ${HY + 13} H316`} style="stroke-width:1" />
        {p.rows.map((r, i) => (
          <g>
            {r.mark === 'del' && <rect class="err" x="104" y={ry(i) - 11} width="212" height="22" rx="4" />}
            {r.mark === 'new' && <rect class="chip" x="104" y={ry(i) - 11} width="212" height="22" rx="4" />}
            {r.c.map((v, k) => (
              <text class={v === 'NULL' ? 'nul' : (v === 'CANCEL' ? 'err-t' : '')} x={p.t.cols[k][1]} y={ry(i)} style={v.length > 4 ? 'font-size:14px' : ''}>{v}</text>
            ))}
            {r.mark === 'del' && <path class="strike" d={`M110 ${ry(i)} H310`} />}
          </g>
        ))}
        {p.note && <text class={p.id === 'd7' ? 'hi' : 'sub'} x="210" y="226">{p.note}</text>}
      </g>
    ))}

    <!-- SELECT 단계: 별칭은 WHERE보다 늦게 생긴다 -->
    <g data-id="alias" class="hide">
      <path class="warn" d={`M99 ${py(4)} C 118 ${py(4)}, 118 ${py(1)}, 101 ${py(1)}`} marker-end="url(#lo-arr)" />
      <text class="hi" x="210" y="164" style="font-size:14px">total은 SELECT에서 생겨요</text>
      <text class="err-t" x="210" y="190" style="font-size:14px">WHERE는 먼저 돌아서</text>
      <text class="err-t" x="210" y="212" style="font-size:14px">total을 몰라요</text>
    </g>
  </svg>
</Stepper>

<style>
  svg.viz text.nul { fill: var(--sl-color-gray-3); font-style: italic; font-size: 14px; }
  svg.viz .strike { stroke: var(--sl-color-red); stroke-width: 1.8; }
  svg.viz .warn { stroke: var(--sl-color-red); stroke-width: 2; fill: none; stroke-dasharray: 4 3; }
</style>
