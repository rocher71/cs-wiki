---
// OOM 진단 결정 트리: 증상 → 앱 로그에 OOM? → 있음(메시지로 영역 → heap이면 바닥선 추세) / 없음(OOMKilled 137) → 즉시 완화 → 근본 해결 → 재발 방지.
import Stepper from '../Stepper.astro';
const s1 = ['A'];
const s2 = [...s1, 'a1', 'B'];
const s3 = [...s2, 'br1', 'Cl'];
const s4 = [...s3, 'aD', 'D', 'aE', 'E'];
const s5 = [...s4, 'br2', 'Cr'];
const s6 = [...s5, 'F'];
const s7 = [...s6, 'aG', 'G'];
const s8 = [...s7, 'aH', 'H'];
const steps = [
  { caption: '증상: 응답이 점점 느려지고 CPU가 높고, 결국 죽고 재시작을 반복해요. 메모리 문제를 의심할 때예요.', show: [...s1, 'hlA'] },
  { caption: '첫 갈림길: 앱 로그에 OutOfMemoryError가 있나요? "누가 죽였나"(JVM인지 컨테이너인지)를 먼저 갈라요.', show: [...s2, 'hlB'] },
  { caption: '있음 → JVM이 던진 거예요. 메시지 뒷부분으로 어느 영역이 찼는지 구분해요. Java heap space면 힙이에요.', show: [...s3, 'hlCl'] },
  { caption: 'heap이면 GC 후 바닥선을 봐요. 계속 오르면 누수(히스토그램 여러 번 비교 → 힙 덤프 → GC Root 경로), 일정하면 용량 부족이나 순간 대량 로딩이에요.', show: [...s4, 'hlD'] },
  { caption: '없음 + kubectl describe에 OOMKilled·Exit 137 → 컨테이너 한도를 넘어 커널이 죽인 거예요. 힙 덤프가 안 남아요. 힙 밖 메모리나 Xmx 과대를 봐요.', show: [...s5, 'hlCr'] },
  { caption: '즉시 완화: 재시작 전에 덤프부터 확보하고, 그 인스턴스를 교체하거나 롤백해서 서비스를 살려요.', show: [...s6, 'hlF'] },
  { caption: '근본 해결: 붙잡고 있던 참조를 끊어요. 크기 제한 캐시, ThreadLocal remove, 크기 제한 큐, 대량 조회는 페이징.', show: [...s7, 'hlG'] },
  { caption: '재발 방지: 힙 사용률·GC 시간에 알림을 걸고, 덤프 옵션은 평소에 켜 둬요.', show: [...s8, 'hlH'] },
];
---
<Stepper title="OOM 진단 순서" steps={steps}>
  <svg class="viz" viewBox="0 0 320 560" role="img" aria-label="OOM 진단 결정 트리. 증상에서 앱 로그에 OutOfMemoryError가 있는지 보고, 있으면 메시지로 영역을 구분해 heap이면 바닥선 추세로 누수와 용량 부족을 가른다. 없고 OOMKilled 137이면 컨테이너 한도 초과다. 이후 즉시 완화, 근본 해결, 재발 방지 순서.">
    <defs>
      <marker id="odf-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
    </defs>
    <g data-id="A">
      <rect class="box" x="8" y="6" width="304" height="40" rx="7" />
      <text x="160" y="26">응답 지연 · CPU 높음 · 재시작 반복</text>
    </g>
    <line data-id="a1" class="line" x1="160" y1="46" x2="160" y2="58" marker-end="url(#odf-arr)" />
    <g data-id="B">
      <rect class="chip" x="8" y="60" width="304" height="40" rx="7" />
      <text x="160" y="80">앱 로그에 <tspan class="mono">OutOfMemoryError</tspan>?</text>
    </g>
    <g data-id="br1">
      <line class="line" x1="82" y1="100" x2="82" y2="126" marker-end="url(#odf-arr)" />
      <text class="hi l" x="90" y="114">있음</text>
    </g>
    <g data-id="Cl">
      <rect class="box" x="8" y="128" width="148" height="86" rx="7" />
      <text x="82" y="146">메시지로 영역</text>
      <text class="sub" x="82" y="166"><tspan class="hi">heap</tspan> · Metaspace</text>
      <text class="sub" x="82" y="184">Direct buffer</text>
      <text class="sub" x="82" y="202">native thread</text>
    </g>
    <g data-id="br2">
      <line class="line" x1="238" y1="100" x2="238" y2="126" marker-end="url(#odf-arr)" />
      <text class="err-t l" x="246" y="114">없음</text>
    </g>
    <g data-id="Cr">
      <rect class="err" x="164" y="128" width="148" height="86" rx="7" />
      <text class="mono" x="238" y="146">OOMKilled · 137</text>
      <text class="sub" x="238" y="166">컨테이너 한도 초과</text>
      <text class="sub" x="238" y="184">힙 밖 메모리</text>
      <text class="sub" x="238" y="202">Xmx 과대</text>
    </g>
    <line data-id="aD" class="line" x1="82" y1="214" x2="82" y2="234" marker-end="url(#odf-arr)" />
    <g data-id="D">
      <rect class="box" x="8" y="236" width="148" height="40" rx="7" />
      <text x="82" y="256">heap: 바닥선은?</text>
    </g>
    <g data-id="aE">
      <line class="line" x1="50" y1="276" x2="50" y2="300" marker-end="url(#odf-arr)" />
      <text class="sub l" x="56" y="288">오름</text>
      <line class="line" x1="114" y1="276" x2="200" y2="300" marker-end="url(#odf-arr)" />
      <text class="sub l" x="160" y="276">일정</text>
    </g>
    <g data-id="E">
      <rect class="box" x="8" y="302" width="148" height="70" rx="7" />
      <text class="err-t" x="82" y="320">누수</text>
      <text class="sub" x="82" y="340">히스토그램 여러 번</text>
      <text class="sub" x="82" y="358">→ 힙 덤프 → GC Root</text>
      <rect class="box" x="164" y="302" width="148" height="70" rx="7" />
      <text x="238" y="320">용량 부족</text>
      <text class="sub" x="238" y="340">순간 대량 로딩</text>
      <text class="sub" x="238" y="358">(바닥선은 일정)</text>
    </g>
    <g data-id="F">
      <text class="sub" x="160" y="390">원인을 찾았으면 (모든 경우)</text>
      <rect class="box" x="8" y="402" width="304" height="42" rx="7" />
      <circle class="badge" cx="28" cy="423" r="11" /><text class="on-badge" x="28" y="424">1</text>
      <text class="l" x="46" y="414" style="font-weight:700">즉시 완화</text>
      <text class="sub l" x="46" y="433">덤프 먼저 확보 → 교체·롤백</text>
    </g>
    <line data-id="aG" class="line" x1="160" y1="444" x2="160" y2="454" marker-end="url(#odf-arr)" />
    <g data-id="G">
      <rect class="box" x="8" y="456" width="304" height="42" rx="7" />
      <circle class="badge" cx="28" cy="477" r="11" /><text class="on-badge" x="28" y="478">2</text>
      <text class="l" x="46" y="468" style="font-weight:700">근본 해결</text>
      <text class="sub l" x="46" y="487">크기 제한 캐시·큐, remove, 페이징</text>
    </g>
    <line data-id="aH" class="line" x1="160" y1="498" x2="160" y2="508" marker-end="url(#odf-arr)" />
    <g data-id="H">
      <rect class="box" x="8" y="510" width="304" height="42" rx="7" />
      <circle class="badge" cx="28" cy="531" r="11" /><text class="on-badge" x="28" y="532">3</text>
      <text class="l" x="46" y="522" style="font-weight:700">재발 방지</text>
      <text class="sub l" x="46" y="541">힙·GC 시간 알림, 덤프 옵션 상시</text>
    </g>
    <rect data-id="hlA" class="hl" x="4" y="2" width="312" height="48" rx="9" />
    <rect data-id="hlB" class="hl" x="4" y="56" width="312" height="48" rx="9" />
    <rect data-id="hlCl" class="hl" x="4" y="124" width="156" height="94" rx="9" />
    <rect data-id="hlCr" class="hl" x="160" y="124" width="156" height="94" rx="9" />
    <rect data-id="hlD" class="hl" x="4" y="232" width="312" height="144" rx="9" />
    <rect data-id="hlF" class="hl" x="4" y="398" width="312" height="50" rx="9" />
    <rect data-id="hlG" class="hl" x="4" y="452" width="312" height="50" rx="9" />
    <rect data-id="hlH" class="hl" x="4" y="506" width="312" height="50" rx="9" />
  </svg>
</Stepper>
