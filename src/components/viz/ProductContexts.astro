---
// 거대한 Product 하나 → 카탈로그·주문·배송 컨텍스트가 필요한 칸만 각자 가져가고, 상품ID로만 연결된다.
import Stepper from '../Stepper.astro';
const steps = [
  { caption: 'Product 클래스 하나에 모든 팀이 쓰는 칸이 다 붙어 있어요. 칸 하나를 바꾸면 이 클래스를 쓰는 모든 팀이 영향을 받아요.', show: ['p'] },
  { caption: '카탈로그(상품 진열)는 이름·설명·이미지·판매가만 있으면 돼요. 이 칸들만 자기 Product로 가져가요.', show: ['p', 'h-cat', 'c-cat'] },
  { caption: '주문은 "상품ID·주문 당시 가격·수량"만 OrderLine(주문 항목)으로 가져가요. 나중에 판매가가 바뀌어도 주문서 가격은 그대로예요.', show: ['p', 'h-ord', 'c-cat', 'c-ord'] },
  { caption: '배송은 무게·부피·송장번호에 배송 주소를 더해 Parcel(소포)로 가져가요. 같은 "상품"인데 팀마다 보는 칸이 달라요.', show: ['p', 'h-del', 'c-cat', 'c-ord', 'c-del'] },
  { caption: '이제 거대한 Product는 필요 없어요. 세 컨텍스트는 상품ID 하나로만 이어지고, 각자 자기 DB를 가져요(재고는 재고 서비스 몫).', show: ['c-cat', 'c-ord', 'c-del', 'link'] },
];
const left = ['이름', '설명', '이미지', '판매가', '재고'];
const right = ['주문가격', '수량', '무게', '부피', '송장번호'];
const fy = (k: number) => 40 + k * 30;
const ctx = [
  { id: 'c-cat', y: 214, t: '카탈로그: Product', f: '이름·설명·이미지·판매가' },
  { id: 'c-ord', y: 306, t: '주문: OrderLine', f: '상품ID·주문 당시 가격·수량' },
  { id: 'c-del', y: 398, t: '배송: Parcel', f: '무게·부피·주소·송장번호' },
];
---
<Stepper title="같은 '상품', 컨텍스트마다 다른 모델" steps={steps}>
  <svg class="viz" viewBox="0 0 320 488" role="img" aria-label="모든 칸이 붙은 거대한 Product 클래스를 카탈로그(이름·설명·이미지·판매가), 주문(상품ID·주문 당시 가격·수량), 배송(무게·부피·주소·송장번호) 컨텍스트가 필요한 칸만 나눠 가지고, 셋은 상품ID로만 연결되며 각자 DB를 가진다">
    <g data-id="p">
      <rect class="frame" x="8" y="2" width="304" height="196" rx="8" style="stroke-dasharray:none" />
      <text x="160" y="20" style="font-weight:700">Product (하나에 다 몰아넣음)</text>
      {left.map((f, k) => (<g><rect class="box" x="18" y={fy(k)} width="136" height="26" rx="4" /><text x="86" y={fy(k) + 13}>{f}</text></g>))}
      {right.map((f, k) => (<g><rect class="box" x="166" y={fy(k)} width="136" height="26" rx="4" /><text x="234" y={fy(k) + 13}>{f}</text></g>))}
    </g>
    <rect data-id="h-cat" class="hl" x="14" y={fy(0) - 4} width="144" height="124" rx="6" />
    <rect data-id="h-ord" class="hl" x="162" y={fy(0) - 4} width="144" height="64" rx="6" />
    <rect data-id="h-del" class="hl" x="162" y={fy(2) - 4} width="144" height="94" rx="6" />

    {ctx.map((c) => (
      <g data-id={c.id}>
        <rect class="box" x="8" y={c.y} width="304" height="80" rx="8" />
        <text class="l" x="20" y={c.y + 22} style="font-weight:700">{c.t}</text>
        <text class="l sub" x="20" y={c.y + 54}>{c.f}</text>
      </g>
    ))}
    <g data-id="link" class="hide">
      <line class="line" x1="226" y1="246" x2="226" y2="408" style="stroke-dasharray:4 3" />
      {ctx.map((c) => (
        <g>
          <rect class="badge" x="190" y={c.y + 10} width="72" height="24" rx="12" />
          <text class="on-badge" x="226" y={c.y + 22}>상품ID</text>
          <rect class="chip" x="270" y={c.y + 10} width="36" height="24" rx="4" />
          <text style="font-size:14px" x="288" y={c.y + 22}>DB</text>
        </g>
      ))}
    </g>
  </svg>
</Stepper>
