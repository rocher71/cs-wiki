---
// maxmemory 초과 시 흐름: 쓰기 → 상한 확인 → noeviction이면 OOM / 아니면 5개 샘플 후 가장 나쁜 키 삭제 반복.
import Stepper from '../Stepper.astro';
const keys = [['k1', '12초'], ['k2', '3초'], ['k3', '95초'], ['k4', '40초'], ['k5', '7초']];
const KX = (i: number) => 16 + i * 58;
const notes = ['쓰기가 들어왔어요', '여유 있으면 그냥 실행', 'noeviction이면 쓰기 거절', '5개 중 제일 오래 안 쓴 키 삭제', '상한 아래로 내려가면 실행', 'TTL 키가 없으면 지울 게 없음'];
const base = ['w', 'q1', 'q2'];
const steps = [
  { caption: '클라이언트가 SET 같은 쓰기 명령을 보내요. Redis는 실행하기 전에 메모리부터 확인해요.', show: ['w', 'n1'] },
  { caption: '사용 중인 메모리가 maxmemory보다 작으면 아무것도 지우지 않고 그대로 실행해요. (maxmemory 기본값 0은 "상한 없음"이에요.)', show: ['w', 'q1', 'no', 'hl-no', 'n2'] },
  { caption: '상한을 넘었는데 정책이 기본값인 noeviction이면, 키를 지우지 않고 쓰기에 OOM 에러를 돌려줘요. GET 같은 읽기는 계속 잘 돼요.', show: [...base, 'oom', 'hl-oom', 'n3'] },
  { caption: '다른 정책이면 후보 키 5개(maxmemory-samples 기본값)를 무작위로 뽑아요. LRU 기준이면 그중 가장 오래 안 쓴 k3(95초)을 지워요. 전체에서 가장 오래된 키가 뽑히지 않을 수도 있어서 "근사" LRU예요.', show: [...base, 'sample', 'cells', 'worst', 'hl-sample', 'n4'] },
  { caption: '하나 지운 뒤 메모리를 다시 재요. 아직 넘으면 샘플→삭제를 반복하고, 상한 아래로 내려가면 그제야 쓰기를 실행해요.', show: [...base, 'sample', 'cells', 'worst', 'loop', 'done', 'hl-done', 'n5'] },
  { caption: '함정: volatile-lru 같은 volatile-* 정책은 TTL이 붙은 키 중에서만 고르기 때문에, TTL 키가 하나도 없으면 지울 후보가 없어 noeviction처럼 OOM 에러가 나요.', show: [...base, 'oom', 'vol', 'hl-oom', 'n6'] },
];
---
<Stepper title="maxmemory에 닿았을 때" steps={steps}>
  <svg class="viz" viewBox="0 0 320 394" role="img" aria-label="쓰기 명령이 오면 메모리가 maxmemory를 넘는지 확인한다. 넘지 않으면 실행, 넘고 noeviction이면 OOM 에러, 그 외 정책이면 키 5개를 샘플링해 가장 오래 안 쓴 키를 지우고 상한 아래가 될 때까지 반복한 뒤 실행한다. volatile 정책인데 TTL 키가 없으면 OOM 에러">
    <defs>
      <marker id="mm-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0,0 L10,5 L0,10 z" style="fill:var(--sl-color-gray-3)" />
      </marker>
    </defs>
    <g data-id="w">
      <rect class="box" x="10" y="8" width="300" height="36" rx="6" />
      <text x="160" y="26" style="font-weight:700">클라이언트 → SET (쓰기)</text>
    </g>
    <line class="line" x1="105" y1="45" x2="105" y2="58" marker-end="url(#mm-arrow)" />

    <g data-id="q1">
      <rect class="box" x="10" y="60" width="190" height="40" rx="6" />
      <text x="105" y="80">메모리 &gt; maxmemory?</text>
      <line class="line" x1="105" y1="101" x2="105" y2="128" marker-end="url(#mm-arrow)" />
      <text class="sub l" x="114" y="114">예</text>
    </g>
    <g data-id="no" class="hide">
      <line class="line" x1="201" y1="80" x2="212" y2="80" marker-end="url(#mm-arrow)" />
      <rect class="chip" x="214" y="60" width="96" height="40" rx="6" />
      <text x="262" y="72">아니오:</text>
      <text x="262" y="90">바로 실행</text>
    </g>
    <rect data-id="hl-no" class="hl" x="211" y="57" width="102" height="46" rx="8" />

    <g data-id="q2">
      <rect class="box" x="10" y="130" width="190" height="40" rx="6" />
      <text x="105" y="150">정책 = noeviction?</text>
      <line class="line" x1="105" y1="171" x2="105" y2="198" marker-end="url(#mm-arrow)" />
      <text class="sub l" x="114" y="184">아니오</text>
    </g>
    <g data-id="oom" class="hide">
      <line class="line" x1="201" y1="150" x2="212" y2="150" marker-end="url(#mm-arrow)" />
      <rect class="err" x="214" y="130" width="96" height="40" rx="6" />
      <text class="err-t" x="262" y="142">OOM 에러</text>
      <text class="sub" x="262" y="160">읽기는 OK</text>
    </g>
    <rect data-id="hl-oom" class="hl" x="211" y="127" width="102" height="46" rx="8" />

    <g data-id="sample">
      <rect class="frame" x="10" y="200" width="300" height="88" rx="8" />
      <text class="l" x="20" y="216" style="font-weight:700">후보 5개 샘플 (LRU 기준)</text>
    </g>
    <g data-id="cells">
      {keys.map(([k, idle], i) => (
        <g>
          <rect class="box" x={KX(i)} y="230" width="52" height="48" rx="5" />
          <text class="mono" x={KX(i) + 26} y="245">{k}</text>
          <text class="sub" x={KX(i) + 26} y="265">{idle}</text>
        </g>
      ))}
    </g>
    <g data-id="worst" class="hide">
      <rect class="err" x={KX(2)} y="230" width="52" height="48" rx="5" />
      <text class="mono" x={KX(2) + 26} y="245">k3</text>
      <text class="err-t" x={KX(2) + 26} y="265">삭제</text>
    </g>
    <rect data-id="hl-sample" class="hl" x="7" y="197" width="306" height="94" rx="10" />
    <g data-id="vol" class="hide">
      <rect class="box" x="10" y="200" width="300" height="88" rx="8" />
      <text x="160" y="230">volatile-* 인데 TTL 키 0개</text>
      <text class="err-t" x="160" y="258">후보 없음 → OOM 에러</text>
    </g>

    <text data-id="loop" class="sub hide" x="160" y="304">↻ 다시 재서 아직 넘으면 반복</text>
    <g data-id="done" class="hide">
      <rect class="chip" x="10" y="318" width="300" height="36" rx="6" />
      <text x="160" y="336">상한 아래로 → 쓰기 실행</text>
    </g>
    <rect data-id="hl-done" class="hl" x="7" y="315" width="306" height="42" rx="8" />

    {notes.map((t, i) => <text data-id={`n${i + 1}`} class="hi hide" x="160" y="378">{t}</text>)}
  </svg>
</Stepper>
