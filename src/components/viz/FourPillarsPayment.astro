---
// 결제 예시 하나로 4대 특징: 추상화(공통 pay 뽑기) → 캡슐화(Card 내부 숨김) → 구현(위로 화살표) → 다형성(꽂는 객체만 바꿈)
import Stepper from '../Stepper.astro';
const steps = [
  { caption: '추상화: 카드·토스·계좌이체는 속사정이 다르지만 "금액만큼 결제한다"는 공통점이 있어요. 이 핵심만 뽑아 Payment라는 약속(인터페이스)으로 정해요.', show: ['abs'] },
  { caption: '캡슐화: Card 객체는 한도와 카드번호를 안에 숨겨요. 바깥 코드는 pay() 버튼만 누르고, 한도 검사는 Card가 스스로 해요.', show: ['enc'] },
  { caption: '상속·구현: Card와 Toss가 Payment 약속을 구현해요. "나도 Payment처럼 pay()를 할 수 있다"는 뜻이라 화살표가 위(Payment)로 향해요.', show: ['inh'] },
  { caption: '다형성: Payment p 칸에 Card를 넣고 p.pay()를 부르면 카드 결제가 돼요.', show: ['poly', 'pCard'] },
  { caption: '호출 코드 p.pay()는 그대로인데, Toss를 넣으면 토스 결제가 돼요. 결제 수단이 늘어도 호출하는 쪽은 안 고쳐요.', show: ['poly', 'pToss'] },
];
---
<Stepper title="결제로 보는 객체지향 4대 특징" steps={steps}>
  <svg class="viz" viewBox="0 0 320 300" role="img" aria-label="카드·토스·계좌이체에서 공통 pay만 뽑은 Payment 인터페이스(추상화), 한도와 카드번호를 숨긴 Card 객체(캡슐화), Card와 Toss가 Payment를 구현(상속·구현), Payment p에 넣는 객체에 따라 같은 p.pay()가 카드 결제 또는 토스 결제가 되는 그림(다형성)">
    <defs>
      <marker id="fpp-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
      <marker id="fpp-tri" viewBox="0 0 12 12" refX="11" refY="6" markerWidth="9" markerHeight="9" orient="auto">
        <path d="M0 0L12 6L0 12z" fill="var(--sl-color-bg)" stroke="var(--sl-color-gray-3)" stroke-width="1.4" />
      </marker>
    </defs>

    <!-- 1. 추상화 -->
    <g data-id="abs" class="hide">
      <rect class="box" x="8" y="16" width="96" height="64" rx="8" />
      <text x="56" y="38" style="font-weight:700">카드</text>
      <text class="sub" x="56" y="62">카드번호</text>
      <rect class="box" x="112" y="16" width="96" height="64" rx="8" />
      <text x="160" y="38" style="font-weight:700">토스</text>
      <text class="sub" x="160" y="62">토스 계정</text>
      <rect class="box" x="216" y="16" width="96" height="64" rx="8" />
      <text x="264" y="38" style="font-weight:700">계좌이체</text>
      <text class="sub" x="264" y="62">계좌번호</text>
      <line class="line" x1="56" y1="82" x2="112" y2="146" marker-end="url(#fpp-arr)" />
      <line class="line" x1="160" y1="82" x2="160" y2="146" marker-end="url(#fpp-arr)" />
      <line class="line" x1="264" y1="82" x2="208" y2="146" marker-end="url(#fpp-arr)" />
      <rect class="chip" x="60" y="150" width="200" height="60" rx="8" />
      <text x="160" y="168" style="font-size:14px">«interface» Payment</text>
      <text class="mono hi" x="160" y="192">pay(금액)</text>
      <text class="sub" x="160" y="236">차이는 빼고 공통만 남김</text>
    </g>

    <!-- 2. 캡슐화 -->
    <g data-id="enc" class="hide">
      <rect class="box" x="40" y="16" width="240" height="150" rx="12" />
      <text x="160" y="38" style="font-weight:700">Card 객체</text>
      <g transform="translate(84 62)">
        <path d="M3 7V4a4 4 0 0 1 8 0v3" fill="none" stroke="var(--sl-color-accent-high)" stroke-width="2" />
        <rect x="0" y="7" width="14" height="10" rx="2" fill="var(--sl-color-accent-high)" />
      </g>
      <text class="l" x="106" y="72">한도: 300만 원</text>
      <g transform="translate(84 92)">
        <path d="M3 7V4a4 4 0 0 1 8 0v3" fill="none" stroke="var(--sl-color-accent-high)" stroke-width="2" />
        <rect x="0" y="7" width="14" height="10" rx="2" fill="var(--sl-color-accent-high)" />
      </g>
      <text class="l" x="106" y="102">카드번호: ****</text>
      <text class="sub" x="160" y="130">비공개(private)</text>
      <rect class="chip" x="110" y="148" width="100" height="40" rx="20" />
      <text class="mono hi" x="160" y="168">pay()</text>
      <rect class="frame" x="90" y="244" width="140" height="40" rx="8" />
      <text x="160" y="264">주문 코드</text>
      <line class="line" x1="160" y1="242" x2="160" y2="192" marker-end="url(#fpp-arr)" />
      <text class="sub l" x="170" y="216">공개된 버튼만</text>
    </g>

    <!-- 3. 상속·구현 -->
    <g data-id="inh" class="hide">
      <rect class="chip" x="80" y="20" width="160" height="56" rx="8" />
      <text x="160" y="38" style="font-size:14px">«interface»</text>
      <text x="160" y="58" style="font-weight:700">Payment</text>
      <rect class="box" x="16" y="180" width="120" height="44" rx="8" />
      <text x="76" y="202" style="font-weight:700">Card</text>
      <rect class="box" x="184" y="180" width="120" height="44" rx="8" />
      <text x="244" y="202" style="font-weight:700">Toss</text>
      <line class="line" x1="76" y1="178" x2="136" y2="80" stroke-dasharray="5 4" marker-end="url(#fpp-tri)" />
      <line class="line" x1="244" y1="178" x2="184" y2="80" stroke-dasharray="5 4" marker-end="url(#fpp-tri)" />
      <text class="sub" x="160" y="164">구현(implements)</text>
      <text class="sub" x="76" y="246">카드 방식 pay()</text>
      <text class="sub" x="244" y="246">토스 방식 pay()</text>
    </g>

    <!-- 4. 다형성 -->
    <g data-id="poly" class="hide">
      <rect class="box" x="60" y="16" width="200" height="44" rx="8" />
      <text class="mono hi" x="160" y="38">p.pay(10000)</text>
      <text class="sub" x="160" y="76">호출 코드 (그대로)</text>
      <line class="line" x1="160" y1="88" x2="160" y2="104" marker-end="url(#fpp-arr)" />
      <rect class="frame" x="60" y="106" width="200" height="80" rx="10" />
      <text class="sub" x="160" y="122">Payment p 칸</text>
      <line class="line" x1="160" y1="188" x2="160" y2="216" marker-end="url(#fpp-arr)" />
    </g>
    <g data-id="pCard" class="hide">
      <rect class="chip" x="95" y="136" width="130" height="40" rx="8" />
      <text x="160" y="156" style="font-weight:700">Card</text>
      <rect class="box" x="70" y="220" width="180" height="44" rx="8" />
      <text x="160" y="242">결과: 카드 결제</text>
    </g>
    <g data-id="pToss" class="hide">
      <rect class="chip" x="95" y="136" width="130" height="40" rx="8" />
      <text x="160" y="156" style="font-weight:700">Toss</text>
      <rect class="box" x="70" y="220" width="180" height="44" rx="8" />
      <text x="160" y="242">결과: 토스 결제</text>
    </g>
  </svg>
</Stepper>
