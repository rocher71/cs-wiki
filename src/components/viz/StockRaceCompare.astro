---
// 재고 100에 동시 요청 1,000개: DECR만 쓰면 판매는 100건이지만 재고 값이 -900, Lua는 0에서 멈춤.
// 레인마다 같은 자리에 번갈아 나오는 상태(d0/d1, l0/l1)와 강조는 class="hide".
import Stepper from '../Stepper.astro';

const steps = [
  { caption: '출발점: 재고 100개에 요청 1,000개가 동시에 몰려요. 위는 DECR만 쓰는 방식, 아래는 Lua 스크립트 방식이에요.', show: ['d0', 'l0'] },
  { caption: 'DECR만: 빼고 나온 값이 0 이상인 100건만 성공이에요. 하지만 실패한 900건도 DECR을 실행했으니 값이 계속 깎여 -900까지 내려가요.', show: ['d1', 'l0', 'hlD'] },
  { caption: 'Lua: “재고가 0보다 크면 DECR, 아니면 -1”을 한 덩어리로 실행해요. 100건 성공 후엔 아예 안 깎으니 재고가 0에서 멈춰요.', show: ['d1', 'l1', 'hlL'] },
  { caption: '비교: 둘 다 100건만 팔아 초과 판매는 0이에요. 차이는 남은 재고 숫자를 믿을 수 있느냐예요. -900이면 화면 표시도, 취소분 되돌리기도 틀어져요.', show: ['d1', 'l1', 'v'] },
];
// 수직선: x(v) = 273 + 0.27v  →  -900: 30, 0: 273, 100: 300
const X = (v: number) => 273 + 0.27 * v;
const lanes = [
  { y: 50, name: '① DECR만', id: 'd', after: { val: '-900', cls: 'err-t', bar: 'err', tally: '성공 100 · 실패 900도 1씩 깎음' } },
  { y: 166, name: '② Lua 스크립트', id: 'l', after: { val: '0', cls: 'hi', bar: '', tally: '성공 100 · 실패 900은 -1 반환, 안 깎음' } },
];
---
<Stepper title="재고 100, 요청 1,000: DECR만 vs Lua" steps={steps}>
  <svg class="viz" viewBox="0 0 320 340" role="img" aria-label="재고 100개에 요청 1,000개. DECR만 쓰면 100건 성공하지만 재고 값이 -900까지 내려가고, Lua 스크립트는 100건 성공 후 재고 0에서 멈춘다. 둘 다 초과 판매는 0이다.">
    <rect class="box" x="6" y="4" width="308" height="34" rx="8" />
    <text x="160" y="21" style="font-weight:700">재고 100개 ← 동시 요청 1,000개</text>

    {lanes.map((ln) => <>
      <rect class="frame" x="6" y={ln.y} width="308" height="106" rx="8" />
      <text class="l" x="16" y={ln.y + 16} style="font-weight:700">{ln.name}</text>
      <!-- 수직선 -->
      <path class="line" d={`M${X(-900)} ${ln.y + 58} H${X(100)}`} />
      {[-900, 0, 100].map((v) => <><path class="line" d={`M${X(v)} ${ln.y + 52} V${ln.y + 64}`} /><text class="sub" x={X(v) + (v === 100 ? -2 : v === -900 ? 6 : 0)} y={ln.y + 76}>{v}</text></>)}

      <g data-id={`${ln.id}0`} class="hide">
        <text class="l" x="16" y={ln.y + 38}>재고 값 <tspan style="font-weight:700">100</tspan></text>
        <rect class="chip" x={X(0)} y={ln.y + 51} width={X(100) - X(0)} height="14" />
        <text class="sub" x="160" y={ln.y + 94}>요청 1,000개 대기 중</text>
      </g>
      <g data-id={`${ln.id}1`} class="hide">
        <text class="l" x="16" y={ln.y + 38}>재고 값 <tspan class={ln.after.cls}>{ln.after.val}</tspan></text>
        {ln.after.bar && <rect class={ln.after.bar} x={X(-900)} y={ln.y + 51} width={X(0) - X(-900)} height="14" />}
        {ln.after.bar && <text class="err-t" x="150" y={ln.y + 38}>음수로 내려감</text>}
        {!ln.after.bar && <><path class="badge" d={`M${X(0)} ${ln.y + 46} l-6 -10 h12 z`} /><text class="hi" x="200" y={ln.y + 38}>0에서 멈춤</text></>}
        <text class="sub" x="160" y={ln.y + 94}>{ln.after.tally}</text>
      </g>
    </>)}
    <rect data-id="hlD" class="hl" x="3" y="47" width="314" height="112" rx="10" />
    <rect data-id="hlL" class="hl" x="3" y="163" width="314" height="112" rx="10" />

    <g data-id="v" class="hide">
      <rect class="chip" x="6" y="282" width="308" height="54" rx="8" />
      <text x="160" y="298">초과 판매: 둘 다 <tspan style="font-weight:700">0건</tspan></text>
      <text x="160" y="322">재고 값: <tspan class="err-t">-900 (틀림)</tspan> vs <tspan class="hi">0 (정확)</tspan></text>
    </g>
  </svg>
</Stepper>
