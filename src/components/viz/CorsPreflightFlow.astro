---
// 단순 요청 vs preflight: 브라우저·서버 두 세로줄, 가운데 화살표 타임라인, 아래 패널에 그 단계 헤더 원문.
import Stepper from '../Stepper.astro';
const B = 78, S = 242, M = 160;
const O = 'https://app.example.com';
// 타임라인 화살표 (단순 s*, preflight p*). 같은 자리를 쓰므로 hide.
const arrows = [
  { id: 'sReq', y: 116, to: S, t: 'GET /items' },
  { id: 'sRes', y: 160, to: B, t: '200 OK + 허가 헤더' },
  { id: 'pOpt', y: 116, to: S, t: 'OPTIONS (먼저 물어보기)' },
  { id: 'p204', y: 154, to: B, t: '204 + 허락 목록' },
  { id: 'pPut', y: 192, to: S, t: 'PUT /items/1 (진짜 요청)' },
  { id: 'p200', y: 230, to: B, t: '200 OK + 허가 헤더' },
];
// 패널: [제목, 줄들]. 줄 앞 '>'는 강조, '~'는 한글 보조줄, 나머지는 헤더 원문(모노).
const panels: [string, string[]][] = [
  ['브라우저 → 서버', ['GET /items', `Origin: ${O}`, '~미리 묻지 않고 바로 보내요']],
  ['서버 → 브라우저', ['200 OK', 'Access-Control-Allow-Origin:', `>  ${O}`, '~서버는 이미 처리를 끝낸 상태']],
  ['브라우저 검사', ['~Allow-Origin == 내 Origin ?', '>일치 → JS가 응답을 읽어요']],
  ['브라우저 → 서버 (preflight)', ['OPTIONS /items/1', `Origin: ${O}`, '>Access-Control-Request-Method: PUT', 'Access-Control-Request-Headers:', '>  authorization, content-type', '~쿠키·인증 값은 싣지 않아요']],
  ['서버 → 브라우저', ['204 No Content', 'Access-Control-Allow-Origin:', '>  ' + O, '>Access-Control-Allow-Methods: PUT', 'Access-Control-Allow-Headers:', '>  authorization, content-type', '>Access-Control-Max-Age: 600']],
  ['브라우저 검사', ['~출처·PUT·헤더가 모두 허락됐나?', '>모두 O → 진짜 요청을 보내요', '~하나라도 X → 여기서 끝', '~(PUT은 서버에 아예 안 가요)']],
  ['진짜 요청과 응답', ['PUT /items/1', `Origin: ${O}`, 'Authorization: Bearer …', '~응답의 Allow-Origin도 다시 확인', '>일치 → JS가 응답을 읽어요']],
  ['Max-Age 캐시', ['~허락 결과를 600초 동안 기억해요', '>같은 요청이면 OPTIONS 생략', '~PUT을 바로 보내요']],
];
const timeline = [['sReq'], ['sReq', 'sRes'], ['sReq', 'sRes', 'sOk'], ['pOpt'], ['pOpt', 'p204'], ['pOpt', 'p204', 'pOk'], ['pOpt', 'p204', 'pOk', 'pPut', 'p200'], ['skip', 'pPut', 'p200']];
const captions = [
  '단순 요청(GET): JS가 fetch하면 브라우저가 Origin 헤더만 붙여 바로 보내요. 미리 묻는 단계가 없어요.',
  '서버는 요청을 처리하고, 응답에 Access-Control-Allow-Origin으로 "이 출처는 읽어도 돼"를 적어 보내요.',
  '브라우저가 Allow-Origin과 페이지 출처를 비교해요. 일치하면 JS에 응답을 넘겨요. 단순 요청은 여기까지예요.',
  'Preflight: PUT + JSON + Authorization처럼 단순하지 않은 요청이면, 브라우저가 먼저 OPTIONS로 "이렇게 보내도 돼?"라고 물어요.',
  '서버가 204로 허락 목록(출처, 메서드, 헤더, Max-Age)을 답해요.',
  '브라우저가 허락 목록을 확인해요. 하나라도 빠지면 여기서 끝나고 진짜 PUT은 서버에 가지 않아요.',
  '허락되면 진짜 PUT을 보내요. 응답의 Allow-Origin을 한 번 더 확인한 뒤 JS에 넘겨요.',
  'Max-Age(600초) 동안은 같은 요청에 OPTIONS를 생략하고 PUT을 바로 보내요.',
];
const steps = captions.map((caption, i) => ({ caption, show: [i < 3 ? 'modeS' : 'modeP', `d${i}`, ...timeline[i]] }));
const halo = 'paint-order:stroke;stroke:var(--sl-color-gray-7, var(--sl-color-black));stroke-width:5px;stroke-linejoin:round';
const PY = 262;
---
<Stepper title="단순 요청과 Preflight 요청" steps={steps}>
  <svg class="viz" viewBox="0 0 320 428" role="img" aria-label="단순 요청은 바로 보내고 응답의 Allow-Origin을 확인하며, preflight 요청은 OPTIONS로 먼저 허락을 받은 뒤 진짜 요청을 보내는 과정">
    <defs>
      <marker id="cpf-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-2)" />
      </marker>
    </defs>
    {[[B, '브라우저', 'app.example.com'], [S, '서버', 'api.example.com']].map(([x, t, d]) => (
      <g>
        <rect class="box" x={+x - 72} y="4" width="144" height="44" rx="8" />
        <text x={x} y="18" style="font-weight:700">{t}</text>
        <text class="sub" x={x} y="37">{d}</text>
        <line class="line" x1={x} y1="96" x2={x} y2="246" style="stroke-dasharray:4 4" />
      </g>
    ))}
    <g data-id="modeS" class="hide">
      <rect class="chip" x="10" y="58" width="300" height="30" rx="15" />
      <text x={M} y="73" style="font-size:14px">A. 단순 요청 (GET)</text>
    </g>
    <g data-id="modeP" class="hide">
      <rect class="chip" x="10" y="58" width="300" height="30" rx="15" />
      <text x={M} y="73" style="font-size:14px">B. Preflight (PUT + JSON + 인증)</text>
    </g>
    {arrows.map((a) => {
      const from = a.to === S ? B : S;
      return (
        <g data-id={a.id} class="hide">
          <line x1={from} y1={a.y} x2={a.to + (a.to > from ? -2 : 2)} y2={a.y}
            style="stroke:var(--sl-color-gray-2);stroke-width:2.2" marker-end="url(#cpf-a)" />
          <text x={M} y={a.y - 11} style={`font-size:14px;font-weight:700;${halo}`}>{a.t}</text>
        </g>
      );
    })}
    <g data-id="sOk" class="hide">
      <text class="hi" x={B} y="192" style={halo}>✓ JS에 전달</text>
    </g>
    <g data-id="pOk" class="hide">
      <text class="hi" x={M} y="173" style={`font-size:14px;${halo}`}>✓ 허락 확인</text>
    </g>
    <g data-id="skip" class="hide">
      <rect class="bad" x="86" y="98" width="148" height="62" rx="8" />
      <text x={M} y="118" style="font-size:14px">OPTIONS·204 생략</text>
      <text class="sub" x={M} y="140">(Max-Age 캐시)</text>
    </g>
    {panels.map(([title, lines], i) => (
      <g data-id={`d${i}`} class="hide">
        <rect class="box" x="10" y={PY - 10} width="300" height="172" rx="8" />
        <text class="l hi" x="20" y={PY + 6} style="font-size:14px">{title}</text>
        {lines.map((ln, k) => {
          const y = PY + 30 + k * 20;
          if (ln[0] === '~') return <text class="l sub" x="20" y={y}>{ln.slice(1)}</text>;
          if (ln[0] === '>') return <text class={`l hi ${/[가-힣]/.test(ln) ? '' : 'mono'}`} x="20" y={y}>{ln.slice(1)}</text>;
          return <text class="l mono" x="20" y={y}>{ln}</text>;
        })}
      </g>
    ))}
  </svg>
</Stepper>
