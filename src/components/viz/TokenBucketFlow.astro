---
// 토큰 버킷(용량 5, 초당 0.5개): 가득 → 5건 통과로 0개 → 6번째 429 → 2초 뒤 1개 → 1건 통과.
// 버킷 속 토큰 상태·시각·아래 패널은 같은 자리에 번갈아 나오므로 class="hide".
import Stepper from '../Stepper.astro';

const steps = [
  { caption: '버킷 용량은 5개, 지금 토큰 5개가 가득 차 있어요. 토큰은 초당 0.5개(2초에 1개)씩 채워져요.', show: ['tk5', 't0', 'p1'] },
  { caption: '요청 5건이 거의 동시에 왔어요. 한 건마다 토큰 1개씩 써서 5건 모두 통과하고, 토큰은 0개가 됐어요. 쌓아 둔 만큼은 몰려도 받아 줘요.', show: ['tk0', 't0', 'p2', 'hlB'] },
  { caption: '곧바로 6번째 요청이 왔지만 토큰이 없어요. 429 Too Many Requests로 거절하고, 토큰 1개가 차는 2초 뒤에 다시 오라고 Retry-After: 2를 붙여요.', show: ['tk0', 't0', 'p3'] },
  { caption: '2초가 지났어요. 2초 × 초당 0.5개 = 토큰 1개가 채워졌어요. 타이머로 넣는 게 아니라, 다음 요청이 올 때 흐른 시간만큼 계산해서 채워요.', show: ['tk1', 't2', 'p4', 'drip'] },
  { caption: '다음 요청 1건이 토큰 1개를 쓰고 통과했어요. 토큰은 다시 0개. 길게 보면 평균은 초당 0.5건으로 맞춰져요.', show: ['tk0', 't2', 'p5', 'hlB'] },
];
const CX = [0, 1, 2, 3, 4].map((i) => 60 + i * 50);
const tokens = (id: string, n: number) => ({ id, n });
const states = [tokens('tk5', 5), tokens('tk0', 0), tokens('tk1', 1)];
const cellX = [0, 1, 2, 3, 4].map((i) => 14 + i * 60);
---
<Stepper title="토큰 버킷: 용량 5, 초당 0.5개" steps={steps}>
  <svg class="viz" viewBox="0 0 320 330" role="img" aria-label="용량 5인 버킷에 토큰 5개가 가득하다. 요청 5건이 토큰을 모두 쓰고 통과하고, 6번째 요청은 토큰이 없어 429로 거절된다. 2초 뒤 토큰 1개가 차서 다음 요청 1건이 통과한다.">
    <text class="l" x="8" y="14" style="font-weight:700">용량 5 · 초당 0.5개 채움</text>
    <text data-id="t0" class="hi hide" x="312" y="44" style="text-anchor:end">t = 0초</text>
    <text data-id="t2" class="hi hide" x="312" y="44" style="text-anchor:end">t = 2초</text>

    <!-- 채우는 꼭지 -->
    <line class="line" x1="160" y1="32" x2="160" y2="70" />
    <path d="M154 64 L160 74 L166 64 Z" style="fill:var(--sl-color-gray-3)" />
    <text class="sub l" x="172" y="58">+0.5개/초</text>
    <g data-id="drip" class="hide">
      <circle class="badge" cx="128" cy="52" r="12" />
      <text class="on-badge" x="128" y="53">+1</text>
    </g>

    <!-- 버킷 -->
    <path class="line" d="M30 78 V148 Q30 160 42 160 H278 Q290 160 290 148 V78" style="stroke-width:2.4" />
    <rect data-id="hlB" class="hl hide" x="24" y="88" width="272" height="78" rx="10" />
    {CX.map((x) => <circle class="frame" cx={x} cy="120" r="17" />)}
    {states.map((s) => (
      <g data-id={s.id} class="hide">
        {CX.slice(0, s.n).map((x) => <circle class="badge" cx={x} cy="120" r="17" />)}
        <text x="160" y="184" style="font-weight:700">남은 토큰 {s.n} / 5</text>
      </g>
    ))}

    <!-- 아래 패널 (같은 자리, 번갈아) -->
    <g data-id="p1" class="hide">
      <rect class="box" x="6" y="204" width="308" height="118" rx="8" />
      <text x="160" y="236">요청 1건 = 토큰 1개</text>
      <text x="160" y="266">토큰 있으면 <tspan class="hi">통과</tspan></text>
      <text x="160" y="294">없으면 <tspan class="err-t">429 거절</tspan></text>
    </g>
    <g data-id="p2" class="hide">
      {cellX.map((x, i) => <>
        <rect class="chip" x={x} y="208" width="52" height="54" rx="6" />
        <text x={x + 26} y="226" style="font-weight:700">{i + 1}</text>
        <text class="sub" x={x + 26} y="248">통과</text>
      </>)}
      <text class="hi" x="160" y="296">5건 통과 · 토큰 5 → 0</text>
    </g>
    <g data-id="p3" class="hide">
      <rect class="err" x="124" y="208" width="72" height="54" rx="6" />
      <text x="160" y="226" style="font-weight:700">6</text>
      <text class="err-t" x="160" y="248">429</text>
      <text class="mono" x="160" y="286">Retry-After: 2</text>
      <text class="sub" x="160" y="310">토큰 1개 차는 데 2초</text>
    </g>
    <g data-id="p4" class="hide">
      <rect class="box" x="6" y="204" width="308" height="118" rx="8" />
      <text class="hi" x="160" y="240">2초 × 0.5개/초 = 1개</text>
      <text x="160" y="272">요청이 올 때</text>
      <text x="160" y="298">흐른 시간만큼 몰아서 채움</text>
    </g>
    <g data-id="p5" class="hide">
      <rect class="chip" x="124" y="208" width="72" height="54" rx="6" />
      <text x="160" y="226" style="font-weight:700">7</text>
      <text class="sub" x="160" y="248">통과</text>
      <text class="hi" x="160" y="296">토큰 1 → 0</text>
    </g>
  </svg>
</Stepper>
