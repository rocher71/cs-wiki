---
// Sentinel 3개가 마스터를 감시 → SDOWN → ODOWN(quorum 2) → 과반수로 리더 선출 → 오프셋 큰 레플리카 승격 → 재구성 → 클라이언트 재접속.
import Stepper from '../Stepper.astro';
const SX = [8, 114, 220]; // Sentinel x
const RX = [8, 200];      // 레플리카 x
// 단계별 상태 [문구, 종류]  종류: '' | hi | err
type S = [string, string];
const sen: S[][] = [
  [['PING 중', ''], ['PING 중', ''], ['PING 중', '']],
  [['SDOWN', 'hi'], ['PING 중', ''], ['PING 중', '']],
  [['SDOWN', ''], ['SDOWN', 'hi'], ['PING 중', '']],
  [['리더', 'hi'], ['1번에 투표', 'hi'], ['1번에 투표', 'hi']],
  [['리더', ''], ['감시 중', ''], ['감시 중', '']],
  [['리더', ''], ['감시 중', ''], ['감시 중', '']],
  [['R1 주소 안내', 'hi'], ['감시 중', ''], ['감시 중', '']],
];
const mst: S[] = [['마스터 · PONG', ''], ['응답 없음', 'err'], ['ODOWN', 'err'], ['ODOWN', 'err'], ['다운', 'err'], ['복구되면 강등', 'hi'], ['레플리카', 'hi']];
const r1: S[] = [['레플리카', ''], ['레플리카', ''], ['레플리카', ''], ['레플리카', ''], ['새 마스터', 'hi'], ['마스터', ''], ['마스터', '']];
const r2: S[] = [['레플리카', ''], ['레플리카', ''], ['레플리카', ''], ['레플리카', ''], ['레플리카', ''], ['R1을 복제', 'hi'], ['R1을 복제', '']];
const notes = [
  ['Sentinel 3개가 계속 PING', '마스터 M이 R1·R2로 복제 중'],
  ['Sentinel 1: "M이 죽은 것 같아"', '혼자 판단 = SDOWN(주관적 다운)'],
  ['2개 동의 = quorum 2 충족', 'ODOWN(객관적 다운) 확정'],
  ['과반수(3개 중 2개 이상) 투표', 'Sentinel 1이 장애 조치 리더'],
  ['오프셋 큰 R1에 REPLICAOF NO ONE', 'R1이 새 마스터로 승격'],
  ['R2는 R1을 복제하도록 변경', '옛 M은 돌아오면 레플리카로'],
  ['클라이언트: Sentinel에 주소 질의', '받은 주소(R1)로 다시 접속'],
];
const ring = [[], ['hS0'], ['hS1'], ['hS0'], ['hR0'], ['hR1', 'hM'], ['hC']];
const steps = [
  'Sentinel 3개가 주기적으로 마스터 M과 레플리카에 PING을 보내요. M은 R1·R2로 데이터를 비동기 복제하고 있어요.',
  'M이 정해진 시간(down-after-milliseconds) 동안 답이 없어요. Sentinel 1이 혼자 "죽은 것 같다"고 판단해요. 이게 SDOWN이에요.',
  'Sentinel 2도 SDOWN이라고 답해요. quorum(여기선 2)만큼 동의했으니 ODOWN, 즉 "여럿이 보기에 죽었음"이 확정돼요.',
  '장애 조치는 한 명만 해야 해요. 전체 Sentinel의 과반수(3개 중 2개 이상) 표를 받은 Sentinel 1이 리더가 돼요.',
  '리더는 복제 오프셋이 가장 큰(가장 최신인) R1을 골라 REPLICAOF NO ONE을 보내요. R1이 새 마스터가 돼요.',
  'R2는 이제 R1을 복제하도록 바꿔요. 옛 M이 나중에 살아나면 마스터로 돌아가지 않고 R1의 레플리카가 돼요.',
  '클라이언트는 주소를 외워 두지 않고 Sentinel에 "지금 마스터 어디야?"라고 물어요. 받은 R1 주소로 다시 접속해요.',
].map((caption, i) => ({
  caption,
  show: [
    `n${i}`, 'm-' + i, 'r0-' + i, 'r1-' + i, ...[0, 1, 2].map((s) => `s${s}-${i}`), ...ring[i],
    ...(i <= 3 ? ['ping', 'repM'] : []),
    ...(i >= 1 && i <= 4 ? ['mErr'] : []),
    ...(i >= 5 ? ['repR'] : []),
    ...(i === 6 ? ['back', 'cli'] : []),
  ],
}));
const cls = (k: string) => (k === 'hi' ? 'hi' : k === 'err' ? 'err-t' : 'sub');
---
<Stepper title="Sentinel 장애 조치" steps={steps}>
  <svg class="viz" viewBox="0 0 320 384" role="img" aria-label="Sentinel 3개가 마스터 M의 다운을 SDOWN, ODOWN으로 판단하고, 과반수로 뽑힌 리더가 오프셋이 큰 레플리카 R1을 새 마스터로 올린 뒤 R2와 옛 M을 R1에 붙이고, 클라이언트는 Sentinel에 물어 R1로 접속한다">
    <defs><marker id="sf-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" style="fill:var(--sl-color-gray-3)" /></marker></defs>

    <!-- Sentinel -->
    {SX.map((x, i) => (
      <g>
        <rect class="box" x={x} y="4" width="92" height="52" rx="6" />
        <text x={x + 46} y="20" style="font-weight:700">Sentinel {i + 1}</text>
        <rect data-id={`hS${i}`} class="hl" x={x - 3} y="1" width="98" height="58" rx="8" />
      </g>
    ))}
    {sen.map((row, i) => row.map(([t, k], s) => (
      <text data-id={`s${s}-${i}`} class={`${cls(k)} hide`} x={SX[s] + 46} y="41" style="font-size:14px">{t}</text>
    )))}

    <g data-id="ping" class="hide">
      {[54, 160, 266].map((x, i) => (
        <line x1={x} y1="56" x2={[130, 160, 190][i]} y2="98" style="stroke:var(--sl-color-gray-3);stroke-width:1.4;stroke-dasharray:4 4" />
      ))}
      <text class="sub" x="252" y="80" style="text-anchor:start">PING</text>
    </g>

    <!-- 마스터 M -->
    <rect class="box" x="100" y="100" width="120" height="56" rx="6" />
    <rect data-id="mErr" class="err hide" x="100" y="100" width="120" height="56" rx="6" />
    <text x="160" y="118" style="font-weight:700">노드 M</text>
    {mst.map(([t, k], i) => <text data-id={`m-${i}`} class={`${cls(k)} hide`} x="160" y="140" style="font-size:14px">{t}</text>)}
    <rect data-id="hM" class="hl" x="97" y="97" width="126" height="62" rx="8" />

    <!-- 복제 선 -->
    <g data-id="repM" class="hide">
      <line class="line" x1="120" y1="156" x2="70" y2="198" marker-end="url(#sf-arr)" />
      <line class="line" x1="200" y1="156" x2="250" y2="198" marker-end="url(#sf-arr)" />
    </g>
    <g data-id="repR" class="hide">
      <line x1="122" y1="232" x2="196" y2="232" style="stroke:var(--sl-color-accent);stroke-width:2" marker-end="url(#sf-arr)" />
      <text class="hi" x="160" y="220" style="font-size:14px">복제</text>
    </g>
    <line data-id="back" class="hide" x1="70" y1="198" x2="118" y2="159" style="stroke:var(--sl-color-accent);stroke-width:2;stroke-dasharray:5 3" marker-end="url(#sf-arr)" />

    <!-- 레플리카 -->
    {RX.map((x, i) => (
      <g>
        <rect class="box" x={x} y="200" width="112" height="66" rx="6" />
        <text x={x + 56} y="216" style="font-weight:700">노드 R{i + 1}</text>
        <text class="mono" x={x + 56} y="254" style="fill:var(--sl-color-gray-2)">offset {i === 0 ? '1000' : '980'}</text>
        <rect data-id={`hR${i}`} class="hl" x={x - 3} y="197" width="118" height="72" rx="8" />
      </g>
    ))}
    {[r1, r2].map((arr, r) => arr.map(([t, k], i) => (
      <text data-id={`r${r}-${i}`} class={`${cls(k)} hide`} x={RX[r] + 56} y="235" style="font-size:14px">{t}</text>
    )))}

    <!-- 클라이언트 -->
    <g data-id="cli" class="hide">
      <rect class="chip" x="8" y="292" width="112" height="34" rx="6" />
      <text x="64" y="309" style="font-weight:700">클라이언트</text>
      <line x1="64" y1="292" x2="64" y2="270" style="stroke:var(--sl-color-accent);stroke-width:2" marker-end="url(#sf-arr)" />
      <text class="hi l" x="130" y="309" style="font-size:14px">→ R1로 재접속</text>
    </g>
    <rect data-id="hC" class="hl" x="5" y="289" width="118" height="40" rx="8" />

    {notes.map(([a, b], i) => (
      <g data-id={`n${i}`} class="hide">
        <text class="l hi" x="4" y="350" style="font-size:15px">{a}</text>
        <text class="l" x="4" y="374" style="font-size:14px">{b}</text>
      </g>
    ))}
  </svg>
</Stepper>
