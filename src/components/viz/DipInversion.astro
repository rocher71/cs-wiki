---
// DIP: 고수준이 저수준 구체 클래스를 직접 의존 → 인터페이스를 고수준 쪽에 두고 구현 화살표가 위로 역전 → 스프링이 주입
import Stepper from '../Stepper.astro';
const steps = [
  { caption: 'Before: OrderService가 KakaoPayClient를 직접 new 해요. 결제사를 바꾸면 주문 로직인 OrderService를 고쳐야 해요.', show: ['os', 'dep', 'kakaoClient', 'beforeNote'] },
  { caption: 'OrderService 쪽에 PaymentGateway 인터페이스를 둬요. KakaoPayGateway가 그것을 구현하니, 저수준에서 고수준으로 화살표가 위로 향해요(의존 방향 역전).', show: ['os', 'dep', 'pg', 'split', 'kakao', 'implK', 'hl-up'] },
  { caption: 'TossPayGateway를 옆에 추가해도 OrderService 코드는 한 줄도 안 바뀌어요. 확장에는 열리고 수정에는 닫혀 있어요(OCP).', show: ['os', 'dep', 'pg', 'split', 'kakao', 'implK', 'toss', 'implT', 'hl-toss'] },
  { caption: '스프링 컨테이너가 PaymentGateway 타입의 빈을 찾아 OrderService 생성자에 넣어 줘요. OrderService는 new를 하지 않아요(IoC, DI).', show: ['os', 'dep', 'pg', 'split', 'kakao', 'implK', 'toss', 'implT', 'spring', 'inject'] },
];
---
<Stepper title="DIP: 화살표 역전과 스프링 주입" steps={steps}>
  <svg class="viz" viewBox="0 0 320 372" role="img" aria-label="OrderService가 KakaoPayClient에 직접 의존하다가, PaymentGateway 인터페이스를 두고 구현체들이 위로 구현 화살표를 보내며, 스프링 컨테이너가 구현체를 주입하는 그림">
    <defs>
      <marker id="dip-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L10 5L0 10z" fill="var(--sl-color-gray-3)" />
      </marker>
      <marker id="dip-tri" viewBox="0 0 12 12" refX="11" refY="6" markerWidth="9" markerHeight="9" orient="auto">
        <path d="M0 0L12 6L0 12z" fill="var(--sl-color-bg)" stroke="var(--sl-color-gray-3)" stroke-width="1.4" />
      </marker>
    </defs>

    <g data-id="os">
      <rect class="box" x="80" y="20" width="160" height="44" rx="8" />
      <text x="160" y="42" style="font-weight:700">OrderService</text>
    </g>

    <g data-id="dep">
      <line class="line" x1="160" y1="66" x2="160" y2="108" marker-end="url(#dip-arr)" />
    </g>

    <g data-id="kakaoClient" class="hide">
      <rect class="box" x="80" y="110" width="160" height="44" rx="8" />
      <text x="160" y="132">KakaoPayClient</text>
      <text class="sub l" x="168" y="87">직접 new</text>
    </g>
    <g data-id="beforeNote" class="hide">
      <text class="err-t" x="160" y="196">결제사 교체 → OrderService 수정</text>
    </g>

    <g data-id="pg" class="hide">
      <rect class="chip" x="80" y="110" width="160" height="44" rx="8" />
      <text x="160" y="125" style="font-size:14px">«interface»</text>
      <text x="160" y="143">PaymentGateway</text>
    </g>

    <g data-id="split" class="hide">
      <line class="frame" x1="8" y1="200" x2="290" y2="200" />
      <text class="sub l" x="8" y="186">▲ 고수준</text>
      <text class="sub l" x="8" y="216">▼ 저수준</text>
    </g>

    <g data-id="kakao" class="hide">
      <rect class="box" x="16" y="240" width="140" height="44" rx="8" />
      <text x="86" y="262">KakaoPayGateway</text>
    </g>
    <g data-id="implK" class="hide">
      <line class="line" x1="96" y1="238" x2="138" y2="158" stroke-dasharray="5 4" marker-end="url(#dip-tri)" />
    </g>

    <g data-id="toss" class="hide">
      <rect class="box" x="164" y="240" width="134" height="44" rx="8" />
      <text x="231" y="262">TossPayGateway</text>
    </g>
    <g data-id="implT" class="hide">
      <line class="line" x1="222" y1="238" x2="182" y2="158" stroke-dasharray="5 4" marker-end="url(#dip-tri)" />
    </g>

    <g data-id="spring" class="hide">
      <rect class="frame" x="8" y="316" width="304" height="44" rx="8" />
      <text x="160" y="338" style="font-weight:700">스프링 컨테이너 (빈 보관)</text>
    </g>
    <g data-id="inject" class="hide">
      <polyline class="line" points="306,314 306,42 244,42" marker-end="url(#dip-arr)" />
      <text class="sub" x="276" y="100">생성자</text>
      <text class="sub" x="276" y="120">주입</text>
    </g>

    <rect data-id="hl-up" class="hl" x="86" y="150" width="62" height="92" rx="10" />
    <rect data-id="hl-toss" class="hl" x="160" y="236" width="142" height="52" rx="10" />
  </svg>
</Stepper>
